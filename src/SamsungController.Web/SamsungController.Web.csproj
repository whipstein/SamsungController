<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Work around dotnet-watch's mixed path separators on POSIX in .NET SDK 10. -->
    <BaseOutputPath Condition="'$(OS)' != 'Windows_NT'">bin/</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(OS)' != 'Windows_NT'">obj/</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath Condition="'$(OS)' != 'Windows_NT'">false</AppendTargetFrameworkToOutputPath>
    <OutputPath Condition="'$(OS)' != 'Windows_NT'">$(BaseOutputPath)$(Configuration)/$(TargetFramework)/</OutputPath>
    <IntermediateOutputPath Condition="'$(OS)' != 'Windows_NT'">$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SamsungController.Automation/SamsungController.Automation.csproj" />
    <ProjectReference Include="../SamsungController.Core/SamsungController.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../samples/menus/s95f-draft.yaml"
             Link="menu-definitions/s95f-draft.yaml"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
