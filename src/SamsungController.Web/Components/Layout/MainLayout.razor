@inherits LayoutComponentBase
@implements IDisposable
@using SamsungController.Web.Components.Shared
@inject SamsungIpRemoteService Controller
@inject IJSRuntime JavaScript
@inject NavigationManager Navigation

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand-lockup"><div class="brand-mark" aria-hidden="true"><span></span></div><div><strong>SamsungController</strong><span>Direct IP control</span></div></div>
        <nav class="main-nav" aria-label="Primary navigation">
            <NavLink href="" Match="NavLinkMatch.All"><span class="nav-glyph">01</span>Display</NavLink>
            <NavLink href="menu"><span class="nav-glyph">02</span>Menu</NavLink>
            <NavLink href="diagnostics"><span class="nav-glyph">03</span>Communication log</NavLink>
        </nav>
        <div class="sidebar-foot"><span class="local-dot"></span>Local control<small>v@SamsungIpRemoteService.Version</small></div>
    </aside>
    <main class="main-stage">
        <header class="topbar">
            <div class="topbar-primary">
                <div class="topbar-context"><span class="eyebrow">SAMSUNG · DIRECT IP</span><strong>@(Snapshot.ActiveProfile?.Model is { Length: > 0 } model ? model : Snapshot.ActiveProfile?.Connection.Host ?? "Choose a display")</strong></div>
                <div class="topbar-connection-control">
                    <button type="button" class="theme-toggle" title="Switch between light and dark mode" aria-label="Switch between light and dark mode" @onclick="ToggleThemeAsync" disabled="@ThemeBusy">
                        <span class="theme-toggle-state light" aria-hidden="true"><i>☀</i> Light</span><span class="theme-toggle-state dark" aria-hidden="true"><i>☾</i> Dark</span>
                    </button>
                    <div class="connection-pill @(Snapshot.Menu.Connected ? "connected" : "disconnected")" title="@Snapshot.Menu.TransportStatus"><span></span>@(Snapshot.Menu.Connected ? "Connected" : "Disconnected")</div>
                    <button class="topbar-connection-button" @onclick="ToggleConnectionAsync" disabled="@Snapshot.IsBusy">@(Snapshot.Menu.Connected ? "Disconnect" : "Connect")</button>
                    <button class="toolbar-button danger-action" @onclick="Controller.Cancel" disabled="@(!Snapshot.IsBusy)">Stop</button>
                    <DesktopAppControls />
                </div>
            </div>
            <div class="direct-header-context">
                <div><span>INPUT · TV REPORTED</span><strong>@(Snapshot.Menu.Connected ? Snapshot.Menu.Input ?? "Not reported" : "—")</strong></div>
                <div><span>PICTURE MODE · TV REPORTED</span><strong>@(Snapshot.Menu.Connected ? Snapshot.Menu.PictureMode ?? "Not reported" : "—")</strong></div>
                <div class="direct-header-keys" role="group" aria-label="TV shortcuts">
                    <button class="toolbar-button" @onclick='() => KeyAsync("firstScreen")' disabled="@(!CanSend)">Home</button>
                    <button class="toolbar-button" @onclick='() => KeyAsync("return")' disabled="@(!CanSend)">Back</button>
                    <button class="toolbar-button" @onclick='() => KeyAsync("exit")' disabled="@(!CanSend)">Exit menu</button>
                    <button type="button" class="toolbar-button" title="Reload every section and available calibration row for the current signal; discards unsent edits" @onclick="RefreshAllAsync" disabled="@(!CanRefreshAll)">Refresh state</button>
                    <button type="button" class="toolbar-button" popovertarget="page-help" aria-controls="page-help" aria-haspopup="dialog" title="Help for this page">Help</button>
                </div>
            </div>
            @if (Error is not null) { <p class="topbar-feedback danger" role="alert">@Error</p> }
            @if (Snapshot.StorageWarning is not null) { <p class="topbar-feedback danger" role="alert">@Snapshot.StorageWarning</p> }
            @if (Snapshot.RgbProbe?.NeedsRecovery == true) { <p class="topbar-feedback danger" role="alert">RGB experiment active — saved originals need recovery. <a href="diagnostics/batch-rgb">Open Batch / RGB test</a>.</p> }
            @if (Snapshot.Menu.WhiteBalanceRead?.NeedsRestore == true && !Snapshot.IsBusy) { <p class="topbar-feedback danger" role="alert">20-point WB was temporarily enabled for reading. <a href="menu">Check/restore its original Off mode in Menu</a>.</p> }
            <p class="topbar-feedback direct-live-status" role="status" title="@(Snapshot.IsBusy ? Snapshot.Menu.Status : null)">@(Snapshot.IsBusy ? Snapshot.Menu.Status : "")</p>
        </header>
        <CascadingValue Value="this" IsFixed="true"><article class="page-content">@Body</article></CascadingValue>
    </main>
</div>

<DirectHelp Section="@MenuHelpSection" />

<button type="button" class="remote-drawer-tab" popovertarget="remote-drawer" aria-controls="remote-drawer" aria-label="Open remote" title="Open the TV remote without leaving this page"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m11 6-6 6 6 6m8-12-6 6 6 6" /></svg></button>
<aside id="remote-drawer" class="remote-drawer" popover="auto" role="dialog" aria-modal="false" aria-labelledby="remote-drawer-title">
    <header class="remote-drawer-heading">
        <div><span class="eyebrow">DIRECT IP KEYS</span><h2 id="remote-drawer-title">Remote</h2></div>
        <button type="button" class="toolbar-button" popovertarget="remote-drawer" popovertargetaction="hide" aria-label="Close remote" autofocus>Close ×</button>
    </header>
    <div class="remote-drawer-body"><DirectRemote /></div>
</aside>

@code {
    private IpRemoteSnapshot Snapshot = new();
    private string? Error;
    private bool ThemeBusy;
    private string MenuHelpSection = "expert";
    public void SetMenuHelpSection(string section)
    {
        if (MenuHelpSection == section) return;
        MenuHelpSection = section;
        _ = InvokeAsync(StateHasChanged);
    }
    private bool CanSend => Snapshot.Menu.Connected && !Snapshot.IsBusy && Snapshot.RgbProbe?.NeedsRecovery != true && Snapshot.Menu.Update?.NeedsReview != true && Snapshot.Menu.WhiteBalanceRead?.NeedsRestore != true;
    private bool CanRefreshAll => CanSend && Snapshot.PictureTest?.RequiresRecovery != true && Snapshot.CommandTrial?.RequiresReview != true;
    protected override async Task OnInitializedAsync()
    { Controller.Changed += Refresh; await GuardAsync(Controller.InitializeAsync); }
    private void Refresh() => _ = InvokeAsync(() => { Snapshot = Controller.GetSnapshot(); StateHasChanged(); });
    private Task ToggleConnectionAsync() => GuardAsync(async () =>
    {
        if (Snapshot.Menu.Connected) await Controller.DisconnectMenuAsync();
        else if (Snapshot.ActiveProfile is null || !Snapshot.HasToken) Navigation.NavigateTo("/");
        else await Controller.ConnectMenuAsync();
    });
    private Task KeyAsync(string key) => GuardAsync(() => Controller.SendMenuKeyAsync(key));
    private Task RefreshAllAsync() => GuardAsync(Controller.RefreshAllMenuSettingsAsync);
    private async Task ToggleThemeAsync()
    {
        ThemeBusy = true;
        try { await JavaScript.InvokeVoidAsync("samsungTheme.toggle"); }
        catch (JSException) { }
        finally { ThemeBusy = false; }
    }
    private async Task GuardAsync(Func<Task> action)
    {
        Error = null;
        try { await action(); }
        catch (Exception error) when (error is InvalidOperationException or ArgumentException or IOException or UnauthorizedAccessException or JsonException or OperationCanceledException) { Error = error.Message; }
        finally { Snapshot = Controller.GetSnapshot(); }
    }
    public void Dispose() => Controller.Changed -= Refresh;
}
