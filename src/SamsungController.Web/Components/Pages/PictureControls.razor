    private async Task DownloadTargetCalibrationAsync()
    {
        if (!CanExportTargetCalibration)
        {
            return;
        }

        IsBusy = true;
        LocalError = null;
        LocalStatus = null;
        try
        {
            var name = string.IsNullOrWhiteSpace(TargetCalibrationName)
                ? $"{Navigation.DefinitionName ?? Navigation.Model ?? "TV"} calibration"
                : TargetCalibrationName.Trim();
            var document = new MenuControlTargetProfile(
                MenuControlTargetProfileSerializer.CurrentVersion,
                name,
                Profile.DefinitionId!,
                Navigation.DefinitionName,
                Navigation.Model,
                Navigation.Context,
                DateTimeOffset.UtcNow,
                CreateControlProfileValues());
            var json = MenuControlTargetProfileSerializer.Serialize(document);
            var fileName = $"{CreateTargetFileStem(name)}.samsung-calibration.json";
            await JavaScript.InvokeVoidAsync(
                "samsungController.downloadText",
                fileName,
                json);
            LocalStatus = $"Downloaded '{fileName}' with {document.Values.Count} desired values. No TV commands were sent.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task LoadTargetCalibrationAsync(InputFileChangeEventArgs args)
    {
        IsBusy = true;
        LocalError = null;
        LocalStatus = null;
        try
        {
            var (document, normalizedValues) = await ReadCalibrationFileAsync(args);
            var (controlAssignments, indexedAssignments) = ResolveCalibrationAssignments(
                normalizedValues);

            foreach (var assignment in controlAssignments)
            {
                assignment.Control.DesiredValue = assignment.Value;
            }

            foreach (var assignment in indexedAssignments)
            {
                assignment.Cell.DesiredValue = assignment.Value;
            }

            ClearPendingValuesThatBecameUnavailable();
            EnsureSelectedMenuArea();
            await Controller.SaveMenuControlProfileAsync(CreateControlProfileValues());
            Profile = Controller.GetMenuControlProfileSnapshot();
            TargetCalibrationName = document.Name;
            LocalStatus = $"Loaded '{document.Name}' and staged {PendingCount} difference{(PendingCount == 1 ? string.Empty : "s")} from the current-TV baseline. The targets were saved locally; no TV commands were sent. Review the differences, then choose Apply when ready.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            TargetFileInputKey++;
            IsBusy = false;
        }
    }

    private async Task LoadCalibrationAsCurrentAsync(InputFileChangeEventArgs args)
    {
        IsBusy = true;
        LocalError = null;
        LocalStatus = null;
        try
        {
            var (document, normalizedValues) = await ReadCalibrationFileAsync(args);
            var (controlAssignments, indexedAssignments) = ResolveCalibrationAssignments(
                normalizedValues);
            foreach (var assignment in controlAssignments)
            {
                CurrentStateDraft[ControlDraftKey(assignment.Control.Node.Id)] = assignment.Value;
            }

            foreach (var assignment in indexedAssignments)
            {
                CurrentStateDraft[IndexedDraftKey(assignment.Group, assignment.Cell)] = assignment.Value;
            }

            SavedStateName = document.Name;
            EnsureSelectedMenuArea();
            LocalStatus = $"Loaded {normalizedValues.Count} value{(normalizedValues.Count == 1 ? string.Empty : "s")} from '{document.Name}' into the current-settings draft. No TV commands were sent. Review the values, then choose Save entered values.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            TargetFileInputKey++;
            IsBusy = false;
        }
    }

    private async Task<(
        MenuControlTargetProfile Document,
        IReadOnlyList<MenuControlProfileValue> Values)> ReadCalibrationFileAsync(
        InputFileChangeEventArgs args)
    {
        const long maximumFileSize = 2 * 1024 * 1024;
        if (args.File.Size > maximumFileSize)
        {
            throw new InvalidOperationException(
                "A calibration file cannot exceed 2 MB.");
        }

        await using var stream = args.File.OpenReadStream(maximumFileSize);
        using var reader = new StreamReader(stream);
        var json = await reader.ReadToEndAsync();
        var document = MenuControlTargetProfileSerializer.Deserialize(json);
        if (string.IsNullOrWhiteSpace(Profile.DefinitionId)
            || !document.DefinitionId.Equals(
                Profile.DefinitionId,
                StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException(
                $"Calibration '{document.Name}' belongs to menu definition '{document.DefinitionId}', but the active definition is '{Profile.DefinitionId ?? "none"}'. Load the matching menu structure first.");
        }

        return (document, Controller.ValidateMenuControlProfileValues(document.Values));
    }

    private (
        IReadOnlyList<(PictureControlEdit Control, string Value)> Controls,
        IReadOnlyList<(IndexedControlGroupEdit Group, IndexedCellEdit Cell, string Value)> Indexed)
        ResolveCalibrationAssignments(IReadOnlyList<MenuControlProfileValue> values)
    {
        var controlAssignments = new List<(PictureControlEdit Control, string Value)>();
        var indexedAssignments = new List<(
            IndexedControlGroupEdit Group,
            IndexedCellEdit Cell,
            string Value)>();
        var unavailable = new List<string>();
        foreach (var value in values)
        {
            if (string.IsNullOrWhiteSpace(value.SelectorNodeId))
            {
                var control = Controls.FirstOrDefault(candidate =>
                    !IsIndexedControl(candidate.Node.Id)
                    && candidate.Node.Id.Equals(value.NodeId, StringComparison.OrdinalIgnoreCase));
                if (control is null)
                {
                    unavailable.Add(value.NodeId);
                }
                else
                {
                    controlAssignments.Add((control, value.Value));
                }

                continue;
            }

            var group = IndexedGroups.FirstOrDefault(candidate => candidate.Selector.Id.Equals(
                value.SelectorNodeId,
                StringComparison.OrdinalIgnoreCase));
            var row = group?.Rows.FirstOrDefault(candidate => candidate.SelectorValue.Equals(
                value.SelectorValue,
                StringComparison.OrdinalIgnoreCase));
            var cell = row?.Cells.FirstOrDefault(candidate => candidate.Slider.Id.Equals(
                value.NodeId,
                StringComparison.OrdinalIgnoreCase));
            if (group is null || cell is null)
            {
                unavailable.Add(
                    $"{value.SelectorNodeId}/{value.SelectorValue}/{value.NodeId}");
            }
            else
            {
                indexedAssignments.Add((group, cell, value.Value));
            }
        }

        if (unavailable.Count > 0)
        {
            throw new InvalidOperationException(
                $"The active verified Menu page cannot load {unavailable.Count} calibration value{(unavailable.Count == 1 ? string.Empty : "s")}: {string.Join(", ", unavailable.Take(5))}{(unavailable.Count > 5 ? ", …" : string.Empty)}.");
        }

        return (controlAssignments, indexedAssignments);
    }

    private static string CreateTargetFileStem(string name)
    {
        var characters = name.Trim().ToLowerInvariant().Select(character =>
            char.IsLetterOrDigit(character) ? character : '-').ToArray();
        var stem = string.Join(
            '-',
            new string(characters).Split('-', StringSplitOptions.RemoveEmptyEntries));
        return string.IsNullOrWhiteSpace(stem) ? "calibration-target" : stem;
    }

