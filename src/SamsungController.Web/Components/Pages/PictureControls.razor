    private void ApplySavedTvState(SavedMenuControlState state)
    {
        foreach (var control in Controls.Where(control => !IsIndexedControl(control.Node.Id)))
        {
            var savedValue = state.Values.FirstOrDefault(value =>
                string.IsNullOrWhiteSpace(value.SelectorNodeId)
                && value.NodeId.Equals(control.Node.Id, StringComparison.OrdinalIgnoreCase));
            if (savedValue is null)
            {
                continue;
            }

            var normalized = NormalizeControlValueWithoutError(
                control.Node,
                savedValue.Value);
            if (normalized is null)
            {
                continue;
            }

            control.AppliedValue = normalized;
            control.DesiredValue = normalized;
            control.AwaitingConfirmation = false;
            control.Confirmed = false;
        }

        foreach (var group in IndexedGroups)
        {
            foreach (var row in group.Rows)
            {
                foreach (var cell in row.Cells)
                {
                    var savedValue = state.Values.FirstOrDefault(value =>
                        value.NodeId.Equals(cell.Slider.Id, StringComparison.OrdinalIgnoreCase)
                        && value.SelectorNodeId?.Equals(
                            group.Selector.Id,
                            StringComparison.OrdinalIgnoreCase) == true
                        && value.SelectorValue?.Equals(
                            row.SelectorValue,
                            StringComparison.OrdinalIgnoreCase) == true);
                    if (savedValue is null)
                    {
                        continue;
                    }

                    var normalized = NormalizeControlValueWithoutError(
                        cell.Slider,
                        savedValue.Value);
                    if (normalized is null)
                    {
                        continue;
                    }

                    cell.AppliedValue = normalized;
                    cell.DesiredValue = normalized;
                }
            }

            group.AwaitingConfirmation = false;
        }

        ClearPendingValuesThatBecameUnavailable();
    }

    private IReadOnlyList<MenuControlProfileValue> CreateControlProfileValues() => Controls
        .Where(control => !IsIndexedControl(control.Node.Id))
        .Select(control => new MenuControlProfileValue(
            control.Node.Id,
            control.DesiredValue))
        .Concat(IndexedGroups.SelectMany(group => group.Rows.SelectMany(row => row.Cells.Select(cell =>
            new MenuControlProfileValue(
                cell.Slider.Id,
                cell.DesiredValue,
                group.Selector.Id,
                row.SelectorValue)))))
        .ToArray();

    private void ResetAppliedValuesToDeclaredDefaults()
    {
        foreach (var control in Controls)
        {
            var defaultValue = NormalizeDefaultValue(control.Node);
            if (defaultValue is not null)
            {
                control.AppliedValue = defaultValue;
            }

            control.AwaitingConfirmation = false;
            control.Confirmed = false;
        }

        foreach (var group in IndexedGroups)
        {
            group.AwaitingConfirmation = false;
            foreach (var cell in group.Rows.SelectMany(row => row.Cells))
            {
                var defaultValue = NormalizeDefaultValue(cell.Slider);
                if (defaultValue is not null)
                {
                    cell.AppliedValue = defaultValue;
                }
            }
        }
    }

    private async Task ConfirmControlAsync(PictureControlEdit control)
    {
        IsBusy = true;
        LocalError = null;
        try
        {
            if (control.Node.ControlType == MenuControlType.Slider)
            {
                Verification = await Controller.ConfirmMenuSliderBehaviorAsync(control.Node.Id);
            }
            else if (IsSelectionControl(control.Node.ControlType))
            {
                Verification = await Controller.ConfirmMenuSelectionBehaviorAsync(control.Node.Id);
            }

            control.AwaitingConfirmation = false;
            control.Confirmed = true;
            if (Verification.SlidersVerified && control.Node.ControlType == MenuControlType.Slider)
            {
                foreach (var slider in Controls.Where(candidate =>
                             candidate.Node.ControlType == MenuControlType.Slider))
                {
                    slider.AwaitingConfirmation = false;
                    slider.Confirmed = true;
                }

                LocalStatus = $"{control.Node.Label} confirmed at {control.AppliedValue}. Shared slider behavior is now verified for this TV.";
            }
            else if (control.Node.ControlType == MenuControlType.Slider)
            {
                LocalStatus = $"{control.Node.Label} confirmed at {control.AppliedValue} · {Verification.ConfirmedSliderCount}/{Verification.RequiredSliderCount} different sliders verified.";
            }
            else if (IsSelectionControl(control.Node.ControlType))
            {
                LocalStatus = $"{control.Node.Label} confirmed at {control.AppliedValue} · {Verification.ConfirmedSelectionCount}/{Verification.RequiredSelectionCount} selection interaction types verified.";
            }
            else
            {
                LocalStatus = $"{control.Node.Label} visually confirmed at {control.AppliedValue}.";
            }
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ConfirmIndexedGroupAsync(IndexedControlGroupEdit group)
    {
        IsBusy = true;
