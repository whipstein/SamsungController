@page "/menu"
@implements IDisposable
@inject SamsungControllerService Controller
@inject IJSRuntime JavaScript

<PageTitle>Menu · SamsungController</PageTitle>

<section class="page-heading compact-heading picture-controls-heading">
    <div>
        <span class="eyebrow">MENU</span>
        <h1>@(WorkspaceMode == MenuWorkspaceMode.CurrentState ? "Record current TV settings." : "Adjust verified menu settings.")</h1>
        <p>@(WorkspaceMode == MenuWorkspaceMode.CurrentState ? "Enter values already shown on the TV in a command-free local workspace." : "Controls are grouped like the TV and unlock after the complete menu structure has been verified for this display combination.")</p>
    </div>
    <div class="page-heading-actions">
        <HelpBubble Title="Menu control behavior" ButtonText="Page help">
            <ul>
                <li>Choose a top-level menu tab, then search or adjust controls grouped by their immediate TV menu section.</li>
                <li>Switches, selections, and submenu selections use predicted values and dynamically apply declared <code>disabledWhen</code> and <code>hiddenWhen</code> rules.</li>
                <li>Turning on 20 Point enables its Interval and RGB controls. Choosing Custom Color Space enables its Color and RGB controls.</li>
                <li>The 2pt tab separates RGB gains and offsets into two columns. The 20pt tab pins its enable switch first, and the Color tab places Color Space first.</li>
                <li>Every 20pt percentage and Custom Color choice groups three full RGB sliders with minus/plus buttons and a raw number input, so all values can be staged together without manually changing the selector.</li>
                <li><strong>Adjust TV</strong> sends or stages commands. <strong>Enter current settings</strong> uses an independent local draft and never sends commands to the TV.</li>
                <li><strong>Immediate</strong> sends one changed control at a time. <strong>Apply button</strong> can stage a controller and its newly enabled settings together.</li>
                <li><strong>Cancel active update</strong> stops a large Apply or reset/apply batch before the next key. It never sends cleanup keys after cancellation.</li>
                <li>A calibration JSON file can be loaded in either workspace. <strong>Adjust TV</strong> stages its values as targets; <strong>Enter current settings</strong> imports them into the command-free current-state draft.</li>
                <li><strong>Reset to defaults</strong> runs the verified reset and makes the declared defaults both the current baseline and saved targets. <strong>Reset &amp; apply all</strong> instead reapplies the saved calibration after the reset.</li>
                <li>Use <strong>Enter current settings</strong> to record values already visible on the TV and later load them as the prediction baseline. Saving or loading a state sends no remote commands.</li>
                <li>This page unlocks only after Display Verification is complete for the selected menu structure, TV, signal, picture mode, input, and configurations.</li>
                <li>Once unlocked, shared slider, switch, selection, submenu-selection, and indexed-selection behaviors are already trusted and do not request redundant confirmation.</li>
            </ul>
            <p class="help-callout">A conditionally enabled or visible control uses its verified containing-section route and the recalculated menu order after its controller has changed.</p>
        </HelpBubble>
        <a class="secondary-action menu-authoring-link" href="verification">Display verification <span>→</span></a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(LocalError))
{
    <div class="notice danger" role="alert"><strong>Menu needs attention</strong><span>@LocalError</span></div>
}
else if (!string.IsNullOrWhiteSpace(LocalStatus))
{
    <div class="notice" role="status"><strong>Menu</strong><span>@LocalStatus</span></div>
}

@if (!MenuIsAvailable)
{
    <section class="panel panel-empty picture-controls-empty menu-validation-lock">
        <strong>Menu controls are locked for this display</strong>
        <span>Complete Display Verification for @DisplayVerification.CurrentDisplay before changing menu settings. @DisplayVerification.VerifiedCount of @DisplayVerification.RequiredCount required checks currently match.</span>
        <a href="verification">Open Display Verification →</a>
    </section>
}
else
{
<nav class="menu-workspace-tabs" aria-label="Menu workspace" role="tablist">
    <button type="button"
            class="@(WorkspaceMode == MenuWorkspaceMode.AdjustTv ? "active" : string.Empty)"
            role="tab"
            aria-selected="@(WorkspaceMode == MenuWorkspaceMode.AdjustTv ? "true" : "false")"
            @onclick="() => SelectWorkspace(MenuWorkspaceMode.AdjustTv)"
            disabled="@IsBusy">
        <span>Adjust TV</span>
        <small>Send now or stage for Apply</small>
    </button>
    <button type="button"
            class="@(WorkspaceMode == MenuWorkspaceMode.CurrentState ? "active safe" : string.Empty)"
            role="tab"
            aria-selected="@(WorkspaceMode == MenuWorkspaceMode.CurrentState ? "true" : "false")"
            @onclick="() => SelectWorkspace(MenuWorkspaceMode.CurrentState)"
            disabled="@IsBusy">
        <span>Enter current settings</span>
        <small>Local values only · never sends commands</small>
    </button>
</nav>

@if (HasActiveTvUpdate)
{
    <section class="active-tv-update" role="alert" aria-live="assertive">
        <div>
            <span>@(ActiveUpdateSource!.IsCancellationRequested ? "STOP REQUESTED" : "TV UPDATE IN PROGRESS")</span>
            <strong>@(Navigation.Progress?.Phase ?? ActiveUpdateLabel)</strong>
            @if (Navigation.Progress is { } progress)
            {
                <small>Command @progress.CommandNumber of @progress.CommandCount · @progress.Key · @progress.TargetPath</small>
            }
            else
            {
                <small>The stop button prevents the next remote key; a key already in flight cannot be recalled.</small>
            }
        </div>
        <button type="button"
                class="secondary-action danger-action cancel-active-update"
                @onclick="CancelActiveUpdate"
                disabled="@ActiveUpdateSource!.IsCancellationRequested">
            @(ActiveUpdateSource.IsCancellationRequested ? "Stopping…" : "Cancel active update")
        </button>
    </section>
}

@if (WorkspaceMode == MenuWorkspaceMode.CurrentState)
{
    <section class="panel current-state-workspace">
        <div class="current-state-safety">
            <div>
                <span>COMMAND-FREE WORKSPACE</span>
                <strong>Record what is already shown on the TV.</strong>
                <small>Edits below stay in a separate local draft. They cannot update the TV, even if immediate updates are enabled in the Adjust TV workspace.</small>
            </div>
            <b>NO TV COMMANDS</b>
        </div>
        <div class="saved-tv-state-manager">
            <label>
                <span>STATE NAME</span>
                <input @bind="SavedStateName" maxlength="80" placeholder="Current calibrated state" disabled="@IsBusy" />
            </label>
            <button class="primary-action" @onclick="SaveCurrentTvStateAsync" disabled="@(!CanSaveCurrentTvState)">Save entered values</button>
            <label>
                <span>LOAD SAVED STATE</span>
                <select @bind="SelectedSavedStateId" disabled="@(IsBusy || SavedTvStates.Count == 0)">
                    @if (SavedTvStates.Count == 0)
                    {
                        <option value="">No saved states</option>
                    }
                    @foreach (var state in SavedTvStates)
                    {
                        <option value="@state.Id">@state.Name · @state.SavedAtUtc.ToLocalTime().ToString("g")</option>
                    }
                </select>
            </label>
            <button class="secondary-action" @onclick="LoadCurrentTvStateAsync" disabled="@(!CanUseSavedTvState)">Load for editing</button>
            <button class="quiet-action" @onclick="ResetCurrentStateDraft" disabled="@(IsBusy || !CurrentStateDraftChanged)">Discard draft</button>
            <button class="quiet-action danger-action" @onclick="DeleteCurrentTvStateAsync" disabled="@(!CanUseSavedTvState)">Delete saved state</button>
        </div>
        <div class="current-state-file-import">
            <div>
                <span>PORTABLE CALIBRATION FILE</span>
                <strong>Load values as the TV's current settings.</strong>
                <small>The file fills the command-free draft below. Review the values, then choose Save entered values to make them the prediction baseline.</small>
            </div>
            <label class="target-calibration-file @(IsBusy ? "disabled" : string.Empty)">
                <span>LOAD CALIBRATION JSON AS CURRENT</span>
                <InputFile @key="TargetFileInputKey"
                           OnChange="LoadCalibrationAsCurrentAsync"
                           accept=".json,application/json"
                           disabled="@IsBusy" />
            </label>
        </div>
    </section>
}
else
{
    <section class="panel target-calibration-panel">
        <div class="target-calibration-copy">
            <span>PORTABLE CALIBRATION FILE · APPLY</span>
            <strong>Load desired values separately from the TV's current baseline.</strong>
            <small>Loading stages values and saves the local target profile; it sends no TV commands. Before Apply, load a matching current-TV state or use the verified reset/apply workflow—relative Samsung controls cannot recover from an incorrect starting value.</small>
        </div>
        <label class="target-calibration-name">
            <span>FILE NAME</span>
            <input @bind="TargetCalibrationName" maxlength="80" disabled="@IsBusy" />
        </label>
        <button class="secondary-action"
                @onclick="DownloadTargetCalibrationAsync"
                disabled="@(!CanExportTargetCalibration)">
            Download targets
        </button>
        <label class="target-calibration-file @(IsBusy ? "disabled" : string.Empty)">
            <span>LOAD CALIBRATION JSON TO APPLY</span>
            <InputFile @key="TargetFileInputKey"
                       OnChange="LoadTargetCalibrationAsync"
                       accept=".json,application/json"
                       disabled="@IsBusy" />
        </label>
    </section>
    <details class="panel picture-control-toolbar compact-update-panel">
        <summary>
            <span>Update behavior</span>
            <small>@UpdateBehaviorSummary</small>
            <b class="@(PendingCount > 0 ? "pending" : "clear")" title="@PendingDetailsSummary">@PendingBadgeLabel</b>
        </summary>
        <div class="compact-update-panel-body">
            <div class="picture-control-options">
                <label>
                    <span>WHEN VALUES CHANGE</span>
                    <select @bind="UpdateMode" disabled="@IsBusy">
                        <option value="@PictureUpdateMode.Immediate">Update TV immediately</option>
                        <option value="@PictureUpdateMode.Staged">Wait for Apply</option>
                    </select>
                </label>
                <label>
                    <span>AFTER UPDATE</span>
                    <select @bind="ExitBehavior" disabled="@IsBusy">
                        <option value="@PictureExitBehavior.Stay">Stay on last adjusted item</option>
                        <option value="@PictureExitBehavior.ReturnToVideo">Exit to normal video</option>
                    </select>
                </label>
                <div class="picture-control-summary">
                    <span>CURRENT MENU</span>
                    <strong>@(Snapshot.MenuLabel ?? "Unknown")</strong>
                    <small>@Snapshot.MenuConfidence confidence</small>
                </div>
                @if (FactoryResetCandidates.Count > 0)
                {
                    <label>
                        <span>FACTORY RESET ROUTE</span>
                        <select @bind="SelectedFactoryResetNodeId" @bind:after="SelectFactoryResetNode" disabled="@IsBusy">
                            @foreach (var candidate in FactoryResetCandidates)
                            {
                                <option value="@candidate.Id">@candidate.Path</option>
                            }
                        </select>
                    </label>
                    <button class="secondary-action danger-action" @onclick="() => BeginFactoryReset(FactoryResetAction.ResetToDefaults)" disabled="@(!CanBeginFactoryReset)">Reset to defaults</button>
                    <button class="secondary-action danger-action" @onclick="() => BeginFactoryReset(FactoryResetAction.ResetAndApply)" disabled="@(!CanBeginFactoryReset)">Reset &amp; apply all</button>
                }
                <button class="secondary-action" @onclick="SaveControlProfileAsync" disabled="@(!CanSaveControlProfile)">Save profile</button>
                <button class="primary-action picture-apply-action" @onclick="ApplyPendingAsync" disabled="@(!CanApplyPending)">
                    @(IsBusy ? "Applying…" : $"Apply {PendingCount} change{(PendingCount == 1 ? string.Empty : "s")}") <span>▶</span>
                </button>
            </div>
            @if (PendingCount > 0)
            {
                <div class="pending-target-explanation">
                    <div>
                        <span>SAVED TARGET DIFFERS FROM CURRENT PREDICTION</span>
                        <strong>These values have not been sent in this session.</strong>
                        <small>Samsung TVs do not report menu-setting values. Apply sends these targets, or use Enter current settings to record what is already on the TV.</small>
                    </div>
                    <ul>
                        @foreach (var pending in GetPendingControlSummaries().Take(6))
                        {
                            <li><span>@pending.Label</span><b>@pending.AppliedValue</b><i>→</i><strong>@pending.DesiredValue</strong></li>
                        }
                        @if (PendingCount > 6)
                        {
                            <li class="pending-target-more">+ @(PendingCount - 6) more</li>
                        }
                    </ul>
                </div>
            }
            @if (ConfirmFactoryReset)
            {
                <div class="factory-reset-confirmation" role="alert">
                    <div>
                        <strong>@(PendingFactoryResetAction == FactoryResetAction.ResetToDefaults ? "Reset settings and keep the factory defaults?" : "Reset settings and reapply the saved calibration?")</strong>
                        @if (PendingFactoryResetAction == FactoryResetAction.ResetToDefaults)
                        {
                            <span>SamsungController will execute <b>@SelectedFactoryResetNode?.Path</b>, choose <b>@SelectedFactoryResetChoice</b>, and return to normal video. The declared menu defaults will replace both the current-value baseline and saved targets. No calibration values will be reapplied.</span>
                        }
                        else
                        {
                            <span>SamsungController will execute <b>@SelectedFactoryResetNode?.Path</b>, choose <b>@SelectedFactoryResetChoice</b>, return to normal video, and then apply every staged value from known menu-definition defaults. This changes all settings covered by that TV reset.</span>
                        }
                    </div>
                    <button class="secondary-action" @onclick="CancelFactoryReset" disabled="@IsBusy">Cancel</button>
                    <button class="primary-action danger-action" @onclick="ExecuteConfirmedFactoryResetAsync" disabled="@IsBusy">
                        @(PendingFactoryResetAction == FactoryResetAction.ResetToDefaults ? "Yes — reset to defaults" : "Yes — reset and apply all")
                    </button>
                </div>
            }
        </div>
    </details>
}

@if (HasExpertControls)
{
    <section class="panel expert-settings-panel">
        <header class="expert-settings-heading">
            <div>
                <span>EXPERT SETTINGS</span>
                <h2>Calibration controls</h2>
                <p>Keep the most-used white-balance and custom-color controls close at hand.</p>
            </div>
            <small>@(WorkspaceMode == MenuWorkspaceMode.CurrentState ? "ENTER VALUES ONLY" : "VERIFIED TV CONTROLS")</small>
        </header>
        <nav class="expert-settings-tabs" aria-label="Expert settings groups" role="tablist">
            @foreach (var tab in ExpertTabs)
            {
                var isSelected = tab.Kind == SelectedExpertTab;
                <button type="button"
                        class="@(isSelected ? "active" : string.Empty)"
                        role="tab"
                        aria-selected="@isSelected.ToString().ToLowerInvariant()"
                        @onclick="() => SelectedExpertTab = tab.Kind"
                        disabled="@IsBusy">
                    <span>@tab.Label</span>
                    <b>@GetExpertControlCount(tab.Kind)</b>
                </button>
            }
        </nav>

        @if (GetExpertControlCount(SelectedExpertTab) == 0)
        {
            <div class="expert-settings-empty">No @GetExpertTabLabel(SelectedExpertTab) controls are defined in this menu structure.</div>
        }
        else
        {
            <div class="expert-settings-content">
                @if (SelectedExpertTab == ExpertSettingsKind.TwoPointWhiteBalance)
                {
                    <div class="two-point-balance-groups">
                        @foreach (var group in TwoPointGroups)
                        {
                            var groupedControls = GetTwoPointControls(group.Kind);
                            @if (groupedControls.Count > 0)
                            {
                                <section class="two-point-balance-group">
                                    <header>
                                        <span>@group.Label.ToUpperInvariant()</span>
                                        <h3>RGB @group.Label</h3>
                                        <small>@group.Description</small>
                                    </header>
                                    <div class="two-point-balance-control-list">
                                        @foreach (var control in groupedControls)
                                        {
                                            var disabled = IsControlDisabled(control);
                                            <MenuControlCard Node="@control.Node"
                                                             Value="@GetControlDisplayValue(control)"
                                                             ReferenceValue="@control.AppliedValue"
                                                             Disabled="@disabled"
                                                             Busy="@IsBusy"
                                                             CurrentStateMode="@(WorkspaceMode == MenuWorkspaceMode.CurrentState)"
                                                             DisabledReason="@GetDisabledReason(control)"
                                                             StateClass="@GetControlCssClass(control, disabled)"
                                                             StateLabel="@GetControlStateLabel(control, disabled)"
                                                             ValueChanged="value => ChangeControlAsync(control, value)" />
                                        }
                                    </div>
                                </section>
                            }
                        }
                    </div>
                    @if (GetUngroupedTwoPointControls().Count > 0)
                    {
                        <div class="picture-control-grid expert-control-grid">
                            @foreach (var control in GetUngroupedTwoPointControls())
                            {
                                var disabled = IsControlDisabled(control);
                                <MenuControlCard Node="@control.Node"
                                                 Value="@GetControlDisplayValue(control)"
                                                 ReferenceValue="@control.AppliedValue"
                                                 Disabled="@disabled"
                                                 Busy="@IsBusy"
                                                 CurrentStateMode="@(WorkspaceMode == MenuWorkspaceMode.CurrentState)"
                                                 DisabledReason="@GetDisabledReason(control)"
                                                 StateClass="@GetControlCssClass(control, disabled)"
                                                 StateLabel="@GetControlStateLabel(control, disabled)"
                                                 ValueChanged="value => ChangeControlAsync(control, value)" />
                            }
                        </div>
                    }
                }
                else if (GetExpertControls(SelectedExpertTab).Count > 0)
                {
                    <div class="picture-control-grid expert-control-grid">
                        @foreach (var control in GetExpertControls(SelectedExpertTab))
                        {
                            var disabled = IsControlDisabled(control);
                            <MenuControlCard Node="@control.Node"
                                             Value="@GetControlDisplayValue(control)"
                                             ReferenceValue="@control.AppliedValue"
                                             Disabled="@disabled"
                                             Busy="@IsBusy"
                                             CurrentStateMode="@(WorkspaceMode == MenuWorkspaceMode.CurrentState)"
                                             DisabledReason="@GetDisabledReason(control)"
                                             StateClass="@GetControlCssClass(control, disabled)"
                                             StateLabel="@GetControlStateLabel(control, disabled)"
                                             ValueChanged="value => ChangeControlAsync(control, value)" />
                        }
                    </div>
                }
                @foreach (var group in GetExpertIndexedGroups(SelectedExpertTab))
                {
                    var groupDisabled = IsIndexedGroupDisabled(group);
                    <section class="picture-control-section indexed-control-section @(groupDisabled ? "disabled" : string.Empty)">
                        <header class="picture-section-heading">
                            <div>
                                <span>INDEXED RGB SLIDERS</span>
                                <h2>@group.Label</h2>
                                <p>@group.Path · each @group.Selector.Label option owns one fixed RGB slider row</p>
                            </div>
                            <small>@group.Rows.Count row@(group.Rows.Count == 1 ? string.Empty : "s")</small>
                        </header>
                        @if (groupDisabled)
                        {
                            <p class="picture-disabled-reason">@GetIndexedGroupDisabledReason(group)</p>
                        }
                        <div class="indexed-slider-groups">
                            @foreach (var row in group.Rows)
                            {
                                <section class="indexed-slider-row">
                                    <header>
                                        <span>@group.Selector.Label.ToUpperInvariant()</span>
                                        <h3>@row.SelectorValue</h3>
                                    </header>
                                    <div class="picture-control-grid indexed-slider-grid">
                                        @foreach (var cell in row.Cells)
                                        {
                                            <MenuControlCard Node="@cell.Slider"
                                                             Value="@GetIndexedDisplayValue(group, cell)"
                                                             ReferenceValue="@cell.AppliedValue"
                                                             Disabled="@groupDisabled"
                                                             Busy="@IsBusy"
                                                             CurrentStateMode="@(WorkspaceMode == MenuWorkspaceMode.CurrentState)"
                                                             DisabledReason="@GetIndexedGroupDisabledReason(group)"
                                                             StateClass="@GetIndexedCellCssClass(group, cell, groupDisabled)"
                                                             StateLabel="@GetIndexedCellStateLabel(group, cell, groupDisabled)"
                                                             ValueChanged="value => ChangeIndexedCellAsync(group, cell, value)" />
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    </section>
                }
            </div>
        }
    </section>
}

<section class="panel menu-area-browser">
    <div class="panel-label"><span>ALL MENU SETTINGS</span><span>@DisplayVerification.CurrentDisplay</span></div>
    @if (Controls.Count > 0)
    {
        <nav class="menu-control-tabs" aria-label="Top-level menu areas" role="tablist">
            @foreach (var area in GetMenuAreas())
            {
                var isSelected = area.Id.Equals(SelectedAreaId, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="menu-control-tab @(isSelected ? "active" : string.Empty)"
                        role="tab"
                        aria-selected="@isSelected.ToString().ToLowerInvariant()"
                        @onclick="() => SelectMenuArea(area.Id)"
                        disabled="@IsBusy">
                    <span>@area.Label</span>
                    <b>@area.ControlCount</b>
                </button>
            }
        </nav>
    }
    <div class="menu-control-filters">
        <label>
            <span>SEARCH THIS MENU AREA</span>
            <input type="search" @bind="SearchText" @bind:event="oninput" placeholder="Name or menu path" disabled="@IsBusy" />
        </label>
        <div class="slider-verification-summary verified">
            <span>WORKSPACE</span>
            <strong>@(WorkspaceMode == MenuWorkspaceMode.CurrentState ? "Local value entry · command-free" : "Fully verified TV updates")</strong>
            <small>@(WorkspaceMode == MenuWorkspaceMode.CurrentState ? "Saving records a new prediction baseline." : "Values are predictions based on changes sent during this session.")</small>
        </div>
    </div>
</section>

@if (GeneralVisibleControlCount == 0)
{
    <section class="panel panel-empty picture-controls-empty">
        <strong>@(Controls.Count == 0 ? "No verified menu controls are available" : "No additional controls match this menu area")</strong>
        <span>@(Controls.Count == 0 ? "Define values and bounds in the menu file, then complete the generated route verification." : "Choose another menu tab or clear the search text. Expert settings remain available above.")</span>
        <a href="menu/build">Open Build &amp; Verify →</a>
    </section>
}
else
{
    <div class="picture-control-sections">
        @foreach (var group in GetVisibleGeneralIndexedGroups())
        {
            var groupDisabled = IsIndexedGroupDisabled(group);
            <section class="panel picture-control-section indexed-control-section @(groupDisabled ? "disabled" : string.Empty)">
                <header class="picture-section-heading">
                    <div>
                        <span>FIXED VALUE GRID</span>
                        <h2>@group.Label</h2>
                        <p>@group.Path · each @group.Selector.Label option is fixed to one row</p>
                    </div>
                    <small>@group.Rows.Count row@(group.Rows.Count == 1 ? string.Empty : "s")</small>
                </header>
                @if (groupDisabled)
                {
                    <p class="picture-disabled-reason">@GetIndexedGroupDisabledReason(group)</p>
                }
                <div class="indexed-control-table-wrap">
                    <table class="indexed-control-table">
                        <thead>
                            <tr>
                                <th>@group.Selector.Label</th>
                                @foreach (var slider in group.Sliders)
                                {
                                    <th>@slider.Label <small>@FormatValue(slider.MinimumValue ?? 0)–@FormatValue(slider.MaximumValue ?? 0)</small></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in group.Rows)
                            {
                                <tr>
                                    <th scope="row">@row.SelectorValue</th>
                                    @foreach (var cell in row.Cells)
                                    {
                                        <td class="@(IsIndexedDisplayPending(group, cell) ? "pending" : string.Empty)">
                                            <input type="number"
                                                   min="@FormatValue(cell.Minimum)"
                                                   max="@FormatValue(cell.Maximum)"
                                                   step="1"
                                                   value="@GetIndexedDisplayValue(group, cell)"
                                                   aria-label="@group.Label @row.SelectorValue @cell.Slider.Label"
                                                   @onchange="args => ChangeIndexedCellAsync(group, cell, args.Value?.ToString())"
                                                   disabled="@(IsBusy || groupDisabled)" />
                                            <small>@(WorkspaceMode == MenuWorkspaceMode.CurrentState ? "Saved" : "TV"): @cell.AppliedValue</small>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        @foreach (var section in GetSections())
        {
            <section class="panel picture-control-section">
                <header class="picture-section-heading">
                    <div>
                        <span>MENU SECTION</span>
                        <h2>@section.Label</h2>
                        <p>@section.Path</p>
                    </div>
                    <small>@section.Controls.Count control@(section.Controls.Count == 1 ? string.Empty : "s")</small>
                </header>
                <div class="picture-control-grid">
                    @foreach (var control in section.Controls)
                    {
                        var disabled = IsControlDisabled(control);
                        <MenuControlCard Node="@control.Node"
                                         Value="@GetControlDisplayValue(control)"
                                         ReferenceValue="@control.AppliedValue"
                                         Disabled="@disabled"
                                         Busy="@IsBusy"
                                         CurrentStateMode="@(WorkspaceMode == MenuWorkspaceMode.CurrentState)"
                                         DisabledReason="@GetDisabledReason(control)"
                                         StateClass="@GetControlCssClass(control, disabled)"
                                         StateLabel="@GetControlStateLabel(control, disabled)"
                                         ValueChanged="value => ChangeControlAsync(control, value)" />
                    }
                </div>
            </section>
        }
    </div>
}
}

@code {
    private ControllerSnapshot Snapshot { get; set; } = null!;
    private MenuNavigationSnapshot Navigation { get; set; } = null!;
    private MenuDefinitionVerificationSnapshot DisplayVerification { get; set; } = null!;
    private MenuControlProfileSnapshot Profile { get; set; } = null!;
    private IReadOnlyList<SavedMenuControlStateSummary> SavedTvStates { get; set; } = [];
    private List<PictureControlEdit> Controls { get; } = [];
    private List<IndexedControlGroupEdit> IndexedGroups { get; } = [];
    private Dictionary<string, string> CurrentStateDraft { get; } = new(StringComparer.OrdinalIgnoreCase);
    private MenuWorkspaceMode WorkspaceMode { get; set; } = MenuWorkspaceMode.AdjustTv;
    private ExpertSettingsKind SelectedExpertTab { get; set; } = ExpertSettingsKind.ExpertSettings;
    private PictureUpdateMode UpdateMode { get; set; } = PictureUpdateMode.Staged;
    private PictureExitBehavior ExitBehavior { get; set; } = PictureExitBehavior.Stay;
    private string SelectedAreaId { get; set; } = string.Empty;
    private string SearchText { get; set; } = string.Empty;
    private string? LocalError { get; set; }
    private string? LocalStatus { get; set; }
    private bool IsBusy { get; set; }
    private bool ConfirmFactoryReset { get; set; }
    private FactoryResetAction PendingFactoryResetAction { get; set; } = FactoryResetAction.ResetAndApply;
    private string SelectedFactoryResetNodeId { get; set; } = string.Empty;
    private string SelectedFactoryResetChoice { get; set; } = string.Empty;
    private string SavedStateName { get; set; } = "Current TV state";
    private string SelectedSavedStateId { get; set; } = string.Empty;
    private string TargetCalibrationName { get; set; } = "Calibration target";
    private int TargetFileInputKey { get; set; }
    private CancellationTokenSource? ActiveUpdateSource { get; set; }
    private string ActiveUpdateLabel { get; set; } = "Applying menu values";

    private int PendingCount => Controls.Count(control =>
            control.Pending
            && !IsIndexedControl(control.Node.Id)
            && !IsControlDisabled(control)
            && !IsControlHidden(control))
        + IndexedGroups.Sum(group => IsIndexedGroupDisabled(group) || IsIndexedGroupHidden(group)
            ? 0
            : group.Rows.Sum(row => row.Cells.Count(cell => cell.Pending)));
    private int GeneralVisibleControlCount => GetFilteredControls().Count + GetVisibleGeneralIndexedGroups().Count;
    private bool HasExpertControls => Controls.Any(control => ClassifyExpertControl(control.Node) is not null)
        || IndexedGroups.Any(group => ClassifyExpertControl(group.Selector) is not null);
    private bool CurrentStateDraftChanged => Controls
            .Where(control => !IsIndexedControl(control.Node.Id))
            .Any(control => !GetControlDisplayValue(control).Equals(
                control.AppliedValue,
                StringComparison.OrdinalIgnoreCase))
        || IndexedGroups.SelectMany(group => group.Rows.SelectMany(row => row.Cells.Select(cell => (group, cell))))
            .Any(item => !GetIndexedDisplayValue(item.group, item.cell).Equals(
                item.cell.AppliedValue,
                StringComparison.OrdinalIgnoreCase));
    private string UpdateBehaviorSummary => $"{(UpdateMode == PictureUpdateMode.Immediate ? "Immediate" : "Apply button")} · {(ExitBehavior == PictureExitBehavior.Stay ? "stay on item" : "return to video")}";
    private string PendingBadgeLabel => PendingCount == 0
        ? "Targets match"
        : PendingCount == 1
            ? "1 saved target differs"
            : $"{PendingCount} saved targets differ";
    private string PendingDetailsSummary => PendingCount == 0
        ? "Every saved target matches the current TV prediction."
        : string.Join(
            "; ",
            GetPendingControlSummaries().Take(4).Select(pending =>
                $"{pending.Label}: {pending.AppliedValue} → {pending.DesiredValue}"));
    private bool MenuIsAvailable => DisplayVerification.FullyVerified;
    private bool HasActiveTvUpdate => ActiveUpdateSource is not null;
    private bool CanExportTargetCalibration => !IsBusy
        && MenuIsAvailable
        && Controls.Count > 0
        && !string.IsNullOrWhiteSpace(Profile.DefinitionId);
    private bool CanApplyPending => PendingCount > 0
        && MenuIsAvailable
        && !IsBusy
        && Snapshot.ConnectionState == SamsungConnectionState.Connected
        && !Snapshot.MacroRunning
        && !Navigation.IsRunning;
    private IReadOnlyList<MenuNodeSummary> FactoryResetCandidates => Navigation.Nodes
        .Where(node => node.ControlType == MenuControlType.Confirmation
            && node.HasVerifiedRoute
            && !IsNodeDisabled(node)
            && !IsNodeHidden(node)
            && (node.Id.Contains("reset", StringComparison.OrdinalIgnoreCase)
                || node.Label.Contains("reset", StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(node => node.Id.Equals("reset-picture", StringComparison.OrdinalIgnoreCase))
        .ThenBy(node => node.Depth)
        .ThenBy(node => node.Path, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    private MenuNodeSummary? SelectedFactoryResetNode => FactoryResetCandidates.FirstOrDefault(node =>
        node.Id.Equals(SelectedFactoryResetNodeId, StringComparison.OrdinalIgnoreCase));
    private bool CanBeginFactoryReset => !IsBusy
        && MenuIsAvailable
        && Snapshot.ConnectionState == SamsungConnectionState.Connected
        && SelectedFactoryResetNode is not null
        && !string.IsNullOrWhiteSpace(SelectedFactoryResetChoice)
        && !Snapshot.MacroRunning
        && !Navigation.IsRunning;
    private bool CanSaveControlProfile => !IsBusy
        && MenuIsAvailable
        && Controls.Count > 0
        && !Snapshot.MacroRunning
        && !Navigation.IsRunning;
    private bool CanSaveCurrentTvState => WorkspaceMode == MenuWorkspaceMode.CurrentState
        && CanSaveControlProfile
        && !string.IsNullOrWhiteSpace(SavedStateName);
    private bool CanUseSavedTvState => !IsBusy
        && MenuIsAvailable
        && !string.IsNullOrWhiteSpace(SelectedSavedStateId)
        && SavedTvStates.Any(state => state.Id.Equals(
            SelectedSavedStateId,
            StringComparison.OrdinalIgnoreCase))
        && !Snapshot.MacroRunning
        && !Navigation.IsRunning;

    protected override async Task OnInitializedAsync()
    {
        Refresh();
        Controller.Changed += HandleControllerChanged;
        await Controller.InitializeAsync();
        Refresh();
        ReconcileControls();
        TargetCalibrationName = $"{Navigation.DefinitionName ?? Navigation.Model ?? "TV"} calibration";
    }

    private async Task ChangeControlAsync(PictureControlEdit control, string? rawValue)
    {
        var value = NormalizeControlValue(control, rawValue);
        if (value is null)
        {
            return;
        }

        if (WorkspaceMode == MenuWorkspaceMode.CurrentState)
        {
            CurrentStateDraft[ControlDraftKey(control.Node.Id)] = value;
            EnsureSelectedMenuArea();
            LocalError = null;
            LocalStatus = $"Recorded {control.Node.Label} at {value} in the local draft. No TV commands were sent.";
            return;
        }

        control.DesiredValue = value;
        ClearPendingValuesThatBecameUnavailable();
        EnsureSelectedMenuArea();
        LocalError = null;
        LocalStatus = UpdateMode == PictureUpdateMode.Staged
            ? $"{control.Node.Label} staged at {value}."
            : null;
        if (UpdateMode == PictureUpdateMode.Immediate && control.Pending)
        {
            await ApplyAsync([control]);
        }
    }

    private Task ApplyPendingAsync() => ApplyChangesAsync(
        Controls.Where(control =>
                control.Pending
                && !IsIndexedControl(control.Node.Id)
                && !IsControlDisabled(control)
                && !IsControlHidden(control))
            .ToArray(),
        GetPendingIndexedChanges());

    private async Task ApplyAsync(IReadOnlyList<PictureControlEdit> controls)
        => await ApplyChangesAsync(controls, []).ConfigureAwait(false);

    private async Task ChangeIndexedCellAsync(
        IndexedControlGroupEdit group,
        IndexedCellEdit cell,
        string? rawValue)
    {
        if (!decimal.TryParse(
                rawValue,
                NumberStyles.Number,
                CultureInfo.InvariantCulture,
                out var numericValue))
        {
            LocalError = $"Enter a whole-number value for {group.Label} / {cell.SelectorValue} / {cell.Slider.Label}.";
            return;
        }

        var value = FormatValue(Math.Clamp(
            decimal.Truncate(numericValue),
            cell.Minimum,
            cell.Maximum));
        if (WorkspaceMode == MenuWorkspaceMode.CurrentState)
        {
            CurrentStateDraft[IndexedDraftKey(group, cell)] = value;
            LocalError = null;
            LocalStatus = $"Recorded {group.Label} · {cell.SelectorValue} · {cell.Slider.Label} at {value} in the local draft. No TV commands were sent.";
            return;
        }

        cell.DesiredValue = value;
        LocalError = null;
        LocalStatus = UpdateMode == PictureUpdateMode.Staged
            ? $"{group.Label} · {cell.SelectorValue} · {cell.Slider.Label} staged at {cell.DesiredValue}."
            : null;
        if (UpdateMode == PictureUpdateMode.Immediate && cell.Pending)
        {
            await ApplyChangesAsync([], [new IndexedCellChange(group, cell)]);
        }
    }

    private async Task ApplyChangesAsync(
        IReadOnlyList<PictureControlEdit> controls,
        IReadOnlyList<IndexedCellChange> indexedChanges)
    {
        if (controls.Count == 0 && indexedChanges.Count == 0)
        {
            return;
        }

        IsBusy = true;
        var updateSource = BeginActiveUpdate("Applying menu values");
        LocalError = null;
        LocalStatus = null;
        try
        {
            await ApplyChangesCoreAsync(controls, indexedChanges, updateSource.Token);
        }
        catch (OperationCanceledException) when (updateSource.IsCancellationRequested)
        {
            LocalError = "Update stopped. No further keys were sent after the stop took effect. Samsung does not report the selected row or setting values, so treat the current menu position and any partly adjusted indexed values as uncertain; enter the TV's current settings before resuming.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            EndActiveUpdate(updateSource);
            IsBusy = false;
        }
    }

    private async Task ApplyChangesCoreAsync(
        IReadOnlyList<PictureControlEdit> controls,
        IReadOnlyList<IndexedCellChange> indexedChanges,
        CancellationToken cancellationToken)
    {
        if (controls.Count > 0)
        {
            var knownValues = CreateKnownControlValues();
            var completed = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            try
            {
                await Controller.ApplyMenuControlValuesAsync(
                    controls.Select(control => new MenuControlValueUpdate(
                            control.Node.Id,
                            control.AppliedValue,
                            control.DesiredValue))
                        .ToArray(),
                    knownValues,
                    returnToNormalVideo: indexedChanges.Count == 0
                        && ExitBehavior == PictureExitBehavior.ReturnToVideo,
                    cancellationToken: cancellationToken,
                    valueApplied: update => completed[update.NodeId] = update.ToValue);
            }
            finally
            {
                foreach (var control in controls.Where(control => completed.ContainsKey(control.Node.Id)))
                {
                    control.AppliedValue = completed[control.Node.Id];
                }
            }
        }

        if (indexedChanges.Count > 0)
        {
            var completed = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            try
            {
                await Controller.ApplyIndexedMenuControlValuesAsync(
                    indexedChanges.Select(change => new MenuIndexedControlValueUpdate(
                            change.Group.Selector.Id,
                            change.Cell.SelectorValue,
                            change.Cell.Slider.Id,
                            change.Cell.AppliedValue,
                            change.Cell.DesiredValue))
                        .ToArray(),
                    CreateKnownControlValues(),
                    ExitBehavior == PictureExitBehavior.ReturnToVideo,
                    cancellationToken: cancellationToken,
                    valueApplied: update => completed[IndexedUpdateKey(update)] = update.ToValue);
            }
            finally
            {
                var appliedChanges = indexedChanges.Where(change => completed.TryGetValue(
                        IndexedUpdateKey(change),
                        out _))
                    .ToArray();
                foreach (var change in appliedChanges)
                {
                    change.Cell.AppliedValue = completed[IndexedUpdateKey(change)];
                }

                foreach (var group in appliedChanges.Select(change => change.Group).Distinct())
                {
                    SynchronizeIndexedGroupControlPredictions(group, appliedChanges);
                }
            }
        }

        var total = controls.Count + indexedChanges.Count;
        await Controller.SaveMenuControlProfileAsync(
            CreateControlProfileValues(),
            cancellationToken);
        LocalStatus = $"Applied {total} menu value{(total == 1 ? string.Empty : "s")} using the fully verified display profile.";
    }

    private CancellationTokenSource BeginActiveUpdate(string label)
    {
        if (ActiveUpdateSource is not null)
        {
            throw new InvalidOperationException("Another TV update is already running.");
        }

        ActiveUpdateLabel = label;
        ActiveUpdateSource = new CancellationTokenSource();
        return ActiveUpdateSource;
    }

    private void CancelActiveUpdate()
    {
        var source = ActiveUpdateSource;
        if (source is null || source.IsCancellationRequested)
        {
            return;
        }

        source.Cancel();
        Controller.CancelNavigation();
        LocalError = null;
        LocalStatus = "Stop requested. The controller will not send another key after the current in-flight send or wait finishes.";
    }

    private void EndActiveUpdate(CancellationTokenSource source)
    {
        if (ReferenceEquals(ActiveUpdateSource, source))
        {
            ActiveUpdateSource = null;
        }

        source.Dispose();
    }

    private void BeginFactoryReset(FactoryResetAction action)
    {
        PendingFactoryResetAction = action;
        ConfirmFactoryReset = true;
        LocalError = null;
        LocalStatus = null;
    }

    private void CancelFactoryReset() => ConfirmFactoryReset = false;

    private void SelectFactoryResetNode()
    {
        var node = SelectedFactoryResetNode;
        SelectedFactoryResetChoice = node?.SelectionOptions.FirstOrDefault(option => option.Equals(
                "Reset",
                StringComparison.OrdinalIgnoreCase))
            ?? node?.SelectionOptions.FirstOrDefault(option => !option.Equals(
                "Cancel",
                StringComparison.OrdinalIgnoreCase))
            ?? node?.SelectionOptions.FirstOrDefault()
            ?? string.Empty;
        ConfirmFactoryReset = false;
    }

    private Task ExecuteConfirmedFactoryResetAsync() =>
        PendingFactoryResetAction == FactoryResetAction.ResetToDefaults
            ? ResetToDefaultsAsync()
            : ResetAndApplyAllAsync();

    private async Task ResetToDefaultsAsync()
    {
        var resetNode = SelectedFactoryResetNode;
        if (resetNode is null || string.IsNullOrWhiteSpace(SelectedFactoryResetChoice))
        {
            LocalError = "Choose a verified factory-reset confirmation route.";
            return;
        }

        IsBusy = true;
        var updateSource = BeginActiveUpdate("Factory reset to declared defaults");
        ConfirmFactoryReset = false;
        LocalError = null;
        LocalStatus = null;
        try
        {
            await Controller.ResetMenuControlsToFactoryDefaultsAsync(
                resetNode.Id,
                SelectedFactoryResetChoice,
                updateSource.Token);
            ResetAppliedValuesToDeclaredDefaults();
            ResetDesiredValuesToDeclaredDefaults();
            ResetCurrentStateDraft();
            await Controller.SaveMenuControlProfileAsync(CreateControlProfileValues());
            Profile = Controller.GetMenuControlProfileSnapshot();
            LocalStatus = "Factory reset completed. Current values and saved targets now match the declared menu defaults; no calibration values were reapplied.";
        }
        catch (OperationCanceledException) when (updateSource.IsCancellationRequested)
        {
            LocalError = "Factory reset stopped. No cleanup keys were added after cancellation. The reset may have completed, so inspect the TV and record its current settings before continuing.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            EndActiveUpdate(updateSource);
            IsBusy = false;
        }
    }

    private async Task ResetAndApplyAllAsync()
    {
        var resetNode = SelectedFactoryResetNode;
        if (resetNode is null || string.IsNullOrWhiteSpace(SelectedFactoryResetChoice))
        {
            LocalError = "Choose a verified factory-reset confirmation route.";
            return;
        }

        IsBusy = true;
        var updateSource = BeginActiveUpdate("Factory reset and target application");
        ConfirmFactoryReset = false;
        LocalError = null;
        LocalStatus = null;
        try
        {
            await Controller.SaveMenuControlProfileAsync(
                CreateControlProfileValues(),
                updateSource.Token);
            await Controller.ResetMenuControlsToFactoryDefaultsAsync(
                resetNode.Id,
                SelectedFactoryResetChoice,
                updateSource.Token);
            ResetAppliedValuesToDeclaredDefaults();
            var controls = Controls.Where(control =>
                    control.Pending
                    && !IsIndexedControl(control.Node.Id)
                    && !IsControlDisabled(control)
                    && !IsControlHidden(control))
                .ToArray();
            var indexedChanges = GetPendingIndexedChanges();
            if (controls.Length > 0 || indexedChanges.Count > 0)
            {
                await ApplyChangesCoreAsync(controls, indexedChanges, updateSource.Token);
                LocalStatus = $"Factory reset completed. {LocalStatus}";
            }
            else
            {
                LocalStatus = "Factory reset completed. Every desired value already matches its declared factory default.";
            }
        }
        catch (OperationCanceledException) when (updateSource.IsCancellationRequested)
        {
            LocalError = "Factory reset/apply stopped. No cleanup or return-to-video keys were added after cancellation. The reset or some target values may already have completed, so record the TV's current settings before resuming.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            EndActiveUpdate(updateSource);
            IsBusy = false;
        }
    }

