@page "/controls"
@page "/picture-controls"
@implements IDisposable
@inject SamsungControllerService Controller

<PageTitle>Menu Controls · SamsungController</PageTitle>

<section class="page-heading compact-heading picture-controls-heading">
    <div>
        <span class="eyebrow">MENU CONTROLS</span>
        <h1>Adjust verified menu settings.</h1>
        <p>Compact controls cover every verified menu area and are grouped like the TV, with conditional settings enabled by their switches and selections.</p>
    </div>
    <div class="page-heading-actions">
        <HelpBubble Title="Menu control behavior" ButtonText="Page help">
            <ul>
                <li>Choose a top-level menu tab, then search or adjust controls grouped by their immediate TV menu section.</li>
                <li>Switches and selections use predicted values and dynamically apply declared <code>disabledWhen</code> and <code>hiddenWhen</code> rules.</li>
                <li>Turning on 20 Point enables its Interval and RGB controls. Choosing Custom Color Space enables its Color and RGB controls.</li>
                <li><strong>Immediate</strong> sends one changed control at a time. <strong>Apply button</strong> can stage a controller and its newly enabled settings together.</li>
                <li>Confirm three different sliders visually to verify the shared slider behavior for this TV. Later slider changes no longer require individual confirmation.</li>
                <li>Confirm each selection dropdown once. Its option list and ordering are stored separately from other selections.</li>
            </ul>
            <p class="help-callout">A conditionally enabled or visible control uses its verified containing-section route and the recalculated menu order after its controller has changed.</p>
        </HelpBubble>
        <a class="secondary-action menu-authoring-link" href="menu">Verified menus <span>→</span></a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(LocalError))
{
    <div class="notice danger" role="alert"><strong>Menu controls need attention</strong><span>@LocalError</span></div>
}
else if (!string.IsNullOrWhiteSpace(LocalStatus))
{
    <div class="notice" role="status"><strong>Menu controls</strong><span>@LocalStatus</span></div>
}

<section class="panel picture-control-toolbar">
    <div class="panel-label"><span>UPDATE BEHAVIOR</span><span>@PendingCount PENDING</span></div>
    <div class="picture-control-options">
        <label>
            <span>WHEN VALUES CHANGE</span>
            <select @bind="UpdateMode" disabled="@IsBusy">
                <option value="@PictureUpdateMode.Immediate">Update TV immediately</option>
                <option value="@PictureUpdateMode.Staged">Wait for Apply</option>
            </select>
        </label>
        <label>
            <span>AFTER UPDATE</span>
            <select @bind="ExitBehavior" disabled="@IsBusy">
                <option value="@PictureExitBehavior.Stay">Stay on last adjusted item</option>
                <option value="@PictureExitBehavior.ReturnToVideo">Exit to normal video</option>
            </select>
        </label>
        <div class="picture-control-summary">
            <span>CURRENT MENU</span>
            <strong>@(Snapshot.MenuLabel ?? "Unknown")</strong>
            <small>@Snapshot.MenuConfidence confidence</small>
        </div>
        <button class="primary-action picture-apply-action" @onclick="ApplyPendingAsync" disabled="@(!CanApplyPending)">
            @(IsBusy ? "Applying…" : $"Apply {PendingCount} change{(PendingCount == 1 ? string.Empty : "s")}") <span>▶</span>
        </button>
    </div>
    @if (Controls.Count > 0)
    {
        <nav class="menu-control-tabs" aria-label="Top-level menu areas" role="tablist">
            @foreach (var area in GetMenuAreas())
            {
                var isSelected = area.Id.Equals(SelectedAreaId, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="menu-control-tab @(isSelected ? "active" : string.Empty)"
                        role="tab"
                        aria-selected="@isSelected.ToString().ToLowerInvariant()"
                        @onclick="() => SelectMenuArea(area.Id)"
                        disabled="@IsBusy">
                    <span>@area.Label</span>
                    <b>@area.ControlCount</b>
                </button>
            }
        </nav>
    }
    <div class="menu-control-filters">
        <label>
            <span>SEARCH CONTROLS</span>
            <input type="search" @bind="SearchText" @bind:event="oninput" placeholder="Name or menu path" disabled="@IsBusy" />
        </label>
        <div class="slider-verification-summary @(Verification.SlidersVerified ? "verified" : "unverified")">
            <span>SHARED SLIDER VERIFICATION</span>
            <strong>@(Verification.SlidersVerified ? "Verified for this TV" : $"{Verification.ConfirmedSliderCount}/{Verification.RequiredSliderCount} different sliders")</strong>
            <small>@(Verification.SlidersVerified ? "Future slider updates do not require confirmation." : "Confirm successful slider values on the TV.")</small>
        </div>
        @if (Verification.RequiredSelectionCount > 0)
        {
            <div class="selection-verification-summary @(Verification.SelectionsVerified ? "verified" : "unverified")">
                <span>SELECTION VERIFICATION</span>
                <strong>@(Verification.SelectionsVerified ? "All selections verified" : $"{Verification.ConfirmedSelectionCount}/{Verification.RequiredSelectionCount} selection dropdowns")</strong>
                <small>@(Verification.SelectionsVerified ? "Future updates use the verified option order." : "Each dropdown needs one visual confirmation.")</small>
            </div>
        }
        @if (Verification.ConfirmedSliderCount > 0 || Verification.ConfirmedSelectionCount > 0)
        {
            <div class="menu-control-verification-actions">
                @if (Verification.ConfirmedSliderCount > 0)
                {
                    <button class="secondary-action" @onclick="ResetSliderVerificationAsync" disabled="@IsBusy">Reset sliders</button>
                }
                @if (Verification.ConfirmedSelectionCount > 0)
                {
                    <button class="secondary-action" @onclick="ResetSelectionVerificationAsync" disabled="@IsBusy">Reset selections</button>
                }
            </div>
        }
    </div>
    <p class="field-note">Values are predictions based on YAML defaults and changes sent during this page session. Controls changed elsewhere can make those predictions inaccurate.</p>
</section>

@if (VisibleControlCount == 0)
{
    <section class="panel panel-empty picture-controls-empty">
        <strong>@(Controls.Count == 0 ? "No verified menu controls are available" : "No controls match this filter")</strong>
        <span>@(Controls.Count == 0 ? "Define values and bounds in YAML, then complete the generated route verification." : "Choose another menu tab or clear the search text.")</span>
        <a href="menu/build">Open Build &amp; Verify →</a>
    </section>
}
else
{
    <div class="picture-control-sections">
        @foreach (var section in GetSections())
        {
            <section class="panel picture-control-section">
                <header class="picture-section-heading">
                    <div>
                        <span>MENU SECTION</span>
                        <h2>@section.Label</h2>
                        <p>@section.Path</p>
                    </div>
                    <small>@section.Controls.Count control@(section.Controls.Count == 1 ? string.Empty : "s")</small>
                </header>
                <div class="picture-control-grid">
                    @foreach (var control in section.Controls)
                    {
                        var disabled = IsControlDisabled(control);
                        <article class="picture-control-card @GetControlCssClass(control, disabled)">
                            <header>
                                <div>
                                    <strong>@control.Node.Label</strong>
                                    <small>@GetControlTypeLabel(control.Node.ControlType)</small>
                                </div>
                                <b>@GetControlStateLabel(control, disabled)</b>
                            </header>

                            @if (control.Node.ControlType == MenuControlType.Slider)
                            {
                                <div class="picture-compact-value">
                                    <strong>@control.DesiredValue</strong>
                                    <span>@FormatValue(control.Minimum) – @FormatValue(control.Maximum)</span>
                                </div>
                                <div class="picture-compact-slider">
                                    <button type="button"
                                            aria-label="Decrease @control.Node.Label"
                                            @onclick="() => NudgeAsync(control, -1)"
                                            disabled="@(IsBusy || disabled || control.DesiredNumber <= control.Minimum)">−</button>
                                    <input type="range"
                                           min="@FormatValue(control.Minimum)"
                                           max="@FormatValue(control.Maximum)"
                                           step="1"
                                           value="@control.DesiredValue"
                                           aria-label="@control.Node.Label"
                                           @onchange="args => ChangeControlAsync(control, args.Value?.ToString())"
                                           disabled="@(IsBusy || disabled)" />
                                    <button type="button"
                                            aria-label="Increase @control.Node.Label"
                                            @onclick="() => NudgeAsync(control, 1)"
                                            disabled="@(IsBusy || disabled || control.DesiredNumber >= control.Maximum)">+</button>
                                    <input class="picture-compact-number"
                                           type="number"
                                           min="@FormatValue(control.Minimum)"
                                           max="@FormatValue(control.Maximum)"
                                           step="1"
                                           value="@control.DesiredValue"
                                           aria-label="Numeric value for @control.Node.Label"
                                           @onchange="args => ChangeControlAsync(control, args.Value?.ToString())"
                                           disabled="@(IsBusy || disabled)" />
                                </div>
                            }
                            else if (control.Node.ControlType == MenuControlType.Switch)
                            {
                                <label class="picture-switch-control">
                                    <span class="picture-switch-copy">
                                        <strong>@(IsOn(control.DesiredValue) ? "On" : "Off")</strong>
                                        <small>@(disabled ? GetDisabledReason(control) : "Select to toggle")</small>
                                    </span>
                                    <input type="checkbox"
                                           checked="@IsOn(control.DesiredValue)"
                                           @onchange="args => ChangeSwitchAsync(control, args.Value is true)"
                                           disabled="@(IsBusy || disabled)" />
                                    <span class="picture-switch-track" aria-hidden="true"><i></i></span>
                                </label>
                            }
                            else if (control.Node.ControlType == MenuControlType.Selection)
                            {
                                <label class="picture-selection-control">
                                    <span>SELECTED VALUE</span>
                                    <select value="@control.DesiredValue"
                                            @onchange="args => ChangeControlAsync(control, args.Value?.ToString())"
                                            disabled="@(IsBusy || disabled)">
                                        @foreach (var option in control.Node.SelectionOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </label>
                            }

                            <footer>
                                @if (disabled)
                                {
                                    <span class="picture-disabled-reason">@GetDisabledReason(control)</span>
                                }
                                else
                                {
                                    <span>TV prediction: <b>@control.AppliedValue</b></span>
                                }
                                @if (control.AwaitingConfirmation && !disabled)
                                {
                                    <button class="secondary-action" @onclick="() => ConfirmControlAsync(control)" disabled="@IsBusy">TV shows @control.AppliedValue ✓</button>
                                }
                            </footer>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    private ControllerSnapshot Snapshot { get; set; } = null!;
    private MenuNavigationSnapshot Navigation { get; set; } = null!;
    private MenuControlVerificationSnapshot Verification { get; set; } = null!;
    private List<PictureControlEdit> Controls { get; } = [];
    private PictureUpdateMode UpdateMode { get; set; } = PictureUpdateMode.Staged;
    private PictureExitBehavior ExitBehavior { get; set; } = PictureExitBehavior.Stay;
    private string SelectedAreaId { get; set; } = string.Empty;
    private string SearchText { get; set; } = string.Empty;
    private string? LocalError { get; set; }
    private string? LocalStatus { get; set; }
    private bool IsBusy { get; set; }

    private int PendingCount => Controls.Count(control => control.Pending && !IsControlDisabled(control));
    private int VisibleControlCount => GetFilteredControls().Count;
    private bool CanApplyPending => PendingCount > 0
        && !IsBusy
        && Snapshot.ConnectionState == SamsungConnectionState.Connected
        && !Snapshot.MacroRunning
        && !Navigation.IsRunning;

    protected override async Task OnInitializedAsync()
    {
        Refresh();
        Controller.Changed += HandleControllerChanged;
        await Controller.InitializeAsync();
        Refresh();
        ReconcileControls();
    }

    private async Task ChangeControlAsync(PictureControlEdit control, string? rawValue)
    {
        var value = NormalizeControlValue(control, rawValue);
        if (value is null)
        {
            return;
        }

        control.DesiredValue = value;
        control.Confirmed = false;
        control.AwaitingConfirmation = false;
        ClearPendingValuesThatBecameUnavailable();
        EnsureSelectedMenuArea();
        LocalError = null;
        LocalStatus = UpdateMode == PictureUpdateMode.Staged
            ? $"{control.Node.Label} staged at {value}."
            : null;
        if (UpdateMode == PictureUpdateMode.Immediate && control.Pending)
        {
            await ApplyAsync([control]);
        }
    }

    private Task ChangeSwitchAsync(PictureControlEdit control, bool enabled) =>
        ChangeControlAsync(control, enabled ? "on" : "off");

    private Task NudgeAsync(PictureControlEdit control, int delta) =>
        ChangeControlAsync(
            control,
            FormatValue(Math.Clamp(
                control.DesiredNumber + delta,
                control.Minimum,
                control.Maximum)));

    private Task ApplyPendingAsync() => ApplyAsync(
        Controls.Where(control => control.Pending && !IsControlDisabled(control)).ToArray());

    private async Task ApplyAsync(IReadOnlyList<PictureControlEdit> controls)
    {
        if (controls.Count == 0)
        {
            return;
        }

        IsBusy = true;
        LocalError = null;
        LocalStatus = null;
        try
        {
            var knownValues = Controls.ToDictionary(
                control => control.Node.Id,
                control => control.AppliedValue,
                StringComparer.OrdinalIgnoreCase);
            await Controller.ApplyMenuControlValuesAsync(
                controls.Select(control => new MenuControlValueUpdate(
                        control.Node.Id,
                        control.AppliedValue,
                        control.DesiredValue))
                    .ToArray(),
                knownValues,
                ExitBehavior == PictureExitBehavior.ReturnToVideo);
            foreach (var control in controls)
            {
                control.AppliedValue = control.DesiredValue;
                var behaviorIsVerified = control.Node.ControlType == MenuControlType.Slider
                        && Verification.SlidersVerified
                    || control.Node.ControlType == MenuControlType.Selection
                        && IsSelectionVerified(control);
                control.AwaitingConfirmation = !behaviorIsVerified;
                control.Confirmed = behaviorIsVerified;
            }

            LocalStatus = controls.All(control => !control.AwaitingConfirmation)
                ? $"Applied {controls.Count} menu control{(controls.Count == 1 ? string.Empty : "s")}. The changed control behavior is already verified."
                : $"Applied {controls.Count} menu control{(controls.Count == 1 ? string.Empty : "s")}. Confirm the displayed values on the TV.";
        }
        catch (OperationCanceledException)
        {
            LocalError = "Menu-control update was cancelled.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ConfirmControlAsync(PictureControlEdit control)
    {
        IsBusy = true;
        LocalError = null;
        try
        {
            if (control.Node.ControlType == MenuControlType.Slider)
            {
                Verification = await Controller.ConfirmMenuSliderBehaviorAsync(control.Node.Id);
            }
            else if (control.Node.ControlType == MenuControlType.Selection)
            {
                Verification = await Controller.ConfirmMenuSelectionBehaviorAsync(control.Node.Id);
            }

            control.AwaitingConfirmation = false;
            control.Confirmed = true;
            if (Verification.SlidersVerified && control.Node.ControlType == MenuControlType.Slider)
            {
                foreach (var slider in Controls.Where(candidate =>
                             candidate.Node.ControlType == MenuControlType.Slider))
                {
                    slider.AwaitingConfirmation = false;
                    slider.Confirmed = true;
                }

                LocalStatus = $"{control.Node.Label} confirmed at {control.AppliedValue}. Shared slider behavior is now verified for this TV.";
            }
            else if (control.Node.ControlType == MenuControlType.Slider)
            {
                LocalStatus = $"{control.Node.Label} confirmed at {control.AppliedValue} · {Verification.ConfirmedSliderCount}/{Verification.RequiredSliderCount} different sliders verified.";
            }
            else if (control.Node.ControlType == MenuControlType.Selection)
            {
                LocalStatus = $"{control.Node.Label} confirmed at {control.AppliedValue} · {Verification.ConfirmedSelectionCount}/{Verification.RequiredSelectionCount} selection dropdowns verified.";
            }
            else
            {
                LocalStatus = $"{control.Node.Label} visually confirmed at {control.AppliedValue}.";
            }
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ResetSliderVerificationAsync()
    {
        IsBusy = true;
        LocalError = null;
        try
        {
            await Controller.ResetMenuSliderBehaviorVerificationAsync();
            Verification = Controller.GetMenuControlVerificationSnapshot();
            foreach (var slider in Controls.Where(control =>
                         control.Node.ControlType == MenuControlType.Slider))
            {
                slider.AwaitingConfirmation = false;
                slider.Confirmed = false;
            }

            LocalStatus = "Shared slider verification reset. Confirm three different sliders to verify it again.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ResetSelectionVerificationAsync()
    {
        IsBusy = true;
        LocalError = null;
        try
        {
            await Controller.ResetMenuSelectionBehaviorVerificationAsync();
            Verification = Controller.GetMenuControlVerificationSnapshot();
            foreach (var selection in Controls.Where(control =>
                         control.Node.ControlType == MenuControlType.Selection))
            {
                selection.AwaitingConfirmation = false;
                selection.Confirmed = false;
            }

            LocalStatus = "Selection verification reset. Confirm each dropdown after changing it on the TV.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private string? NormalizeControlValue(PictureControlEdit control, string? rawValue)
    {
        if (string.IsNullOrWhiteSpace(rawValue))
        {
            LocalError = $"Choose a value for {control.Node.Label}.";
            return null;
        }

        if (control.Node.ControlType == MenuControlType.Slider)
        {
            if (!decimal.TryParse(
                    rawValue,
                    NumberStyles.Number,
                    CultureInfo.InvariantCulture,
                    out var numericValue))
            {
                LocalError = $"Enter a whole-number value for {control.Node.Label}.";
                return null;
            }

            return FormatValue(Math.Clamp(
                decimal.Truncate(numericValue),
                control.Minimum,
                control.Maximum));
        }

        if (control.Node.ControlType == MenuControlType.Switch)
        {
            return rawValue.Equals("on", StringComparison.OrdinalIgnoreCase) ? "on" : "off";
        }

        var option = control.Node.SelectionOptions.FirstOrDefault(candidate =>
            candidate.Equals(rawValue, StringComparison.OrdinalIgnoreCase));
        if (option is null)
        {
            LocalError = $"{rawValue} is not available for {control.Node.Label}.";
        }

        return option;
    }

    private void ClearPendingValuesThatBecameUnavailable()
    {
        foreach (var control in Controls.Where(control =>
                     IsControlDisabled(control) || IsControlHidden(control)))
        {
            control.DesiredValue = control.AppliedValue;
            control.AwaitingConfirmation = false;
            control.Confirmed = false;
        }
    }

    private bool IsControlDisabled(PictureControlEdit control) =>
        control.Node.DisabledWhen.Any(condition =>
        {
            var value = GetPredictedValue(condition.SettingNodeId);
            return value?.Equals(condition.EqualsValue, StringComparison.OrdinalIgnoreCase) == true;
        });

    private bool IsControlHidden(PictureControlEdit control)
    {
        var current = control.Node;
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        while (visited.Add(current.Id))
        {
            if (current.HiddenWhen.Any(condition => GetPredictedValue(condition.SettingNodeId)
                    ?.Equals(condition.EqualsValue, StringComparison.OrdinalIgnoreCase) == true))
            {
                return true;
            }

            if (string.IsNullOrWhiteSpace(current.ParentId))
            {
                break;
            }

            var parent = Navigation.Nodes.FirstOrDefault(candidate => candidate.Id.Equals(
                current.ParentId,
                StringComparison.OrdinalIgnoreCase));
            if (parent is null)
            {
                break;
            }

            current = parent;
        }

        return false;
    }

    private string? GetPredictedValue(string nodeId) =>
        Controls.FirstOrDefault(candidate => candidate.Node.Id.Equals(
            nodeId,
            StringComparison.OrdinalIgnoreCase))?.DesiredValue
        ?? Navigation.ControlValues.GetValueOrDefault(nodeId)
        ?? Navigation.Nodes.FirstOrDefault(candidate => candidate.Id.Equals(
            nodeId,
            StringComparison.OrdinalIgnoreCase))?.DefaultValue;

    private string GetDisabledReason(PictureControlEdit control)
    {
        var matches = control.Node.DisabledWhen.Where(condition =>
            GetPredictedValue(condition.SettingNodeId)?.Equals(
                condition.EqualsValue,
                StringComparison.OrdinalIgnoreCase) == true).Select(condition =>
        {
            var setting = Navigation.Nodes.FirstOrDefault(candidate => candidate.Id.Equals(
                condition.SettingNodeId,
                StringComparison.OrdinalIgnoreCase));
            return $"{setting?.Label ?? condition.SettingNodeId} = {GetPredictedValue(condition.SettingNodeId)}";
        }).ToArray();
        return matches.Length == 0 ? "Unavailable in the predicted state" : $"Disabled while {string.Join(" or ", matches)}";
    }

    private IReadOnlyList<PictureControlSection> GetSections()
    {
        var nodeOrder = Navigation.Nodes.Select((node, index) => (node.Id, index))
            .ToDictionary(item => item.Id, item => item.index, StringComparer.OrdinalIgnoreCase);
        return GetFilteredControls()
            .GroupBy(control => control.Node.ParentId ?? "settings", StringComparer.OrdinalIgnoreCase)
            .Select(group =>
            {
                var sectionNode = Navigation.Nodes.FirstOrDefault(node => node.Id.Equals(
                    group.Key,
                    StringComparison.OrdinalIgnoreCase));
                return new PictureControlSection(
                    group.Key,
                    sectionNode?.Label ?? "Settings",
                    sectionNode?.Path ?? "Settings",
                    group.OrderBy(control => nodeOrder.GetValueOrDefault(control.Node.Id, int.MaxValue)).ToArray(),
                    nodeOrder.GetValueOrDefault(group.Key, int.MaxValue));
            })
            .OrderBy(section => section.Order)
            .ToArray();
    }

    private IReadOnlyList<PictureControlEdit> GetFilteredControls() => Controls.Where(control =>
            !IsControlHidden(control)
            && !string.IsNullOrWhiteSpace(SelectedAreaId)
            && ResolveMenuArea(control.Node).Id.Equals(
                SelectedAreaId,
                StringComparison.OrdinalIgnoreCase)
            && (string.IsNullOrWhiteSpace(SearchText)
                || control.Node.Label.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase)
                || control.Node.Path.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase)))
        .ToArray();

    private IReadOnlyList<MenuControlArea> GetMenuAreas()
    {
        var nodeOrder = Navigation.Nodes.Select((node, index) => (node.Id, index))
            .ToDictionary(item => item.Id, item => item.index, StringComparer.OrdinalIgnoreCase);
        return Controls.Where(control => !IsControlHidden(control))
            .Select(control => ResolveMenuArea(control.Node))
            .GroupBy(area => area.Id, StringComparer.OrdinalIgnoreCase)
            .Select(group => new MenuControlArea(group.Key, group.First().Label, group.Count()))
            .OrderBy(area => nodeOrder.GetValueOrDefault(area.Id, int.MaxValue))
            .ThenBy(area => area.Label, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private MenuControlArea ResolveMenuArea(MenuNodeSummary node)
    {
        var current = node;
        while (!string.IsNullOrWhiteSpace(current.ParentId))
        {
            var parent = Navigation.Nodes.FirstOrDefault(candidate => candidate.Id.Equals(
                current.ParentId,
                StringComparison.OrdinalIgnoreCase));
            if (parent is null)
            {
                break;
            }

            if (parent.Id.Equals("settings", StringComparison.OrdinalIgnoreCase)
                || parent.Label.Equals("Settings", StringComparison.OrdinalIgnoreCase))
            {
                return current.Id.Equals(node.Id, StringComparison.OrdinalIgnoreCase)
                    ? new MenuControlArea(parent.Id, parent.Label, 0)
                    : new MenuControlArea(current.Id, current.Label, 0);
            }

            if (parent.Id.Equals("normal-video", StringComparison.OrdinalIgnoreCase))
            {
                return new MenuControlArea(current.Id, current.Label, 0);
            }

            current = parent;
        }

        return new MenuControlArea(current.Id, current.Label, 0);
    }

    private void SelectMenuArea(string areaId)
    {
        SelectedAreaId = areaId;
        LocalError = null;
    }

    private void EnsureSelectedMenuArea()
    {
        var areas = GetMenuAreas();
        if (areas.Count == 0)
        {
            SelectedAreaId = string.Empty;
            return;
        }

        if (areas.Any(area => area.Id.Equals(SelectedAreaId, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        SelectedAreaId = areas.FirstOrDefault(area =>
                area.Label.Equals("Picture", StringComparison.OrdinalIgnoreCase))?.Id
            ?? areas[0].Id;
    }

    private void HandleControllerChanged()
    {
        _ = InvokeAsync(() =>
        {
            Refresh();
            ReconcileControls();
            StateHasChanged();
        });
    }

    private void Refresh()
    {
        Snapshot = Controller.GetSnapshot();
        Navigation = Controller.GetMenuNavigationSnapshot();
        Verification = Controller.GetMenuControlVerificationSnapshot();
    }

    private void ReconcileControls()
    {
        var existing = Controls.ToDictionary(control => control.Node.Id, StringComparer.OrdinalIgnoreCase);
        var eligible = Navigation.Nodes.Where(node =>
                IsSupportedControl(node)
                && HasUsableRoute(node))
            .ToArray();
        Controls.Clear();
        foreach (var node in eligible)
        {
            if (existing.TryGetValue(node.Id, out var edit))
            {
                edit.Node = node;
                Controls.Add(edit);
                continue;
            }

            var defaultValue = Navigation.ControlValues.GetValueOrDefault(node.Id)
                ?? NormalizeDefaultValue(node);
            if (defaultValue is not null)
            {
                Controls.Add(new PictureControlEdit(node, defaultValue));
            }
        }

        EnsureSelectedMenuArea();
        foreach (var selection in Controls.Where(control =>
                     control.Node.ControlType == MenuControlType.Selection))
        {
            if (IsSelectionVerified(selection))
            {
                selection.AwaitingConfirmation = false;
                selection.Confirmed = true;
            }
            else if (!selection.AwaitingConfirmation)
            {
                selection.Confirmed = false;
            }
        }
    }

    private bool HasUsableRoute(MenuNodeSummary node)
    {
        if (node.HasVerifiedRoute)
        {
            return true;
        }

        var current = node;
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        while (visited.Add(current.Id) && !string.IsNullOrWhiteSpace(current.ParentId))
        {
            var parent = Navigation.Nodes.FirstOrDefault(candidate => candidate.Id.Equals(
                current.ParentId,
                StringComparison.OrdinalIgnoreCase));
            if (parent is null)
            {
                break;
            }

            if ((current.DisabledWhen.Count > 0 || current.HiddenWhen.Count > 0)
                && parent.HasVerifiedRoute)
            {
                return true;
            }

            current = parent;
        }

        return false;
    }

    private static bool IsSupportedControl(MenuNodeSummary node) => node.ControlType switch
    {
        MenuControlType.Slider => node.MinimumValue is not null
            && node.MaximumValue is not null
            && !string.IsNullOrWhiteSpace(node.DefaultValue),
        MenuControlType.Switch => !string.IsNullOrWhiteSpace(node.DefaultValue),
        MenuControlType.Selection => !string.IsNullOrWhiteSpace(node.DefaultValue)
            && node.SelectionOptions.Count > 0,
        _ => false
    };

    private static string? NormalizeDefaultValue(MenuNodeSummary node)
    {
        if (node.ControlType == MenuControlType.Slider)
        {
            if (!decimal.TryParse(
                    node.DefaultValue,
                    NumberStyles.Number,
                    CultureInfo.InvariantCulture,
                    out var defaultValue))
            {
                return null;
            }

            return FormatValue(Math.Clamp(
                decimal.Truncate(defaultValue),
                node.MinimumValue!.Value,
                node.MaximumValue!.Value));
        }

        if (node.ControlType == MenuControlType.Switch)
        {
            return node.DefaultValue!.Equals("on", StringComparison.OrdinalIgnoreCase) ? "on" : "off";
        }

        return node.SelectionOptions.FirstOrDefault(option => option.Equals(
            node.DefaultValue,
            StringComparison.OrdinalIgnoreCase));
    }

    private static string GetControlTypeLabel(MenuControlType type) => type switch
    {
        MenuControlType.Slider => "SLIDER",
        MenuControlType.Switch => "SWITCH",
        MenuControlType.Selection => "SELECTION",
        _ => type.ToString().ToUpperInvariant()
    };

    private string GetControlStateLabel(PictureControlEdit control, bool disabled) => disabled
        ? "DISABLED"
        : control.Pending
            ? "PENDING"
            : control.AwaitingConfirmation
                ? "VERIFY"
                : control.Node.ControlType == MenuControlType.Slider && Verification.SlidersVerified
                    ? "SLIDER VERIFIED"
                    : control.Node.ControlType == MenuControlType.Selection && IsSelectionVerified(control)
                        ? "SELECTION VERIFIED"
                        : control.Confirmed
                            ? "CONFIRMED"
                            : control.Node.ControlType == MenuControlType.Selection
                                ? "NEEDS VERIFICATION"
                                : control.Node.HasVerifiedRoute
                                    ? "VERIFIED"
                                    : "CONDITIONAL";

    private string GetControlCssClass(PictureControlEdit control, bool disabled)
    {
        var confirmed = control.Confirmed
            || control.Node.ControlType == MenuControlType.Selection
            && IsSelectionVerified(control);
        return $"{(disabled ? "disabled" : string.Empty)} {(control.Pending ? "pending" : string.Empty)} {(control.AwaitingConfirmation ? "awaiting-confirmation" : confirmed ? "confirmed" : string.Empty)}";
    }

    private bool IsSelectionVerified(PictureControlEdit control) =>
        Verification.ConfirmedSelectionNodeIds.Contains(
            control.Node.Id,
            StringComparer.OrdinalIgnoreCase);

    private static bool IsOn(string value) => value.Equals("on", StringComparison.OrdinalIgnoreCase);

    private static string FormatValue(decimal value) =>
        value.ToString("G29", CultureInfo.InvariantCulture);

    public void Dispose() => Controller.Changed -= HandleControllerChanged;

    private enum PictureUpdateMode
    {
        Immediate,
        Staged
    }

    private enum PictureExitBehavior
    {
        Stay,
        ReturnToVideo
    }

    private sealed class PictureControlEdit(MenuNodeSummary node, string defaultValue)
    {
        public MenuNodeSummary Node { get; set; } = node;
        public string AppliedValue { get; set; } = defaultValue;
        public string DesiredValue { get; set; } = defaultValue;
        public bool AwaitingConfirmation { get; set; }
        public bool Confirmed { get; set; }
        public bool Pending => !DesiredValue.Equals(AppliedValue, StringComparison.OrdinalIgnoreCase);
        public decimal Minimum => Node.MinimumValue ?? 0;
        public decimal Maximum => Node.MaximumValue ?? 0;
        public decimal DesiredNumber => decimal.TryParse(
            DesiredValue,
            NumberStyles.Number,
            CultureInfo.InvariantCulture,
            out var value) ? value : 0;
    }

    private sealed record PictureControlSection(
        string Id,
        string Label,
        string Path,
        IReadOnlyList<PictureControlEdit> Controls,
        int Order);

    private sealed record MenuControlArea(string Id, string Label, int ControlCount);
}
