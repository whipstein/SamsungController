@page "/controls"
@page "/picture-controls"
@implements IDisposable
@inject SamsungControllerService Controller

<PageTitle>Menu Controls · SamsungController</PageTitle>

<section class="page-heading compact-heading picture-controls-heading">
    <div>
        <span class="eyebrow">MENU CONTROLS</span>
        <h1>Adjust verified menu settings.</h1>
        <p>Compact controls cover every verified menu area and are grouped like the TV, with conditional settings enabled by their switches and selections.</p>
    </div>
    <div class="page-heading-actions">
        <HelpBubble Title="Menu control behavior" ButtonText="Page help">
            <ul>
                <li>Choose a top-level menu tab, then search or adjust controls grouped by their immediate TV menu section.</li>
                <li>Switches, selections, and submenu selections use predicted values and dynamically apply declared <code>disabledWhen</code> and <code>hiddenWhen</code> rules.</li>
                <li>Turning on 20 Point enables its Interval and RGB controls. Choosing Custom Color Space enables its Color and RGB controls.</li>
                <li>Interval percentages and Custom Color choices appear as fixed grid rows, so every RGB value can be staged together without manually changing the selector.</li>
                <li><strong>Immediate</strong> sends one changed control at a time. <strong>Apply button</strong> can stage a controller and its newly enabled settings together.</li>
                <li><strong>Save profile</strong> stores desired values locally. <strong>Reset &amp; apply all</strong> runs a verified reset confirmation, restores known defaults, and reapplies that profile.</li>
                <li>Use <strong>Saved current TV states</strong> to record values already visible on the TV and later load them as the prediction baseline. Saving or loading a state sends no remote commands.</li>
                <li>Confirm three different sliders visually to verify the shared slider behavior for this TV. Later slider changes no longer require individual confirmation.</li>
                <li>Confirm each selection control once. A submenu selection also sends Return after choosing its value.</li>
            </ul>
            <p class="help-callout">A conditionally enabled or visible control uses its verified containing-section route and the recalculated menu order after its controller has changed.</p>
        </HelpBubble>
        <a class="secondary-action menu-authoring-link" href="menu">Verified menus <span>→</span></a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(LocalError))
{
    <div class="notice danger" role="alert"><strong>Menu controls need attention</strong><span>@LocalError</span></div>
}
else if (!string.IsNullOrWhiteSpace(LocalStatus))
{
    <div class="notice" role="status"><strong>Menu controls</strong><span>@LocalStatus</span></div>
}

<section class="panel picture-control-toolbar">
    <div class="panel-label"><span>UPDATE BEHAVIOR</span><span>@PendingCount PENDING</span></div>
    <div class="picture-control-options">
        <label>
            <span>WHEN VALUES CHANGE</span>
            <select @bind="UpdateMode" disabled="@IsBusy">
                <option value="@PictureUpdateMode.Immediate">Update TV immediately</option>
                <option value="@PictureUpdateMode.Staged">Wait for Apply</option>
            </select>
        </label>
        <label>
            <span>AFTER UPDATE</span>
            <select @bind="ExitBehavior" disabled="@IsBusy">
                <option value="@PictureExitBehavior.Stay">Stay on last adjusted item</option>
                <option value="@PictureExitBehavior.ReturnToVideo">Exit to normal video</option>
            </select>
        </label>
        <div class="picture-control-summary">
            <span>CURRENT MENU</span>
            <strong>@(Snapshot.MenuLabel ?? "Unknown")</strong>
            <small>@Snapshot.MenuConfidence confidence</small>
        </div>
        @if (FactoryResetCandidates.Count > 0)
        {
            <label>
                <span>FACTORY RESET ROUTE</span>
                <select @bind="SelectedFactoryResetNodeId" @bind:after="SelectFactoryResetNode" disabled="@IsBusy">
                    @foreach (var candidate in FactoryResetCandidates)
                    {
                        <option value="@candidate.Id">@candidate.Path</option>
                    }
                </select>
            </label>
            <button class="secondary-action danger-action" @onclick="BeginFactoryReset" disabled="@(!CanBeginFactoryReset)">Reset &amp; apply all</button>
        }
        <button class="secondary-action" @onclick="SaveControlProfileAsync" disabled="@(!CanSaveControlProfile)">Save profile</button>
        <button class="primary-action picture-apply-action" @onclick="ApplyPendingAsync" disabled="@(!CanApplyPending)">
            @(IsBusy ? "Applying…" : $"Apply {PendingCount} change{(PendingCount == 1 ? string.Empty : "s")}") <span>▶</span>
        </button>
    </div>
    @if (Controls.Count > 0)
    {
        <nav class="menu-control-tabs" aria-label="Top-level menu areas" role="tablist">
            @foreach (var area in GetMenuAreas())
            {
                var isSelected = area.Id.Equals(SelectedAreaId, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="menu-control-tab @(isSelected ? "active" : string.Empty)"
                        role="tab"
                        aria-selected="@isSelected.ToString().ToLowerInvariant()"
                        @onclick="() => SelectMenuArea(area.Id)"
                        disabled="@IsBusy">
                    <span>@area.Label</span>
                    <b>@area.ControlCount</b>
                </button>
            }
        </nav>
    }
    <div class="menu-control-filters">
        <label>
            <span>SEARCH CONTROLS</span>
            <input type="search" @bind="SearchText" @bind:event="oninput" placeholder="Name or menu path" disabled="@IsBusy" />
        </label>
        <div class="slider-verification-summary @(Verification.SlidersVerified ? "verified" : "unverified")">
            <span>SHARED SLIDER VERIFICATION</span>
            <strong>@(Verification.SlidersVerified ? "Verified for this TV" : $"{Verification.ConfirmedSliderCount}/{Verification.RequiredSliderCount} different sliders")</strong>
            <small>@(Verification.SlidersVerified ? "Future slider updates do not require confirmation." : "Confirm successful slider values on the TV.")</small>
        </div>
        @if (Verification.RequiredSelectionCount > 0)
        {
            <div class="selection-verification-summary @(Verification.SelectionsVerified ? "verified" : "unverified")">
                <span>SHARED SELECTION VERIFICATION</span>
                <strong>@(Verification.SelectionsVerified ? "All selection behaviors verified" : $"{Verification.ConfirmedSelectionCount}/{Verification.RequiredSelectionCount} interaction types")</strong>
                <small>@(Verification.SelectionsVerified ? "Controls with the same interaction type share this evidence." : "Confirm one ordinary, submenu, or indexed selection when that type exists.")</small>
            </div>
        }
        @if (Verification.ConfirmedSliderCount > 0 || Verification.ConfirmedSelectionCount > 0)
        {
            <div class="menu-control-verification-actions">
                @if (Verification.ConfirmedSliderCount > 0)
                {
                    <button class="secondary-action" @onclick="ResetSliderVerificationAsync" disabled="@IsBusy">Reset sliders</button>
                }
                @if (Verification.ConfirmedSelectionCount > 0)
                {
                    <button class="secondary-action" @onclick="ResetSelectionVerificationAsync" disabled="@IsBusy">Reset selections</button>
                }
            </div>
        }
    </div>
    <p class="field-note">Values are predictions based on menu-definition defaults and changes sent during this page session. Controls changed elsewhere can make those predictions inaccurate.</p>
    <div class="saved-tv-state-manager">
        <div>
            <span>SAVED CURRENT TV STATES</span>
            <strong>Load an observed baseline without changing the TV</strong>
            <small>Stage the values currently shown by the TV, name that state, then save it. Loading a state makes relative adjustments start from those saved values and sends no keys.</small>
        </div>
        <label>
            <span>STATE NAME</span>
            <input @bind="SavedStateName" maxlength="80" placeholder="Current calibrated state" disabled="@IsBusy" />
        </label>
        <button class="secondary-action" @onclick="SaveCurrentTvStateAsync" disabled="@(!CanSaveCurrentTvState)">Save staged values as current</button>
        <label>
            <span>SAVED STATE</span>
            <select @bind="SelectedSavedStateId" disabled="@(IsBusy || SavedTvStates.Count == 0)">
                @if (SavedTvStates.Count == 0)
                {
                    <option value="">No saved states</option>
                }
                @foreach (var state in SavedTvStates)
                {
                    <option value="@state.Id">@state.Name · @state.SavedAtUtc.ToLocalTime().ToString("g")</option>
                }
            </select>
        </label>
        <button class="primary-action" @onclick="LoadCurrentTvStateAsync" disabled="@(!CanUseSavedTvState)">Load as current values</button>
        <button class="quiet-action" @onclick="DeleteCurrentTvStateAsync" disabled="@(!CanUseSavedTvState)">Delete</button>
    </div>
    @if (ConfirmFactoryReset)
    {
        <div class="factory-reset-confirmation" role="alert">
            <div>
                <strong>Reset picture settings to factory defaults?</strong>
                <span>SamsungController will execute <b>@SelectedFactoryResetNode?.Path</b>, choose <b>@SelectedFactoryResetChoice</b>, return to normal video, and then apply every staged value from known menu-definition defaults. This changes all settings covered by that TV reset.</span>
            </div>
            <button class="secondary-action" @onclick="CancelFactoryReset" disabled="@IsBusy">Cancel</button>
            <button class="primary-action danger-action" @onclick="ResetAndApplyAllAsync" disabled="@IsBusy">Yes — reset and apply all</button>
        </div>
    }
</section>

@if (VisibleControlCount == 0)
{
    <section class="panel panel-empty picture-controls-empty">
        <strong>@(Controls.Count == 0 ? "No verified menu controls are available" : "No controls match this filter")</strong>
        <span>@(Controls.Count == 0 ? "Define values and bounds in the menu file, then complete the generated route verification." : "Choose another menu tab or clear the search text.")</span>
        <a href="menu/build">Open Build &amp; Verify →</a>
    </section>
}
else
{
    <div class="picture-control-sections">
        @foreach (var group in GetVisibleIndexedGroups())
        {
            var groupDisabled = IsIndexedGroupDisabled(group);
            <section class="panel picture-control-section indexed-control-section @(groupDisabled ? "disabled" : string.Empty)">
                <header class="picture-section-heading">
                    <div>
                        <span>FIXED VALUE GRID</span>
                        <h2>@group.Label</h2>
                        <p>@group.Path · each @group.Selector.Label option is fixed to one row</p>
                    </div>
                    @if (group.AwaitingConfirmation && !groupDisabled)
                    {
                        <button class="secondary-action" @onclick="() => ConfirmIndexedGroupAsync(group)" disabled="@IsBusy">TV grid matches ✓</button>
                    }
                    else
                    {
                        <small>@group.Rows.Count row@(group.Rows.Count == 1 ? string.Empty : "s")</small>
                    }
                </header>
                @if (groupDisabled)
                {
                    <p class="picture-disabled-reason">@GetIndexedGroupDisabledReason(group)</p>
                }
                <div class="indexed-control-table-wrap">
                    <table class="indexed-control-table">
                        <thead>
                            <tr>
                                <th>@group.Selector.Label</th>
                                @foreach (var slider in group.Sliders)
                                {
                                    <th>@slider.Label <small>@FormatValue(slider.MinimumValue ?? 0)–@FormatValue(slider.MaximumValue ?? 0)</small></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in group.Rows)
                            {
                                <tr>
                                    <th scope="row">@row.SelectorValue</th>
                                    @foreach (var cell in row.Cells)
                                    {
                                        <td class="@(cell.Pending ? "pending" : string.Empty)">
                                            <input type="number"
                                                   min="@FormatValue(cell.Minimum)"
                                                   max="@FormatValue(cell.Maximum)"
                                                   step="1"
                                                   value="@cell.DesiredValue"
                                                   aria-label="@group.Label @row.SelectorValue @cell.Slider.Label"
                                                   @onchange="args => ChangeIndexedCellAsync(group, cell, args.Value?.ToString())"
                                                   disabled="@(IsBusy || groupDisabled)" />
                                            <small>TV: @cell.AppliedValue</small>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        @foreach (var section in GetSections())
        {
            <section class="panel picture-control-section">
                <header class="picture-section-heading">
                    <div>
                        <span>MENU SECTION</span>
                        <h2>@section.Label</h2>
                        <p>@section.Path</p>
                    </div>
                    <small>@section.Controls.Count control@(section.Controls.Count == 1 ? string.Empty : "s")</small>
                </header>
                <div class="picture-control-grid">
                    @foreach (var control in section.Controls)
                    {
                        var disabled = IsControlDisabled(control);
                        <article class="picture-control-card @GetControlCssClass(control, disabled)">
                            <header>
                                <div>
                                    <strong>@control.Node.Label</strong>
                                    <small>@GetControlTypeLabel(control.Node.ControlType)</small>
                                </div>
                                <b>@GetControlStateLabel(control, disabled)</b>
                            </header>

                            @if (control.Node.ControlType == MenuControlType.Slider)
                            {
                                <div class="picture-compact-value">
                                    <strong>@control.DesiredValue</strong>
                                    <span>@FormatValue(control.Minimum) – @FormatValue(control.Maximum)</span>
                                </div>
                                <div class="picture-compact-slider">
                                    <button type="button"
                                            aria-label="Decrease @control.Node.Label"
                                            @onclick="() => NudgeAsync(control, -1)"
                                            disabled="@(IsBusy || disabled || control.DesiredNumber <= control.Minimum)">−</button>
                                    <input type="range"
                                           min="@FormatValue(control.Minimum)"
                                           max="@FormatValue(control.Maximum)"
                                           step="1"
                                           value="@control.DesiredValue"
                                           aria-label="@control.Node.Label"
                                           @onchange="args => ChangeControlAsync(control, args.Value?.ToString())"
                                           disabled="@(IsBusy || disabled)" />
                                    <button type="button"
                                            aria-label="Increase @control.Node.Label"
                                            @onclick="() => NudgeAsync(control, 1)"
                                            disabled="@(IsBusy || disabled || control.DesiredNumber >= control.Maximum)">+</button>
                                    <input class="picture-compact-number"
                                           type="number"
                                           min="@FormatValue(control.Minimum)"
                                           max="@FormatValue(control.Maximum)"
                                           step="1"
                                           value="@control.DesiredValue"
                                           aria-label="Numeric value for @control.Node.Label"
                                           @onchange="args => ChangeControlAsync(control, args.Value?.ToString())"
                                           disabled="@(IsBusy || disabled)" />
                                </div>
                            }
                            else if (control.Node.ControlType == MenuControlType.Switch)
                            {
                                <label class="picture-switch-control">
                                    <span class="picture-switch-copy">
                                        <strong>@(IsOn(control.DesiredValue) ? "On" : "Off")</strong>
                                        <small>@(disabled ? GetDisabledReason(control) : "Select to toggle")</small>
                                    </span>
                                    <input type="checkbox"
                                           checked="@IsOn(control.DesiredValue)"
                                           @onchange="args => ChangeSwitchAsync(control, args.Value is true)"
                                           disabled="@(IsBusy || disabled)" />
                                    <span class="picture-switch-track" aria-hidden="true"><i></i></span>
                                </label>
                            }
                            else if (control.Node.ControlType is MenuControlType.Selection
                                     or MenuControlType.SubmenuSelection
                                     or MenuControlType.IndexedSelection)
                            {
                                <label class="picture-selection-control">
                                    <span>SELECTED VALUE</span>
                                    <select value="@control.DesiredValue"
                                            @onchange="args => ChangeControlAsync(control, args.Value?.ToString())"
                                            disabled="@(IsBusy || disabled)">
                                        @foreach (var option in control.Node.SelectionOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </label>
                            }

                            <footer>
                                @if (disabled)
                                {
                                    <span class="picture-disabled-reason">@GetDisabledReason(control)</span>
                                }
                                else
                                {
                                    <span>TV prediction: <b>@control.AppliedValue</b></span>
                                }
                                @if (control.AwaitingConfirmation && !disabled)
                                {
                                    <button class="secondary-action" @onclick="() => ConfirmControlAsync(control)" disabled="@IsBusy">TV shows @control.AppliedValue ✓</button>
                                }
                            </footer>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    private ControllerSnapshot Snapshot { get; set; } = null!;
    private MenuNavigationSnapshot Navigation { get; set; } = null!;
    private MenuControlVerificationSnapshot Verification { get; set; } = null!;
    private MenuControlProfileSnapshot Profile { get; set; } = null!;
    private IReadOnlyList<SavedMenuControlStateSummary> SavedTvStates { get; set; } = [];
    private List<PictureControlEdit> Controls { get; } = [];
    private List<IndexedControlGroupEdit> IndexedGroups { get; } = [];
    private PictureUpdateMode UpdateMode { get; set; } = PictureUpdateMode.Staged;
    private PictureExitBehavior ExitBehavior { get; set; } = PictureExitBehavior.Stay;
    private string SelectedAreaId { get; set; } = string.Empty;
    private string SearchText { get; set; } = string.Empty;
    private string? LocalError { get; set; }
    private string? LocalStatus { get; set; }
    private bool IsBusy { get; set; }
    private bool ConfirmFactoryReset { get; set; }
    private string SelectedFactoryResetNodeId { get; set; } = string.Empty;
    private string SelectedFactoryResetChoice { get; set; } = string.Empty;
    private string SavedStateName { get; set; } = "Current TV state";
    private string SelectedSavedStateId { get; set; } = string.Empty;

    private int PendingCount => Controls.Count(control =>
            control.Pending
            && !IsIndexedControl(control.Node.Id)
            && !IsControlDisabled(control)
            && !IsControlHidden(control))
        + IndexedGroups.Sum(group => IsIndexedGroupDisabled(group)
            ? 0
            : group.Rows.Sum(row => row.Cells.Count(cell => cell.Pending)));
    private int VisibleControlCount => GetFilteredControls().Count + GetVisibleIndexedGroups().Count;
    private bool CanApplyPending => PendingCount > 0
        && !IsBusy
        && Snapshot.ConnectionState == SamsungConnectionState.Connected
        && !Snapshot.MacroRunning
        && !Navigation.IsRunning;
    private IReadOnlyList<MenuNodeSummary> FactoryResetCandidates => Navigation.Nodes
        .Where(node => node.ControlType == MenuControlType.Confirmation
            && node.HasVerifiedRoute
            && !IsNodeDisabled(node)
            && !IsNodeHidden(node)
            && (node.Id.Contains("reset", StringComparison.OrdinalIgnoreCase)
                || node.Label.Contains("reset", StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(node => node.Id.Equals("reset-picture", StringComparison.OrdinalIgnoreCase))
        .ThenBy(node => node.Depth)
        .ThenBy(node => node.Path, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    private MenuNodeSummary? SelectedFactoryResetNode => FactoryResetCandidates.FirstOrDefault(node =>
        node.Id.Equals(SelectedFactoryResetNodeId, StringComparison.OrdinalIgnoreCase));
    private bool CanBeginFactoryReset => !IsBusy
        && Snapshot.ConnectionState == SamsungConnectionState.Connected
        && SelectedFactoryResetNode is not null
        && !string.IsNullOrWhiteSpace(SelectedFactoryResetChoice)
        && !Snapshot.MacroRunning
        && !Navigation.IsRunning;
    private bool CanSaveControlProfile => !IsBusy
        && Controls.Count > 0
        && !Snapshot.MacroRunning
        && !Navigation.IsRunning;
    private bool CanSaveCurrentTvState => CanSaveControlProfile
        && !string.IsNullOrWhiteSpace(SavedStateName);
    private bool CanUseSavedTvState => !IsBusy
        && !string.IsNullOrWhiteSpace(SelectedSavedStateId)
        && SavedTvStates.Any(state => state.Id.Equals(
            SelectedSavedStateId,
            StringComparison.OrdinalIgnoreCase))
        && !Snapshot.MacroRunning
        && !Navigation.IsRunning;

    protected override async Task OnInitializedAsync()
    {
        Refresh();
        Controller.Changed += HandleControllerChanged;
        await Controller.InitializeAsync();
        Refresh();
        ReconcileControls();
    }

    private async Task ChangeControlAsync(PictureControlEdit control, string? rawValue)
    {
        var value = NormalizeControlValue(control, rawValue);
        if (value is null)
        {
            return;
        }

        control.DesiredValue = value;
        control.Confirmed = false;
        control.AwaitingConfirmation = false;
        ClearPendingValuesThatBecameUnavailable();
        EnsureSelectedMenuArea();
        LocalError = null;
        LocalStatus = UpdateMode == PictureUpdateMode.Staged
            ? $"{control.Node.Label} staged at {value}."
            : null;
        if (UpdateMode == PictureUpdateMode.Immediate && control.Pending)
        {
            await ApplyAsync([control]);
        }
    }

    private Task ChangeSwitchAsync(PictureControlEdit control, bool enabled) =>
        ChangeControlAsync(control, enabled ? "on" : "off");

    private Task NudgeAsync(PictureControlEdit control, int delta) =>
        ChangeControlAsync(
            control,
            FormatValue(Math.Clamp(
                control.DesiredNumber + delta,
                control.Minimum,
                control.Maximum)));

    private Task ApplyPendingAsync() => ApplyChangesAsync(
        Controls.Where(control =>
                control.Pending
                && !IsIndexedControl(control.Node.Id)
                && !IsControlDisabled(control)
                && !IsControlHidden(control))
            .ToArray(),
        GetPendingIndexedChanges());

    private async Task ApplyAsync(IReadOnlyList<PictureControlEdit> controls)
        => await ApplyChangesAsync(controls, []).ConfigureAwait(false);

    private async Task ChangeIndexedCellAsync(
        IndexedControlGroupEdit group,
        IndexedCellEdit cell,
        string? rawValue)
    {
        if (!decimal.TryParse(
                rawValue,
                NumberStyles.Number,
                CultureInfo.InvariantCulture,
                out var numericValue))
        {
            LocalError = $"Enter a whole-number value for {group.Label} / {cell.SelectorValue} / {cell.Slider.Label}.";
            return;
        }

        cell.DesiredValue = FormatValue(Math.Clamp(
            decimal.Truncate(numericValue),
            cell.Minimum,
            cell.Maximum));
        group.AwaitingConfirmation = false;
        LocalError = null;
        LocalStatus = UpdateMode == PictureUpdateMode.Staged
            ? $"{group.Label} · {cell.SelectorValue} · {cell.Slider.Label} staged at {cell.DesiredValue}."
            : null;
        if (UpdateMode == PictureUpdateMode.Immediate && cell.Pending)
        {
            await ApplyChangesAsync([], [new IndexedCellChange(group, cell)]);
        }
    }

    private async Task ApplyChangesAsync(
        IReadOnlyList<PictureControlEdit> controls,
        IReadOnlyList<IndexedCellChange> indexedChanges)
    {
        if (controls.Count == 0 && indexedChanges.Count == 0)
        {
            return;
        }

        IsBusy = true;
        LocalError = null;
        LocalStatus = null;
        try
        {
            await ApplyChangesCoreAsync(controls, indexedChanges);
        }
        catch (OperationCanceledException)
        {
            LocalError = "Menu-control update was cancelled.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ApplyChangesCoreAsync(
        IReadOnlyList<PictureControlEdit> controls,
        IReadOnlyList<IndexedCellChange> indexedChanges)
    {
        if (controls.Count > 0)
        {
            var knownValues = CreateKnownControlValues();
            await Controller.ApplyMenuControlValuesAsync(
                controls.Select(control => new MenuControlValueUpdate(
                        control.Node.Id,
                        control.AppliedValue,
                        control.DesiredValue))
                    .ToArray(),
                knownValues,
                returnToNormalVideo: indexedChanges.Count == 0
                    && ExitBehavior == PictureExitBehavior.ReturnToVideo);
            foreach (var control in controls)
            {
                control.AppliedValue = control.DesiredValue;
                var behaviorIsVerified = control.Node.ControlType == MenuControlType.Slider
                        && Verification.SlidersVerified
                    || IsSelectionControl(control.Node.ControlType)
                        && IsSelectionVerified(control);
                control.AwaitingConfirmation = !behaviorIsVerified;
                control.Confirmed = behaviorIsVerified;
            }
        }

        if (indexedChanges.Count > 0)
        {
            await Controller.ApplyIndexedMenuControlValuesAsync(
                indexedChanges.Select(change => new MenuIndexedControlValueUpdate(
                        change.Group.Selector.Id,
                        change.Cell.SelectorValue,
                        change.Cell.Slider.Id,
                        change.Cell.AppliedValue,
                        change.Cell.DesiredValue))
                    .ToArray(),
                CreateKnownControlValues(),
                ExitBehavior == PictureExitBehavior.ReturnToVideo);
            foreach (var change in indexedChanges)
            {
                change.Cell.AppliedValue = change.Cell.DesiredValue;
            }

            foreach (var group in indexedChanges.Select(change => change.Group).Distinct())
            {
                SynchronizeIndexedGroupControlPredictions(group, indexedChanges);
                group.AwaitingConfirmation = !Verification.SlidersVerified
                    || !IsSelectionVerified(group.Selector);
            }
        }

        var total = controls.Count + indexedChanges.Count;
        var needsConfirmation = controls.Any(control => control.AwaitingConfirmation)
            || indexedChanges.Any(change => change.Group.AwaitingConfirmation);
        await Controller.SaveMenuControlProfileAsync(CreateControlProfileValues());
        LocalStatus = needsConfirmation
            ? $"Applied {total} menu value{(total == 1 ? string.Empty : "s")}. Confirm the displayed values on the TV."
            : $"Applied {total} menu value{(total == 1 ? string.Empty : "s")}. The changed control behavior is already verified.";
    }

    private void BeginFactoryReset()
    {
        ConfirmFactoryReset = true;
        LocalError = null;
        LocalStatus = null;
    }

    private void CancelFactoryReset() => ConfirmFactoryReset = false;

    private void SelectFactoryResetNode()
    {
        var node = SelectedFactoryResetNode;
        SelectedFactoryResetChoice = node?.SelectionOptions.FirstOrDefault(option => option.Equals(
                "Reset",
                StringComparison.OrdinalIgnoreCase))
            ?? node?.SelectionOptions.FirstOrDefault(option => !option.Equals(
                "Cancel",
                StringComparison.OrdinalIgnoreCase))
            ?? node?.SelectionOptions.FirstOrDefault()
            ?? string.Empty;
        ConfirmFactoryReset = false;
    }

    private async Task ResetAndApplyAllAsync()
    {
        var resetNode = SelectedFactoryResetNode;
        if (resetNode is null || string.IsNullOrWhiteSpace(SelectedFactoryResetChoice))
        {
            LocalError = "Choose a verified factory-reset confirmation route.";
            return;
        }

        IsBusy = true;
        ConfirmFactoryReset = false;
        LocalError = null;
        LocalStatus = null;
        try
        {
            await Controller.SaveMenuControlProfileAsync(CreateControlProfileValues());
            await Controller.ResetMenuControlsToFactoryDefaultsAsync(
                resetNode.Id,
                SelectedFactoryResetChoice);
            ResetAppliedValuesToDeclaredDefaults();
            var controls = Controls.Where(control =>
                    control.Pending
                    && !IsIndexedControl(control.Node.Id)
                    && !IsControlDisabled(control)
                    && !IsControlHidden(control))
                .ToArray();
            var indexedChanges = GetPendingIndexedChanges();
            if (controls.Length > 0 || indexedChanges.Count > 0)
            {
                await ApplyChangesCoreAsync(controls, indexedChanges);
                LocalStatus = $"Factory reset completed. {LocalStatus}";
            }
            else
            {
                LocalStatus = "Factory reset completed. Every desired value already matches its declared factory default.";
            }
        }
        catch (OperationCanceledException)
        {
            LocalError = "Factory reset and profile application was cancelled.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

