    private string? NormalizeControlValue(PictureControlEdit control, string? rawValue)
    {
        if (string.IsNullOrWhiteSpace(rawValue))
        {
            LocalError = $"Choose a value for {control.Node.Label}.";
            return null;
        }

        if (control.Node.ControlType == MenuControlType.Slider)
        {
            if (!decimal.TryParse(
                    rawValue,
                    NumberStyles.Number,
                    CultureInfo.InvariantCulture,
                    out var numericValue))
            {
                LocalError = $"Enter a whole-number value for {control.Node.Label}.";
                return null;
            }

            return FormatValue(Math.Clamp(
                decimal.Truncate(numericValue),
                control.Minimum,
                control.Maximum));
        }

        if (control.Node.ControlType == MenuControlType.Switch)
        {
            return rawValue.Equals("on", StringComparison.OrdinalIgnoreCase) ? "on" : "off";
        }

        var option = control.Node.SelectionOptions.FirstOrDefault(candidate =>
            candidate.Equals(rawValue, StringComparison.OrdinalIgnoreCase));
        if (option is null)
        {
            LocalError = $"{rawValue} is not available for {control.Node.Label}.";
        }

        return option;
    }

    private void ClearPendingValuesThatBecameUnavailable()
    {
        foreach (var control in Controls.Where(control =>
                     IsControlDisabled(control) || IsControlHidden(control)))
        {
            control.DesiredValue = control.AppliedValue;
            control.AwaitingConfirmation = false;
            control.Confirmed = false;
        }


        foreach (var group in IndexedGroups.Where(group =>
                     IsIndexedGroupDisabled(group) || IsIndexedGroupHidden(group)))
        {
            foreach (var cell in group.Rows.SelectMany(row => row.Cells))
            {
                cell.DesiredValue = cell.AppliedValue;
            }

            group.AwaitingConfirmation = false;
        }
    }

    private bool IsControlDisabled(PictureControlEdit control) => IsNodeDisabled(control.Node);

    private bool IsNodeDisabled(MenuNodeSummary node) => FindDisabledNode(node) is not null;

    private MenuNodeSummary? FindDisabledNode(MenuNodeSummary node)
    {
        var current = node;
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        while (visited.Add(current.Id))
        {
            if (current.Disabled
                || current.DisabledWhen.Any(condition =>
                    GetPredictedValue(condition.SettingNodeId)?.Equals(
                        condition.EqualsValue,
                        StringComparison.OrdinalIgnoreCase) == true))
            {
                return current;
            }

            if (string.IsNullOrWhiteSpace(current.ParentId))
            {
                break;
            }

            var parent = Navigation.Nodes.FirstOrDefault(candidate => candidate.Id.Equals(
                current.ParentId,
                StringComparison.OrdinalIgnoreCase));
            if (parent is null)
            {
                break;
            }

            current = parent;
        }

        return null;
    }

    private bool IsControlHidden(PictureControlEdit control) => IsNodeHidden(control.Node);

    private bool IsNodeHidden(MenuNodeSummary node)
    {
        var current = node;
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        while (visited.Add(current.Id))
        {
            if (current.HiddenWhen.Any(condition => GetPredictedValue(condition.SettingNodeId)
                    ?.Equals(condition.EqualsValue, StringComparison.OrdinalIgnoreCase) == true))
            {
                return true;
            }

            if (string.IsNullOrWhiteSpace(current.ParentId))
            {
                break;
            }

            var parent = Navigation.Nodes.FirstOrDefault(candidate => candidate.Id.Equals(
                current.ParentId,
                StringComparison.OrdinalIgnoreCase));
            if (parent is null)
            {
                break;
            }

            current = parent;
        }

        return false;
    }

    private bool IsIndexedControl(string nodeId) => IndexedGroups.Any(group =>
        group.Selector.Id.Equals(nodeId, StringComparison.OrdinalIgnoreCase)
        || group.Sliders.Any(slider => slider.Id.Equals(nodeId, StringComparison.OrdinalIgnoreCase)));

    private bool IsIndexedGroupDisabled(IndexedControlGroupEdit group) =>
        IsNodeDisabled(group.Selector) || group.Sliders.Any(IsNodeDisabled);

    private bool IsIndexedGroupHidden(IndexedControlGroupEdit group) =>
        IsNodeHidden(group.Selector) || group.Sliders.All(IsNodeHidden);

    private string GetIndexedGroupDisabledReason(IndexedControlGroupEdit group)
    {
        var disabledNode = new[] { group.Selector }.Concat(group.Sliders)
            .FirstOrDefault(IsNodeDisabled);
        return disabledNode is null
            ? "Unavailable under the current predicted settings"
            : GetDisabledReason(disabledNode);
    }

    private IReadOnlyList<IndexedControlGroupEdit> GetVisibleIndexedGroups() => IndexedGroups
        .Where(group => !IsIndexedGroupHidden(group)
            && !string.IsNullOrWhiteSpace(SelectedAreaId)
            && ResolveMenuArea(group.Selector).Id.Equals(
                SelectedAreaId,
                StringComparison.OrdinalIgnoreCase)
            && (string.IsNullOrWhiteSpace(SearchText)
                || group.Label.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase)
                || group.Path.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase)
                || group.Rows.Any(row => row.SelectorValue.Contains(
                    SearchText.Trim(),
                    StringComparison.OrdinalIgnoreCase))
                || group.Sliders.Any(slider => slider.Label.Contains(
                    SearchText.Trim(),
                    StringComparison.OrdinalIgnoreCase))))
        .ToArray();

    private IReadOnlyList<IndexedCellChange> GetPendingIndexedChanges() => IndexedGroups
        .Where(group => !IsIndexedGroupDisabled(group) && !IsIndexedGroupHidden(group))
        .SelectMany(group => group.Rows.SelectMany(row => row.Cells
            .Where(cell => cell.Pending)
            .Select(cell => new IndexedCellChange(group, cell))))
        .ToArray();

    private Dictionary<string, string> CreateKnownControlValues() => Controls.ToDictionary(
        control => control.Node.Id,
        control => control.AppliedValue,
        StringComparer.OrdinalIgnoreCase);

    private void SynchronizeIndexedGroupControlPredictions(
        IndexedControlGroupEdit group,
        IReadOnlyList<IndexedCellChange> changes)
    {
        var groupChanges = changes.Where(change => ReferenceEquals(change.Group, group)).ToArray();
        var lastSelectorValue = group.Rows
            .Where(row => groupChanges.Any(change => change.Cell.SelectorValue.Equals(
                row.SelectorValue,
                StringComparison.OrdinalIgnoreCase)))
            .LastOrDefault()?.SelectorValue;
        var selectorControl = Controls.FirstOrDefault(control => control.Node.Id.Equals(
            group.Selector.Id,
            StringComparison.OrdinalIgnoreCase));
        if (selectorControl is not null && lastSelectorValue is not null)
        {
            selectorControl.AppliedValue = lastSelectorValue;
            selectorControl.DesiredValue = lastSelectorValue;
        }

        foreach (var slider in group.Sliders)
        {
            var lastCell = groupChanges.Select(change => change.Cell)
                .LastOrDefault(cell => cell.Slider.Id.Equals(
                    slider.Id,
                    StringComparison.OrdinalIgnoreCase));
            var sliderControl = Controls.FirstOrDefault(control => control.Node.Id.Equals(
                slider.Id,
                StringComparison.OrdinalIgnoreCase));
            if (lastCell is not null && sliderControl is not null)
            {
                sliderControl.AppliedValue = lastCell.AppliedValue;
                sliderControl.DesiredValue = lastCell.AppliedValue;
            }
        }
    }

    private string? GetPredictedValue(string nodeId) =>
        Controls.FirstOrDefault(candidate => candidate.Node.Id.Equals(
            nodeId,
            StringComparison.OrdinalIgnoreCase))?.DesiredValue
        ?? Navigation.ControlValues.GetValueOrDefault(nodeId)
        ?? Navigation.Nodes.FirstOrDefault(candidate => candidate.Id.Equals(
            nodeId,
            StringComparison.OrdinalIgnoreCase))?.DefaultValue;

    private string GetDisabledReason(PictureControlEdit control) =>
        GetDisabledReason(control.Node);

    private string GetDisabledReason(MenuNodeSummary node)
    {
        var disabledNode = FindDisabledNode(node);
        if (disabledNode is null)
        {
            return "Unavailable in the predicted state";
        }

        if (disabledNode.Disabled)
        {
            return disabledNode.Id.Equals(node.Id, StringComparison.OrdinalIgnoreCase)
                ? "Permanently disabled in this menu"
                : $"Disabled because parent menu {disabledNode.Label} is permanently disabled";
        }

        var matches = disabledNode.DisabledWhen.Where(condition =>
            GetPredictedValue(condition.SettingNodeId)?.Equals(
                condition.EqualsValue,
                StringComparison.OrdinalIgnoreCase) == true).Select(condition =>
        {
            var setting = Navigation.Nodes.FirstOrDefault(candidate => candidate.Id.Equals(
                condition.SettingNodeId,
                StringComparison.OrdinalIgnoreCase));
            return $"{setting?.Label ?? condition.SettingNodeId} = {GetPredictedValue(condition.SettingNodeId)}";
        }).ToArray();
        if (matches.Length == 0)
        {
            return "Unavailable in the predicted state";
        }

        return disabledNode.Id.Equals(node.Id, StringComparison.OrdinalIgnoreCase)
            ? $"Disabled while {string.Join(" or ", matches)}"
            : $"Disabled because parent menu {disabledNode.Label} is disabled while {string.Join(" or ", matches)}";
    }

    private IReadOnlyList<PictureControlSection> GetSections()
    {
        var nodeOrder = Navigation.Nodes.Select((node, index) => (node.Id, index))
            .ToDictionary(item => item.Id, item => item.index, StringComparer.OrdinalIgnoreCase);
        return GetFilteredControls()
            .GroupBy(control => control.Node.ParentId ?? "settings", StringComparer.OrdinalIgnoreCase)
            .Select(group =>
            {
                var sectionNode = Navigation.Nodes.FirstOrDefault(node => node.Id.Equals(
                    group.Key,
                    StringComparison.OrdinalIgnoreCase));
                return new PictureControlSection(
                    group.Key,
                    sectionNode?.Label ?? "Settings",
                    sectionNode?.Path ?? "Settings",
                    group.OrderBy(control => nodeOrder.GetValueOrDefault(control.Node.Id, int.MaxValue)).ToArray(),
                    nodeOrder.GetValueOrDefault(group.Key, int.MaxValue));
            })
            .OrderBy(section => section.Order)
            .ToArray();
    }

    private IReadOnlyList<PictureControlEdit> GetFilteredControls() => Controls.Where(control =>
            !IsControlHidden(control)
            && !IsIndexedControl(control.Node.Id)
            && !string.IsNullOrWhiteSpace(SelectedAreaId)
            && ResolveMenuArea(control.Node).Id.Equals(
                SelectedAreaId,
                StringComparison.OrdinalIgnoreCase)
            && (string.IsNullOrWhiteSpace(SearchText)
                || control.Node.Label.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase)
                || control.Node.Path.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase)))
        .ToArray();

    private IReadOnlyList<MenuControlArea> GetMenuAreas()
    {
        var nodeOrder = Navigation.Nodes.Select((node, index) => (node.Id, index))
            .ToDictionary(item => item.Id, item => item.index, StringComparer.OrdinalIgnoreCase);
        return Controls.Where(control => !IsControlHidden(control) && !IsIndexedControl(control.Node.Id))
            .Select(control => ResolveMenuArea(control.Node))
            .Concat(IndexedGroups
                .Where(group => !IsIndexedGroupHidden(group))
                .SelectMany(group => Enumerable.Repeat(
                    ResolveMenuArea(group.Selector),
                    Math.Max(1, group.Rows.Count * group.Sliders.Count))))
            .GroupBy(area => area.Id, StringComparer.OrdinalIgnoreCase)
            .Select(group => new MenuControlArea(group.Key, group.First().Label, group.Count()))
            .OrderBy(area => nodeOrder.GetValueOrDefault(area.Id, int.MaxValue))
            .ThenBy(area => area.Label, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private MenuControlArea ResolveMenuArea(MenuNodeSummary node)
    {
        var current = node;
        while (!string.IsNullOrWhiteSpace(current.ParentId))
        {
            var parent = Navigation.Nodes.FirstOrDefault(candidate => candidate.Id.Equals(
                current.ParentId,
                StringComparison.OrdinalIgnoreCase));
            if (parent is null)
            {
                break;
            }

            if (parent.Id.Equals("settings", StringComparison.OrdinalIgnoreCase)
                || parent.Label.Equals("Settings", StringComparison.OrdinalIgnoreCase))
            {
                return current.Id.Equals(node.Id, StringComparison.OrdinalIgnoreCase)
                    ? new MenuControlArea(parent.Id, parent.Label, 0)
                    : new MenuControlArea(current.Id, current.Label, 0);
            }

            if (parent.Id.Equals("normal-video", StringComparison.OrdinalIgnoreCase))
            {
                return new MenuControlArea(current.Id, current.Label, 0);
            }

            current = parent;
        }

        return new MenuControlArea(current.Id, current.Label, 0);
    }

    private void SelectMenuArea(string areaId)
    {
        SelectedAreaId = areaId;
        LocalError = null;
    }

    private void EnsureSelectedMenuArea()
    {
        var areas = GetMenuAreas();
        if (areas.Count == 0)
        {
            SelectedAreaId = string.Empty;
            return;
        }

        if (areas.Any(area => area.Id.Equals(SelectedAreaId, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        SelectedAreaId = areas.FirstOrDefault(area =>
                area.Label.Equals("Picture", StringComparison.OrdinalIgnoreCase))?.Id
            ?? areas[0].Id;
    }

    private void HandleControllerChanged()
    {
        _ = InvokeAsync(() =>
        {
            Refresh();
            ReconcileControls();
            StateHasChanged();
        });
    }

    private void Refresh()
    {
        Snapshot = Controller.GetSnapshot();
        Navigation = Controller.GetMenuNavigationSnapshot();
        Verification = Controller.GetMenuControlVerificationSnapshot();
        Profile = Controller.GetMenuControlProfileSnapshot();
        SavedTvStates = Controller.GetSavedMenuControlStates();
        if (!SavedTvStates.Any(state => state.Id.Equals(
                SelectedSavedStateId,
                StringComparison.OrdinalIgnoreCase)))
        {
            SelectedSavedStateId = SavedTvStates.FirstOrDefault()?.Id ?? string.Empty;
        }
    }

    private void ReconcileControls()
    {
        var existing = Controls.ToDictionary(control => control.Node.Id, StringComparer.OrdinalIgnoreCase);
        var eligible = Navigation.Nodes.Where(node =>
                IsSupportedControl(node)
                && HasUsableRoute(node))
            .ToArray();
        Controls.Clear();
        foreach (var node in eligible)
        {
            if (existing.TryGetValue(node.Id, out var edit))
            {
                edit.Node = node;
                Controls.Add(edit);
                continue;
            }

            var defaultValue = Navigation.ControlValues.GetValueOrDefault(node.Id)
                ?? NormalizeDefaultValue(node);
            if (defaultValue is not null)
            {
                var newEdit = new PictureControlEdit(node, defaultValue);
                var profileValue = Profile.Values.FirstOrDefault(value =>
                    string.IsNullOrWhiteSpace(value.SelectorNodeId)
                    && value.NodeId.Equals(node.Id, StringComparison.OrdinalIgnoreCase));
                if (profileValue is not null)
                {
                    newEdit.DesiredValue = NormalizeControlValueWithoutError(node, profileValue.Value)
                        ?? defaultValue;
                }

                Controls.Add(newEdit);
            }
        }

        ReconcileIndexedGroups();
        EnsureSelectedMenuArea();
        EnsureFactoryResetSelection();
        foreach (var selection in Controls.Where(control =>
                     IsSelectionControl(control.Node.ControlType)))
        {
            if (IsSelectionVerified(selection))
            {
                selection.AwaitingConfirmation = false;
                selection.Confirmed = true;
            }
            else if (!selection.AwaitingConfirmation)
            {
                selection.Confirmed = false;
            }
        }
    }

    private void ReconcileIndexedGroups()
    {
        var existingCells = IndexedGroups
            .SelectMany(group => group.Rows.SelectMany(row => row.Cells.Select(cell => (
                Key: $"{group.Selector.Id}\u001f{row.SelectorValue}\u001f{cell.Slider.Id}",
                Cell: cell))))
            .ToDictionary(item => item.Key, item => item.Cell, StringComparer.OrdinalIgnoreCase);
        var awaitingBySelector = IndexedGroups.ToDictionary(
            group => group.Selector.Id,
            group => group.AwaitingConfirmation,
            StringComparer.OrdinalIgnoreCase);
        var nodes = Navigation.Nodes.ToArray();
        IndexedGroups.Clear();
        foreach (var selector in nodes.Where(node =>
                     IsIndexedSelector(node)
                     && IsSupportedControl(node)
                     && HasUsableRoute(node)))
        {
            var selectorIndex = Array.FindIndex(nodes, node => node.Id.Equals(
                selector.Id,
                StringComparison.OrdinalIgnoreCase));
            var sliders = new List<MenuNodeSummary>();
            for (var index = selectorIndex + 1; index < nodes.Length; index++)
            {
                var candidate = nodes[index];
                if (candidate.ParentId?.Equals(selector.ParentId, StringComparison.OrdinalIgnoreCase) != true
                    || candidate.ControlType != MenuControlType.Slider)
                {
                    break;
                }

                if (IsSupportedControl(candidate) && HasUsableRoute(candidate))
                {
                    sliders.Add(candidate);
                }
            }

            if (sliders.Count == 0)
            {
                continue;
            }

            var parent = Navigation.Nodes.FirstOrDefault(node => node.Id.Equals(
                selector.ParentId,
                StringComparison.OrdinalIgnoreCase));
            var rows = selector.SelectionOptions.Select(option => new IndexedControlRowEdit(
                    option,
                    sliders.Select(slider =>
                    {
                        var key = $"{selector.Id}\u001f{option}\u001f{slider.Id}";
                        if (existingCells.TryGetValue(key, out var existing))
                        {
                            existing.Slider = slider;
                            return existing;
                        }

                        var cell = new IndexedCellEdit(
                            option,
                            slider,
                            NormalizeDefaultValue(slider)!);
                        var profileValue = Profile.Values.FirstOrDefault(value =>
                            value.NodeId.Equals(slider.Id, StringComparison.OrdinalIgnoreCase)
                            && value.SelectorNodeId?.Equals(
                                selector.Id,
                                StringComparison.OrdinalIgnoreCase) == true
                            && value.SelectorValue?.Equals(
                                option,
                                StringComparison.OrdinalIgnoreCase) == true);
                        if (profileValue is not null)
                        {
                            cell.DesiredValue = NormalizeControlValueWithoutError(
                                    slider,
                                    profileValue.Value)
                                ?? cell.DesiredValue;
                        }

                        return cell;
                    }).ToArray()))
                .ToArray();
            IndexedGroups.Add(new IndexedControlGroupEdit(
                selector,
                sliders,
                rows,
                parent?.Label ?? selector.Label,
                parent?.Path ?? selector.Path,
                awaitingBySelector.GetValueOrDefault(selector.Id)));
        }
    }

    private static bool IsIndexedSelector(MenuNodeSummary node)
    {
        if (node.ControlType == MenuControlType.IndexedSelection)
        {
            return true;
        }

        if (node.ControlType != MenuControlType.Selection)
        {
            return false;
        }

        return node.Label.Equals("Interval", StringComparison.OrdinalIgnoreCase)
               && node.SelectionOptions.Count > 1
               && node.SelectionOptions.All(option => option.EndsWith('%'))
            || node.Label.Equals("Color", StringComparison.OrdinalIgnoreCase)
               && new[] { "Red", "Green", "Blue" }.All(required =>
                   node.SelectionOptions.Contains(required, StringComparer.OrdinalIgnoreCase));
    }

    private void EnsureFactoryResetSelection()
    {
        var candidates = FactoryResetCandidates;
        if (candidates.Count == 0)
        {
            SelectedFactoryResetNodeId = string.Empty;
            SelectedFactoryResetChoice = string.Empty;
            ConfirmFactoryReset = false;
            return;
        }

        if (!candidates.Any(node => node.Id.Equals(
                SelectedFactoryResetNodeId,
                StringComparison.OrdinalIgnoreCase)))
        {
            SelectedFactoryResetNodeId = candidates[0].Id;
        }

        if (string.IsNullOrWhiteSpace(SelectedFactoryResetChoice)
            || SelectedFactoryResetNode?.SelectionOptions.Contains(
                SelectedFactoryResetChoice,
                StringComparer.OrdinalIgnoreCase) != true)
        {
            SelectFactoryResetNode();
        }
    }

    private bool HasUsableRoute(MenuNodeSummary node)
    {
        if (node.HasVerifiedRoute)
        {
            return true;
        }

        var current = node;
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        while (visited.Add(current.Id) && !string.IsNullOrWhiteSpace(current.ParentId))
        {
            var parent = Navigation.Nodes.FirstOrDefault(candidate => candidate.Id.Equals(
                current.ParentId,
                StringComparison.OrdinalIgnoreCase));
            if (parent is null)
            {
                break;
            }

            if ((current.Disabled || current.DisabledWhen.Count > 0 || current.HiddenWhen.Count > 0)
                && parent.HasVerifiedRoute)
            {
                return true;
            }

            current = parent;
        }

        return false;
    }

    private static bool IsSupportedControl(MenuNodeSummary node) => node.ControlType switch
    {
        MenuControlType.Slider => node.MinimumValue is not null
            && node.MaximumValue is not null
            && !string.IsNullOrWhiteSpace(node.DefaultValue),
        MenuControlType.Switch => !string.IsNullOrWhiteSpace(node.DefaultValue),
        MenuControlType.Selection => !string.IsNullOrWhiteSpace(node.DefaultValue)
            && node.SelectionOptions.Count > 0,
        MenuControlType.SubmenuSelection => !string.IsNullOrWhiteSpace(node.DefaultValue)
            && node.SelectionOptions.Count > 0,
        MenuControlType.IndexedSelection => !string.IsNullOrWhiteSpace(node.DefaultValue)
            && node.SelectionOptions.Count > 0,
        _ => false
    };

    private static string? NormalizeDefaultValue(MenuNodeSummary node)
    {
        if (node.ControlType == MenuControlType.Slider)
        {
            if (!decimal.TryParse(
                    node.DefaultValue,
                    NumberStyles.Number,
                    CultureInfo.InvariantCulture,
                    out var defaultValue))
            {
                return null;
            }

            return FormatValue(Math.Clamp(
                decimal.Truncate(defaultValue),
                node.MinimumValue!.Value,
                node.MaximumValue!.Value));
        }

        if (node.ControlType == MenuControlType.Switch)
        {
            return node.DefaultValue!.Equals("on", StringComparison.OrdinalIgnoreCase) ? "on" : "off";
        }

        return node.SelectionOptions.FirstOrDefault(option => option.Equals(
            node.DefaultValue,
            StringComparison.OrdinalIgnoreCase));
    }

    private static string? NormalizeControlValueWithoutError(
        MenuNodeSummary node,
        string? rawValue)
    {
        if (string.IsNullOrWhiteSpace(rawValue))
        {
            return null;
        }

        if (node.ControlType == MenuControlType.Slider)
        {
            if (!decimal.TryParse(
                    rawValue,
                    NumberStyles.Number,
                    CultureInfo.InvariantCulture,
                    out var numericValue)
                || node.MinimumValue is not { } minimum
                || node.MaximumValue is not { } maximum)
            {
                return null;
            }

            return FormatValue(Math.Clamp(decimal.Truncate(numericValue), minimum, maximum));
        }

        if (node.ControlType == MenuControlType.Switch)
        {
            return rawValue.Equals("on", StringComparison.OrdinalIgnoreCase)
                ? "on"
                : rawValue.Equals("off", StringComparison.OrdinalIgnoreCase)
                    ? "off"
                    : null;
        }

        return node.SelectionOptions.FirstOrDefault(option => option.Equals(
            rawValue,
            StringComparison.OrdinalIgnoreCase));
    }

    private static string GetControlTypeLabel(MenuControlType type) => type switch
    {
        MenuControlType.Slider => "SLIDER",
        MenuControlType.Switch => "SWITCH",
        MenuControlType.Selection => "SELECTION",
        MenuControlType.SubmenuSelection => "SUBMENU SELECTION",
        MenuControlType.IndexedSelection => "INDEXED SELECTION",
        _ => type.ToString().ToUpperInvariant()
    };

    private string GetControlStateLabel(PictureControlEdit control, bool disabled) => disabled
        ? "DISABLED"
        : control.Pending
            ? "PENDING"
            : control.AwaitingConfirmation
                ? "VERIFY"
                : control.Node.ControlType == MenuControlType.Slider && Verification.SlidersVerified
                    ? "SLIDER VERIFIED"
                    : IsSelectionControl(control.Node.ControlType) && IsSelectionVerified(control)
                        ? "SELECTION VERIFIED"
                        : control.Confirmed
                            ? "CONFIRMED"
                            : IsSelectionControl(control.Node.ControlType)
                                ? "NEEDS VERIFICATION"
                                : control.Node.HasVerifiedRoute
                                    ? "VERIFIED"
                                    : "CONDITIONAL";

    private string GetControlCssClass(PictureControlEdit control, bool disabled)
    {
        var confirmed = control.Confirmed
            || IsSelectionControl(control.Node.ControlType)
            && IsSelectionVerified(control);
        return $"{(disabled ? "disabled" : string.Empty)} {(control.Pending ? "pending" : string.Empty)} {(control.AwaitingConfirmation ? "awaiting-confirmation" : confirmed ? "confirmed" : string.Empty)}";
    }

    private bool IsSelectionVerified(PictureControlEdit control) =>
        IsSelectionVerified(control.Node);

    private bool IsSelectionVerified(MenuNodeSummary node) =>
        Verification.VerifiedSelectionControlTypes.Contains(
            MenuControlBehaviorClassifier.GetEffectiveControlType(
                node.ControlType,
                node.Label,
                node.SelectionOptions));

    private static bool IsSelectionControl(MenuControlType controlType) =>
        controlType is MenuControlType.Selection
            or MenuControlType.SubmenuSelection
            or MenuControlType.IndexedSelection;

    private static bool IsOn(string value) => value.Equals("on", StringComparison.OrdinalIgnoreCase);

    private static string FormatValue(decimal value) =>
        value.ToString("G29", CultureInfo.InvariantCulture);

    public void Dispose() => Controller.Changed -= HandleControllerChanged;

    private enum PictureUpdateMode
    {
        Immediate,
        Staged
    }

    private enum PictureExitBehavior
    {
        Stay,
        ReturnToVideo
    }

    private sealed class PictureControlEdit(MenuNodeSummary node, string defaultValue)
    {
        public MenuNodeSummary Node { get; set; } = node;
        public string AppliedValue { get; set; } = defaultValue;
        public string DesiredValue { get; set; } = defaultValue;
        public bool AwaitingConfirmation { get; set; }
        public bool Confirmed { get; set; }
        public bool Pending => !DesiredValue.Equals(AppliedValue, StringComparison.OrdinalIgnoreCase);
        public decimal Minimum => Node.MinimumValue ?? 0;
        public decimal Maximum => Node.MaximumValue ?? 0;
        public decimal DesiredNumber => decimal.TryParse(
            DesiredValue,
            NumberStyles.Number,
            CultureInfo.InvariantCulture,
            out var value) ? value : 0;
    }

    private sealed record PictureControlSection(
        string Id,
        string Label,
        string Path,
        IReadOnlyList<PictureControlEdit> Controls,
        int Order);

    private sealed record MenuControlArea(string Id, string Label, int ControlCount);

    private sealed class IndexedControlGroupEdit(
        MenuNodeSummary selector,
        IReadOnlyList<MenuNodeSummary> sliders,
        IReadOnlyList<IndexedControlRowEdit> rows,
        string label,
        string path,
        bool awaitingConfirmation)
    {
        public MenuNodeSummary Selector { get; } = selector;
        public IReadOnlyList<MenuNodeSummary> Sliders { get; } = sliders;
        public IReadOnlyList<IndexedControlRowEdit> Rows { get; } = rows;
        public string Label { get; } = label;
        public string Path { get; } = path;
        public bool AwaitingConfirmation { get; set; } = awaitingConfirmation;
    }

    private sealed record IndexedControlRowEdit(
        string SelectorValue,
        IReadOnlyList<IndexedCellEdit> Cells);

    private sealed class IndexedCellEdit(
        string selectorValue,
        MenuNodeSummary slider,
        string defaultValue)
    {
        public string SelectorValue { get; } = selectorValue;
        public MenuNodeSummary Slider { get; set; } = slider;
        public string AppliedValue { get; set; } = defaultValue;
        public string DesiredValue { get; set; } = defaultValue;
        public bool Pending => !DesiredValue.Equals(AppliedValue, StringComparison.OrdinalIgnoreCase);
        public decimal Minimum => Slider.MinimumValue ?? 0;
        public decimal Maximum => Slider.MaximumValue ?? 0;
    }

    private sealed record IndexedCellChange(
        IndexedControlGroupEdit Group,
        IndexedCellEdit Cell);
}
