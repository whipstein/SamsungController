@page "/ip-remote"
@implements IDisposable
@using SamsungController.Core.IpRemote
@inject SamsungIpRemoteService IpRemoteController
@inject IJSRuntime JavaScript

<PageTitle>IP Remote Preview · SamsungController</PageTitle>

<section class="page-heading compact-heading">
    <div>
        <span class="eyebrow">v@(SamsungIpRemoteService.Version) · GUARDED CONTRAST CHECKPOINT</span>
        <h1>IP Remote diagnostics</h1>
        <p>A separate, direct HTTPS connection. Read TV-reported data and explicitly test one reversible contrast change.</p>
    </div>
</section>

<div class="notice">
    <strong>Isolated IP Remote preview</strong>
    <span>The Connect status and quick-access buttons above belong to the existing WebSocket remote. Pairing here saves a separate credential; it does not establish a persistent connection. Only the explicitly confirmed contrast test below can write a setting. No polling, fallback keys, resets, or calibration imports occur here.</span>
</div>
@if (PendingContrast)
{
    <div class="notice danger" role="alert"><strong>Contrast restoration pending — original @Snapshot.ContrastTest!.Original</strong><span>Keep the original TV, input, picture mode, and signal unchanged. Finish or recover the contrast test below before leaving. Cancel stops requests; it does not undo a write. The original is saved privately for restart recovery.</span><a href="#contrast-test">Go to contrast recovery</a></div>
}
@if (Error is not null)
{
    <div class="notice danger" role="alert"><strong>IP Remote action failed</strong><span>@Error</span></div>
}
@if (Snapshot.StorageWarning is not null)
{
    <div class="notice danger" role="alert">@Snapshot.StorageWarning</div>
}

<div class="ip-remote-workspace">
    <section class="panel ip-step">
        <h2>1. Choose a display and context</h2>
        <p>Enable <strong>IP Remote</strong> on the TV first. These annotations describe the test conditions; they are not automatically detected or applied to the TV.</p>
        @if (Snapshot.Profiles.Count > 0)
        {
            <label>Saved IP Remote profiles
                <select aria-label="Saved IP Remote profiles" value="@(Snapshot.ActiveProfile?.Endpoint ?? "")" @onchange="SelectProfileAsync" disabled="@(Snapshot.IsBusy || PendingContrast)">
                    @if (Snapshot.ActiveProfile is null) { <option value="" disabled>Choose a saved profile…</option> }
                    @foreach (var profile in Snapshot.Profiles)
                    {
                        <option value="@profile.Endpoint">@(string.IsNullOrWhiteSpace(profile.Model) ? "Display" : profile.Model) · @profile.Endpoint</option>
                    }
                </select>
            </label>
        }
        <fieldset disabled="@(Snapshot.IsBusy || PendingContrast)">
            <div class="ip-fields">
                <label>TV IP address or hostname<input aria-label="TV IP address or hostname" @bind="Host" @bind:event="oninput" placeholder="192.168.1.100" autocomplete="off" /></label>
                <label>HTTPS port<input type="number" min="1" max="65535" aria-label="HTTPS port" @bind="Port" /></label>
                <label>Model<input aria-label="Model" @bind="Model" @bind:event="oninput" placeholder="S95F / Odyssey G9…" /></label>
                <label>Firmware<input aria-label="Firmware" @bind="Firmware" @bind:event="oninput" /></label>
                <label>Input source<input aria-label="Input source" @bind="InputSource" @bind:event="oninput" placeholder="HDMI 1 / app…" /></label>
                <label>Picture mode<input aria-label="Picture mode" @bind="PictureMode" @bind:event="oninput" /></label>
                <label class="ip-wide">Signal / other conditions<input aria-label="Signal / other conditions" @bind="Signal" @bind:event="oninput" placeholder="SDR, RGB, 8-bit; record what is actually being sent" /></label>
            </div>
            <details class="ip-security">
                <summary>Certificate trust and timeouts</summary>
                <p>System certificate validation is the default. A verified SHA-256 pin takes precedence over the opt-in below, and applies only to this saved host and port. A fingerprint shown after a failed handshake identifies the responding server, not proof that it is your TV.</p>
                <label>Trusted certificate SHA-256 fingerprint<input aria-label="Certificate SHA-256 fingerprint" @bind="CertificatePin" @bind:event="oninput" placeholder="Optional · 64 hex digits" autocomplete="off" /></label>
                <label class="ip-check"><input type="checkbox" @bind="AllowUntrustedCertificate" /> Allow an untrusted certificate for this endpoint only</label>
                <p>This opt-in weakens server identity checking. Use it only on a trusted local network; it never disables TLS validation globally.</p>
                <div class="ip-fields">
                    <label>Read timeout (seconds)<input type="number" min="1" max="120" @bind="ReadTimeoutSeconds" /></label>
                    <label>Pairing timeout (seconds)<input type="number" min="1" max="120" @bind="PairingTimeoutSeconds" /></label>
                </div>
            </details>
        </fieldset>
        <div class="ip-actions">
            <button class="primary-action" @onclick="SaveAsync" disabled="@(Snapshot.IsBusy || !Snapshot.Initialized || PendingContrast)">Save IP Remote profile</button>
            <button class="toolbar-button" @onclick="NewProfile" disabled="@(Snapshot.IsBusy || PendingContrast)">New display</button>
            @if (Snapshot.ActiveProfile is not null)
            {
                <button class="toolbar-button" @onclick="LoadActiveProfile" disabled="@Snapshot.IsBusy">Discard unsaved edits</button>
            }
            @if (!Snapshot.Initialized)
            {
                <button class="toolbar-button" @onclick="InitializeAsync">Retry loading profiles</button>
            }
        </div>
        <p>@(IsSaved ? $"Saved endpoint: {Snapshot.ActiveProfile!.Endpoint}" : "Save the profile or discard edits before pairing or reading. This prevents querying an old address or labeling a response with unsaved conditions.")</p>
    </section>

    <section class="panel ip-step">
        <h2>2. Pair explicitly</h2>
        <p>Pair once, then accept on the TV. After restarting, use Read directly with the saved token. Pair again deliberately requests a new token and may require TV approval. Port 1516 is the initial default; neither port is scanned automatically.</p>
        <p class="ip-status"><strong>@TokenStatus</strong></p>
        <div class="ip-actions">
            <button class="primary-action" @onclick="PairAsync" disabled="@(!CanAct)">@(Snapshot.HasToken ? "Pair again…" : "Pair with TV")</button>
            <button class="toolbar-button" @onclick="ForgetAsync" disabled="@(!CanAct || !Snapshot.HasToken || PendingContrast)">Forget local IP Remote token…</button>
            <button class="toolbar-button" @onclick="IpRemoteController.Cancel" disabled="@(!Snapshot.IsBusy)">Cancel request</button>
        </div>
        <p role="status" aria-live="polite">@Snapshot.Status</p>
        @if (!Snapshot.IsBusy && LatestPairing is { } pairing)
        {
            <div class="ip-pairing-result @(pairing.IsSuccess ? "success" : "failure")" role="@(pairing.IsSuccess ? "status" : "alert")">
                <strong>Last pairing attempt: @(pairing.IsSuccess ? "completed" : $"failed — {pairing.Outcome}")</strong>
                <span>@pairing.Message</span>
            </div>
        }
        @if (LatestCertificate is { } fingerprint)
        {
            <p>Last observed server certificate SHA-256:</p>
            <code class="ip-fingerprint">@fingerprint</code>
        }
        <p>Credentials are stored only in the separate per-user <code>ip-remote/tokens.json</code> file. Requests, replies, and this page's diagnostic logs always redact tokens.</p>
    </section>

    <section class="panel ip-step">
        <h2>3. Read and compare</h2>
        <p>Start with a baseline. Later, manually change one TV setting, label the change, and read again in the same saved context. These are historical observations, not live values or verified slider mappings.</p>
        @if (Snapshot.ActiveProfile is { } savedContext)
        {
            <p><strong>Saved comparison context:</strong> @savedContext.Model · @savedContext.Firmware · @savedContext.InputSource · @savedContext.PictureMode · @savedContext.Signal</p>
        }
        <label>Observation label<input aria-label="Observation label" @bind="Label" @bind:event="oninput" placeholder="Baseline / manually changed TV Brightness +1 / restored" disabled="@Snapshot.IsBusy" /></label>
        <div class="ip-actions">
            <button class="primary-action" @onclick="ReadBothAsync" disabled="@(!CanRead)">Read both state queries</button>
            @foreach (var method in SamsungIpRemoteClient.ReadMethods)
            {
                <button class="toolbar-button" @onclick="() => ReadAsync(method)" disabled="@(!CanRead)">@method</button>
            }
        </div>
        @if (ReadDisabledReason is { } reason)
        {
            <p class="ip-read-blocked" role="status"><strong>Read unavailable:</strong> @reason</p>
        }
        <p><strong>Do not map fields by name yet.</strong> A reported “brightness” field may not represent the modern TV Brightness slider. Backlight/Brightness and Shadow Detail must be checked against actual manual changes. Advanced white balance and custom color support are still unknown.</p>
        <div class="ip-results">
            @foreach (var method in SamsungIpRemoteClient.ReadMethods)
            {
                var attempts = ContextObservations.Where(item => item.Exchange.Method == method).ToArray();
                var latest = attempts.LastOrDefault();
                var previous = attempts.SkipLast(1).LastOrDefault(item => item.Exchange.IsSuccess);
                <article class="ip-result">
                    <h3>@method</h3>
                    <p><strong>@(latest is null ? "Not tested in this session and saved context" : latest.Exchange.Outcome.ToString())</strong> · Getter evidence only; the separate contrast experiment is below.</p>
                    @if (latest is not null)
                    {
                        <p>@latest.Exchange.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz") · @latest.Label · @latest.Exchange.DurationMilliseconds ms</p>
                        <p>@latest.Exchange.Message</p>
                        @if (latest.Exchange.IsSuccess && latest.Exchange.Result is { } result)
                        {
                            @if (result.Count == 0) { <p>No fields returned. This does not establish any setting's availability.</p> }
                            <div class="ip-table-scroll">
                                <table>
                                    <thead><tr><th>Reported field</th><th>This response (raw JSON)</th><th>Previous successful response</th></tr></thead>
                                    <tbody>
                                        @foreach (var key in result.Select(pair => pair.Key).Union(previous?.Exchange.Result?.Select(pair => pair.Key) ?? []).Order(StringComparer.Ordinal))
                                        {
                                            var currentValue = FieldValue(result, key);
                                            var previousValue = FieldValue(previous?.Exchange.Result, key);
                                            <tr><th>@key</th><td>@currentValue @if (previous is not null && currentValue != previousValue) { <strong> · changed</strong> }</td><td>@previousValue</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (previous is not null) { <p>Compared with @previous.Label at @previous.Exchange.Timestamp.ToLocalTime().ToString("HH:mm:ss"). Missing fields are not carried forward.</p> }
                        }
                        else if (previous is not null)
                        {
                            <p>Prior success at @previous.Exchange.Timestamp.ToLocalTime().ToString("HH:mm:ss") is stale. No current values are available from this attempt.</p>
                        }
                    }
                </article>
            }
        </div>
    </section>

    <section class="panel ip-step" id="contrast-test">
        <h2>4. Guided contrast test</h2>
        <p>One experiment only: read the current contrast, lower it by <strong>1</strong>, check it, then restore the original. Support must be verified on each display. No other setting or navigation key is sent.</p>
        <p><strong>Keep the TV/input, picture mode, and external signal unchanged until restoration is confirmed.</strong> The app checks reported input/mode and other returned video fields; it cannot detect every signal condition or prevent changes made with another remote.</p>
        <div class="ip-actions">
            <button class="primary-action" @onclick="PrepareContrastAsync" disabled="@(!CanRead || PendingContrast)">Prepare contrast test (read only)</button>
            <button class="toolbar-button" @onclick="IpRemoteController.Cancel" disabled="@(!Snapshot.IsBusy)">Stop requests</button>
        </div>
        @if (!CanRead && ReadDisabledReason is { } testReason) { <p class="ip-read-blocked">@testReason</p> }
        @if (Snapshot.ContrastTest is { } test)
        {
            <div class="ip-contrast-result @(test.Verified ? "success" : test.RequiresRecovery ? "failure" : "")" role="status" aria-live="polite">
                <strong>@test.Stage · @(test.Verified ? "Passed in this saved context" : "Not verified")</strong>
                <p>@test.Message</p>
                <p><strong>Test display:</strong> @test.Profile.Model · firmware @test.Profile.Firmware · @test.Profile.Endpoint<br />
                    <strong>Reported conditions:</strong> @test.ReportedInput · @test.ReportedPictureMode<br />
                    <strong>Annotated signal:</strong> @test.Profile.Signal</p>
                <div class="ip-contrast-values"><span>Original <strong>@test.Original</strong></span><span>Test target <strong>@test.Target</strong></span><span>Last readback <strong>@test.LastReadback</strong></span></div>
                <p>Change readback: @(test.ChangeReadbackConfirmed ? "matched" : "not confirmed") · Visual check: @(test.VisualConfirmed is true ? "passed" : test.VisualConfirmed is false ? "failed" : "not confirmed") · Restoration readback: @(test.RestorationConfirmed ? "matched" : "not confirmed")</p>
            </div>
            @if (test.Stage == IpRemoteContrastStage.Prepared)
            {
                <label class="ip-check"><input type="checkbox" aria-label="Confirm contrast test conditions" @bind="ContrastConditionsConfirmed" disabled="@Snapshot.IsBusy" />
                    I checked Contrast on this TV: it is @test.Original, @test.Target is a valid one-step-lower value, and the displayed input/mode/signal conditions will remain unchanged.</label>
                <p>The baseline expires after two minutes. Confirm against the TV's actual range; the historical protocol limit of 100 is not this TV's slider maximum.</p>
                <button class="primary-action" @onclick="() => ApplyContrastAsync(test)" disabled="@(!CanRead || !ContrastConditionsConfirmed || test.Profile != Snapshot.ActiveProfile)">Apply one-step contrast test…</button>
            }
            @if (test.Stage == IpRemoteContrastStage.AwaitingVisualCheck)
            {
                <p><strong>Check the actual Contrast number on the TV: is it @test.Target?</strong> Use the physical remote to inspect it if needed, without changing its value, input, or picture mode. Both choices below restore @test.Original and read it back.</p>
                <div class="ip-actions">
                    <button class="primary-action" @onclick="() => RestoreContrastAsync(test, true)" disabled="@(!CanRead)">Matches — restore original</button>
                    <button class="toolbar-button" @onclick="() => RestoreContrastAsync(test, false)" disabled="@(!CanRead)">Does not match — restore original</button>
                </div>
            }
            @if (test.RequiresRecovery)
            {
                <p><strong>If stopped or interrupted:</strong> a write may already have reached the TV. There is no automatic retry or undo. Recovery reads first and only writes the original if it still sees the test target in the same context. A previously attempted restoration is never sent twice.</p>
                <div class="ip-actions">
                    @if (test.Stage != IpRemoteContrastStage.AwaitingVisualCheck)
                    {
                        <button class="primary-action" @onclick="() => RestoreContrastAsync(test, null)" disabled="@(!CanRead || test.Profile != Snapshot.ActiveProfile)">Check and restore original…</button>
                    }
                    <button class="toolbar-button" @onclick="() => CloseContrastAsync(test)" disabled="@Snapshot.IsBusy">I restored manually — close test…</button>
                </div>
            }
        }
        <p>The recovery record survives app restarts. Startup sends no requests and never resumes a write. A passed test applies only to this display and saved conditions; it does not enable other controls or update existing calibration/menu verification.</p>
    </section>

    <section class="panel ip-step">
        <h2>Share the evidence</h2>
        <p>Download the report after testing each display. It includes the last 100 observations across this session, labeled contexts, errors, and redacted request/response JSON. Tokens can never be revealed. Review the file before sharing; model names and free-text annotations remain visible.</p>
        <label class="ip-check"><input type="checkbox" @bind="RedactIdentifiers" /> Redact IP, MAC, and UUID identifiers in the downloaded report</label>
        <label class="ip-check"><input type="checkbox" aria-label="Redact certificate SHA-256 fingerprints" @bind="RedactCertificateFingerprints" /> Redact certificate SHA-256 fingerprints in the downloaded report</label>
        <p>Both export redactions default to on. Saved certificate pins and the local diagnostic log are unchanged; tokens are always redacted.</p>
        <button class="toolbar-button" @onclick="ExportAsync" disabled="@((Snapshot.Observations.Count == 0 && Snapshot.ContrastTest is null) || Snapshot.IsBusy)">Download diagnostic report</button>
        <details>
            <summary>Request / response history (@Snapshot.Observations.Count)</summary>
            @foreach (var observation in Snapshot.Observations.Reverse())
            {
                <details class="ip-exchange">
                    <summary>@observation.Exchange.Timestamp.ToLocalTime().ToString("HH:mm:ss") · @observation.UserEnteredContext.Model · @observation.Label · @observation.Exchange.Method · @observation.Exchange.Outcome</summary>
                    <p>@observation.Exchange.Endpoint · HTTP @(observation.Exchange.HttpStatus?.ToString() ?? "no reply") · RPC @(observation.Exchange.RpcErrorCode?.ToString() ?? "no error code")</p>
                    <pre>@observation.Exchange.RequestJson</pre>
                    <pre>@(observation.Exchange.ResponseJson ?? "No response body received.")</pre>
                </details>
            }
        </details>
        <p>Session history starts empty after an app restart. The token-redacted append-only log remains in your personal data folder at <code>@IpRemoteController.DiagnosticLogPath</code>. That private log retains device identifiers and certificate fingerprints.</p>
    </section>
</div>

@code {
    private IpRemoteSnapshot Snapshot = new();
    private string Host = "", Model = "", Firmware = "", InputSource = "", PictureMode = "", Signal = "", CertificatePin = "";
    private string Label = "Baseline";
    private string? Error;
    private int Port = 1516, ReadTimeoutSeconds = 10, PairingTimeoutSeconds = 60;
    private bool AllowUntrustedCertificate, RedactIdentifiers = true, RedactCertificateFingerprints = true;
    private bool ContrastConditionsConfirmed;
    private bool PendingContrast => Snapshot.ContrastTest?.RequiresRecovery == true;
    private bool IsSaved => Snapshot.ActiveProfile == Draft;
    private bool CanAct => Snapshot.Initialized && IsSaved && !Snapshot.IsBusy;
    private bool CanRead => ReadDisabledReason is null;
    private string? ReadDisabledReason => !Snapshot.Initialized ? "Load the IP Remote profiles first."
        : !IsSaved ? "Save the IP Remote profile or discard its unsaved edits first."
        : Snapshot.IsBusy ? "An IP Remote request is still running. Wait for it to finish or select Cancel request."
        : Snapshot.AuthorizationRejected ? "The TV rejected authorization. Pair again explicitly when ready."
        : !Snapshot.HasToken ? "Pairing has not saved an IP Remote token. Complete pairing in step 2; accepting on the TV must also return a valid response to the app."
        : null;
    private SamsungIpRemoteExchange? LatestPairing => Snapshot.Observations.LastOrDefault(item =>
        item.UserEnteredContext.Endpoint == Snapshot.ActiveProfile?.Endpoint && item.Exchange.Method == "createAccessToken")?.Exchange;
    private string TokenStatus => Snapshot.AuthorizationRejected ? "Authorization rejected — pair again explicitly when ready"
        : Snapshot.HasToken ? "Separate IP Remote token saved — reachability not continuously monitored" : "No IP Remote token saved for this endpoint";
    private IEnumerable<IpRemoteObservation> ContextObservations => Snapshot.Observations.Where(item => item.UserEnteredContext.ContextKey == Snapshot.ActiveProfile?.ContextKey);
    private string? LatestCertificate => Snapshot.Observations.LastOrDefault(item => item.UserEnteredContext.Endpoint == Snapshot.ActiveProfile?.Endpoint
        && item.Exchange.ObservedCertificateSha256 is not null)?.Exchange.ObservedCertificateSha256;
    private IpRemoteProfile Draft => new()
    {
        Connection = new SamsungIpRemoteOptions { Host = Host.Trim(), Port = Port, AllowUntrustedCertificate = AllowUntrustedCertificate,
            CertificateSha256 = string.IsNullOrWhiteSpace(CertificatePin) ? null : CertificatePin.Trim(),
            RequestTimeout = TimeSpan.FromSeconds(ReadTimeoutSeconds), PairingTimeout = TimeSpan.FromSeconds(PairingTimeoutSeconds) },
        Model = Model.Trim(), Firmware = Firmware.Trim(), InputSource = InputSource.Trim(), PictureMode = PictureMode.Trim(), Signal = Signal.Trim()
    };

    protected override async Task OnInitializedAsync()
    {
        IpRemoteController.Changed += Refresh;
        await InitializeAsync();
    }
    private Task InitializeAsync() => GuardAsync(async () => { await IpRemoteController.InitializeAsync(); LoadActiveProfile(); });
    private void Refresh() => _ = InvokeAsync(() =>
    {
        var updated = IpRemoteController.GetSnapshot();
        if (updated.ContrastTest?.Id != Snapshot.ContrastTest?.Id || updated.ActiveProfile != Snapshot.ActiveProfile)
            ContrastConditionsConfirmed = false;
        Snapshot = updated;
        StateHasChanged();
    });
    private void LoadActiveProfile()
    {
        Snapshot = IpRemoteController.GetSnapshot();
        SetDraft(Snapshot.ActiveProfile ?? new());
    }
    private void NewProfile() { Error = null; SetDraft(new()); }
    private void SetDraft(IpRemoteProfile profile)
    {
        Host = profile.Connection.Host; Port = profile.Connection.Port;
        AllowUntrustedCertificate = profile.Connection.AllowUntrustedCertificate;
        CertificatePin = profile.Connection.CertificateSha256 ?? "";
        ReadTimeoutSeconds = (int)profile.Connection.RequestTimeout.TotalSeconds;
        PairingTimeoutSeconds = (int)profile.Connection.PairingTimeout.TotalSeconds;
        Model = profile.Model; Firmware = profile.Firmware; InputSource = profile.InputSource; PictureMode = profile.PictureMode; Signal = profile.Signal;
    }
    private Task SelectProfileAsync(ChangeEventArgs args) => GuardAsync(async () =>
    { await IpRemoteController.SelectProfileAsync(args.Value?.ToString() ?? ""); LoadActiveProfile(); });
    private Task SaveAsync() => GuardAsync(async () => { await IpRemoteController.SaveProfileAsync(Draft); LoadActiveProfile(); });
    private Task PairAsync() => GuardAsync(async () =>
    {
        if (!Snapshot.HasToken || await JavaScript.InvokeAsync<bool>("confirm", "Request a new IP Remote token? Watch for the TV approval prompt. The existing token will be kept unless a new one is successfully saved."))
            await IpRemoteController.PairAsync();
    });
    private Task ForgetAsync() => GuardAsync(async () =>
    {
        if (await JavaScript.InvokeAsync<bool>("confirm", "Forget only this endpoint's local IP Remote token? This does not revoke it on the TV or change the WebSocket remote token."))
            await IpRemoteController.ForgetTokenAsync();
    });
    private Task ReadBothAsync() => GuardAsync(() => IpRemoteController.ReadBothAsync(Label));
    private Task ReadAsync(string method) => GuardAsync(() => IpRemoteController.ReadAsync(method, Label));
    private Task PrepareContrastAsync() => GuardAsync(async () =>
    {
        ContrastConditionsConfirmed = false;
        await IpRemoteController.PrepareContrastTestAsync();
    });
    private Task ApplyContrastAsync(IpRemoteContrastTest test) => GuardAsync(async () =>
    {
        if (CanRead && ContrastConditionsConfirmed && await JavaScript.InvokeAsync<bool>("confirm",
            $"Change Contrast on {test.Profile.Model} from {test.Original} to {test.Target} once? Keep input, picture mode, and signal unchanged. After checking the TV, select a visual result to restore {test.Original}. Stop requests does NOT undo a write."))
            await IpRemoteController.ApplyContrastTestAsync(test.Id, ContrastConditionsConfirmed);
    });
    private Task RestoreContrastAsync(IpRemoteContrastTest test, bool? visual) => GuardAsync(async () =>
    {
        if (CanRead && (visual is not null || await JavaScript.InvokeAsync<bool>("confirm",
            $"Confirm you are back on {test.Profile.Model}, {test.ReportedInput}, {test.ReportedPictureMode}, signal {test.Profile.Signal}. Read first, then restore Contrast to {test.Original} only if it still equals {test.Target}?")))
            await IpRemoteController.RestoreContrastTestAsync(test.Id, visual);
    });
    private Task CloseContrastAsync(IpRemoteContrastTest test) => GuardAsync(async () =>
    {
        if (await JavaScript.InvokeAsync<bool>("confirm",
            $"Have you manually restored Contrast to {test.Original} on {test.Profile.Model} in the original input/mode/signal context? Closing sends no request and does NOT mark the test verified."))
            await IpRemoteController.CloseManuallyRestoredContrastTestAsync(test.Id);
    });
    private Task ExportAsync() => GuardAsync(async () => await JavaScript.InvokeVoidAsync("samsungController.downloadText",
        $"samsung-ip-remote-{DateTime.Now:yyyyMMdd-HHmmss}.json", IpRemoteController.ExportReport(RedactIdentifiers, RedactCertificateFingerprints)));
    private static string FieldValue(JsonObject? result, string key) => result is not null && result.TryGetPropertyValue(key, out var value)
        ? value?.ToJsonString() ?? "null" : "Not reported";
    private async Task GuardAsync(Func<Task> action)
    {
        Error = null;
        try { await action(); }
        catch (ArgumentException exception) { Error = exception.Message; }
        catch (InvalidOperationException exception) { Error = exception.Message; }
        catch (OperationCanceledException) { Error = "Request canceled. No automatic retry was attempted."; }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or JsonException)
        { Error = "Could not read or save the separate IP Remote files. Check personal data folder permissions and profiles.json / contrast-test.json formatting. Do not discard an unresolved contrast recovery record before checking the TV. Existing remote files were not changed."; }
        finally { Snapshot = IpRemoteController.GetSnapshot(); }
    }
    public void Dispose() => IpRemoteController.Changed -= Refresh;
}
