@page "/protocol"
@implements IDisposable
@inject SamsungControllerService Controller
@inject IJSRuntime JavaScript

<PageTitle>Protocol · SamsungController</PageTitle>

<section class="page-heading compact-heading protocol-heading">
    <div>
        <span class="eyebrow">PROTOCOL CONSOLE</span>
        <h1>Every message, in the open.</h1>
        <p>Inspect the live WebSocket exchange. Pairing tokens are redacted unless you explicitly reveal them.</p>
    </div>
    <div class="capture-count"><strong>@Messages.Count</strong><span>messages retained</span></div>
</section>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="notice danger" role="alert"><strong>Protocol action failed</strong><span>@ErrorMessage</span></div>
}

<section class="protocol-layout">
    <div class="panel protocol-panel">
        <div class="protocol-toolbar">
            <input class="search-input" @bind="Search" @bind:event="oninput" placeholder="Search channel, event, or payload" aria-label="Search protocol messages" />
            <select class="direction-filter" @bind="DirectionFilter" aria-label="Direction filter">
                <option value="All">RX + TX</option>
                <option value="Rx">RX only</option>
                <option value="Tx">TX only</option>
            </select>
            <button class="toolbar-button" @onclick="ExportAsync" disabled="@(FilteredMessages.Count == 0)">Export view</button>
            <button class="toolbar-button" @onclick="Controller.ClearMessages" disabled="@(Messages.Count == 0)">Clear</button>
        </div>

        <div class="sensitive-row">
            <label><input type="checkbox" @bind="RevealSensitive" /> Reveal pairing tokens in this browser</label>
            <span>Full capture: @Snapshot.ProtocolLogPath</span>
        </div>

        <div class="message-list">
            @if (FilteredMessages.Count == 0)
            {
                <div class="panel-empty">
                    <strong>@(Messages.Count == 0 ? "Listening for traffic" : "No matching messages")</strong>
                    <span>@(Messages.Count == 0 ? "Connect or send a key to populate the console." : "Adjust the search or direction filter.")</span>
                </div>
            }
            @foreach (var message in FilteredMessages)
            {
                <article class="message-card @message.Direction.ToString().ToLowerInvariant()">
                    <header>
                        <span class="direction-tag">@message.Direction</span>
                        <strong>@(message.Event ?? message.Channel)</strong>
                        <small>@message.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff", CultureInfo.InvariantCulture)</small>
                        <button title="Copy formatted payload" @onclick="() => CopyAsync(message)">Copy</button>
                    </header>
                    <div class="message-meta">@message.Channel · generation @message.ConnectionGeneration</div>
                    <pre>@ProtocolMessageFormatter.Format(message, RevealSensitive)</pre>
                    @if (!string.IsNullOrWhiteSpace(message.ParseError))
                    {
                        <div class="parse-error">@message.ParseError</div>
                    }
                </article>
            }
        </div>
    </div>

    <aside class="protocol-side-stack">
        <section class="panel research-panel">
            <div class="panel-label"><span>RESEARCH QUERIES</span><span>READ ONLY</span></div>
            <p>Send known application-list queries. Firmware support varies; any response appears in the captured message stream.</p>
            <button class="research-query" @onclick="SendEdenQueryAsync" disabled="@(!CanSendQuery)">
                <span><strong>Eden applications</strong><code>ed.edenApp.get</code></span><b>Send →</b>
            </button>
            <button class="research-query" @onclick="SendInstalledQueryAsync" disabled="@(!CanSendQuery)">
                <span><strong>Installed applications</strong><code>ed.installedApp.get</code></span><b>Send →</b>
            </button>
            @if (!string.IsNullOrWhiteSpace(ResearchStatus))
            {
                <div class="research-status" role="status">@ResearchStatus</div>
            }
            <small>Experimental read/query envelopes only. No setting writes are included.</small>

            <div class="device-probe">
                <div class="device-probe-heading"><strong>Device information</strong><code>GET /api/v2/</code></div>
                <p>Label the TV state, then capture it. This also works while the WebSocket is disconnected so standby failures can be recorded.</p>
                <label><span>State label</span><input @bind="DeviceInfoLabel" placeholder="Powered on · Home" disabled="@DeviceInfo.IsQuerying" /></label>
                <button class="research-query" @onclick="ProbeDeviceInfoAsync" disabled="@(!CanProbeDeviceInfo)">
                    <span><strong>@(DeviceInfo.IsQuerying ? "Probing…" : "Capture device state")</strong><code>@DeviceInfoEndpoint</code></span><b>GET →</b>
                </button>
            </div>
        </section>

        <section class="panel raw-panel">
            <div class="panel-label"><span>RAW SENDER</span><span>DEVELOPER</span></div>
            <label class="developer-toggle"><input type="checkbox" @bind="DeveloperMode" /> Enable raw JSON sender</label>
            <p>Raw protocol messages can change device state. The sender remains locked until developer mode is enabled.</p>
            <textarea @bind="RawPayload" rows="13" spellcheck="false" disabled="@(!DeveloperMode)" aria-label="Raw JSON payload"></textarea>
            <button class="primary-action" @onclick="SendRawAsync" disabled="@(!CanSendRaw)">Send raw JSON <span>→</span></button>
        </section>
    </aside>
</section>

@if (DeviceInfo.Observations.Count > 0)
{
    <section class="panel device-observations-panel">
        <div class="panel-label">
            <span>DEVICE STATE SNAPSHOTS</span>
            <span>@DeviceInfo.Observations.Count / 20 RETAINED</span>
        </div>
        <div class="device-observation-toolbar">
            <p>Compare labeled responses across applications and power states. Successful responses also appear in the protocol stream and complete NDJSON capture.</p>
            <div>
                <button class="toolbar-button" @onclick="ExportDeviceInfoAsync">Export snapshots</button>
                <button class="toolbar-button" @onclick="Controller.ClearDeviceInfoObservations">Clear snapshots</button>
            </div>
        </div>
        <div class="device-observation-list">
            @foreach (var observation in DeviceInfo.Observations.Reverse())
            {
                <article class="device-observation-card @(observation.IsSuccess ? "success" : "failed")">
                    <header>
                        <strong>@observation.Label</strong>
                        <span>@(observation.StatusCode is null ? "NO RESPONSE" : $"HTTP {observation.StatusCode}")</span>
                        <small>@observation.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff", CultureInfo.InvariantCulture)</small>
                    </header>
                    <div class="message-meta">@observation.Endpoint</div>
                    @if (!string.IsNullOrWhiteSpace(observation.Error))
                    {
                        <div class="device-observation-error">@observation.Error</div>
                    }
                    else
                    {
                        <pre>@FormatDeviceInfo(observation.RawContent)</pre>
                        @if (!string.IsNullOrWhiteSpace(observation.ParseError))
                        {
                            <div class="parse-error">Response was not JSON: @observation.ParseError</div>
                        }
                    }
                </article>
            }
        </div>
    </section>
}

@code {
    private static readonly JsonSerializerOptions PrettyJson = new() { WriteIndented = true };
    private ControllerSnapshot Snapshot { get; set; } = null!;
    private DeviceInfoSnapshot DeviceInfo { get; set; } = null!;
    private IReadOnlyList<SamsungMessage> Messages { get; set; } = [];
    private string Search { get; set; } = string.Empty;
    private string DirectionFilter { get; set; } = "All";
    private bool RevealSensitive { get; set; }
    private bool DeveloperMode { get; set; }
    private bool IsSending { get; set; }
    private bool IsQuerying { get; set; }
    private string RawPayload { get; set; } = "{\n  \"method\": \"ms.remote.control\"\n}";
    private string? ErrorMessage { get; set; }
    private string? ResearchStatus { get; set; }
    private string DeviceInfoLabel { get; set; } = "Powered on";

    private bool CanSendRaw => DeveloperMode && !IsSending &&
        Snapshot.ConnectionState == SamsungConnectionState.Connected &&
        !Snapshot.MacroRunning && !Snapshot.NavigationRunning &&
        !string.IsNullOrWhiteSpace(RawPayload);
    private bool CanSendQuery => !IsQuerying && !IsSending &&
        !DeviceInfo.IsQuerying &&
        Snapshot.ConnectionState == SamsungConnectionState.Connected &&
        !Snapshot.MacroRunning && !Snapshot.NavigationRunning;
    private bool CanProbeDeviceInfo => !IsQuerying && !IsSending &&
        !DeviceInfo.IsQuerying && !string.IsNullOrWhiteSpace(Snapshot.Host) &&
        !Snapshot.MacroRunning && !Snapshot.NavigationRunning;
    private string DeviceInfoEndpoint => string.IsNullOrWhiteSpace(Snapshot.Host)
        ? "Configure a TV host first"
        : $"{(Snapshot.Secure ? "https" : "http")}://{Snapshot.Host}:{Snapshot.Port ?? (Snapshot.Secure ? 8002 : 8001)}/api/v2/";

    private IReadOnlyList<SamsungMessage> FilteredMessages => Messages
        .Where(message => DirectionFilter == "All" || message.Direction.ToString() == DirectionFilter)
        .Where(message => string.IsNullOrWhiteSpace(Search) || MatchesSearch(message, Search))
        .Reverse()
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        Snapshot = Controller.GetSnapshot();
        DeviceInfo = Controller.GetDeviceInfoSnapshot();
        Messages = Controller.GetMessages();
        Controller.Changed += HandleControllerChanged;
        await Controller.InitializeAsync();
        Refresh();
    }

    private bool MatchesSearch(SamsungMessage message, string query) =>
        message.Channel.Contains(query, StringComparison.OrdinalIgnoreCase) ||
        (message.Event?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false) ||
        ProtocolMessageFormatter.Format(message, RevealSensitive).Contains(query, StringComparison.OrdinalIgnoreCase);

    private async Task CopyAsync(SamsungMessage message)
    {
        ErrorMessage = null;
        try
        {
            await JavaScript.InvokeVoidAsync("samsungController.copyText", ProtocolMessageFormatter.Format(message, RevealSensitive));
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
    }

    private async Task ExportAsync()
    {
        ErrorMessage = null;
        try
        {
            var lines = FilteredMessages.Select(message =>
                $"[{message.Timestamp:O}] {message.Direction} {message.Channel} {message.Event}\n{ProtocolMessageFormatter.Format(message, RevealSensitive)}");
            var capture = string.Join("\n\n", lines);
            var fileName = $"samsung-protocol-{DateTimeOffset.Now:yyyyMMdd-HHmmss}.txt";
            await JavaScript.InvokeVoidAsync("samsungController.downloadText", fileName, capture);
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
    }

    private async Task SendRawAsync()
    {
        IsSending = true;
        ErrorMessage = null;
        try
        {
            await Controller.SendRawAsync(RawPayload);
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSending = false;
        }
    }

    private async Task SendQueryAsync(SamsungQuery query, string label)
    {
        IsQuerying = true;
        ErrorMessage = null;
        ResearchStatus = null;
        try
        {
            await Controller.SendQueryAsync(query);
            ResearchStatus = $"{label} query sent · inspect RX messages for the response";
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsQuerying = false;
        }
    }

    private Task SendEdenQueryAsync() =>
        SendQueryAsync(SamsungQuery.EdenApplications, "Eden applications");

    private Task SendInstalledQueryAsync() =>
        SendQueryAsync(SamsungQuery.InstalledApplications, "Installed applications");

    private async Task ProbeDeviceInfoAsync()
    {
        ErrorMessage = null;
        ResearchStatus = null;
        try
        {
            var observation = await Controller.ProbeDeviceInfoAsync(DeviceInfoLabel);
            ResearchStatus = observation.Error is null
                ? $"Captured {observation.Label} · HTTP {observation.StatusCode}"
                : $"Captured {observation.Label} · no response";
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
    }

    private async Task ExportDeviceInfoAsync()
    {
        ErrorMessage = null;
        try
        {
            var export = JsonSerializer.Serialize(
                DeviceInfo.Observations.Select(observation => new
                {
                    observation.Timestamp,
                    observation.Label,
                    observation.Endpoint,
                    observation.StatusCode,
                    observation.IsSuccess,
                    Response = FormatDeviceInfo(observation.RawContent),
                    observation.ParseError,
                    observation.Error
                }),
                PrettyJson);
            var fileName = $"samsung-device-info-{DateTimeOffset.Now:yyyyMMdd-HHmmss}.json";
            await JavaScript.InvokeVoidAsync("samsungController.downloadText", fileName, export);
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
    }

    private string FormatDeviceInfo(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return "(empty response)";
        }

        return ProtocolMessageFormatter.FormatJson(content, RevealSensitive);
    }

    private void HandleControllerChanged()
    {
        Refresh();
        _ = InvokeAsync(StateHasChanged);
    }

    private void Refresh()
    {
        Snapshot = Controller.GetSnapshot();
        DeviceInfo = Controller.GetDeviceInfoSnapshot();
        Messages = Controller.GetMessages();
    }

    public void Dispose()
    {
        Controller.Changed -= HandleControllerChanged;
    }
}
