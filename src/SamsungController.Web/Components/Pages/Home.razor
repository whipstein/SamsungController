@page "/"
@implements IDisposable
@inject SamsungControllerService Controller
@inject NavigationManager PageNavigation

<PageTitle>Connection · SamsungController</PageTitle>

<section class="page-heading compact-heading">
    <div>
        <span class="eyebrow">CONNECTION</span>
        <h1>Choose your display.</h1>
        <p>Open a saved display and menu together, or set up a new combination.</p>
    </div>
    <div class="page-heading-actions">
        <HelpBubble Title="Choose or create a display/menu combination" ButtonText="Page help">
            <p><strong>Use saved combination</strong> restores the display's connection settings, menu file, and menu layout. Choose a combination, then connect.</p>
            <p><strong>Create new combination</strong> guides you through the display name, address, and menu. Use an existing menu file or start a new menu for your TV model and firmware.</p>
            <p><strong>Edit combination</strong> changes the selected display's settings. Choosing another menu or layout adds a saved combination for that display. Existing menu links remain available.</p>
            <p>Setup changes take effect when you save. Cancel discards the form. Menu files stay where they are referenced; display verification stays in your personal data folder.</p>
            <p>Keep the recommended connection defaults. On first connection, watch the TV and select <strong>Allow</strong> when prompted.</p>
        </HelpBubble>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="notice danger" role="alert"><strong>Needs attention</strong><span>@ErrorMessage</span></div>
}
else if (Snapshot.ConnectionState == SamsungConnectionState.Pairing)
{
    <div class="notice pairing" role="status"><strong>Approval needed</strong><span>Select Allow on the TV. Pairing will continue automatically.</span></div>
}
else if (Snapshot.ConnectionState == SamsungConnectionState.Warming)
{
    <div class="notice pairing" role="status"><strong>Warming TV</strong><span>The connection is authorized. Commands wait briefly for the TV to be ready.</span></div>
}
else if (!string.IsNullOrWhiteSpace(LocalStatus))
{
    <div class="notice" role="status"><strong>Display and menu</strong><span>@LocalStatus</span></div>
}

<div class="connection-workspace">
    <nav class="connection-mode-picker" aria-label="Display setup options">
        <button type="button" class="@(Mode == ConnectionPageMode.Saved ? "active" : "")"
                aria-pressed="@(Mode == ConnectionPageMode.Saved)" @onclick="CancelSetup" disabled="@ControlsBusy">
            <strong>Use saved combination</strong><span>Choose a display and menu, then connect.</span>
        </button>
        <button type="button" class="@(Mode == ConnectionPageMode.Create ? "active" : "")"
                aria-pressed="@(Mode == ConnectionPageMode.Create)" @onclick="BeginCreateAsync" disabled="@(ControlsBusy || CanDisconnect)">
            <strong>Create new combination</strong><span>Set up a display with an existing or new menu.</span>
        </button>
    </nav>

    @if (Mode == ConnectionPageMode.Saved)
    {
        <section class="panel saved-combination-panel">
            <div class="connection-section-heading">
                <div><h2>Saved combinations</h2><p>Each choice includes the display, menu, and saved layout.</p></div>
                <button type="button" class="secondary-action" @onclick="RefreshCatalogsAsync" disabled="@ControlsBusy">Refresh list</button>
            </div>
            @if (SavedCombinations.Count == 0)
            {
                <div class="connection-empty-state">
                    <strong>No saved combinations yet.</strong>
                    <p>Choose Create new combination above to enter your TV address and select or define its menu.</p>
                </div>
            }
            else
            {
                <label class="saved-combination-selector">
                    <span>Display / menu combination</span>
                    <select value="@ActiveCombinationKey" @onchange="ChangeCombinationAsync" disabled="@(ControlsBusy || CanDisconnect)" aria-label="Saved combination">
                        @if (ActiveCombination is null)
                        {
                            <option value="">Choose a saved combination…</option>
                        }
                        @foreach (var combination in SavedCombinations)
                        {
                            <option value="@combination.Key">@combination.Label</option>
                        }
                    </select>
                </label>
            }
            @if (ActiveCombination is { } active)
            {
                <dl class="combination-summary">
                    <div><dt>Display</dt><dd>@active.Display.Name<small>@(Snapshot.Host ?? "Address needed — edit this combination")</small></dd></div>
                    <div><dt>Menu</dt><dd>@Navigation.DefinitionName<small>@ActiveMenuContext</small></dd></div>
                    <div><dt>Layout</dt><dd>@ActiveConfigurationName<small>@ActiveConfigurationConditions</small></dd></div>
                </dl>
                <div class="combination-actions">
                    @if (CanDisconnect)
                    {
                        <button type="button" class="secondary-action danger-action" @onclick="DisconnectAsync" disabled="@ControlsBusy">Disconnect</button>
                    }
                    else
                    {
                        <button type="button" class="primary-action" @onclick="ConnectAsync" disabled="@(ControlsBusy || string.IsNullOrWhiteSpace(Snapshot.Host))">
                            @(IsBusy ? "Connecting…" : "Connect to display") <span>→</span>
                        </button>
                    }
                    <button type="button" class="secondary-action" @onclick="BeginEditAsync" disabled="@(ControlsBusy || CanDisconnect)">Edit combination</button>
                </div>
                <p class="connection-hint">@ConnectionHint</p>
                <div class="combination-next-links">
                    <a href="menu">Open Menu →</a>
                    <a href="verification">Verify this display →</a>
                    <a href="menu/build">Build &amp; Verify →</a>
                </div>
            }
            else if (CanDisconnect)
            {
                <p class="connection-hint">Disconnect before selecting or creating a saved combination.</p>
                <button type="button" class="secondary-action danger-action" @onclick="DisconnectAsync" disabled="@ControlsBusy">Disconnect</button>
            }
            else if (SavedCombinations.Count > 0)
            {
                <p class="connection-hint">Choose a combination to load its settings. If your display is not listed, create a new combination.</p>
            }
        </section>
    }
    else
    {
        <section class="panel combination-setup-panel">
            <div class="connection-section-heading">
                <div>
                    <h2>@(Mode == ConnectionPageMode.Edit ? "Edit combination" : "Create new combination")</h2>
                    <p>Set the display, choose its menu, then save. Nothing in this form is applied before saving.</p>
                </div>
                <button type="button" class="secondary-action" @onclick="CancelSetup" disabled="@ControlsBusy">Cancel</button>
            </div>
            <fieldset class="combination-setup-step" disabled="@(ControlsBusy || CanDisconnect)">
                <legend><b>1</b> Display</legend>
                <div class="field-grid">
                    <label><span>Display name</span><input @bind="DisplayName" placeholder="e.g. Living room TV" aria-label="Display name" /></label>
                    <label><span>IP address</span><input @bind="Host" placeholder="192.0.2.10" aria-label="IP address" /></label>
                </div>
                <p class="connection-hint">Find the TV's address in its network settings. Use a distinct display name for each physical TV.</p>
            </fieldset>

            <fieldset class="combination-setup-step" disabled="@(ControlsBusy || CanDisconnect)">
                <legend><b>2</b> Menu</legend>
                <div class="menu-source-options" role="group" aria-label="Menu source">
                    <label><input type="radio" name="menu-source" checked="@(!CreateNewMenu)" @onchange="() => CreateNewMenu = false" /><span>Use an existing menu</span></label>
                    <label><input type="radio" name="menu-source" checked="@CreateNewMenu" @onchange="() => CreateNewMenu = true" /><span>Define a new menu</span></label>
                </div>
                @if (CreateNewMenu)
                {
                    <div class="field-grid">
                        <label><span>TV model number</span><input @bind="NewMenuModel" placeholder="e.g. S95F" /></label>
                        <label><span>Firmware version</span><input @bind="NewMenuFirmware" placeholder="e.g. 1296" /></label>
                        <label><span>Signal type</span><input @bind="NewMenuSignal" placeholder="Any, SDR, or HDR" /></label>
                        <label><span>Picture mode</span><input @bind="NewMenuPictureMode" placeholder="Any, or a specific mode" /></label>
                        <label><span>Input / source</span><input @bind="NewMenuInput" placeholder="Any, or e.g. HDMI 1" /></label>
                        <label><span>File format</span><select @bind="NewMenuFormat"><option value="@MenuDefinitionFileFormat.Yaml">YAML (default)</option><option value="@MenuDefinitionFileFormat.Json">JSON</option></select></label>
                    </div>
                    <p class="connection-hint">The menu name and filename are generated from the model, firmware, and any specific context. After saving, you'll continue to Build &amp; Verify to enter the menu tree.</p>
                }
                else
                {
                    <label>
                        <span>Menu definition</span>
                        <select value="@DraftMenuPath" @onchange="ChangeDraftMenuAsync" aria-label="Menu definition">
                            <option value="">Choose a menu file…</option>
                            @foreach (var menuEntry in MenuDefinitions.Where(item => item.IsValid))
                            {
                                <option value="@menuEntry.Path">@FormatMenuDefinition(menuEntry)</option>
                            }
                        </select>
                    </label>
                    @if (DraftMenu is { } menu)
                    {
                        <p class="connection-hint">@FormatMenuContext(menu.Model, menu.Context)</p>
                        <label class="draft-menu-layout">
                            <span>Menu layout</span>
                            <select @bind="DraftConfigurationId" aria-label="Menu layout">
                                @if (menu.Configurations.Count == 0)
                                {
                                    <option value="">Default layout</option>
                                }
                                @foreach (var configuration in menu.Configurations.Values)
                                {
                                    <option value="@configuration.Id">@configuration.Name</option>
                                }
                            </select>
                        </label>
                        <p class="connection-hint">@menu.Configurations.GetValueOrDefault(DraftConfigurationId)?.Conditions</p>
                    }
                    else
                    {
                        <p class="connection-hint">Menus are discovered from your personal data, repository, and installation folders. If none matches your TV, choose Define a new menu.</p>
                    }
                }
            </fieldset>

            <fieldset class="combination-setup-step" disabled="@(ControlsBusy || CanDisconnect)">
                <legend><b>3</b> Connection settings</legend>
                <p class="connection-hint">Recommended defaults work for most Samsung TVs. Expand only if you need to adjust them.</p>
                <details class="connection-advanced">
                    <summary>Advanced connection settings</summary>
                    <div class="connection-options">
                        <label class="toggle-row"><input type="checkbox" @bind="Secure" /> Secure WebSocket <small>Recommended</small></label>
                        <label class="toggle-row"><input type="checkbox" @bind="AllowUntrustedCertificate" /> Accept TV certificate <small>Local TV certificate</small></label>
                        <label class="toggle-row compact-option"><span>Port override</span><InputNumber @bind-Value="Port" min="1" max="65535" placeholder="Automatic" /></label>
                    </div>
                    <div class="field-grid">
                        <label><span>Health-check interval (seconds)</span><InputNumber @bind-Value="KeepAliveIntervalSeconds" min="5" max="120" /></label>
                        <label><span>Health-check timeout (seconds)</span><InputNumber @bind-Value="KeepAliveTimeoutSeconds" min="0" max="60" /></label>
                        <label><span>Post-connect warm-up (ms)</span><InputNumber @bind-Value="PostConnectWarmupMilliseconds" min="0" max="10000" step="100" /></label>
                        <label><span>Refresh channel after idle (seconds)</span><InputNumber @bind-Value="ReconnectAfterIdleSeconds" min="0" max="3600" step="30" /></label>
                    </div>
                    <p class="connection-hint">Set idle refresh to 0 to disable it. Set health-check timeout to 0 only if the TV does not answer WebSocket health checks.</p>
                    <label><span>Display file ID</span><input @bind="DisplayDefinitionId" placeholder="Generated from display name" disabled="@(Mode == ConnectionPageMode.Edit)" /></label>
                </details>
                @if (!ReadinessSettingsValid)
                {
                    <p class="connection-form-error" role="alert">Use a 5–120 second interval, a 0 or 2–60 second timeout no greater than the interval, a 0–10,000 ms warm-up, and a 0 or 30–3,600 second idle refresh.</p>
                }
            </fieldset>
            @if (PendingDisplayDefinitionReplacement is { } replacement)
            {
                <div class="definition-replacement-confirmation" role="alert">
                    <div><strong>A display with this ID already exists.</strong><p>Replace @Path.GetFileName(replacement.Path)? Its existing menu links will be retained.</p></div>
                    <div>
                        <button type="button" class="secondary-action" @onclick="() => PendingDisplayDefinitionReplacement = null" disabled="@ControlsBusy">Keep existing</button>
                        <button type="button" class="secondary-action danger-action" @onclick="() => SaveCombinationAsync(true)" disabled="@(ControlsBusy || CanDisconnect)">Replace and save</button>
                    </div>
                </div>
            }
            <div class="combination-actions setup-save-actions">
                <button type="button" class="primary-action" @onclick="() => SaveCombinationAsync()" disabled="@(ControlsBusy || CanDisconnect)">
                    @(IsBusy ? "Saving…" : CreateNewMenu ? "Save & define menu" : Mode == ConnectionPageMode.Edit ? "Save changes" : "Save combination") <span>→</span>
                </button>
                <button type="button" class="secondary-action" @onclick="CancelSetup" disabled="@ControlsBusy">Cancel</button>
            </div>
            @if (CanDisconnect)
            {
                <p class="connection-hint">Disconnect from the TV before saving setup changes.</p>
            }
        </section>
    }

    <details class="panel connection-diagnostics">
        <summary>Files and connection details
            @if (InvalidFileCount > 0)
            {
                <b>@InvalidFileCount file issue@(InvalidFileCount == 1 ? "" : "s")</b>
            }
        </summary>
        @if (InvalidFileCount > 0)
        {
            <div class="menu-definition-file-errors" role="alert">
                <strong>Files needing attention</strong>
                @foreach (var file in DisplayDefinitions.Where(item => !item.IsValid))
                {
                    <div><code>@Path.GetFileName(file.Path) · @file.Location</code><span>@file.Error</span></div>
                }
                @foreach (var file in MenuDefinitions.Where(item => !item.IsValid))
                {
                    <div><code>@Path.GetFileName(file.Path) · @file.Location</code><span>@file.Error</span></div>
                }
                <a href="menu/build">Inspect menu files in Build &amp; Verify →</a>
            </div>
        }
        <dl class="metric-list">
            <div><dt>Connection</dt><dd>@Snapshot.ConnectionState</dd></div>
            <div><dt>Transport</dt><dd>@(Snapshot.Secure ? "WSS" : "WS") : @(Snapshot.Port ?? (Snapshot.Secure ? 8002 : 8001))</dd></div>
            <div><dt>Authorization</dt><dd>@(Snapshot.HasToken ? "Token retained" : "Pair on connect")</dd></div>
            <div><dt>Warm-up</dt><dd>@Snapshot.PostConnectWarmupMilliseconds ms</dd></div>
        </dl>
        <p class="connection-file-path"><strong>Active menu file</strong><span>@Navigation.DefinitionPath</span></p>
        <div class="combination-actions">
            <button type="button" class="secondary-action" @onclick="ReloadMenuDefinitionAsync" disabled="@(ControlsBusy || Mode != ConnectionPageMode.Saved || string.IsNullOrWhiteSpace(Navigation.DefinitionPath))">Reload menu file</button>
            <button type="button" class="secondary-action" @onclick="RefreshCatalogsAsync" disabled="@ControlsBusy">Refresh file lists</button>
        </div>
    </details>
</div>

@code {
    private enum ConnectionPageMode { Saved, Create, Edit }

    private sealed record SavedCombination(DisplayDefinitionCatalogEntry Display, DisplayMenuReferenceSummary Menu)
    {
        public string Key => $"{Display.Path}|{Menu.Id}";
        public string Label => $"{Display.Name} — {Menu.MenuDefinitionName} · {Menu.MenuConfigurationId ?? "default"} · {Display.Location}";
    }

    private ConnectionPageMode Mode { get; set; } = ConnectionPageMode.Saved;
    private ControllerSnapshot Snapshot { get; set; } = null!;
    private MenuNavigationSnapshot Navigation { get; set; } = null!;
    private IReadOnlyList<MenuDefinitionCatalogEntry> MenuDefinitions { get; set; } = [];
    private IReadOnlyList<DisplayDefinitionCatalogEntry> DisplayDefinitions { get; set; } = [];
    private IReadOnlyList<SavedCombination> SavedCombinations => DisplayDefinitions
        .Where(display => display.IsValid)
        .SelectMany(display => display.Menus.Select(menu => new SavedCombination(display, menu)))
        .ToArray();
    private SavedCombination? ActiveCombination => SavedCombinations.FirstOrDefault(item =>
        string.Equals(item.Display.Path, Snapshot.DisplayDefinitionPath, StringComparison.OrdinalIgnoreCase)
        && string.Equals(item.Menu.ResolvedMenuDefinitionPath, Navigation.DefinitionPath, StringComparison.OrdinalIgnoreCase)
        && string.Equals(item.Menu.MenuConfigurationId, Navigation.ActiveConfigurationId, StringComparison.OrdinalIgnoreCase));
    private string ActiveCombinationKey => ActiveCombination?.Key ?? string.Empty;
    private string ActiveConfigurationName => Navigation.Configurations.FirstOrDefault(item => item.IsActive)?.Name ?? "Default";
    private string? ActiveConfigurationConditions => Navigation.Configurations.FirstOrDefault(item => item.IsActive)?.Conditions;
    private string ActiveMenuContext => Navigation.Context is null ? "No menu loaded" : FormatMenuContext(Navigation.Model, Navigation.Context);
    private int InvalidFileCount => DisplayDefinitions.Count(item => !item.IsValid) + MenuDefinitions.Count(item => !item.IsValid);
    private bool IsBusy { get; set; }
    private bool ControlsBusy => IsBusy || Snapshot.MacroRunning || Snapshot.NavigationRunning || Controller.GetMenuAuthoringSnapshot().IsRecording;
    private bool CanDisconnect => ConnectionStatePresentation.CanDisconnect(Snapshot.ConnectionState);
    private string? LocalError { get; set; }
    private string? LocalStatus { get; set; }
    private string? ErrorMessage => LocalError ?? Snapshot.LastError;
    private string ConnectionHint => CanDisconnect
        ? "Disconnect to change displays or edit this combination."
        : "On first connection, select Allow on the TV when prompted.";
    private string DisplayName { get; set; } = string.Empty;
    private string DisplayDefinitionId { get; set; } = string.Empty;
    private string Host { get; set; } = string.Empty;
    private bool Secure { get; set; } = true;
    private bool AllowUntrustedCertificate { get; set; } = true;
    private int? Port { get; set; }
    private int KeepAliveIntervalSeconds { get; set; } = 20;
    private int KeepAliveTimeoutSeconds { get; set; } = 10;
    private int PostConnectWarmupMilliseconds { get; set; } = 1500;
    private int ReconnectAfterIdleSeconds { get; set; } = 300;
    private string DraftMenuPath { get; set; } = string.Empty;
    private string DraftConfigurationId { get; set; } = string.Empty;
    private MenuDefinition? DraftMenu { get; set; }
    private bool CreateNewMenu { get; set; }
    private string NewMenuModel { get; set; } = string.Empty;
    private string NewMenuFirmware { get; set; } = string.Empty;
    private string NewMenuSignal { get; set; } = string.Empty;
    private string NewMenuPictureMode { get; set; } = string.Empty;
    private string NewMenuInput { get; set; } = string.Empty;
    private MenuDefinitionFileFormat NewMenuFormat { get; set; } = MenuDefinitionFileFormat.Yaml;
    private DisplayDefinitionSavePreview? PendingDisplayDefinitionReplacement { get; set; }
    private bool ReadinessSettingsValid => KeepAliveIntervalSeconds is >= 5 and <= 120
        && (KeepAliveTimeoutSeconds == 0 || KeepAliveTimeoutSeconds is >= 2 and <= 60)
        && KeepAliveTimeoutSeconds <= KeepAliveIntervalSeconds
        && PostConnectWarmupMilliseconds is >= 0 and <= 10_000
        && (ReconnectAfterIdleSeconds == 0 || ReconnectAfterIdleSeconds is >= 30 and <= 3600);

    protected override async Task OnInitializedAsync()
    {
        RefreshSnapshot();
        Controller.Changed += HandleControllerChanged;
        await Controller.InitializeAsync();
        await LoadCatalogsAsync();
    }

    private void RefreshSnapshot()
    {
        Snapshot = Controller.GetSnapshot();
        Navigation = Controller.GetMenuNavigationSnapshot();
    }

    private async Task LoadCatalogsAsync()
    {
        MenuDefinitions = await Controller.DiscoverMenuDefinitionsAsync();
        DisplayDefinitions = await Controller.DiscoverDisplayDefinitionsAsync();
        RefreshSnapshot();
    }

    private async Task RefreshCatalogsAsync() => await RunAsync(async () =>
    {
        await LoadCatalogsAsync();
        LocalStatus = "Saved combinations and menu file lists refreshed.";
    });

    private async Task ChangeCombinationAsync(ChangeEventArgs args)
    {
        var combination = SavedCombinations.FirstOrDefault(item => item.Key == args.Value?.ToString());
        if (combination is null || CanDisconnect)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await Controller.SetDisplayMenuReferenceAsync(combination.Display.Path, combination.Menu.Id);
            await LoadCatalogsAsync();
            LocalStatus = $"Loaded {combination.Display.Name} with {combination.Menu.MenuDefinitionName}. Ready to connect.";
        });
    }

    private async Task BeginCreateAsync()
    {
        if (CanDisconnect || ControlsBusy)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await LoadCatalogsAsync();
            ApplySnapshotToForm();
            if (Snapshot.DisplayDefinitionPath is not null)
            {
                DisplayName = string.Empty;
                Host = string.Empty;
                Secure = true;
                AllowUntrustedCertificate = true;
                Port = null;
                KeepAliveIntervalSeconds = 20;
                KeepAliveTimeoutSeconds = 10;
                PostConnectWarmupMilliseconds = 1500;
                ReconnectAfterIdleSeconds = 300;
            }

            DisplayDefinitionId = string.Empty;
            DraftMenuPath = string.Empty;
            DraftConfigurationId = string.Empty;
            DraftMenu = null;
            CreateNewMenu = false;
            NewMenuModel = NewMenuFirmware = NewMenuSignal = NewMenuPictureMode = NewMenuInput = string.Empty;
            NewMenuFormat = MenuDefinitionFileFormat.Yaml;
            PendingDisplayDefinitionReplacement = null;
            Mode = ConnectionPageMode.Create;
        });
    }

    private async Task BeginEditAsync()
    {
        if (CanDisconnect || ControlsBusy || ActiveCombination is not { } active)
        {
            return;
        }

        await RunAsync(async () =>
        {
            ApplySnapshotToForm();
            DisplayDefinitionId = active.Display.Id;
            CreateNewMenu = false;
            await LoadDraftMenuAsync(Navigation.DefinitionPath, Navigation.ActiveConfigurationId);
            PendingDisplayDefinitionReplacement = null;
            Mode = ConnectionPageMode.Edit;
        });
    }

    private void CancelSetup()
    {
        Mode = ConnectionPageMode.Saved;
        DraftMenu = null;
        PendingDisplayDefinitionReplacement = null;
        LocalError = LocalStatus = null;
    }

    private async Task ChangeDraftMenuAsync(ChangeEventArgs args) => await RunAsync(async () =>
    {
        PendingDisplayDefinitionReplacement = null;
        await LoadDraftMenuAsync(args.Value?.ToString() ?? string.Empty);
    });

    private async Task LoadDraftMenuAsync(string path, string? configurationId = null)
    {
        DraftMenuPath = path;
        DraftMenu = null;
        DraftConfigurationId = string.Empty;
        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        // Inspect the draft without activating it or changing the saved TV state.
        DraftMenu = await new MenuDefinitionParser().ParseFileAsync(path);
        DraftConfigurationId = configurationId is not null && DraftMenu.Configurations.ContainsKey(configurationId)
            ? configurationId
            : DraftMenu.ActiveConfigurationId ?? DraftMenu.Configurations.Keys.FirstOrDefault() ?? string.Empty;
    }

    private async Task SaveCombinationAsync(bool replaceExisting = false)
    {
        if (ControlsBusy || CanDisconnect)
        {
            return;
        }

        await RunAsync(async () =>
        {
            if (string.IsNullOrWhiteSpace(DisplayName) || string.IsNullOrWhiteSpace(Host))
            {
                throw new InvalidOperationException("Enter a display name and IP address in step 1.");
            }

            if (!ReadinessSettingsValid || Port is <= 0 or > 65_535)
            {
                throw new InvalidOperationException("Check the advanced connection settings in step 3. The port must be 1–65535 or automatic, and channel-readiness values must be within their allowed ranges.");
            }

            var newMenu = CreateNewMenu;
            MenuDefinitionCreationRequest? creation = null;
            MenuDefinitionCreationPreview? menuPreview = null;
            if (newMenu)
            {
                if (string.IsNullOrWhiteSpace(NewMenuModel) || string.IsNullOrWhiteSpace(NewMenuFirmware))
                {
                    throw new InvalidOperationException("Enter the TV model number and firmware version in step 2.");
                }

                creation = new MenuDefinitionCreationRequest(string.Empty, string.Empty, NewMenuModel,
                    NewMenuFirmware, NewMenuSignal, NewMenuPictureMode, NewMenuInput, NewMenuFormat);
                menuPreview = Controller.PreviewMenuDefinitionCreation(creation);
                if (menuPreview.FileExists)
                {
                    throw new InvalidOperationException($"A menu file named {Path.GetFileName(menuPreview.Path)} already exists. Choose Use an existing menu to link it, or change the model/firmware/context for a different menu.");
                }
            }
            else if (DraftMenu is null
                || (DraftMenu.Configurations.Count > 0 && !DraftMenu.Configurations.ContainsKey(DraftConfigurationId)))
            {
                throw new InvalidOperationException("Choose a menu definition and layout in step 2.");
            }

            var request = new DisplayDefinitionEditRequest(DisplayDefinitionId, DisplayName, Host, Secure, Port,
                AllowUntrustedCertificate, menuPreview?.Path ?? DraftMenuPath, menuPreview?.Id ?? DraftMenu!.Id,
                newMenu ? "default" : string.IsNullOrWhiteSpace(DraftConfigurationId) ? null : DraftConfigurationId,
                KeepAliveIntervalSeconds, KeepAliveTimeoutSeconds, PostConnectWarmupMilliseconds, ReconnectAfterIdleSeconds);
            var preview = Controller.PreviewDisplayDefinitionSave(request);
            if (preview.FileExists && (Mode == ConnectionPageMode.Create || !preview.IsActiveUserDefinition)
                && (!replaceExisting || PendingDisplayDefinitionReplacement?.Path != preview.Path))
            {
                PendingDisplayDefinitionReplacement = preview;
                return;
            }

            if (creation is not null)
            {
                await Controller.CreateMenuDefinitionAsync(creation);
                // Retain the created file as a draft if the display save needs to be retried.
                await LoadDraftMenuAsync(menuPreview!.Path, "default");
                CreateNewMenu = false;
            }

            var savedPath = await Controller.SaveDisplayDefinitionAsync(request, replaceExisting);
            await Controller.SetDisplayDefinitionAsync(savedPath);
            await LoadCatalogsAsync();
            PendingDisplayDefinitionReplacement = null;
            Mode = ConnectionPageMode.Saved;
            LocalStatus = $"Saved {DisplayName}. Select Connect to display when ready.";
            if (newMenu)
            {
                PageNavigation.NavigateTo("menu/build");
            }
        });
    }

    private async Task ConnectAsync() => await RunAsync(async () =>
    {
        // Connect using the selected combination, never an unsaved setup draft.
        RefreshSnapshot();
        await Controller.ConnectAsync(new TvConnectionRequest(Snapshot.DisplayName, Snapshot.Host ?? string.Empty,
            Snapshot.Secure, Snapshot.Port, Snapshot.AllowUntrustedCertificate,
            Snapshot.KeepAliveIntervalSeconds, Snapshot.KeepAliveTimeoutSeconds,
            Snapshot.PostConnectWarmupMilliseconds, Snapshot.ReconnectAfterIdleSeconds));
    });

    private async Task DisconnectAsync() => await RunAsync(() => Controller.DisconnectAsync());

    private async Task ReloadMenuDefinitionAsync() => await RunAsync(async () =>
    {
        await Controller.ReloadMenuDefinitionAsync();
        await LoadCatalogsAsync();
        LocalStatus = "Menu file reloaded. Routes and required verification checks are up to date.";
    });

    private async Task RunAsync(Func<Task> operation)
    {
        if (ControlsBusy)
        {
            return;
        }

        IsBusy = true;
        LocalError = LocalStatus = null;
        try
        {
            await operation();
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            RefreshSnapshot();
            IsBusy = false;
        }
    }

    private void ApplySnapshotToForm()
    {
        DisplayName = Snapshot.DisplayName;
        Host = Snapshot.Host ?? string.Empty;
        Secure = Snapshot.Secure;
        Port = Snapshot.Port;
        AllowUntrustedCertificate = Snapshot.AllowUntrustedCertificate;
        KeepAliveIntervalSeconds = Snapshot.KeepAliveIntervalSeconds;
        KeepAliveTimeoutSeconds = Snapshot.KeepAliveTimeoutSeconds;
        PostConnectWarmupMilliseconds = Snapshot.PostConnectWarmupMilliseconds;
        ReconnectAfterIdleSeconds = Snapshot.ReconnectAfterIdleSeconds;
    }

    private static string FormatMenuDefinition(MenuDefinitionCatalogEntry definition) =>
        $"{definition.Name} · {Path.GetFileName(definition.Path)} · {definition.Location}";

    private static string FormatMenuContext(string? model, MenuDefinitionContext context) =>
        $"{model} · firmware {context.Firmware} · {context.Signal} · {context.PictureMode} · {context.Input}";

    private void HandleControllerChanged() => _ = InvokeAsync(() =>
    {
        RefreshSnapshot();
        StateHasChanged();
    });

    public void Dispose() => Controller.Changed -= HandleControllerChanged;
}
