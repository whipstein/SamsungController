@page "/"
@implements IDisposable
@inject SamsungControllerService Controller

<PageTitle>Connection · SamsungController</PageTitle>

<section class="page-heading">
    <div>
        <span class="eyebrow">CONNECTION</span>
        <h1>Your display, one quiet connection away.</h1>
        <p>Pair once, retain the local token, and keep the control channel open while you work.</p>
    </div>
    <div class="page-heading-actions">
        <HelpBubble Title="Connect SamsungController to your TV" ButtonText="Page help">
            <ol>
                <li>Select a saved display definition, or enter a friendly display name and the TV's current IPv4 address.</li>
                <li>Keep <strong>Secure WebSocket</strong> and <strong>Accept TV certificate</strong> enabled for the usual port 8002 connection.</li>
                <li>Select <strong>Connect to display</strong>, then choose <strong>Allow</strong> on the TV when prompted.</li>
                <li>After the first approval, the saved host and token are reused by the web UI and CLI.</li>
                <li>Channel-readiness defaults verify the WebSocket and briefly warm the TV before its first command.</li>
                <li>Choose an automatically discovered menu structure and the configuration matching the rows currently visible on the TV. The list identifies active, user-data, repository, and installation copies separately.</li>
            </ol>
            <p class="help-callout safe">A successful connection may run the preferred verified anchor to establish a known menu position. This can send visible menu keys immediately after pairing.</p>
            <p>If no approval prompt appears, check the TV's Device Connect Manager and remove any denied or stale SamsungController entry before trying again.</p>
        </HelpBubble>
        <div class="state-orb @StateClass" aria-label="@Snapshot.ConnectionState">
            <span></span>
            <strong>@StateLabel</strong>
            <small>@StateDetail</small>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="notice danger" role="alert"><strong>@(Snapshot.ConnectionState == SamsungConnectionState.Connected ? "Connection warning" : "Connection error")</strong><span>@ErrorMessage</span></div>
}
else if (Snapshot.ConnectionState == SamsungConnectionState.Pairing)
{
    <div class="notice pairing" role="status"><strong>Approval needed</strong><span>Accept SamsungController on the TV. Pairing will continue automatically.</span></div>
}
else if (Snapshot.ConnectionState == SamsungConnectionState.Warming)
{
    <div class="notice pairing" role="status"><strong>Warming TV</strong><span>The channel is authorized. Commands remain held until the TV's remote service is ready.</span></div>
}
else if (!string.IsNullOrWhiteSpace(LocalStatus))
{
    <div class="notice" role="status"><strong>Display / menu profile</strong><span>@LocalStatus</span></div>
}

<section class="dashboard-grid">
    <div class="panel connection-panel">
        <div class="panel-label"><span>TV PROFILE</span><span>01</span></div>
        <div class="display-definition-picker">
            <div class="connection-menu-profile-heading">
                <span>DISPLAY DEFINITION</span>
                <small>Select once to restore the display, connection, menu, and layout together</small>
            </div>
            <div class="display-definition-controls">
                <label>
                    <span>Saved display</span>
                    <select value="@Snapshot.DisplayDefinitionPath"
                            @onchange="ChangeDisplayDefinitionAsync"
                            disabled="@DisplayDefinitionSelectionDisabled"
                            aria-label="Display definition">
                        <option value="">Manual / not linked</option>
                        @foreach (var definition in DisplayDefinitions)
                        {
                            <option value="@definition.Path" disabled="@(!definition.IsValid)">@FormatDisplayDefinition(definition)</option>
                        }
                    </select>
                </label>
            </div>
            @if (ActiveDisplayDefinition is { } activeDisplay)
            {
                <label class="display-menu-reference-selector">
                    <span>Menu linked to this display</span>
                    <select value="@SelectedDisplayMenuReferenceId"
                            @onchange="ChangeDisplayMenuReferenceAsync"
                            disabled="@MenuProfileControlDisabled">
                        @if (string.IsNullOrWhiteSpace(SelectedDisplayMenuReferenceId))
                        {
                            <option value="">Current menu is not linked yet — save the display to add it</option>
                        }
                        @foreach (var menu in activeDisplay.Menus)
                        {
                            <option value="@menu.Id">@FormatDisplayMenuReference(menu)</option>
                        }
                    </select>
                </label>
            }
            <p>Selecting a display restores its connection and default menu context. You can still choose or add another linked menu below.</p>
            @if (InvalidDisplayDefinitions.Count > 0)
            {
                <div class="menu-definition-file-errors" role="alert">
                    <strong>Display definitions needing attention</strong>
                    @foreach (var definition in InvalidDisplayDefinitions)
                    {
                        <div>
                            <code>@Path.GetFileName(definition.Path) · @definition.Location</code>
                            <span>@definition.Error</span>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="field-grid">
            <label>
                <span>Display name</span>
                <input @bind="DisplayName" aria-label="Display name" disabled="@IsBusy" />
            </label>
            <label>
                <span>IP address</span>
                <input @bind="Host" aria-label="IP address" placeholder="192.0.2.10" disabled="@IsBusy" />
            </label>
        </div>
        <div class="connection-options">
            <label class="toggle-row"><input type="checkbox" @bind="Secure" disabled="@IsBusy" /> Secure WebSocket <small>Recommended</small></label>
            <label class="toggle-row"><input type="checkbox" @bind="AllowUntrustedCertificate" disabled="@IsBusy" /> Accept TV certificate <small>Local TV certificate</small></label>
            <label class="toggle-row compact-option"><span>Port override</span><InputNumber @bind-Value="Port" placeholder="Automatic" disabled="@IsBusy" /></label>
        </div>
        <div class="connection-menu-profile">
            <div class="connection-menu-profile-heading">
                <span>MENU DEFINITION</span>
                <small>Detected from user data, the repository, and the installation</small>
                <button class="secondary-action menu-file-reload" type="button"
                        @onclick="ReloadMenuDefinitionAsync"
                        disabled="@(MenuProfileControlDisabled || string.IsNullOrWhiteSpace(Navigation.DefinitionPath))">
                    @(MenuFileReloading ? "Reloading…" : "Reload menu file")
                </button>
            </div>
            <label>
                <span>Menu structure</span>
                <select value="@Navigation.DefinitionPath"
                        @onchange="ChangeMenuDefinitionAsync"
                        disabled="@MenuProfileControlDisabled"
                        aria-label="Menu structure">
                    @if (MenuDefinitions.Count == 0)
                    {
                        <option value="">No valid menu structures found</option>
                    }
                    else if (!MenuDefinitions.Any(definition => definition.IsActive))
                    {
                        <option value="@Navigation.DefinitionPath" disabled>Configured menu file unavailable — choose another structure</option>
                    }
                    @foreach (var definition in MenuDefinitions)
                    {
                        <option value="@definition.Path" disabled="@(!definition.IsValid)">@FormatMenuDefinition(definition)</option>
                    }
                </select>
            </label>
            <label>
                <span>Menu configuration</span>
                <select value="@Navigation.ActiveConfigurationId"
                        @onchange="ChangeMenuConfigurationAsync"
                        disabled="@(MenuProfileControlDisabled || Navigation.Configurations.Count == 0)"
                        aria-label="Menu configuration">
                    @if (Navigation.Configurations.Count == 0)
                    {
                        <option value="">No configurations available</option>
                    }
                    @foreach (var configuration in Navigation.Configurations)
                    {
                        <option value="@configuration.Id">@configuration.Name</option>
                    }
                </select>
            </label>
            <p>@ActiveMenuContext</p>
            @if (InvalidMenuDefinitions.Count > 0)
            {
                <div class="menu-definition-file-errors" role="alert">
                    <strong>Menu files needing attention</strong>
                    @foreach (var definition in InvalidMenuDefinitions)
                    {
                        <div>
                            <code>@Path.GetFileName(definition.Path) · @definition.Location</code>
                            <span>@definition.Error</span>
                        </div>
                    }
                    <a href="menu/build">Open Build &amp; Verify →</a>
                </div>
            }
        </div>
        <div class="display-definition-save">
            <label>
                <span>Display ID</span>
                <input @bind="DisplayDefinitionId" placeholder="Generated from display name" disabled="@MenuProfileControlDisabled" />
            </label>
            <button class="secondary-action" type="button" @onclick="SaveDisplayDefinitionAsync" disabled="@(MenuProfileControlDisabled || Navigation.DefinitionName is null)">
                @(DisplayDefinitionBusy ? "Saving…" : Snapshot.DisplayDefinitionPath is null ? "Save display" : "Update display")
            </button>
            <p>Save the connection and selected menu/configuration together. Existing menu links are retained, and Display Verification is never copied, reset, or altered.</p>
            @if (PendingDisplayDefinitionReplacement is not null)
            {
                <div class="definition-replacement-confirmation display-definition-replacement">
                    <div>
                        <span>DISPLAY ID ALREADY EXISTS</span>
                        <strong>Replace @Path.GetFileName(PendingDisplayDefinitionReplacement.Path)?</strong>
                        <p>This replaces only the user display definition. It does not modify the referenced menu or any validation records.</p>
                    </div>
                    <div>
                        <button class="secondary-action" type="button" @onclick="CancelDisplayDefinitionReplacement">Cancel</button>
                        <button class="secondary-action danger-action" type="button" @onclick="ReplaceDisplayDefinitionAsync">Replace display</button>
                    </div>
                </div>
            }
        </div>
        <details class="connection-readiness-settings">
            <summary><span>Channel readiness</span><small>Recommended defaults</small></summary>
            <div class="readiness-field-grid">
                <label>
                    <span>Health-check interval</span>
                    <div class="number-with-unit"><InputNumber @bind-Value="KeepAliveIntervalSeconds" min="5" max="120" disabled="@IsBusy" /><b>sec</b></div>
                </label>
                <label>
                    <span>Health-check timeout</span>
                    <div class="number-with-unit"><InputNumber @bind-Value="KeepAliveTimeoutSeconds" min="0" max="60" disabled="@IsBusy" /><b>sec</b></div>
                </label>
                <label>
                    <span>Post-connect warm-up</span>
                    <div class="number-with-unit"><InputNumber @bind-Value="PostConnectWarmupMilliseconds" min="0" max="10000" step="100" disabled="@IsBusy" /><b>ms</b></div>
                </label>
                <label>
                    <span>Refresh channel after idle</span>
                    <div class="number-with-unit"><InputNumber @bind-Value="ReconnectAfterIdleSeconds" min="0" max="3600" step="30" disabled="@IsBusy" /><b>sec</b></div>
                </label>
            </div>
            <p>After the idle threshold, the next command waits for a fresh authorization and warm-up, then sends exactly once. Set idle refresh to 0 to disable proactive refresh, or health-check timeout to 0 if this TV does not answer WebSocket PINGs.</p>
            @if (!ReadinessSettingsValid)
            {
                <p class="readiness-validation" role="alert">Use 5–120 seconds for the interval, either 0 or 2–60 seconds for its timeout, 0–10,000 ms for warm-up, and either 0 or 30–3,600 seconds for idle refresh. Timeout cannot exceed the interval.</p>
            }
        </details>
        @if (CanDisconnect)
        {
            <button class="secondary-action danger-action" type="button" @onclick="DisconnectAsync" disabled="@(IsBusy || Snapshot.MacroRunning || Snapshot.NavigationRunning)">Disconnect <span>×</span></button>
        }
        else
        {
            <button class="primary-action" type="button" @onclick="ConnectAsync" disabled="@(IsBusy || string.IsNullOrWhiteSpace(Host) || !ReadinessSettingsValid)">
                @(IsBusy ? "Opening channel…" : "Connect to display") <span>→</span>
            </button>
        }
        <p class="field-note">After connecting, SamsungController automatically runs the preferred verified anchor to establish a known menu state. The TV may ask you to approve the first connection.</p>
    </div>

    <div class="panel signal-panel">
        <div class="panel-label"><span>SESSION SIGNAL</span><span>LIVE</span></div>
        <div class="signal-visual" aria-hidden="true">
            <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
        </div>
        <dl class="metric-list">
            <div><dt>Transport</dt><dd>@TransportLabel</dd></div>
            <div><dt>Authorization</dt><dd>@(Snapshot.HasToken ? "Token retained" : "Pair on connect")</dd></div>
            <div><dt>Generation</dt><dd>@(Snapshot.ConnectionGeneration == 0 ? "—" : Snapshot.ConnectionGeneration)</dd></div>
            <div><dt>Protocol capture</dt><dd>@(Snapshot.ConnectionState == SamsungConnectionState.Connected ? "Recording" : "Armed")</dd></div>
            <div><dt>Channel readiness</dt><dd>@Snapshot.PostConnectWarmupMilliseconds ms warm-up</dd></div>
            <div><dt>Menu prediction</dt><dd>@Snapshot.MenuConfidence</dd></div>
        </dl>
    </div>

    <div class="panel quick-panel">
        <div class="panel-label"><span>NEXT ACTIONS</span><span>04</span></div>
        <div class="quick-links">
            <a href="remote"><span>Remote</span><small>Directional and volume control</small><b>→</b></a>
            <a href="menu"><span>Menu</span><small>Verified controls grouped like the TV</small><b>→</b></a>
            <a href="macros"><span>Macro runner</span><small>Validated repeatable sequences</small><b>→</b></a>
            <a href="protocol"><span>Protocol</span><small>Inspect every RX / TX message</small><b>→</b></a>
        </div>
    </div>
</section>

@code {
    private ControllerSnapshot Snapshot { get; set; } = null!;
    private MenuNavigationSnapshot Navigation { get; set; } = null!;
    private IReadOnlyList<MenuDefinitionCatalogEntry> MenuDefinitions { get; set; } = [];
    private IReadOnlyList<DisplayDefinitionCatalogEntry> DisplayDefinitions { get; set; } = [];
    private string DisplayDefinitionId { get; set; } = string.Empty;
    private bool DisplayDefinitionBusy { get; set; }
    private DisplayDefinitionSavePreview? PendingDisplayDefinitionReplacement { get; set; }
    private string DisplayName { get; set; } = "Samsung TV";
    private string Host { get; set; } = string.Empty;
    private bool Secure { get; set; } = true;
    private bool AllowUntrustedCertificate { get; set; } = true;
    private int? Port { get; set; }
    private int KeepAliveIntervalSeconds { get; set; } = 20;
    private int KeepAliveTimeoutSeconds { get; set; } = 10;
    private int PostConnectWarmupMilliseconds { get; set; } = 1500;
    private int ReconnectAfterIdleSeconds { get; set; } = 300;
    private bool IsBusy { get; set; }
    private bool MenuProfileBusy { get; set; }
    private bool MenuFileReloading { get; set; }
    private string? LocalError { get; set; }
    private string? LocalStatus { get; set; }
    private IReadOnlyList<MenuDefinitionCatalogEntry> InvalidMenuDefinitions =>
        MenuDefinitions.Where(definition => !definition.IsValid).ToArray();
    private IReadOnlyList<DisplayDefinitionCatalogEntry> InvalidDisplayDefinitions =>
        DisplayDefinitions.Where(definition => !definition.IsValid).ToArray();
    private DisplayDefinitionCatalogEntry? ActiveDisplayDefinition =>
        DisplayDefinitions.FirstOrDefault(definition => definition.IsActive && definition.IsValid);
    private string? SelectedDisplayMenuReferenceId => ActiveDisplayDefinition?.Menus
        .FirstOrDefault(menu => menu.ResolvedMenuDefinitionPath.Equals(
                                   Navigation.DefinitionPath,
                                   StringComparison.OrdinalIgnoreCase)
                               && string.Equals(
                                   menu.MenuConfigurationId,
                                   Navigation.ActiveConfigurationId,
                                   StringComparison.OrdinalIgnoreCase))?.Id;

    private string? ErrorMessage => LocalError ?? Snapshot.LastError;
    private bool ReadinessSettingsValid => KeepAliveIntervalSeconds is >= 5 and <= 120
        && (KeepAliveTimeoutSeconds == 0 || KeepAliveTimeoutSeconds is >= 2 and <= 60)
        && KeepAliveTimeoutSeconds <= KeepAliveIntervalSeconds
        && PostConnectWarmupMilliseconds is >= 0 and <= 10_000
        && (ReconnectAfterIdleSeconds == 0
            || ReconnectAfterIdleSeconds is >= 30 and <= 3600);
    private bool CanDisconnect => ConnectionStatePresentation.CanDisconnect(
        Snapshot.ConnectionState);
    private bool MenuProfileControlDisabled => IsBusy
        || MenuProfileBusy
        || DisplayDefinitionBusy
        || Snapshot.MacroRunning
        || Snapshot.NavigationRunning;
    private bool DisplayDefinitionSelectionDisabled => MenuProfileControlDisabled
        || CanDisconnect;
    private string ActiveMenuContext => Navigation.Context is null
        ? "No menu/display context loaded."
        : $"{Navigation.Model} · firmware {Navigation.Context.Firmware} · {Navigation.Context.Signal} · {Navigation.Context.PictureMode} · {Navigation.Context.Input}";
    private string TransportLabel => $"{(Secure ? "WSS" : "WS")} : {Port ?? (Secure ? 8002 : 8001)}";
    private string StateClass => Snapshot.ConnectionState switch
    {
        SamsungConnectionState.Connected => "connected",
        SamsungConnectionState.Connecting or SamsungConnectionState.Pairing or SamsungConnectionState.Warming or
            SamsungConnectionState.Reconnecting or SamsungConnectionState.Disconnecting => "working",
        SamsungConnectionState.Faulted => "faulted",
        _ => "disconnected"
    };
    private string StateLabel => Snapshot.ConnectionState switch
    {
        SamsungConnectionState.Connected => "Online",
        SamsungConnectionState.Pairing => "Pairing",
        SamsungConnectionState.Warming => "Warming",
        SamsungConnectionState.Connecting => "Opening",
        SamsungConnectionState.Reconnecting => "Retrying",
        SamsungConnectionState.Disconnecting => "Closing",
        SamsungConnectionState.Faulted => "Faulted",
        _ => "Offline"
    };
    private string StateDetail => Snapshot.ConnectionState switch
    {
        SamsungConnectionState.Connected => Snapshot.Host ?? "Active channel",
        SamsungConnectionState.Pairing => "Check the TV",
        SamsungConnectionState.Warming => "Preparing commands",
        SamsungConnectionState.Connecting => "Negotiating",
        SamsungConnectionState.Reconnecting => "Recovering channel",
        SamsungConnectionState.Disconnecting => "Ending session",
        SamsungConnectionState.Faulted => "Review error",
        _ => "No active channel"
    };

    protected override async Task OnInitializedAsync()
    {
        Snapshot = Controller.GetSnapshot();
        Navigation = Controller.GetMenuNavigationSnapshot();
        Controller.Changed += HandleControllerChanged;
        await Controller.InitializeAsync();
        ApplySnapshotToForm(Controller.GetSnapshot());
        Navigation = Controller.GetMenuNavigationSnapshot();
        MenuDefinitions = await Controller.DiscoverMenuDefinitionsAsync();
        DisplayDefinitions = await Controller.DiscoverDisplayDefinitionsAsync();
        DisplayDefinitionId = DisplayDefinitions.FirstOrDefault(item => item.IsActive)?.Id
            ?? string.Empty;
    }

    private async Task ConnectAsync()
    {
        IsBusy = true;
        LocalError = null;
        try
        {
            await Controller.ConnectAsync(new TvConnectionRequest(
                DisplayName,
                Host,
                Secure,
                Port,
                AllowUntrustedCertificate,
                KeepAliveIntervalSeconds,
                KeepAliveTimeoutSeconds,
                PostConnectWarmupMilliseconds,
                ReconnectAfterIdleSeconds));
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task DisconnectAsync()
    {
        IsBusy = true;
        LocalError = null;
        try
        {
            await Controller.DisconnectAsync();
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ChangeMenuDefinitionAsync(ChangeEventArgs args)
    {
        var path = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        MenuProfileBusy = true;
        LocalError = null;
        LocalStatus = null;
        try
        {
            await Controller.SetMenuDefinitionAsync(path);
            Navigation = Controller.GetMenuNavigationSnapshot();
            MenuDefinitions = await Controller.DiscoverMenuDefinitionsAsync();
            DisplayDefinitions = await Controller.DiscoverDisplayDefinitionsAsync();
            Snapshot = Controller.GetSnapshot();
            LocalStatus = $"Selected {Navigation.DefinitionName}. Choose the configuration matching the TV's visible menu layout.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            MenuProfileBusy = false;
        }
    }

    private async Task ReloadMenuDefinitionAsync()
    {
        MenuProfileBusy = true;
        MenuFileReloading = true;
        LocalError = null;
        LocalStatus = null;
        try
        {
            await Controller.ReloadMenuDefinitionAsync();
            Navigation = Controller.GetMenuNavigationSnapshot();
            MenuDefinitions = await Controller.DiscoverMenuDefinitionsAsync();
            DisplayDefinitions = await Controller.DiscoverDisplayDefinitionsAsync();
            Snapshot = Controller.GetSnapshot();
            LocalStatus = $"Reloaded {Path.GetFileName(Navigation.DefinitionPath)} from disk. Generated routes and required verification checks are up to date.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
            Navigation = Controller.GetMenuNavigationSnapshot();
            MenuDefinitions = await Controller.DiscoverMenuDefinitionsAsync();
            DisplayDefinitions = await Controller.DiscoverDisplayDefinitionsAsync();
        }
        finally
        {
            MenuFileReloading = false;
            MenuProfileBusy = false;
        }
    }

    private async Task ChangeMenuConfigurationAsync(ChangeEventArgs args)
    {
        var configurationId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(configurationId))
        {
            return;
        }

        MenuProfileBusy = true;
        LocalError = null;
        LocalStatus = null;
        try
        {
            await Controller.SetMenuConfigurationAsync(configurationId);
            Navigation = Controller.GetMenuNavigationSnapshot();
            DisplayDefinitions = await Controller.DiscoverDisplayDefinitionsAsync();
            Snapshot = Controller.GetSnapshot();
            var selected = Navigation.Configurations.First(configuration => configuration.IsActive);
            LocalStatus = $"Selected menu configuration: {selected.Name}.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            MenuProfileBusy = false;
        }
    }

    private async Task ChangeDisplayDefinitionAsync(ChangeEventArgs args)
    {
        DisplayDefinitionBusy = true;
        LocalError = null;
        LocalStatus = null;
        PendingDisplayDefinitionReplacement = null;
        try
        {
            var path = args.Value?.ToString();
            if (string.IsNullOrWhiteSpace(path))
            {
                await Controller.ClearDisplayDefinitionSelectionAsync();
                Snapshot = Controller.GetSnapshot();
                DisplayDefinitions = await Controller.DiscoverDisplayDefinitionsAsync();
                DisplayDefinitionId = string.Empty;
                LocalStatus = "Using manual connection and menu selections.";
                return;
            }

            await Controller.SetDisplayDefinitionAsync(path);
            Snapshot = Controller.GetSnapshot();
            Navigation = Controller.GetMenuNavigationSnapshot();
            ApplySnapshotToForm(Snapshot);
            MenuDefinitions = await Controller.DiscoverMenuDefinitionsAsync();
            DisplayDefinitions = await Controller.DiscoverDisplayDefinitionsAsync();
            DisplayDefinitionId = DisplayDefinitions.First(item => item.IsActive).Id;
            LocalStatus = $"Loaded display definition {DisplayName} with {Navigation.DefinitionName}. Existing display verification was preserved.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            DisplayDefinitionBusy = false;
        }
    }

    private async Task SaveDisplayDefinitionAsync()
    {
        LocalError = null;
        try
        {
            var request = CreateDisplayDefinitionEditRequest();
            var preview = Controller.PreviewDisplayDefinitionSave(request);
            if (preview.FileExists && !preview.IsActiveUserDefinition)
            {
                PendingDisplayDefinitionReplacement = preview;
                return;
            }

            await PersistDisplayDefinitionAsync(request, replaceExisting: false);
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
    }

    private async Task ChangeDisplayMenuReferenceAsync(ChangeEventArgs args)
    {
        var referenceId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(referenceId)
            || ActiveDisplayDefinition is not { } activeDisplay)
        {
            return;
        }

        MenuProfileBusy = true;
        LocalError = null;
        LocalStatus = null;
        try
        {
            await Controller.SetDisplayMenuReferenceAsync(
                activeDisplay.Path,
                referenceId);
            Snapshot = Controller.GetSnapshot();
            Navigation = Controller.GetMenuNavigationSnapshot();
            MenuDefinitions = await Controller.DiscoverMenuDefinitionsAsync();
            DisplayDefinitions = await Controller.DiscoverDisplayDefinitionsAsync();
            LocalStatus = $"Selected {Navigation.DefinitionName} for {DisplayName}. Existing display verification was preserved.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            MenuProfileBusy = false;
        }
    }

    private async Task ReplaceDisplayDefinitionAsync()
    {
        try
        {
            await PersistDisplayDefinitionAsync(
                CreateDisplayDefinitionEditRequest(),
                replaceExisting: true);
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
    }

    private async Task PersistDisplayDefinitionAsync(
        DisplayDefinitionEditRequest request,
        bool replaceExisting)
    {
        DisplayDefinitionBusy = true;
        LocalError = null;
        LocalStatus = null;
        try
        {
            var path = await Controller.SaveDisplayDefinitionAsync(
                request,
                replaceExisting);
            Snapshot = Controller.GetSnapshot();
            DisplayDefinitions = await Controller.DiscoverDisplayDefinitionsAsync();
            DisplayDefinitionId = DisplayDefinitions.First(item => item.Path.Equals(
                path,
                StringComparison.OrdinalIgnoreCase)).Id;
            PendingDisplayDefinitionReplacement = null;
            LocalStatus = $"Saved display definition {DisplayDefinitionId}. Menu and display validation records were not changed.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            DisplayDefinitionBusy = false;
        }
    }

    private DisplayDefinitionEditRequest CreateDisplayDefinitionEditRequest()
    {
        var selectedMenu = MenuDefinitions.FirstOrDefault(definition =>
            definition.IsValid
            && definition.Path.Equals(
                Navigation.DefinitionPath,
                StringComparison.OrdinalIgnoreCase))
            ?? throw new InvalidOperationException(
                "Load a valid menu definition before saving the display definition.");
        return new DisplayDefinitionEditRequest(
            DisplayDefinitionId,
            DisplayName,
            Host,
            Secure,
            Port,
            AllowUntrustedCertificate,
            selectedMenu.Path,
            selectedMenu.Id,
            Navigation.ActiveConfigurationId);
    }

    private void CancelDisplayDefinitionReplacement() =>
        PendingDisplayDefinitionReplacement = null;

    private void HandleControllerChanged()
    {
        Snapshot = Controller.GetSnapshot();
        Navigation = Controller.GetMenuNavigationSnapshot();
        _ = InvokeAsync(StateHasChanged);
    }

    private static string FormatMenuDefinition(MenuDefinitionCatalogEntry definition)
    {
        var location = definition.IsActive
            ? $"Active / {definition.Location}"
            : definition.Location;
        if (!definition.IsValid)
        {
            return $"{Path.GetFileName(definition.Path)} · INVALID · {location}";
        }

        return $"{definition.Name} · {definition.Model} · firmware {definition.Context.Firmware} · {definition.Context.Signal} · {definition.Context.PictureMode} · {definition.Context.Input} · {location}";
    }

    private static string FormatDisplayDefinition(DisplayDefinitionCatalogEntry definition)
    {
        var location = definition.IsActive
            ? $"Active / {definition.Location}"
            : definition.Location;
        if (!definition.IsValid)
        {
            return $"{Path.GetFileName(definition.Path)} · INVALID · {location}";
        }

        var host = string.IsNullOrWhiteSpace(definition.Host)
            ? "IP entered separately"
            : definition.Host;
        var menuCount = definition.Menus.Count == 1
            ? definition.MenuDefinitionName
            : $"{definition.Menus.Count} linked menus";
        return $"{definition.Name} · {host} · {menuCount} · {location}";
    }

    private static string FormatDisplayMenuReference(DisplayMenuReferenceSummary menu)
    {
        var configuration = string.IsNullOrWhiteSpace(menu.MenuConfigurationId)
            ? "default layout"
            : menu.MenuConfigurationId;
        return $"{menu.MenuDefinitionName} · {configuration}{(menu.IsDefault ? " · default" : string.Empty)}";
    }

    private void ApplySnapshotToForm(ControllerSnapshot snapshot)
    {
        Snapshot = snapshot;
        DisplayName = snapshot.DisplayName;
        Host = snapshot.Host ?? string.Empty;
        Secure = snapshot.Secure;
        Port = snapshot.Port;
        AllowUntrustedCertificate = snapshot.AllowUntrustedCertificate;
        KeepAliveIntervalSeconds = snapshot.KeepAliveIntervalSeconds;
        KeepAliveTimeoutSeconds = snapshot.KeepAliveTimeoutSeconds;
        PostConnectWarmupMilliseconds = snapshot.PostConnectWarmupMilliseconds;
        ReconnectAfterIdleSeconds = snapshot.ReconnectAfterIdleSeconds;
    }

    public void Dispose()
    {
        Controller.Changed -= HandleControllerChanged;
    }
}
