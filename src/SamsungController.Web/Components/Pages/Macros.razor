    private async Task RequestRunMacroAsync()
    {
        if (SelectedMacro is null)
        {
            return;
        }

        if (SelectedSummary?.ConfirmBeforeRun == true)
        {
            PendingRunMacroName = SelectedMacro;
            ErrorMessage = null;
            StatusMessage = null;
            return;
        }

        await ExecuteMacroAsync(SelectedMacro);
    }

    private async Task ConfirmRunMacroAsync()
    {
        var name = PendingRunMacroName;
        PendingRunMacroName = null;
        if (name is not null)
        {
            await ExecuteMacroAsync(name);
        }
    }

    private void CancelRunMacro()
    {
        PendingRunMacroName = null;
        StatusMessage = "Macro execution cancelled before any commands were sent.";
    }

    private async Task ExecuteMacroAsync(string macroName)
    {
        if (SelectedMacro?.Equals(macroName, StringComparison.OrdinalIgnoreCase) != true)
        {
            return;
        }

        ErrorMessage = null;
        StatusMessage = null;
        AwaitingValidationName = null;
        try
        {
            await Controller.RunMacroAsync(macroName);
            AwaitingValidationName = macroName;
            StatusMessage = "Replay completed. Inspect the TV, then count the pass or report failure.";
        }
        catch (OperationCanceledException)
        {
            // The live run status already reports cancellation.
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
    }

    private void CancelMacro() => Controller.CancelMacro();

    private async Task ConfirmValidationAsync(bool passed)
    {
        if (AwaitingValidationName is null)
        {
            return;
        }

        var name = AwaitingValidationName;
        await RunBusyAsync(async () =>
        {
            var updated = await Controller.ConfirmMacroValidationAsync(name, passed);
            CatalogMacros = await Controller.LoadMacrosAsync();
            await LoadSelectedDetailsAsync();
            QuickActions = Controller.GetQuickAccessActions();
            AwaitingValidationName = null;
            StatusMessage = passed
                ? updated.Verified
                    ? $"{updated.Name} is verified after 3/3 visual passes."
                    : $"Pass counted for {updated.Name}: {updated.VerificationPasses}/3. Replay will prepare its declared starting state again."
                : $"{updated.Name} failed visual verification; its count is reset to 0/3.";
        });
    }

    private async Task ToggleSelectedMacroQuickAccessAsync()
    {
        if (SelectedMacro is null)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            if (SelectedQuickAction is { } existing)
            {
                await Controller.RemoveQuickAccessActionAsync(existing.Id);
            }
            else
            {
                await Controller.AddQuickAccessMacroAsync(SelectedMacro);
