        PendingRunMacroName = null;
        ErrorMessage = null;
        StatusMessage = null;
    }

    private void CancelListDelete() => ListDeleteConfirmationName = null;

    private async Task DeleteMacroFromListAsync(string name)
    {
        if (ListDeleteConfirmationName?.Equals(name, StringComparison.OrdinalIgnoreCase) != true)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            await Controller.DeleteMacroAsync(name);
            CatalogMacros = await Controller.LoadMacrosAsync();
            QuickActions = Controller.GetQuickAccessActions();
            ListDeleteConfirmationName = null;
            PendingRunMacroName = null;
            AwaitingValidationName = null;

            if (SelectedMacro?.Equals(name, StringComparison.OrdinalIgnoreCase) == true)
            {
                SelectedMacro = null;
                SelectedDetails = null;
                CancelEdit();
            }

