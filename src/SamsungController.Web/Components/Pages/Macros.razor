    private async Task DownloadCatalogAsync()
    {
        await RunBusyAsync(async () =>
        {
            var yaml = await Controller.ExportMacroCatalogAsync();
            var fileName = Path.GetFileName(MacroPath);
            await JavaScript.InvokeVoidAsync(
                "samsungController.downloadText",
                string.IsNullOrWhiteSpace(fileName) ? "macros.yaml" : fileName,
