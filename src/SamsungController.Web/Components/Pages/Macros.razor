    private async Task RunBusyAsync(Func<Task> action)
    {
        IsBusy = true;
        ErrorMessage = null;
        try
        {
            await action();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private static string DescribeSteps(IReadOnlyList<MacroStep> steps) =>
        string.Join(" · ", steps.Select((step, index) => $"{index + 1}. {DescribeStep(step)}"));

    private static string DescribeStep(MacroStep step) => step switch
    {
        KeyStep key => $"{key.Key}{(key.Repeat == 1 ? string.Empty : $" ×{key.Repeat}")}",
        DelayStep delay => $"wait {delay.Duration.TotalMilliseconds:0.###} ms",
        CallMacroStep call => $"call {call.MacroName}{(call.Repeat == 1 ? string.Empty : $" ×{call.Repeat}")}",
        MenuStep menu => $"menu {menu.TargetNodeId}",
        _ => step.GetType().Name
    };

    private string GetPreferredStartingNodeId()
    {
        if (Navigation.State.NodeId is { } currentNodeId
            && VerifiedMenuItems.Any(node => node.Id.Equals(
                currentNodeId,
                StringComparison.OrdinalIgnoreCase)))
        {
            return currentNodeId;
        }

        return Navigation.Anchors
                   .Where(anchor => anchor.Verified)
                   .Select(anchor => anchor.TargetNodeId)
                   .FirstOrDefault(nodeId => VerifiedMenuItems.Any(node => node.Id.Equals(
                       nodeId,
                       StringComparison.OrdinalIgnoreCase)))
               ?? VerifiedMenuItems.FirstOrDefault()?.Id
               ?? string.Empty;
    }

    private string GetMenuPath(string? nodeId) =>
        string.IsNullOrWhiteSpace(nodeId)
            ? "Not declared"
            : Navigation.Nodes.FirstOrDefault(node => node.Id.Equals(
                nodeId,
                StringComparison.OrdinalIgnoreCase))?.Path
              ?? nodeId;

    private void HandleControllerChanged()
    {
        Snapshot = Controller.GetSnapshot();
        Run = Controller.GetMacroRunSnapshot();
        Navigation = Controller.GetMenuNavigationSnapshot();
        QuickActions = Controller.GetQuickAccessActions();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Controller.Changed -= HandleControllerChanged;
    }

    private enum MacroStepKind
    {
        Key,
        Delay,
        Call,
        Menu
    }

    private sealed class MacroStepDraft
    {
        public MacroStepKind Kind { get; set; }

        public string Key { get; set; } = "KEY_MENU";

        public RemoteKeyAction Action { get; set; } = RemoteKeyAction.Click;

        public int Repeat { get; set; } = 1;

        public int? DelayMilliseconds { get; set; }

        public string CalledMacro { get; set; } = string.Empty;

        public string MenuNodeId { get; set; } = string.Empty;

        public static MacroStepDraft Create(MacroStepKind kind) => new()
        {
            Kind = kind,
            DelayMilliseconds = kind == MacroStepKind.Delay ? 500 : null
        };

        public static MacroStepDraft CreateCapturedKey(
            string key,
            RemoteKeyAction action,
            int? delayMilliseconds) => new()
        {
            Kind = MacroStepKind.Key,
            Key = key,
            Action = action,
            DelayMilliseconds = delayMilliseconds
        };

        public static MacroStepDraft CreateMenu(string menuNodeId) => new()
        {
            Kind = MacroStepKind.Menu,
            MenuNodeId = menuNodeId
        };

        public static MacroStepDraft FromStep(MacroStep step) => step switch
        {
            KeyStep key => new MacroStepDraft
            {
                Kind = MacroStepKind.Key,
                Key = key.Key,
                Action = key.Action,
                Repeat = key.Repeat,
                DelayMilliseconds = key.Delay is null ? null : checked((int)Math.Round(key.Delay.Value.TotalMilliseconds))
            },
            DelayStep delay => new MacroStepDraft
            {
                Kind = MacroStepKind.Delay,
                DelayMilliseconds = checked((int)Math.Round(delay.Duration.TotalMilliseconds))
            },
            CallMacroStep call => new MacroStepDraft
            {
                Kind = MacroStepKind.Call,
                CalledMacro = call.MacroName,
                Repeat = call.Repeat
            },
            MenuStep menu => new MacroStepDraft
            {
                Kind = MacroStepKind.Menu,
                MenuNodeId = menu.TargetNodeId
            },
            _ => throw new InvalidOperationException($"Unsupported macro step type '{step.GetType().Name}'.")
        };

        public MacroStep ToStep(int stepNumber)
        {
            if (Repeat is < 1 or > MacroValidator.MaximumRepeat)
            {
                throw new InvalidOperationException(
                    $"Step {stepNumber}: repeat must be from 1 through {MacroValidator.MaximumRepeat}.");
            }

            return Kind switch
            {
                MacroStepKind.Key when string.IsNullOrWhiteSpace(Key) =>
                    throw new InvalidOperationException($"Step {stepNumber}: enter a Samsung key."),
                MacroStepKind.Key when DelayMilliseconds is <= 0 or > 86_400_000 =>
                    throw new InvalidOperationException(
                        $"Step {stepNumber}: wait after must be empty or from 1 through 86,400,000 ms."),
                MacroStepKind.Key => new KeyStep(
                    Key.Trim(),
                    Action,
                    Repeat,
                    DelayMilliseconds is { } keyDelay ? TimeSpan.FromMilliseconds(keyDelay) : null),
                MacroStepKind.Delay when DelayMilliseconds is null or <= 0 or > 86_400_000 =>
                    throw new InvalidOperationException(
                        $"Step {stepNumber}: wait duration must be from 1 through 86,400,000 ms."),
                MacroStepKind.Delay => new DelayStep(TimeSpan.FromMilliseconds(DelayMilliseconds.Value)),
                MacroStepKind.Call when string.IsNullOrWhiteSpace(CalledMacro) =>
                    throw new InvalidOperationException($"Step {stepNumber}: select a saved macro to call."),
                MacroStepKind.Call => new CallMacroStep(CalledMacro.Trim(), Repeat),
                MacroStepKind.Menu when string.IsNullOrWhiteSpace(MenuNodeId) =>
                    throw new InvalidOperationException($"Step {stepNumber}: select a verified menu destination."),
                MacroStepKind.Menu => new MenuStep(MenuNodeId.Trim()),
                _ => throw new InvalidOperationException($"Step {stepNumber}: unsupported operation type.")
            };
        }
    }
}
