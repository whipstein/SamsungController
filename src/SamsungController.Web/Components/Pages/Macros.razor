@page "/macros"
@implements IDisposable
@inject SamsungControllerService Controller
@inject IJSRuntime JavaScript

<PageTitle>Macros · SamsungController</PageTitle>

<section class="page-heading compact-heading">
    <div>
        <span class="eyebrow">MACRO STUDIO</span>
        <h1>Build it. Replay it. Prove it.</h1>
        <p>Create and edit YAML macros in the browser, then count three visual passes on the TV before treating a sequence as verified.</p>
    </div>
    <div class="page-heading-actions">
        <HelpBubble Title="Build and verify a macro" ButtonText="Page help">
            <ol>
                <li>Load an existing YAML catalog, or select <strong>New macro</strong> to create the missing default catalog.</li>
                <li>Select the verified TV state where the macro begins, then use <strong>Prepare selected start</strong> before capturing. Replay visibly prepares that state before the first saved button.</li>
                <li>While editing, use the compact remote or the verified-menu list to execute commands live and append every successful action. Set the captured-key wait to control replay timing.</li>
                <li>Use <strong>Pause capture</strong> when you need to reposition the TV without adding those keys or menu calls to the draft, then resume capture.</li>
                <li>Add or edit key, wait, nested-macro, and verified menu-destination steps. Reorder them to match the exact sequence you expect.</li>
                <li>Save before testing. Any behavioral edit resets only that macro's verification count.</li>
                <li>Connect to the TV and select <strong>Replay test</strong>. If the observed result is correct, select <strong>Count pass</strong>.</li>
                <li>Three accepted runs mark the macro verified in YAML. A failed run resets that macro to 0/3.</li>
            </ol>
            <p class="help-callout">The declared starting state is an explicit planned operation shown in replay progress. It uses verified routes and may run a verified anchor when the current state is unknown. Selecting a verified menu item beside the remote executes it immediately and records one high-level menu call unless capture is paused.</p>
        </HelpBubble>
        <div class="page-state @(Snapshot.MacroRunning ? "working" : "")"><span></span>@(Snapshot.MacroRunning ? "Running" : "Ready")</div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="notice danger" role="alert"><strong>Macro action failed</strong><span>@ErrorMessage</span></div>
}
else if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="notice" role="status"><strong>Macro studio</strong><span>@StatusMessage</span></div>
}

<section class="macro-layout">
    <div class="panel macro-catalog-panel">
        <div class="panel-label"><span>CATALOG</span><span>@CatalogMacros.Count MACROS</span></div>
        <div class="path-editor">
            <label>
                <span>YAML file</span>
                <input @bind="MacroPath" disabled="@IsLocked" />
            </label>
            <button class="secondary-action" @onclick="LoadMacrosAsync" disabled="@(IsLocked || IsLoading)">@(IsLoading ? "Checking…" : "Load & validate")</button>
        </div>
        <div class="macro-catalog-actions">
            <button class="secondary-action" @onclick="StartNewMacro" disabled="@IsLocked">New macro <span>＋</span></button>
            <button class="secondary-action" @onclick="StartDuplicateMacro" disabled="@(IsLocked || SelectedDetails is null)">Duplicate <span>⧉</span></button>
            <button class="secondary-action" @onclick="DownloadCatalogAsync" disabled="@(IsLocked || CatalogMacros.Count == 0)">Download YAML <span>↓</span></button>
        </div>

        @if (CatalogMacros.Count == 0)
        {
            <div class="panel-empty">
                <strong>No macros in this catalog</strong>
                <span>Create the first macro here; no command line is required.</span>
                <button class="primary-action inline-action" @onclick="StartNewMacro" disabled="@IsLocked">Create first macro <span>＋</span></button>
            </div>
        }
        else
        {
            <div class="macro-list">
                @foreach (var macro in CatalogMacros)
                {
                    <div class="macro-card-shell">
                        <button class="macro-card @(SelectedMacro == macro.Name ? "selected" : "") @(macro.Verified ? "verified" : "needs-verification")"
                                @onclick="() => SelectMacroAsync(macro.Name)" disabled="@IsLocked">
                            <span>
                                <strong>@macro.Name</strong>
                                <small>@(string.IsNullOrWhiteSpace(macro.Description) ? "No description" : macro.Description)</small>
                                <small class="macro-start-state">Starts at @GetMenuPath(macro.StartingNodeId)</small>
                            </span>
                            <span class="macro-card-meta">
                                <b>@macro.StepCount steps</b>
                                <em>@(macro.Verified ? "Verified" : $"{macro.VerificationPasses}/3 passes")</em>
                                @if (macro.ConfirmBeforeRun)
                                {
                                    <i>Confirm to run</i>
                                }
                            </span>
                        </button>
                        <div class="macro-card-actions">
                            @if (ListDeleteConfirmationName?.Equals(macro.Name, StringComparison.OrdinalIgnoreCase) == true)
                            {
                                <button class="macro-list-delete-confirm" title="Confirm deleting @macro.Name" @onclick="() => DeleteMacroFromListAsync(macro.Name)" disabled="@IsLocked">Delete</button>
                                <button title="Keep @macro.Name" @onclick="CancelListDelete" disabled="@IsLocked">Keep</button>
                            }
                            else
                            {
                                <button class="macro-list-delete" title="Delete @macro.Name" aria-label="Delete @macro.Name" @onclick="() => BeginListDelete(macro.Name)" disabled="@IsLocked">×</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="macro-side-stack">
        <div class="panel run-panel">
            <div class="panel-label"><span>REPLAY + VERIFY</span><span>@Snapshot.ConnectionState</span></div>
            <span class="selected-label">SAVED MACRO</span>
            <strong class="selected-macro">@(SelectedMacro ?? "—")</strong>

            @if (SelectedSummary is { } selected)
            {
                <div class="macro-start-summary">
                    <span>STARTING TV STATE</span>
                    <strong>@GetMenuPath(selected.StartingNodeId)</strong>
                </div>
            }

            @if (SelectedSummary is { } summary)
            {
                <div class="macro-verification-state @(summary.Verified ? "verified" : "unverified")">
                    <strong>@(summary.Verified ? "Verified" : "Needs visual verification")</strong>
                    <span>@summary.VerificationPasses / 3 accepted runs</span>
                    <i><span style="width: @(summary.VerificationPasses * 100 / 3)%"></span></i>
                </div>
            }

            @if (Run.IsRunning)
            {
                <button class="secondary-action danger-action" @onclick="CancelMacro">Cancel macro <span>×</span></button>
            }
            else if (AwaitingValidationName is not null
                && AwaitingValidationName.Equals(SelectedMacro, StringComparison.OrdinalIgnoreCase))
            {
                <div class="macro-confirmation" role="group" aria-label="Confirm macro replay">
                    <p>Did this exact replay behave correctly on the TV?</p>
                    <button class="primary-action" @onclick="() => ConfirmValidationAsync(true)" disabled="@IsBusy">Count pass <span>✓</span></button>
                    <button class="secondary-action danger-action" @onclick="() => ConfirmValidationAsync(false)" disabled="@IsBusy">Failed · reset count <span>×</span></button>
                </div>
            }
            else
            {
                <button class="primary-action" @onclick="RequestRunMacroAsync" disabled="@(!CanRun)">Replay test <span>▶</span></button>
            }

            @if (SelectedMacro is not null)
            {
                <button class="secondary-action quick-pin-action" @onclick="ToggleSelectedMacroQuickAccessAsync" disabled="@(!CanManageQuickAccess)">
                    @(SelectedQuickAction is null ? "Add to quick access" : "Remove from quick access")
                    <span>@(SelectedQuickAction is null ? "＋" : "×")</span>
                </button>
            }
            <p class="field-note">Save edits before replaying. Quick access is available after 3/3 visual passes.</p>
        </div>

        <div class="panel progress-panel">
            <div class="panel-label"><span>EXECUTION</span><span>@(Run.Progress.Count == 0 ? "IDLE" : $"{Run.Progress.Count} OPS")</span></div>
            <strong class="run-status">@(Run.Status ?? "Waiting for a run")</strong>
            <div class="progress-list">
                @foreach (var progress in Run.Progress.Reverse().Take(12))
                {
                    <div class="progress-entry">
                        <span>@progress.OperationNumber/@progress.OperationCount</span>
                        <strong>@progress.Description</strong>
                        <small>@progress.SourceMacroName · @(progress.SourceStepNumber is null ? "starting state" : $"step {progress.SourceStepNumber}")</small>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="panel macro-editor-panel">
    <div class="panel-label"><span>EDITOR</span><span>@(IsEditing ? (OriginalName is null ? "NEW" : "EDITING") : "SELECT A MACRO")</span></div>
    @if (!IsEditing)
    {
        <div class="macro-editor-empty">
            <strong>@(SelectedDetails is null ? "Choose a macro or create a new one" : SelectedDetails.Name)</strong>
            @if (SelectedDetails is not null)
            {
                <span>Starts at @GetMenuPath(SelectedDetails.StartingNodeId)</span>
                <span>@DescribeSteps(SelectedDetails.Steps)</span>
                <button class="primary-action inline-action" @onclick="StartEditSelected" disabled="@IsLocked">Edit macro <span>✎</span></button>
            }
            else
            {
                <span>The editor saves directly to the YAML catalog shown above.</span>
            }
        </div>
    }
    else
    {
        <div class="macro-editor-heading">
            <label>
                <span>Macro name</span>
                <input @bind="EditorName" placeholder="OpenPictureSettings" disabled="@IsBusy" />
            </label>
            <label>
                <span>Description</span>
                <input @bind="EditorDescription" placeholder="What should this sequence accomplish?" disabled="@IsBusy" />
            </label>
            <label>
                <span>Starting TV state</span>
                <select @bind="EditorStartingNodeId" disabled="@IsBusy">
                    <option value="">Select a verified starting state</option>
                    @foreach (var menuItem in VerifiedMenuItems)
                    {
                        <option value="@menuItem.Id">@menuItem.Path</option>
                    }
                </select>
            </label>
            <label class="macro-confirm-run-toggle">
                <input type="checkbox" @bind="EditorConfirmBeforeRun" disabled="@IsBusy" />
                <span>
                    <strong>Confirm before execution</strong>
                    <small>Show an “Are you sure?” prompt before Replay or quick access runs this macro.</small>
                </span>
            </label>
        </div>

        <div class="macro-live-builder">
            <div class="macro-live-builder-copy">
                <span class="eyebrow">LIVE BUTTON BUILDER</span>
                <strong>Send it now and append it on success.</strong>
                <p>Choose the TV's state before the first button, then use the compact remote while watching the TV. Every successful send becomes the next key operation in this draft.</p>
                <button class="secondary-action macro-prepare-start" @onclick="PrepareEditorStartAsync" disabled="@(!CanPrepareEditorStart)">Prepare selected start <span>◎</span></button>
                <label>
                    <span>Wait after each captured key (ms)</span>
                    <input type="number" min="1" max="86400000" @bind="CaptureWaitMilliseconds" disabled="@IsSendingCapturedKey" />
                </label>
                <div class="macro-capture-actions">
                    <button class="secondary-action macro-capture-pause @(IsCapturePaused ? "paused" : "")" @onclick="ToggleCapturePause" disabled="@(!CanToggleCapturePause)">@(IsCapturePaused ? "Resume capture" : "Pause capture") <span>@(IsCapturePaused ? "▶" : "Ⅱ")</span></button>
                    <button class="secondary-action" @onclick="UndoLastEditorStep" disabled="@(IsBusy || IsSendingCapturedKey || EditorSteps.Count == 0)">Undo last step</button>
                    <button class="secondary-action danger-action" @onclick="ClearEditorSteps" disabled="@(IsBusy || IsSendingCapturedKey || EditorSteps.Count == 0)">Clear steps</button>
                </div>
                <small class="@(IsCapturePaused ? "capture-paused-note" : "")">@(IsCapturePaused && Snapshot.ConnectionState == SamsungConnectionState.Connected ? "Capture paused · remote keys and menu selections still execute, but are not added." : IsCapturePaused ? "Capture paused · connect to send live actions without recording them." : CanCaptureKey ? "Ready · successful remote keys and menu selections are captured." : "Connect to the TV to enable live capture. You can still edit steps manually.")</small>
                <small>Preparing the start moves the TV through verified navigation but does not append those preparation keys to the draft.</small>
                <small>Undo and clear change the draft only; they do not reverse buttons already sent to the TV. Clear the wait field to capture without an automatic pause.</small>
            </div>
            <div class="macro-live-remote">
                <div class="authoring-remote" aria-label="Macro recording remote">
                    <div class="authoring-remote-row">
                        <button @onclick='() => SendAndCaptureKeyAsync("KEY_HOME")' disabled="@(!CanCaptureKey)">Home</button>
                        <button @onclick='() => SendAndCaptureKeyAsync("KEY_MENU")' disabled="@(!CanCaptureKey)">Menu</button>
                        <button @onclick='() => SendAndCaptureKeyAsync("KEY_EXIT")' disabled="@(!CanCaptureKey)">Exit</button>
                    </div>
                    <div class="authoring-dpad">
                        <button class="up" aria-label="Up" @onclick='() => SendAndCaptureKeyAsync("KEY_UP")' disabled="@(!CanCaptureKey)">↑</button>
                        <button class="left" aria-label="Left" @onclick='() => SendAndCaptureKeyAsync("KEY_LEFT")' disabled="@(!CanCaptureKey)">←</button>
                        <button class="enter" aria-label="Enter" @onclick='() => SendAndCaptureKeyAsync("KEY_ENTER")' disabled="@(!CanCaptureKey)">OK</button>
                        <button class="right" aria-label="Right" @onclick='() => SendAndCaptureKeyAsync("KEY_RIGHT")' disabled="@(!CanCaptureKey)">→</button>
                        <button class="down" aria-label="Down" @onclick='() => SendAndCaptureKeyAsync("KEY_DOWN")' disabled="@(!CanCaptureKey)">↓</button>
                    </div>
                    <button class="authoring-return" @onclick='() => SendAndCaptureKeyAsync("KEY_RETURN")' disabled="@(!CanCaptureKey)">↩ Return</button>
                </div>
                <div class="custom-record-key macro-custom-record-key">
                    <input @bind="CaptureCustomKey" placeholder="KEY_SOURCE" disabled="@(!CanCaptureKey)" />
                    <select @bind="CaptureCustomAction" disabled="@(!CanCaptureKey)">
                        @foreach (var action in Enum.GetValues<RemoteKeyAction>())
                        {
                            <option value="@action">@action</option>
                        }
                    </select>
                    <button class="secondary-action" @onclick="SendAndCaptureCustomKeyAsync" disabled="@(!CanCaptureKey || string.IsNullOrWhiteSpace(CaptureCustomKey))">@(IsCapturePaused ? "Send only" : "Send + add")</button>
                </div>
            </div>
            <div class="macro-live-menu">
                <div class="macro-live-menu-heading">
                    <span class="eyebrow">VERIFIED MENU ITEMS</span>
                    <strong>Select, execute, and @(IsCapturePaused ? "do not record" : "record").</strong>
                    <small>Each successful selection becomes one menu-call step. The verified planner supplies the traversal during replay.</small>
                </div>
                @if (VerifiedMenuItems.Count == 0)
                {
                    <div class="macro-live-menu-empty">No verified menu items are available.</div>
                }
                else
                {
                    <div class="macro-live-menu-list">
                        @foreach (var menuItem in VerifiedMenuItems)
                        {
                            <button class="@(Navigation.State.NodeId?.Equals(menuItem.Id, StringComparison.OrdinalIgnoreCase) == true ? "current" : "")"
                                    @onclick="() => SendAndCaptureMenuAsync(menuItem)" disabled="@(!CanCaptureKey)">
                                <strong>@menuItem.Label</strong>
                                <small>@menuItem.Path</small>
                                <span>@(IsCapturePaused ? "Run" : "Run + add")</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="macro-step-toolbar">
            <span>Add an operation</span>
            <button class="secondary-action" @onclick="() => AddStep(MacroStepKind.Key)" disabled="@IsBusy">Key</button>
            <button class="secondary-action" @onclick="() => AddStep(MacroStepKind.Delay)" disabled="@IsBusy">Wait</button>
            <button class="secondary-action" @onclick="() => AddStep(MacroStepKind.Call)" disabled="@(IsBusy || CatalogMacros.Count == 0)">Call macro</button>
            <button class="secondary-action" @onclick="() => AddStep(MacroStepKind.Menu)" disabled="@(IsBusy || VerifiedMenuItems.Count == 0)">Call menu item</button>
        </div>

        @if (EditorSteps.Count == 0)
        {
            <div class="panel-empty macro-step-empty">
                <strong>This macro has no operations</strong>
                <span>Capture a live key, or add a key, explicit wait, nested macro, or verified menu destination.</span>
            </div>
        }
        else
        {
            <div class="macro-step-list">
                @for (var index = 0; index < EditorSteps.Count; index++)
                {
                    var stepIndex = index;
                    var step = EditorSteps[index];
                    <div class="macro-step-row">
                        <span class="macro-step-number">@(index + 1)</span>
                        <label class="macro-step-kind">
                            <span>Type</span>
                            <select @bind="step.Kind" disabled="@IsBusy">
                                <option value="@MacroStepKind.Key">Key</option>
                                <option value="@MacroStepKind.Delay">Wait</option>
                                <option value="@MacroStepKind.Call">Call macro</option>
                                <option value="@MacroStepKind.Menu">Call menu item</option>
                            </select>
                        </label>

                        @if (step.Kind == MacroStepKind.Key)
                        {
                            <label class="macro-step-value">
                                <span>Samsung key</span>
                                <input @bind="step.Key" placeholder="KEY_MENU" disabled="@IsBusy" />
                            </label>
                            <label>
                                <span>Action</span>
                                <select @bind="step.Action" disabled="@IsBusy">
                                    @foreach (var action in Enum.GetValues<RemoteKeyAction>())
                                    {
                                        <option value="@action">@action</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>Repeat</span>
                                <input type="number" min="1" max="1000" @bind="step.Repeat" disabled="@IsBusy" />
                            </label>
                            <label>
                                <span>Wait after (ms)</span>
                                <input type="number" min="1" max="86400000" @bind="step.DelayMilliseconds" placeholder="None" disabled="@IsBusy" />
                            </label>
                        }
                        else if (step.Kind == MacroStepKind.Delay)
                        {
                            <label class="macro-step-value macro-step-wide">
                                <span>Wait duration (ms)</span>
                                <input type="number" min="1" max="86400000" @bind="step.DelayMilliseconds" disabled="@IsBusy" />
                            </label>
                        }
                        else if (step.Kind == MacroStepKind.Call)
                        {
                            <label class="macro-step-value macro-step-wide">
                                <span>Saved macro</span>
                                <select @bind="step.CalledMacro" disabled="@IsBusy">
                                    <option value="">Select macro</option>
                                    @foreach (var candidate in CallableMacros)
                                    {
                                        <option value="@candidate.Name">@candidate.Name</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>Repeat</span>
                                <input type="number" min="1" max="1000" @bind="step.Repeat" disabled="@IsBusy" />
                            </label>
                        }
                        else
                        {
                            <label class="macro-step-value macro-step-wide">
                                <span>Verified menu destination</span>
                                <select @bind="step.MenuNodeId" disabled="@IsBusy">
                                    <option value="">Select menu item</option>
                                    @foreach (var menuItem in VerifiedMenuItems)
                                    {
                                        <option value="@menuItem.Id">@menuItem.Path</option>
                                    }
                                </select>
                            </label>
                        }

                        <div class="macro-step-controls">
                            <button title="Move up" @onclick="() => MoveStep(stepIndex, -1)" disabled="@(IsBusy || stepIndex == 0)">↑</button>
                            <button title="Move down" @onclick="() => MoveStep(stepIndex, 1)" disabled="@(IsBusy || stepIndex == EditorSteps.Count - 1)">↓</button>
                            <button class="danger-action" title="Delete step" @onclick="() => DeleteStep(stepIndex)" disabled="@IsBusy">×</button>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="macro-editor-actions">
            <button class="primary-action" @onclick="SaveMacroAsync" disabled="@IsBusy">@(OriginalName is null ? "Save new macro" : "Update macro") <span>✓</span></button>
            <button class="secondary-action" @onclick="CancelEdit" disabled="@IsBusy">Cancel</button>
            @if (OriginalName is not null)
            {
                @if (DeleteConfirmation)
                {
                    <button class="secondary-action danger-action" @onclick="DeleteSelectedMacroAsync" disabled="@IsBusy">Confirm delete <span>×</span></button>
                    <button class="secondary-action" @onclick="() => DeleteConfirmation = false" disabled="@IsBusy">Keep macro</button>
                }
                else
                {
                    <button class="secondary-action danger-action macro-delete-action" @onclick="() => DeleteConfirmation = true" disabled="@IsBusy">Delete macro</button>
                }
            }
        </div>
        <p class="field-note">Changing the name, description, or confirmation preference preserves visual passes. Changing the starting state, key, wait, repeat, action, nested call, or menu destination resets this macro to 0/3.</p>
    }
</section>

@if (PendingRunMacroName is { } pendingRunMacroName)
{
    <MacroExecutionConfirmation MacroName="@pendingRunMacroName"
                                Description="@SelectedDetails?.Description"
                                OnConfirm="ConfirmRunMacroAsync"
                                OnCancel="CancelRunMacro" />
}

@code {
    private ControllerSnapshot Snapshot { get; set; } = null!;
    private MacroRunSnapshot Run { get; set; } = new(false, null, null, []);
    private MenuNavigationSnapshot Navigation { get; set; } = null!;
    private IReadOnlyList<MacroSummary> CatalogMacros { get; set; } = [];
    private IReadOnlyList<QuickAccessAction> QuickActions { get; set; } = [];
    private MacroDetails? SelectedDetails { get; set; }
    private string MacroPath { get; set; } = string.Empty;
    private string? SelectedMacro { get; set; }
    private string? ErrorMessage { get; set; }
    private string? StatusMessage { get; set; }
    private string? AwaitingValidationName { get; set; }
    private string? PendingRunMacroName { get; set; }
    private string? ListDeleteConfirmationName { get; set; }
    private bool IsLoading { get; set; }
    private bool IsBusy { get; set; }
    private bool IsEditing { get; set; }
    private bool DeleteConfirmation { get; set; }
    private string? OriginalName { get; set; }
    private string EditorName { get; set; } = string.Empty;
    private string EditorDescription { get; set; } = string.Empty;
    private string EditorStartingNodeId { get; set; } = string.Empty;
    private bool EditorConfirmBeforeRun { get; set; }
    private List<MacroStepDraft> EditorSteps { get; } = [];
    private bool IsSendingCapturedKey { get; set; }
    private string CaptureCustomKey { get; set; } = string.Empty;
    private RemoteKeyAction CaptureCustomAction { get; set; } = RemoteKeyAction.Click;
    private int? CaptureWaitMilliseconds { get; set; } = 300;
    private bool IsCapturePaused { get; set; }

    private bool IsLocked => IsBusy || Run.IsRunning || Snapshot.NavigationRunning || IsEditing;
    private bool CanRun => Snapshot.ConnectionState == SamsungConnectionState.Connected
        && !IsLocked && !IsEditing && PendingRunMacroName is null && !string.IsNullOrWhiteSpace(SelectedMacro);
    private bool CanManageQuickAccess => !IsLocked && !IsEditing
        && SelectedSummary?.Verified == true && !string.IsNullOrWhiteSpace(SelectedMacro);
    private bool CanCaptureKey => IsEditing
        && Snapshot.ConnectionState == SamsungConnectionState.Connected
        && !IsBusy && !IsSendingCapturedKey && !Run.IsRunning && !Snapshot.NavigationRunning;
    private bool CanToggleCapturePause => IsEditing
        && !IsBusy && !IsSendingCapturedKey && !Run.IsRunning && !Snapshot.NavigationRunning;
    private bool CanPrepareEditorStart => IsEditing
        && Snapshot.ConnectionState == SamsungConnectionState.Connected
        && !IsBusy && !IsSendingCapturedKey && !Run.IsRunning && !Snapshot.NavigationRunning
        && !string.IsNullOrWhiteSpace(EditorStartingNodeId);
    private MacroSummary? SelectedSummary => CatalogMacros.FirstOrDefault(macro =>
        macro.Name.Equals(SelectedMacro, StringComparison.OrdinalIgnoreCase));
    private QuickAccessAction? SelectedQuickAction => QuickActions.FirstOrDefault(action =>
        action.Kind == QuickAccessActionKind.Macro
        && action.Target.Equals(SelectedMacro, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<MacroSummary> CallableMacros => CatalogMacros.Where(macro =>
        !macro.Name.Equals(EditorName, StringComparison.OrdinalIgnoreCase));
    private IReadOnlyList<MenuNodeSummary> VerifiedMenuItems => Navigation.Nodes
        .Where(node => node.HasVerifiedRoute)
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        Snapshot = Controller.GetSnapshot();
        Run = Controller.GetMacroRunSnapshot();
        Navigation = Controller.GetMenuNavigationSnapshot();
        QuickActions = Controller.GetQuickAccessActions();
        Controller.Changed += HandleControllerChanged;
        await Controller.InitializeAsync();
        Snapshot = Controller.GetSnapshot();
        MacroPath = Snapshot.MacroFilePath;
        await LoadMacrosAsync(savePath: false);
    }

    private Task LoadMacrosAsync() => LoadMacrosAsync(savePath: true);

    private async Task LoadMacrosAsync(bool savePath)
    {
        IsLoading = true;
        ErrorMessage = null;
        StatusMessage = null;
        try
        {
            CatalogMacros = savePath
                ? await Controller.SetMacroFileAsync(MacroPath)
                : await Controller.LoadMacrosAsync();
            SelectedMacro = null;
            SelectedDetails = null;
            AwaitingValidationName = null;
            PendingRunMacroName = null;
            ListDeleteConfirmationName = null;
            MacroPath = Controller.GetSnapshot().MacroFilePath;
            CancelEdit();
        }
        catch (FileNotFoundException)
        {
            CatalogMacros = [];
            SelectedMacro = null;
            SelectedDetails = null;
            StatusMessage = "This catalog does not exist yet. Select New macro to create it.";
        }
        catch (Exception exception)
        {
            CatalogMacros = [];
            SelectedMacro = null;
            SelectedDetails = null;
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SelectMacroAsync(string name)
    {
        if (SelectedMacro?.Equals(name, StringComparison.OrdinalIgnoreCase) == true)
        {
            SelectedMacro = null;
            SelectedDetails = null;
            AwaitingValidationName = null;
            PendingRunMacroName = null;
            ListDeleteConfirmationName = null;
            ErrorMessage = null;
            StatusMessage = null;
            CancelEdit();
            return;
        }

        SelectedMacro = name;
        AwaitingValidationName = null;
        PendingRunMacroName = null;
        ListDeleteConfirmationName = null;
        ErrorMessage = null;
        StatusMessage = null;
        CancelEdit();
        await LoadSelectedDetailsAsync();
    }

    private async Task LoadSelectedDetailsAsync()
    {
        SelectedDetails = SelectedMacro is null
            ? null
            : await Controller.LoadMacroDetailsAsync(SelectedMacro);
    }

