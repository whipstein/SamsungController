    private void StartDuplicateMacro()
    {
        if (SelectedDetails is null)
        {
            return;
        }

        OriginalName = null;
        EditorName = CreateCopyName(SelectedDetails.Name);
        EditorDescription = SelectedDetails.Description ?? string.Empty;
        EditorStartingNodeId = SelectedDetails.StartingNodeId ?? GetPreferredStartingNodeId();
        EditorConfirmBeforeRun = SelectedDetails.ConfirmBeforeRun;
        IsCapturePaused = false;
        EditorSteps.Clear();
        EditorSteps.AddRange(SelectedDetails.Steps.Select(MacroStepDraft.FromStep));
        DeleteConfirmation = false;
        PendingRunMacroName = null;
        ListDeleteConfirmationName = null;
        IsEditing = true;
        ErrorMessage = null;
        StatusMessage = "Review the duplicate, then save it as a new unverified macro.";
        AwaitingValidationName = null;
    }

    private string CreateCopyName(string sourceName)
    {
        var candidate = $"{sourceName}-copy";
        var suffix = 2;
        while (CatalogMacros.Any(macro => macro.Name.Equals(candidate, StringComparison.OrdinalIgnoreCase)))
        {
            candidate = $"{sourceName}-copy-{suffix++}";
        }

        return candidate;
    }

    private void AddStep(MacroStepKind kind)
    {
        var step = MacroStepDraft.Create(kind);
        if (kind == MacroStepKind.Menu)
        {
            step.MenuNodeId = VerifiedMenuItems.FirstOrDefault()?.Id ?? string.Empty;
        }

        EditorSteps.Add(step);
    }

    private Task SendAndCaptureCustomKeyAsync() =>
        SendAndCaptureKeyAsync(CaptureCustomKey, CaptureCustomAction);

    private Task PrepareEditorStartAsync() => RunBusyAsync(async () =>
    {
        await Controller.PrepareMacroRecordingStartAsync(EditorStartingNodeId);
        StatusMessage = $"Starting TV state prepared: {GetMenuPath(EditorStartingNodeId)}. Capture the first macro button when ready.";
    });

    private void ToggleCapturePause()
    {
        if (!CanToggleCapturePause)
        {
            return;
        }

        IsCapturePaused = !IsCapturePaused;
        StatusMessage = IsCapturePaused
            ? "Capture paused. Live actions will still be sent to the TV without changing the draft."
            : "Capture resumed. The next successful live action will be appended to the draft.";
        ErrorMessage = null;
    }

    private async Task SendAndCaptureKeyAsync(
        string key,
        RemoteKeyAction action = RemoteKeyAction.Click)
    {
        if (!CanCaptureKey || string.IsNullOrWhiteSpace(key))
        {
            return;
        }

        if (!IsCapturePaused && CaptureWaitMilliseconds is <= 0 or > 86_400_000)
        {
            ErrorMessage = "Captured-key wait must be from 1 through 86,400,000 ms.";
            return;
        }

        IsSendingCapturedKey = true;
        ErrorMessage = null;
        try
        {
            var normalizedKey = key.Trim();
            await Controller.SendKeyAsync(normalizedKey, action);
            if (IsCapturePaused)
            {
                StatusMessage = $"Sent {action} {normalizedKey}; capture is paused, so the draft was not changed.";
            }
            else
            {
                EditorSteps.Add(MacroStepDraft.CreateCapturedKey(
                    normalizedKey,
                    action,
                    CaptureWaitMilliseconds));
                StatusMessage = $"Sent and captured {action} {normalizedKey} as step {EditorSteps.Count}.";
            }
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSendingCapturedKey = false;
        }
    }

    private async Task SendAndCaptureMenuAsync(MenuNodeSummary menuItem)
    {
        if (!CanCaptureKey)
        {
            return;
        }

        IsSendingCapturedKey = true;
        ErrorMessage = null;
        try
        {
            await Controller.NavigateToMenuNodeAsync(menuItem.Id);
            if (IsCapturePaused)
            {
                StatusMessage = $"Navigated to {menuItem.Path}; capture is paused, so the draft was not changed.";
            }
            else
            {
                EditorSteps.Add(MacroStepDraft.CreateMenu(menuItem.Id));
                StatusMessage = $"Navigated to {menuItem.Path} and captured it as step {EditorSteps.Count}.";
            }
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSendingCapturedKey = false;
        }
    }

    private void UndoLastEditorStep()
    {
        if (EditorSteps.Count > 0)
        {
            EditorSteps.RemoveAt(EditorSteps.Count - 1);
        }
    }

    private void ClearEditorSteps() => EditorSteps.Clear();

    private void MoveStep(int index, int offset)
    {
        var destination = index + offset;
        if (index < 0 || index >= EditorSteps.Count || destination < 0 || destination >= EditorSteps.Count)
        {
            return;
        }

        var item = EditorSteps[index];
        EditorSteps.RemoveAt(index);
        EditorSteps.Insert(destination, item);
    }

    private void DeleteStep(int index)
    {
        if (index >= 0 && index < EditorSteps.Count)
        {
            EditorSteps.RemoveAt(index);
        }
    }

    private async Task SaveMacroAsync()
    {
        await RunBusyAsync(async () =>
        {
            var request = BuildEditRequest();
            var saved = await Controller.SaveMacroAsync(OriginalName, request);
            CatalogMacros = await Controller.LoadMacrosAsync();
            SelectedMacro = saved.Name;
            await LoadSelectedDetailsAsync();
            IsEditing = false;
            IsCapturePaused = false;
            OriginalName = null;
            EditorSteps.Clear();
            AwaitingValidationName = null;
            StatusMessage = saved.Verified
                ? $"Saved {saved.Name}; its verified behavior was unchanged."
                : $"Saved {saved.Name}; replay it and count three visual passes.";
        });
    }

    private MacroEditRequest BuildEditRequest()
    {
        if (string.IsNullOrWhiteSpace(EditorName))
        {
            throw new InvalidOperationException("Enter a macro name.");
        }

        if (EditorSteps.Count == 0)
        {
            throw new InvalidOperationException("Add at least one macro operation.");
        }

        if (string.IsNullOrWhiteSpace(EditorStartingNodeId))
        {
            throw new InvalidOperationException(
                "Select a verified starting TV state. Define and verify at least one menu state first if this list is empty.");
        }

        return new MacroEditRequest(
            EditorName,
            EditorDescription,
            EditorSteps.Select((step, index) => step.ToStep(index + 1)).ToArray(),
            EditorStartingNodeId,
            EditorConfirmBeforeRun);
    }

    private void CancelEdit()
    {
        IsEditing = false;
        DeleteConfirmation = false;
        OriginalName = null;
        EditorName = string.Empty;
        EditorDescription = string.Empty;
        EditorStartingNodeId = string.Empty;
        EditorConfirmBeforeRun = false;
        IsCapturePaused = false;
        EditorSteps.Clear();
    }

    private async Task DeleteSelectedMacroAsync()
    {
        if (OriginalName is null)
        {
            return;
        }

        var deleted = OriginalName;
        await RunBusyAsync(async () =>
        {
            await Controller.DeleteMacroAsync(deleted);
            CatalogMacros = await Controller.LoadMacrosAsync();
            QuickActions = Controller.GetQuickAccessActions();
            SelectedMacro = null;
            await LoadSelectedDetailsAsync();
            CancelEdit();
            AwaitingValidationName = null;
            StatusMessage = $"Deleted {deleted} from the YAML catalog.";
        });
    }

