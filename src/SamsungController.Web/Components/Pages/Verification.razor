@page "/verification"
@implements IDisposable
@inject SamsungControllerService Controller
@using SamsungController.Automation.Navigation
@using SamsungController.Core.Connection

<PageTitle>Display Verification · SamsungController</PageTitle>

<section class="verification-page">
    <header class="page-heading verification-heading">
        <div>
            <span class="eyebrow">LOCAL DISPLAY PROFILE</span>
            <h1>Verify this menu structure on this display</h1>
            <p>A compact representative checklist for the loaded menu structure, display model, and firmware.</p>
        </div>
        <HelpBubble Title="How complete verification works">
            <ol>
                <li>Confirm the physical display and viewing combination shown below.</li>
                <li>Carry forward routes and controls already verified elsewhere in the app.</li>
                <li>For timing, anchor, return-script, and route checks, use <strong>Prepare start</strong> and <strong>Run test</strong> directly on the listed line.</li>
                <li>Use <strong>Run guided test</strong> for each remaining representative control behavior. The app opens the right menu and makes a safe, visible adjustment for you.</li>
                <li>Count or fail the result on that same line. Use the remote only if the TV needs a manual correction.</li>
                <li>If a result was accepted accidentally, select <strong>Remove validation</strong> on that completed line. Only that local display result is removed.</li>
            </ol>
            <p class="help-callout safe">Equivalent controls and conditional effects are covered by representative behavior classes. Each class is fingerprinted in a local display-verification sidecar, so YAML and JSON structure files remain portable. A relevant structure edit reopens only the affected class.</p>
        </HelpBubble>
    </header>

    <div class="verification-hero @(VerificationState.FullyVerified ? "complete" : "required")">
        <div class="verification-gauge" style="--verification-progress: @ProgressPercent%">
            <strong>@VerificationState.VerifiedCount</strong>
            <span>/ @VerificationState.RequiredCount</span>
        </div>
        <div>
            <span>@(VerificationState.FullyVerified ? "DISPLAY PROFILE FULLY VERIFIED" : "DISPLAY VERIFICATION REQUIRED")</span>
            <h2>@(VerificationState.FullyVerified ? "This structure matches the recorded display combination." : $"{VerificationState.RemainingCount} check{(VerificationState.RemainingCount == 1 ? "" : "s")} remain before this structure is trusted on this display.")</h2>
            <p>@VerificationState.CurrentDisplay</p>
            @if (VerificationState.RecordedDisplay is { } recordedDisplay)
            {
                <small>Manifest display · @recordedDisplay</small>
            }
        </div>
        <div class="verification-hero-actions">
            <button class="secondary-action" @onclick="CarryForwardAsync" disabled="@IsBusy">Carry forward existing verified work</button>
            @if (VerificationState.LastVerifiedAtUtc is { } lastVerified)
            {
                <small>Last confirmation · @lastVerified.ToLocalTime().ToString("g")</small>
            }
        </div>
    </div>

    @if (VerificationState.StaleRecordCount > 0)
    {
        <div class="verification-change-alert" role="status">
            <strong>Menu-structure changes detected</strong>
            <span>@VerificationState.StaleRecordCount previous result@((VerificationState.StaleRecordCount == 1 ? " no longer matches" : "s no longer match")); the affected checks are open below.</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="feedback danger" role="alert">@ErrorMessage</div>
    }
    else if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="feedback" role="status">@StatusMessage</div>
    }

    <div class="verification-workspace">
        <div class="verification-checklist">
            @foreach (var group in Groups)
            {
                <section class="verification-group">
                    <header>
                        <div><span>@group.Index</span><strong>@group.Label</strong></div>
                        <small>@group.Checks.Count(check => check.Verified) / @group.Checks.Count verified</small>
                    </header>
                    <div class="verification-checks">
                        @foreach (var check in group.Checks)
                        {
                            <article id="verification-check-@check.Id" class="verification-check @(check.Verified ? "verified" : "pending")">
                                <div class="verification-check-state" aria-hidden="true">@(check.Verified ? "✓" : "!")</div>
                                <div class="verification-check-copy">
                                    <span>@FormatKind(check.Kind)@FormatConfiguration(check)</span>
                                    <strong>@check.Label</strong>
                                    <p>@check.Description</p>
                                    @if (!check.Verified && !check.ExistingEvidenceReady && RequiresEvidenceTest(check))
                                    {
                                        <small class="verification-route-progress">Visual validation · @check.ValidationPasses/@check.RequiredValidationPasses passes</small>
                                    }
                                    @if (!check.Verified && !check.ExistingEvidenceReady && check.Kind == MenuVerificationCheckKind.Timing && Authoring.TimingTestRoutes.Count > 0)
                                    {
                                        <label class="verification-inline-route">
                                            <span>TEST USING</span>
                                            <select @bind="SelectedTimingTestRouteId" disabled="@IsBusy">
                                                @foreach (var route in Authoring.TimingTestRoutes)
                                                {
                                                    <option value="@route.Id">@route.SourcePath → @route.TargetPath · @route.CommandCount commands</option>
                                                }
                                            </select>
                                            <small>START AT · @SelectedTimingTestRoute?.SourcePath</small>
                                            <small>Prepare start sends the defined anchor and source route, even if they still need verification. Check the TV before selecting Run test.</small>
                                        </label>
                                    }
                                    @if (!check.Verified && RequiresEvidenceTest(check) && !check.ExistingEvidenceReady)
                                    {
                                        <small class="verification-prerequisite">@EvidenceInstruction(check)</small>
                                    }
                                    else if (!check.Verified && check.ExistingEvidenceReady)
                                    {
                                        <small class="verification-evidence">Existing verified evidence is ready to carry into this file.</small>
                                    }
                                    else if (check.VerifiedAtUtc is { } verifiedAt)
                                    {
                                        <small class="verification-evidence">Recorded @verifiedAt.ToLocalTime().ToString("g")</small>
                                    }
                                    @if (IsPendingVisualTest(check))
                                    {
                                        <small class="verification-test-result">@PendingVisualTest!.ActionDescription</small>
                                    }
                                    else if (IsGuidedTestError(check))
                                    {
                                        <small class="verification-test-error">@GuidedTestErrorMessage</small>
                                    }
                                    @if (EvidenceActionCheckId == check.Id && EvidenceActionMessage is not null)
                                    {
                                        <small class="@(EvidenceActionFailed ? "verification-test-error" : "verification-test-result")"
                                               role="@(EvidenceActionFailed ? "alert" : "status")">@EvidenceActionMessage</small>
                                    }
                                </div>
                                <div class="verification-check-actions">
                                    @if (IsPendingVisualTest(check))
                                    {
                                        <button class="primary-action" @onclick="() => ConfirmGuidedTestAsync(check, true)" disabled="@IsBusy">Count pass</button>
                                        <button class="quiet-action" @onclick="() => ConfirmGuidedTestAsync(check, false)" disabled="@IsBusy">Failed</button>
                                    }
                                    else if (check.AwaitingValidationConfirmation)
                                    {
                                        <button class="primary-action" @onclick="() => ConfirmEvidenceTestAsync(check, true)" disabled="@IsBusy">Count pass</button>
                                        <button class="quiet-action" @onclick="() => ConfirmEvidenceTestAsync(check, false)" disabled="@IsBusy">Failed</button>
                                    }
                                    else if (!check.Verified && !check.ExistingEvidenceReady && CanRunEvidenceTest(check) && check.IsForActiveConfiguration)
                                    {
                                        <button class="secondary-action" @onclick="() => PrepareEvidenceTestAsync(check)" disabled="@TvActionsDisabled">Prepare start</button>
                                        <button class="primary-action" @onclick="() => RunEvidenceTestAsync(check)" disabled="@TvActionsDisabled">Run test</button>
                                    }
                                    else if (!check.Verified && !check.ExistingEvidenceReady && RequiresEvidenceTest(check) && !check.IsForActiveConfiguration)
                                    {
                                        <button class="secondary-action" @onclick="() => ActivateConfigurationAsync(check)" disabled="@IsBusy">Use @check.ConfigurationId layout</button>
                                    }
                                    else if (!check.Verified && !check.ExistingEvidenceReady && CanRunGuidedTest(check))
                                    {
                                        <button class="primary-action" @onclick="() => RunGuidedTestAsync(check)" disabled="@TvActionsDisabled">@(IsRunningGuidedTest(check) ? "Preparing test…" : "Run guided test")</button>
                                    }
                                    else if (!check.Verified && !check.IsForActiveConfiguration && IsGuidedVisualCheck(check))
                                    {
                                        <button class="secondary-action" @onclick="() => ActivateConfigurationAsync(check)" disabled="@IsBusy">Use @check.ConfigurationId layout</button>
                                    }
                                    else if (check.Verified && CanOpenOnTv(check))
                                    {
                                        <button class="secondary-action" @onclick="() => OpenOnTvAsync(check)" disabled="@TvActionsDisabled">Open on TV</button>
                                    }
                                    @if (!check.AwaitingValidationConfirmation && check.Verified)
                                    {
                                        <button class="quiet-action danger-action"
                                                title="Remove this saved result from the local display-verification record"
                                                @onclick="() => RemoveValidationAsync(check)"
                                                disabled="@IsBusy">Remove validation</button>
                                    }
                                    else if (!check.AwaitingValidationConfirmation && (check.ExistingEvidenceReady || check.Kind == MenuVerificationCheckKind.Display) && CanConfirm(check))
                                    {
                                        <button class="primary-action" @onclick="() => ConfirmAsync(check)" disabled="@IsBusy">@ConfirmationLabel(check)</button>
                                    }
                                    else if (!check.AwaitingValidationConfirmation && !check.Verified && !check.ExistingEvidenceReady && check.IsForActiveConfiguration && NeedsRelatedReturnCheck(check))
                                    {
                                        <a class="secondary-action" href="verification#verification-check-@check.RelatedReturnCheckId">Go to matching return test</a>
                                    }
                                    else if (!check.AwaitingValidationConfirmation && !check.Verified && !check.ExistingEvidenceReady && check.IsForActiveConfiguration && RequiresEvidenceTest(check) && !CanRunEvidenceTest(check) && !NeedsRelatedReturnCheck(check))
                                    {
                                        <a class="secondary-action" href="menu/build#draft-validation">Add missing definition</a>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>

        <aside class="verification-remote-panel">
            <div class="panel-label"><span>MANUAL CORRECTION REMOTE</span><span>EXPLICIT KEYS</span></div>
            <p>The guided test handles normal verification. Use these keys only to correct the TV before counting or failing the active result.</p>
            <div class="verification-remote-top">
                <button @onclick='() => SendKeyAsync("KEY_MENU")' disabled="@TvActionsDisabled">☰<small>Menu</small></button>
                <button @onclick='() => SendKeyAsync("KEY_HOME")' disabled="@TvActionsDisabled">⌂<small>Home</small></button>
            </div>
            <div class="verification-dpad">
                <button class="up" aria-label="Up" @onclick='() => SendKeyAsync("KEY_UP")' disabled="@TvActionsDisabled">↑</button>
                <button class="left" aria-label="Left" @onclick='() => SendKeyAsync("KEY_LEFT")' disabled="@TvActionsDisabled">←</button>
                <button class="enter" aria-label="Enter" @onclick='() => SendKeyAsync("KEY_ENTER")' disabled="@TvActionsDisabled">OK</button>
                <button class="right" aria-label="Right" @onclick='() => SendKeyAsync("KEY_RIGHT")' disabled="@TvActionsDisabled">→</button>
                <button class="down" aria-label="Down" @onclick='() => SendKeyAsync("KEY_DOWN")' disabled="@TvActionsDisabled">↓</button>
            </div>
            <button class="verification-return" @onclick='() => SendKeyAsync("KEY_RETURN")' disabled="@TvActionsDisabled">↩ <span>Return</span></button>
            <small>The TV does not report its highlighted value. Visual confirmation remains the authority.</small>
        </aside>
    </div>
</section>

@code {
    private ControllerSnapshot ControllerState { get; set; } = null!;
    private MenuAuthoringSnapshot Authoring { get; set; } = null!;
    private MenuDefinitionVerificationSnapshot VerificationState { get; set; } = null!;
    private MenuControlVerificationSnapshot ControlVerification { get; set; } = null!;
    private MenuDefinitionVerificationTestResult? PendingVisualTest { get; set; }
    private string? ActiveGuidedCheckId { get; set; }
    private string? GuidedTestErrorCheckId { get; set; }
    private string? GuidedTestErrorMessage { get; set; }
    private string SelectedTimingTestRouteId { get; set; } = string.Empty;
    private MenuTimingTestRouteSummary? SelectedTimingTestRoute => Authoring.TimingTestRoutes
        .FirstOrDefault(route => route.Id.Equals(SelectedTimingTestRouteId, StringComparison.OrdinalIgnoreCase));
    private string? EvidenceActionCheckId { get; set; }
    private string? EvidenceActionMessage { get; set; }
    private bool EvidenceActionFailed { get; set; }
    private bool IsBusy { get; set; }
    private string? StatusMessage { get; set; }
    private string? ErrorMessage { get; set; }

    private int ProgressPercent => VerificationState.RequiredCount == 0
        ? 0
        : VerificationState.VerifiedCount * 100 / VerificationState.RequiredCount;
    private bool TvActionsDisabled => IsBusy
        || ControllerState.ConnectionState != SamsungConnectionState.Connected
        || ControllerState.MacroRunning
        || ControllerState.NavigationRunning
        || Authoring.IsRecording;
    private IReadOnlyList<VerificationGroup> Groups =>
    new[]
    {
        CreateGroup("01", "Display & timing", VerificationState.Checks.Where(check => check.Kind is MenuVerificationCheckKind.Display or MenuVerificationCheckKind.Timing)),
        CreateGroup("02", "Menu locations & return paths", VerificationState.Checks.Where(check => check.Kind is MenuVerificationCheckKind.Anchor or MenuVerificationCheckKind.ReturnScript or MenuVerificationCheckKind.Route or MenuVerificationCheckKind.CalculatedNavigation)),
        CreateGroup("03", "Representative control behaviors", VerificationState.Checks.Where(check => check.Kind is MenuVerificationCheckKind.SliderBehavior or MenuVerificationCheckKind.Selection or MenuVerificationCheckKind.Switch or MenuVerificationCheckKind.Confirmation)),
        CreateGroup("04", "Representative conditional behaviors", VerificationState.Checks.Where(check => check.Kind == MenuVerificationCheckKind.ConditionalVisibility))
    }.Where(group => group.Checks.Count > 0).ToArray();

    protected override async Task OnInitializedAsync()
    {
        Refresh();
        Controller.Changed += HandleControllerChanged;
        await Controller.InitializeAsync();
        Refresh();
    }

    private async Task CarryForwardAsync() => await RunAsync(async () =>
    {
        PendingVisualTest = null;
        VerificationState = await Controller.CarryForwardExistingMenuVerificationAsync();
        StatusMessage = "Existing verified timing, routes, slider behavior, and selections were recorded for this display and menu structure.";
    });

    private async Task ConfirmAsync(MenuDefinitionVerificationCheckSummary check) => await RunAsync(async () =>
    {
        VerificationState = await Controller.ConfirmMenuDefinitionVerificationCheckAsync(check.Id);
        StatusMessage = VerificationState.FullyVerified
            ? "Complete verification recorded. The loaded menu definition and display combination are fully verified."
            : $"Verification recorded for {check.Label}.";
    });

    private async Task RemoveValidationAsync(MenuDefinitionVerificationCheckSummary check) => await RunAsync(async () =>
    {
        PendingVisualTest = null;
        VerificationState = await Controller.RemoveMenuDefinitionVerificationCheckAsync(check.Id);
        StatusMessage = $"Removed the saved display validation for {check.Label}. Other validation results were not changed.";
    });

    private async Task OpenOnTvAsync(MenuDefinitionVerificationCheckSummary check) => await RunAsync(async () =>
    {
        if (check.Id is "condition:external-disabled-behavior" or "condition:external-hidden-behavior")
        {
            // External-condition checks only inspect a row; they do not adjust
            // controls. Use the same highlight-only path after verification too.
            var result = await Controller.RunMenuDefinitionVerificationTestAsync(check.Id);
            StatusMessage = $"{result.ActionDescription} The recorded verification result was not changed.";
            return;
        }
        await Controller.NavigateToMenuNodeAsync(check.TargetNodeId!);
        StatusMessage = $"Opened {check.Label} without changing its recorded verification result.";
    });

    private async Task ActivateConfigurationAsync(MenuDefinitionVerificationCheckSummary check) => await RunAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(check.ConfigurationId))
        {
            throw new InvalidOperationException(
                $"{check.Label} does not declare a menu configuration.");
        }

        await Controller.SetMenuConfigurationAsync(check.ConfigurationId);
        StatusMessage = $"Selected {check.ConfigurationId} for {check.Label}. Its verification controls are now ready on this line.";
    });

    private async Task RunGuidedTestAsync(MenuDefinitionVerificationCheckSummary check)
    {
        ActiveGuidedCheckId = check.Id;
        GuidedTestErrorCheckId = null;
        GuidedTestErrorMessage = null;
        await RunAsync(async () =>
        {
            PendingVisualTest = await Controller.RunMenuDefinitionVerificationTestAsync(check.Id);
            StatusMessage = PendingVisualTest.ActionDescription;
        });
        if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            GuidedTestErrorCheckId = check.Id;
            GuidedTestErrorMessage = ErrorMessage;
        }

        ActiveGuidedCheckId = null;
    }

    private async Task ConfirmGuidedTestAsync(
        MenuDefinitionVerificationCheckSummary check,
        bool passed) => await RunAsync(async () =>
    {
        var test = PendingVisualTest;
        if (test is null || !test.CheckId.Equals(check.Id, StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException("Run this guided test before counting its result.");
        }

        if (!passed)
        {
            var failedTarget = test.TargetPath;
            var restoredCount = await Controller.RestoreMenuDefinitionVerificationTestAsync(test);
            PendingVisualTest = null;
            var recoveryState = await Controller.ReturnMenuDefinitionVerificationToKnownStateAsync();
            StatusMessage = $"{failedTarget} was not counted. Restored {restoredCount} temporary value{(restoredCount == 1 ? string.Empty : "s")} and returned the TV to {recoveryState}; rerun the guided test after correcting the definition or timing.";
            return;
        }

        var restoredValues = await Controller.RestoreMenuDefinitionVerificationTestAsync(test);
        var behaviorComplete = true;
        if (test.ControlType == MenuControlType.Slider)
        {
            ControlVerification = await Controller.ConfirmMenuSliderBehaviorAsync(test.TargetNodeId);
            behaviorComplete = ControlVerification.SlidersVerified;
        }
        else if (test.ControlType is MenuControlType.Selection
                     or MenuControlType.SubmenuSelection
                     or MenuControlType.IndexedSelection)
        {
            ControlVerification = await Controller.ConfirmMenuSelectionBehaviorAsync(test.TargetNodeId);
        }

        if (behaviorComplete)
        {
            VerificationState = await Controller.ConfirmMenuDefinitionVerificationCheckAsync(check.Id);
        }

        PendingVisualTest = null;
        var knownState = await Controller.ReturnMenuDefinitionVerificationToKnownStateAsync();
        if (!behaviorComplete)
        {
            StatusMessage = $"Slider pass counted ({ControlVerification.ConfirmedSliderCount}/{ControlVerification.RequiredSliderCount}). Restored {restoredValues} temporary value{(restoredValues == 1 ? string.Empty : "s")} and returned the TV to {knownState}; run this line again for the next representative slider.";
            return;
        }

        StatusMessage = VerificationState.FullyVerified
            ? $"{check.Label} passed. Restored {restoredValues} temporary value{(restoredValues == 1 ? string.Empty : "s")}; the file is fully verified, and the TV returned to {knownState}."
            : $"{check.Label} passed and was recorded. Restored {restoredValues} temporary value{(restoredValues == 1 ? string.Empty : "s")} before returning the TV to {knownState}.";
    });

    private async Task PrepareEvidenceTestAsync(MenuDefinitionVerificationCheckSummary check) => await RunEvidenceActionAsync(check, async () =>
    {
        switch (check.Kind)
        {
            case MenuVerificationCheckKind.Timing:
                await Controller.PrepareMenuTimingProfileTestSourceAsync(
                    GetSelectedTimingTestRouteId());
                break;
            case MenuVerificationCheckKind.ReturnScript
                when check.ReturnScriptKind == MenuReturnScriptKind.NodeOverride:
                await Controller.PrepareMenuVerificationSourceAsync(check.TargetNodeId!);
                break;
            case MenuVerificationCheckKind.ReturnScript
                when check.ReturnScriptKind is { } returnKind:
                await Controller.PrepareMenuReturnStrategyTestSourceAsync(
                    returnKind,
                    returnKind == MenuReturnScriptKind.BelowMenuRoot
                        ? check.TargetNodeId
                        : null);
                break;
            case MenuVerificationCheckKind.Anchor or MenuVerificationCheckKind.Route
                when check.AuthoringItemKind is { } itemKind:
                await Controller.PrepareMenuAuthoringValidationSourceAsync(
                    itemKind,
                    check.AuthoringItemId!);
                break;
            default:
                throw new InvalidOperationException(
                    $"{check.Label} does not have a test start that can be prepared yet.");
        }

        StatusMessage = check.Kind == MenuVerificationCheckKind.Timing
            ? $"Start prepared · {SelectedTimingTestRoute?.SourcePath}. Check the TV, then select Run test. Preparation does not count a pass."
            : $"Prepared the displayed start for {check.Label}. Manually correct the TV if needed, then run the test.";
    });

    private async Task RunEvidenceTestAsync(MenuDefinitionVerificationCheckSummary check) => await RunEvidenceActionAsync(check, async () =>
    {
        switch (check.Kind)
        {
            case MenuVerificationCheckKind.Timing:
                await Controller.RunMenuTimingProfileTestAsync(
                    GetSelectedTimingTestRouteId(),
                    Authoring.Timing);
                break;
            case MenuVerificationCheckKind.ReturnScript
                when check.ReturnScriptKind is { } returnKind:
                await Controller.RunMenuReturnStrategyTestAsync(
                    returnKind,
                    returnKind is MenuReturnScriptKind.BelowMenuRoot
                        or MenuReturnScriptKind.NodeOverride
                        ? check.TargetNodeId
                        : null);
                break;
            case MenuVerificationCheckKind.Anchor or MenuVerificationCheckKind.Route
                when check.AuthoringItemKind is { } itemKind:
                await Controller.RunMenuAuthoringValidationAsync(
                    itemKind,
                    check.AuthoringItemId!);
                break;
            default:
                throw new InvalidOperationException(
                    $"{check.Label} does not have an inline verification test yet.");
        }

        StatusMessage = $"Inspect the TV, then count or fail {check.Label} on this line.";
    });

    private async Task ConfirmEvidenceTestAsync(
        MenuDefinitionVerificationCheckSummary check,
        bool passed) => await RunEvidenceActionAsync(check, async () =>
    {
        switch (check.Kind)
        {
            case MenuVerificationCheckKind.Timing:
                await Controller.ConfirmMenuTimingProfileTestAsync(passed);
                break;
            case MenuVerificationCheckKind.ReturnScript:
                await Controller.ConfirmMenuReturnStrategyTestAsync(passed);
                break;
            case MenuVerificationCheckKind.Anchor or MenuVerificationCheckKind.Route:
                await Controller.ConfirmMenuAuthoringValidationAsync(passed);
                break;
            default:
                throw new InvalidOperationException(
                    $"{check.Label} does not have an active evidence test.");
        }

        var refreshed = Controller.GetMenuDefinitionVerificationSnapshot();
        var current = refreshed.Checks.FirstOrDefault(item => item.Id.Equals(
            check.Id,
            StringComparison.OrdinalIgnoreCase));
        if (passed && current?.ExistingEvidenceReady == true && !current.Verified)
        {
            refreshed = await Controller.ConfirmMenuDefinitionVerificationCheckAsync(check.Id);
        }

        VerificationState = refreshed;
        StatusMessage = !passed
            ? $"{check.Label} failed. Its pass count returned to zero."
            : current?.ExistingEvidenceReady == true
                ? $"{check.Label} completed 3/3 and was recorded for this display and menu structure."
                : $"Pass counted for {check.Label}. Prepare its displayed start for the next run.";
    });

    private async Task SendKeyAsync(string key) => await RunAsync(async () =>
    {
        await Controller.SendKeyAsync(key);
        StatusMessage = $"Sent {key}.";
    });

    private async Task RunEvidenceActionAsync(MenuDefinitionVerificationCheckSummary check, Func<Task> action)
    {
        EvidenceActionCheckId = check.Id;
        EvidenceActionMessage = "Working…";
        EvidenceActionFailed = false;
        await RunAsync(action);
        EvidenceActionFailed = ErrorMessage is not null;
        EvidenceActionMessage = ErrorMessage ?? StatusMessage;
    }

    private async Task RunAsync(Func<Task> action)
    {
        IsBusy = true;
        ErrorMessage = null;
        StatusMessage = null;
        try
        {
            await action();
        }
        catch (OperationCanceledException)
        {
            StatusMessage = "Verification action cancelled.";
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsBusy = false;
            Refresh();
        }
    }

    private void Refresh()
    {
        ControllerState = Controller.GetSnapshot();
        Authoring = Controller.GetMenuAuthoringSnapshot();
        VerificationState = Controller.GetMenuDefinitionVerificationSnapshot();
        ControlVerification = Controller.GetMenuControlVerificationSnapshot();
        if (string.IsNullOrWhiteSpace(SelectedTimingTestRouteId)
            || Authoring.TimingTestRoutes.All(route => !route.Id.Equals(
                SelectedTimingTestRouteId,
                StringComparison.OrdinalIgnoreCase)))
        {
            SelectedTimingTestRouteId = Authoring.ActiveTimingTestRouteId
                ?? Authoring.TimingTestRoutes.FirstOrDefault()?.Id
                ?? string.Empty;
        }
    }

    private void HandleControllerChanged()
    {
        Refresh();
        _ = InvokeAsync(StateHasChanged);
    }

    private static bool RequiresEvidenceTest(MenuDefinitionVerificationCheckSummary check) =>
        check.Kind is MenuVerificationCheckKind.Timing
            or MenuVerificationCheckKind.Anchor
            or MenuVerificationCheckKind.ReturnScript
            or MenuVerificationCheckKind.Route;

    private static bool CanConfirm(MenuDefinitionVerificationCheckSummary check) =>
        !RequiresEvidenceTest(check) || check.ExistingEvidenceReady;

    // Planner metadata describes actual definitions. The abbreviated builder list
    // intentionally omits some covered entry routes and is not a validity check.
    private bool CanRunEvidenceTest(MenuDefinitionVerificationCheckSummary check) =>
        check.Kind switch
        {
            MenuVerificationCheckKind.Timing =>
                Authoring.TimingTestRoutes.Count > 0
                && !string.IsNullOrWhiteSpace(SelectedTimingTestRouteId),
            MenuVerificationCheckKind.ReturnScript =>
                Authoring.ReturnStrategy is not null
                && check.ReturnScriptKind is not null
                && check.TargetNodeId is not null,
            MenuVerificationCheckKind.Anchor or MenuVerificationCheckKind.Route =>
                check.AuthoringItemKind is not null
                && check.AuthoringItemId is not null
                && !NeedsRelatedReturnCheck(check),
            _ => false
        };

    private bool NeedsRelatedReturnCheck(MenuDefinitionVerificationCheckSummary check) =>
        check.Kind == MenuVerificationCheckKind.Anchor
        && check.RelatedReturnCheckId is not null;

    private string EvidenceInstruction(MenuDefinitionVerificationCheckSummary check)
    {
        if (!check.IsForActiveConfiguration)
        {
            return $"Activate the {check.ConfigurationId} menu layout from this line before running its test.";
        }

        if (CanRunEvidenceTest(check))
        {
            return "Prepare the displayed starting point, run the test, and count three visual passes here.";
        }

        if (check.Kind == MenuVerificationCheckKind.Timing)
        {
            return "Record at least one traversal before testing system timing.";
        }

        if (NeedsRelatedReturnCheck(check))
        {
            var related = VerificationState.Checks.FirstOrDefault(item => item.Id == check.RelatedReturnCheckId);
            return $"This anchor uses the same commands as {related?.Label ?? "the matching return test"}. Complete that test on this page; its third pass also verifies this anchor. No definition is missing.";
        }

        return "The menu definition is missing the recorded route needed for this test.";
    }

    private string GetSelectedTimingTestRouteId() =>
        Authoring.TimingTestRoutes.Any(route => route.Id.Equals(
            SelectedTimingTestRouteId,
            StringComparison.OrdinalIgnoreCase))
            ? SelectedTimingTestRouteId
            : throw new InvalidOperationException(
                "Choose a timing test traversal before preparing or running this check.");

    private static bool CanOpenOnTv(MenuDefinitionVerificationCheckSummary check) =>
        check.TargetNodeId is not null
        && check.IsForActiveConfiguration
        && check.Kind is (MenuVerificationCheckKind.Selection
            or MenuVerificationCheckKind.Switch
            or MenuVerificationCheckKind.Confirmation
            or MenuVerificationCheckKind.ConditionalVisibility
            or MenuVerificationCheckKind.CalculatedNavigation
            or MenuVerificationCheckKind.SliderBehavior);

    private bool IsPendingVisualTest(MenuDefinitionVerificationCheckSummary check) =>
        PendingVisualTest?.CheckId.Equals(check.Id, StringComparison.OrdinalIgnoreCase) == true;

    private bool IsRunningGuidedTest(MenuDefinitionVerificationCheckSummary check) =>
        IsBusy
        && ActiveGuidedCheckId?.Equals(check.Id, StringComparison.OrdinalIgnoreCase) == true;

    private bool IsGuidedTestError(MenuDefinitionVerificationCheckSummary check) =>
        GuidedTestErrorCheckId?.Equals(check.Id, StringComparison.OrdinalIgnoreCase) == true
        && !string.IsNullOrWhiteSpace(GuidedTestErrorMessage);

    private static bool CanRunGuidedTest(MenuDefinitionVerificationCheckSummary check) =>
        CanOpenOnTv(check)
        && IsGuidedVisualCheck(check);

    private static bool IsGuidedVisualCheck(MenuDefinitionVerificationCheckSummary check) =>
        check.Kind is (MenuVerificationCheckKind.Selection
            or MenuVerificationCheckKind.Switch
            or MenuVerificationCheckKind.Confirmation
            or MenuVerificationCheckKind.ConditionalVisibility
            or MenuVerificationCheckKind.CalculatedNavigation
            or MenuVerificationCheckKind.SliderBehavior);

    private static string ConfirmationLabel(MenuDefinitionVerificationCheckSummary check) => check.Kind switch
    {
        MenuVerificationCheckKind.Display => "Confirm this display",
        MenuVerificationCheckKind.Timing or MenuVerificationCheckKind.Anchor or MenuVerificationCheckKind.ReturnScript or MenuVerificationCheckKind.Route => "Record existing result",
        _ => "Count visual pass"
    };

    private static string FormatKind(MenuVerificationCheckKind kind) => kind switch
    {
        MenuVerificationCheckKind.ConditionalVisibility => "CONDITIONAL STATE",
        MenuVerificationCheckKind.SliderBehavior => "SHARED BEHAVIOR",
        MenuVerificationCheckKind.ReturnScript => "RETURN SCRIPT",
        MenuVerificationCheckKind.CalculatedNavigation => "CALCULATED ROUTE",
        _ => kind.ToString().ToUpperInvariant()
    };

    private static string FormatConfiguration(MenuDefinitionVerificationCheckSummary check) =>
        string.IsNullOrWhiteSpace(check.ConfigurationId)
            ? string.Empty
            : $" · {check.ConfigurationId}{(check.IsForActiveConfiguration ? "" : " · inactive layout")}";

    private static VerificationGroup CreateGroup(
        string index,
        string label,
        IEnumerable<MenuDefinitionVerificationCheckSummary> checks) =>
        new(index, label, checks.ToArray());

    public void Dispose() => Controller.Changed -= HandleControllerChanged;

    private sealed record VerificationGroup(
        string Index,
        string Label,
        IReadOnlyList<MenuDefinitionVerificationCheckSummary> Checks);
}
