@page "/menu"
@page "/ip-controls"
@implements IDisposable
@using SamsungController.Core.IpRemote
@inject SamsungIpRemoteService Controller

<PageTitle>Menu · SamsungController</PageTitle>
<section class="page-heading compact-heading"><div><span class="eyebrow">DIRECT SETTINGS</span><h1>Menu</h1><p>Current values are queried from the TV. Documented commands are ready to use—no traversal recording or verification required.</p></div></section>
@if (Error is not null) { <div class="notice danger" role="alert">@Error</div> }
@if (!Snapshot.Menu.Connected) { <div class="notice"><strong>Display disconnected</strong><span>Connect to read current settings.</span><a href="/">Choose display →</a></div> }
@if (Snapshot.PictureTest?.RequiresRecovery == true || Snapshot.CommandTrial?.RequiresReview == true)
{ <div class="notice danger">An earlier diagnostic write needs attention. <a href="@(Snapshot.CommandTrial?.RequiresReview == true ? "ip-commands" : "diagnostics/picture-tests")">Open its saved recovery details</a>.</div> }

<section class="panel direct-panel">
    <div class="direct-toolbar">
        <div><h2>@(Category == "Picture" ? "Calibration controls" : Category + " controls")</h2><p>@(Snapshot.Menu.SectionsRead.TryGetValue(Section, out var readAt) ? "Read from TV " + readAt.ToLocalTime().ToString("HH:mm:ss") : "Select a section to read its current values.")</p></div>
        <div class="direct-actions"><button class="toolbar-button" @onclick="RefreshAsync" disabled="@(!CanWork)">Refresh TV values</button><button class="primary-action" @onclick="ApplyAsync" disabled="@(!CanApply)">Apply @Snapshot.Menu.Pending.Count pending</button><button class="toolbar-button danger-action" @onclick="Controller.Cancel" disabled="@(!Snapshot.IsBusy)">Stop</button></div>
    </div>
    <details class="direct-details compact"><summary>Update behavior · @(Snapshot.Menu.Preferences.ApplyImmediately ? "Apply immediately" : "Wait for Apply")</summary>
        <label class="direct-check"><input type="checkbox" aria-label="Apply settings immediately" checked="@Snapshot.Menu.Preferences.ApplyImmediately" @onchange="SetImmediateAsync" disabled="@Snapshot.IsBusy" /> Apply immediately when an edit is committed</label>
        <p>Sliders send when released, not on every drag event. Apply or discard pending changes before turning this on. Direct settings do not open menus, so no return-to-video sequence is needed.</p>
        <button class="toolbar-button" @onclick="Discard" disabled="@(Snapshot.IsBusy || Snapshot.Menu.Pending.Count == 0)">Discard pending changes</button>
    </details>
    <nav class="direct-tabs" aria-label="Top-level settings">
        @foreach (var category in IpMenuCatalog.Sections.Select(section => section.Category).Distinct())
        { <button class="@(Category == category ? "active" : "")" @onclick="() => SelectCategory(category)" disabled="@Snapshot.IsBusy">@category</button> }
    </nav>
    @if (Category == "Picture")
    {
        <nav class="direct-tabs secondary" aria-label="Calibration controls">
            @foreach (var section in IpMenuCatalog.Sections.Where(section => section.Category == Category))
            { <button class="@(Section == section.Id ? "active" : "")" @onclick="() => SelectSection(section.Id)" disabled="@Snapshot.IsBusy">@section.Name</button> }
        </nav>
    }
    @if (Section == "white2")
    {
        <div class="direct-white2">
            @foreach (var suffix in new[] { "Gain", "Offset" })
            { <section><h3>RGB @suffix.ToLowerInvariant()s</h3>@foreach (var control in VisibleControls.Where(control => control.Field.EndsWith(suffix, StringComparison.Ordinal))) { @ControlCard(control) }</section> }
        </div>
    }
    else
    {
        <div class="direct-control-grid">@foreach (var control in VisibleControls) { @ControlCard(control) }</div>
    }
    @if (Grid is { } grid)
    {
        <section class="direct-indexed" aria-label="@(grid.Section == "white20" ? "All white balance intervals" : "All custom colors")">
            <div class="direct-toolbar"><div><h2>@(grid.Section == "white20" ? "20-point RGB adjustments" : "Custom color RGB adjustments")</h2>
                <p>@grid.Values.Count fixed rows · each has its own Red, Green, and Blue values.</p></div>
                <button class="toolbar-button" @onclick="RefreshAsync" disabled="@(!CanWork || Snapshot.Menu.Update?.NeedsReview == true)">@(Snapshot.Menu.GridsRead.ContainsKey(Section) ? "Reload all rows" : "Load all rows")</button></div>
            <p class="direct-hint">Loading reads each row by temporarily selecting it, then restores the original selection. Apply addresses the edited rows automatically and restores the selector when finished. No RGB value changes during loading. Stop sends no further commands, including restoration.</p>
            @if (!Snapshot.Menu.GridsRead.ContainsKey(Section))
            { <p class="direct-unavailable">@(GridModeEnabled ? "Load all rows to read their current values." : grid.Section == "white20" ? "Turn on 20-point white balance above and Apply to enable these controls." : "Choose Custom in Color space above and Apply to enable these controls.")</p> }
            @if (Snapshot.Menu.SelectorSession is { } session && session.Section == Section)
            { <p class="direct-hint" role="status">@(Snapshot.IsBusy ? Snapshot.Menu.Status : session.Message)</p> }
            <div class="direct-indexed-rows">
                @foreach (var value in grid.Values)
                {
                    <section class="direct-indexed-row" @key="value"><h3>@value</h3>
                        <div class="direct-indexed-channels">@foreach (var control in grid.Row(value)) { @ControlCard(control) }</div>
                    </section>
                }
            </div>
        </section>
    }
    <p class="direct-hint">Limits are from Samsung's command tables and protocol references—not range metadata returned by queries. Unsupported/unreported controls can be retried with Refresh after changing the display's mode or signal.</p>
</section>

@if (Snapshot.Menu.Update is { } update)
{
    <section class="panel direct-panel" aria-label="Last settings update">
        <div class="direct-toolbar"><h2>Last update · @update.Status</h2><span>@update.StartedAt.ToLocalTime().ToString("HH:mm:ss")</span></div><p>@update.Endpoint · @update.Input · @update.PictureMode</p><p role="status">@update.Message</p>
        <div class="direct-update-rows">@foreach (var step in update.Steps)
        { <div><strong>@IpMenuCatalog.Get(step.ControlId).Name</strong><span>@step.Original → @step.Target</span><span>@step.Status</span></div> }</div>
        @if (update.NeedsReview)
        {
            <p class="direct-error">A delivered command may have changed the TV. Refresh/read the actual values and check the display. Stop does not undo delivered commands.</p>
            <button class="toolbar-button" @onclick="CloseReviewAsync" disabled="@Snapshot.IsBusy">I checked the TV — close interrupted update</button>
        }
    </section>
}

@code {
    private IpRemoteSnapshot Snapshot = new();
    private string Section = "expert", Category = "Picture";
    private readonly Dictionary<string, string> Edits = new(StringComparer.Ordinal);
    private readonly HashSet<string> AutoReads = new(StringComparer.Ordinal);
    private string? Error;
    private bool ActionRunning;
    private bool CanWork => Snapshot.Menu.Connected && !Snapshot.IsBusy && !ActionRunning;
    private bool CanApply => CanWork && Snapshot.Menu.Pending.Count > 0 && Snapshot.Menu.Update?.NeedsReview != true;
    private IpMenuGrid? Grid => IpMenuGrids.ForSection(Section);
    private bool GridModeEnabled => Grid is { } grid && Snapshot.Menu.Readings.GetValueOrDefault(grid.ModeMethod)?.Values?[grid.ModeField]?.ToString() == grid.RequiredMode;
    private IEnumerable<IpMenuControl> VisibleControls => IpMenuCatalog.ForSection(Section)
        .Where(control => Grid is not { } grid || control.Field != grid.SelectorField && !grid.Fields.Contains(control.Field))
        .OrderBy(control => control.Method is "WB20PointModeControl" or "colorSpaceControl" ? 0 : 2);
    protected override async Task OnInitializedAsync() { Controller.Changed += Refresh; await GuardAsync(Controller.InitializeAsync); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var key = Snapshot.Menu.SessionId + ":" + Section;
        if (CanWork && (!Snapshot.Menu.SectionsRead.ContainsKey(Section) || Grid is not null && !Snapshot.Menu.GridsRead.ContainsKey(Section)) && AutoReads.Add(key)) await RefreshAsync();
    }
    private void Refresh() => _ = InvokeAsync(() =>
    {
        var next = Controller.GetSnapshot();
        if (Snapshot.Menu.SessionId != next.Menu.SessionId) Edits.Clear();
        Snapshot = next; StateHasChanged();
    });
    private void SelectCategory(string category) { Category = category; SelectSection(IpMenuCatalog.Sections.First(section => section.Category == category).Id); }
    private void SelectSection(string section) { Section = section; Error = null; }
    private string Target(IpMenuControl control) => Edits.GetValueOrDefault(control.Id) ?? Snapshot.Menu.Pending.GetValueOrDefault(control.Id)?.Target.ToString() ?? Snapshot.Menu.Value(control)?.ToString() ?? "";
    private bool Dirty(IpMenuControl control) => Snapshot.Menu.Pending.ContainsKey(control.Id);
    private string? DisabledReason(IpMenuControl control) => ActionRunning ? "A TV request is running." : Controller.MenuControlDisabledReason(control);
    private RenderFragment ControlCard(IpMenuControl control) => @<article class="direct-control @(Dirty(control) ? "pending" : "")">
        <div class="direct-control-heading"><h3>@(control.IsIndexed ? control.Field.Split('.').Last() : control.Name)</h3><span class="direct-read-value">TV: @(Snapshot.Menu.Value(control)?.ToString() ?? "Not reported")</span></div>
        @if (control.IsSwitch)
        {
            <label class="picture-switch-control">
                <span class="picture-switch-copy"><strong>@(Target(control).Length == 0 ? "Not reported" : Target(control).EndsWith("On", StringComparison.OrdinalIgnoreCase) ? "On" : "Off")</strong><small>Select to toggle</small></span>
                <input type="checkbox" role="switch" aria-label="@control.Name" checked="@Target(control).EndsWith("On", StringComparison.OrdinalIgnoreCase)" @onchange="args => SwitchAsync(control, args)" disabled="@(DisabledReason(control) is not null)" />
                <span class="picture-switch-track" aria-hidden="true"><i></i></span>
            </label>
        }
        else if (control.Parameter.Kind == IpRemoteParameterKind.Integer)
        {
            <div class="picture-compact-value"><strong>@(Target(control).Length > 0 ? Target(control) : "Not reported")</strong><span>@control.Parameter.Minimum – @control.Parameter.Maximum</span></div>
            <fieldset disabled="@(DisabledReason(control) is not null)"><div class="picture-compact-slider">
                <button aria-label="@($"Decrease {control.Name}")" @onclick="() => NudgeAsync(control, -1)" disabled="@(Target(control) == "" || Target(control) == control.Parameter.Minimum.ToString(CultureInfo.InvariantCulture))">−</button>
                <input type="range" aria-label="@($"{control.Name} slider")" min="@control.Parameter.Minimum" max="@control.Parameter.Maximum" step="1" value="@Target(control)" @oninput="args => Preview(control, args)" @onchange="args => CommitAsync(control, args.Value?.ToString() ?? string.Empty)" />
                <button aria-label="@($"Increase {control.Name}")" @onclick="() => NudgeAsync(control, 1)" disabled="@(Target(control) == "" || Target(control) == control.Parameter.Maximum.ToString(CultureInfo.InvariantCulture))">+</button>
                <input class="picture-compact-number direct-number-value" aria-label="@($"{control.Name} value")" type="number" min="@control.Parameter.Minimum" max="@control.Parameter.Maximum" step="1" value="@Target(control)" @onchange="args => CommitAsync(control, args.Value?.ToString() ?? string.Empty)" />
            </div></fieldset>
        }
        else
        {
            <select class="direct-choice" aria-label="@control.Name" value="@Target(control)" @onchange="args => CommitAsync(control, args.Value?.ToString() ?? string.Empty)" disabled="@(DisabledReason(control) is not null)">
                @if (!control.Parameter.Choices.Contains(Target(control), StringComparer.Ordinal)) { <option value="@Target(control)">@(Target(control).Length > 0 ? Target(control) + " (TV reported)" : "Not reported")</option> }
                @foreach (var choice in control.Parameter.Choices) { <option value="@choice">@choice</option> }
            </select>
        }
        @if (Dirty(control)) { <small class="direct-pending">Pending · not sent</small> }
        @if (!Snapshot.IsBusy && (!control.IsIndexed || GridModeEnabled) && DisabledReason(control) is { } reason) { <p class="direct-unavailable">@reason</p> }
        @if (!control.IsIndexed)
        { <details class="direct-control-help"><summary>About this setting</summary><p>@(control.Command.ManagedPictureControl is not null ? "Reads the current value, applies your target directly, then queries the result." : control.Command.Notes.Replace("Experimental; display/input/mode support must be tested. ", "", StringComparison.Ordinal))</p><code>@control.Method</code><p>@control.RangeSource</p></details> }
    </article>;
    private void Preview(IpMenuControl control, ChangeEventArgs args) { Edits[control.Id] = args.Value?.ToString() ?? ""; }
    private Task CommitAsync(IpMenuControl control, string text) => GuardAsync(async () =>
    {
        Edits.Remove(control.Id);
        Controller.StageMenuValue(control.Id, text);
        if (Snapshot.Menu.Preferences.ApplyImmediately && Controller.GetSnapshot().Menu.Pending.Count > 0) { await Controller.ApplyMenuAsync(); await RefreshAfterModeAsync(control); }
    });
    private Task SwitchAsync(IpMenuControl control, ChangeEventArgs args) => CommitAsync(control, control.Parameter.Choices.Single(choice => choice.EndsWith(args.Value is true ? "On" : "Off", StringComparison.OrdinalIgnoreCase)));
    private Task NudgeAsync(IpMenuControl control, int amount) => int.TryParse(Target(control), out var value) ? CommitAsync(control, Math.Clamp(value + amount, control.Parameter.Minimum, control.Parameter.Maximum).ToString(CultureInfo.InvariantCulture)) : Task.CompletedTask;
    private Task ReadSectionAsync(string section)
    {
        AutoReads.Add(Snapshot.Menu.SessionId + ":" + section);
        return IpMenuGrids.ForSection(section) is null ? Controller.RefreshMenuSectionAsync(section) : Controller.RefreshMenuGridAsync(section);
    }
    private Task RefreshAsync() => GuardAsync(async () => { Edits.Clear(); await ReadSectionAsync(Section); });
    private Task ApplyAsync() => GuardAsync(async () => { await Controller.ApplyMenuAsync(); Edits.Clear(); if (!Controller.GetSnapshot().Menu.SectionsRead.ContainsKey(Section)) await ReadSectionAsync(Section); });
    private Task RefreshAfterModeAsync(IpMenuControl control) => !Controller.GetSnapshot().Menu.SectionsRead.ContainsKey(control.Section) ? ReadSectionAsync(control.Section) : Task.CompletedTask;
    private Task SetImmediateAsync(ChangeEventArgs args) => GuardAsync(() => Controller.SaveMenuPreferencesAsync(args.Value is true));
    private void Discard() { try { Controller.DiscardMenuChanges(); Edits.Clear(); Error = null; } catch (InvalidOperationException error) { Error = error.Message; } }
    private Task CloseReviewAsync() => GuardAsync(Controller.CloseMenuUpdateReviewAsync);
    private async Task GuardAsync(Func<Task> action)
    {
        Error = null; ActionRunning = true;
        try { await action(); }
        catch (Exception error) when (error is ArgumentException or InvalidOperationException or IOException or UnauthorizedAccessException or JsonException or OperationCanceledException) { Error = error.Message; }
        finally { Snapshot = Controller.GetSnapshot(); ActionRunning = false; await InvokeAsync(StateHasChanged); }
    }
    public void Dispose() => Controller.Changed -= Refresh;
}
