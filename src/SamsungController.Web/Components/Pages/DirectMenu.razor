@page "/menu"
@page "/ip-controls"
@implements IAsyncDisposable
@using SamsungController.Core.IpRemote
@inject SamsungIpRemoteService Controller

<PageTitle>Menu · SamsungController</PageTitle>
<section class="direct-menu-toolbar" aria-label="Menu controls and navigation" data-menu-section="@Section" @ref="MenuToolbarElement">
    <div class="direct-menu-behavior">
        <fieldset class="direct-apply-mode"><legend>Apply behavior</legend>
            <label title="Stage changes until you select Apply"><input type="radio" name="menu-apply-mode" value="wait" aria-label="Wait for Apply" checked="@(!Snapshot.Menu.Preferences.ApplyImmediately)" @onchange="() => SetWaitAsync()" disabled="@Snapshot.IsBusy" /> On Apply</label>
            <label title="Send each committed adjustment immediately"><input type="radio" name="menu-apply-mode" value="immediate" aria-label="Apply settings immediately" checked="@Snapshot.Menu.Preferences.ApplyImmediately" @onchange="SetImmediateAsync" disabled="@Snapshot.IsBusy" /> Immediately</label>
        </fieldset>
        <label class="direct-query-option" title="Query before changes: On rechecks current values; Off is faster and uses last known values. Refresh after outside changes. Post-change readback remains enabled."><input type="checkbox" aria-label="Query before changes" checked="@Snapshot.Menu.Preferences.QueryBeforeChange" @onchange="SetQueryBeforeChangeAsync" disabled="@Snapshot.IsBusy" /> Query first <span class="@(!Snapshot.Menu.Preferences.QueryBeforeChange ? "direct-fast-warning" : "")">@(Snapshot.Menu.Preferences.QueryBeforeChange ? "On" : "Cached")</span></label>
        <div class="direct-actions">
            <button type="button" class="toolbar-button" @onclick="RefreshAsync" disabled="@(!(Grid is null ? CanWork : CanLoadGrid))">Refresh section</button>
            <button type="button" class="toolbar-button" title="@(Grid is null ? "Available only in 20pt WB and Color" : "Reload all values in this section's fixed RGB rows")" @onclick="ReloadRowsAsync" disabled="@(Grid is null || !CanLoadGrid)">Reload all rows</button>
            @if (Grid is { } resetGrid)
            { <button type="button" class="toolbar-button danger-action" title="@(ResetDisabledReason ?? $"Reset all RGB values in this section to {resetGrid.NominalValue}")" @onclick="AskReset" disabled="@(ResetDisabledReason is not null)">Reset all</button> }
            <button type="button" class="primary-action" aria-label="@($"Apply {Snapshot.Menu.Pending.Count} pending")" @onclick="ApplyAsync" disabled="@(!CanApply)">Apply (@Snapshot.Menu.Pending.Count)</button>
            <button type="button" class="toolbar-button danger-action" @onclick="Controller.Cancel" disabled="@(!Snapshot.IsBusy)">Stop</button>
        </div>
    </div>
    <div class="direct-menu-navigation">
        <nav class="direct-tabs" aria-label="Top-level settings">
            @foreach (var section in IpMenuCatalog.Sections)
            { <button type="button" class="@(Section == section.Id ? "active" : "")" aria-label="@section.Name" title="@section.Name" aria-pressed="@(Section == section.Id ? "true" : "false")" @onclick="() => SelectSectionAsync(section.Id)" disabled="@(Snapshot.IsBusy || LayoutSaving || SwitchingSection)">@SectionLabel(section)</button> }
        </nav>
    </div>
    @if (ResetSection == Section && Grid is { } confirmGrid)
    {
        <section class="direct-reset-confirmation" aria-label="Confirm calibration reset">
            <strong>Reset all @(confirmGrid.Section == "white20" ? "20pt white balance" : "Custom color") values?</strong>
            <p>All @(confirmGrid.Values.Count * confirmGrid.Fields.Count) RGB values will target <strong>@confirmGrid.NominalValue</strong>. This replaces unsent edits in this section only, not other settings or the mode switch/dropdown.</p>
            <p>@(Snapshot.Menu.Preferences.ApplyImmediately ? "Confirmation sends the reset to the TV now. Stop cancels unsent changes, but does not undo delivered ones." : "Confirmation stages the reset only. The TV stays unchanged until you select Apply.")</p>
            <div class="direct-actions"><button type="button" class="toolbar-button danger-action" @onclick="ConfirmResetAsync" disabled="@(ResetDisabledReason is not null)">@(Snapshot.Menu.Preferences.ApplyImmediately ? "Reset now" : "Stage reset")</button><button type="button" class="toolbar-button" @onclick="CancelReset">Cancel reset</button></div>
        </section>
    }
    @if (ResetFeedback is not null) { <p class="direct-reset-feedback" role="status">@ResetFeedback</p> }
</section>
@if (Error is not null) { <div class="notice danger" role="alert">@Error</div> }
@if (!Snapshot.Menu.Connected) { <div class="notice"><strong>Display disconnected</strong><span>Connect to read current settings.</span><a href="/">Choose display →</a></div> }
@if (Snapshot.PictureTest?.RequiresRecovery == true || Snapshot.CommandTrial?.RequiresReview == true)
{ <div class="notice danger">An earlier diagnostic write needs attention. <a href="diagnostics#recovery">Open its saved recovery details</a>.</div> }
@if (Snapshot.Menu.WhiteBalanceRead is { NeedsRestore: true } modeRead && !Snapshot.IsBusy)
{
    <section class="panel direct-panel" aria-label="Interrupted white-balance read">
        <h2>Restore 20-point white balance</h2><p class="direct-error" role="alert">@modeRead.Message</p>
        <p>Original display: @modeRead.Endpoint · @modeRead.Input · @modeRead.PictureMode. Original mode: <strong>Off</strong>. Original interval: @(modeRead.OriginalInterval ?? "not yet read").</p>
        <p>Keep the original signal active. Restore reads the current state first, restores the saved interval when available, then turns 20-point WB Off. It never changes RGB values. If you restored these manually, confirm below instead.</p>
        <div class="direct-actions"><button class="toolbar-button" @onclick="RestoreWhiteBalanceAsync" disabled="@(!CanWork)">Restore 20-point WB to Off</button><button class="toolbar-button" @onclick="CloseWhiteBalanceReviewAsync" disabled="@Snapshot.IsBusy">I restored the original interval and Off manually</button></div>
    </section>
}

<section class="panel direct-panel" @ref="MenuContentElement">
    @if (Snapshot.Menu.Connected && Snapshot.Menu.ConnectionLoadAttempted && Snapshot.Menu.SettingsLoadedAt is null && !Snapshot.IsBusy)
    { <p class="direct-unavailable" role="status">All-settings load is incomplete or the TV context changed. Select Refresh state in the top header to reload all settings for the current signal—no reconnect needed. Opening a tab does not resume a stopped load.</p> }
    @if (Snapshot.Menu.SettingsLoadedAt is { } loadedAt)
    {
        <details class="direct-details compact"><summary>Settings load · @loadedAt.ToLocalTime().ToString("HH:mm:ss") · @(Snapshot.Menu.LoadWarnings.Count == 0 ? "complete" : "some values unavailable")</summary>
            <p>@Snapshot.Menu.TransportStatus</p>
            @foreach (var warning in Snapshot.Menu.LoadWarnings) { <p class="direct-unavailable">@warning</p> }
            <p><a href="diagnostics">Browse requests and replies →</a></p>
        </details>
    }
    <div class="direct-toolbar">
        <div><h1>@SectionName</h1><p>@(Snapshot.Menu.SectionsRead.TryGetValue(Section, out var readAt) ? "Read from TV " + readAt.ToLocalTime().ToString("HH:mm:ss") : "Not yet read")</p></div>
        <div class="direct-actions">
            @if (HasArrangedLayout) { <button class="toolbar-button" @onclick="ResetExpertLayoutAsync" disabled="@LayoutLocked">Reset layout</button> }
            <button class="toolbar-button @(Snapshot.Menu.Pending.Count == 0 ? "direct-discard-empty" : "")" aria-label="Discard pending changes" title="Discard unsent edits without changing the TV" @onclick="Discard" disabled="@(Snapshot.IsBusy || Snapshot.Menu.Pending.Count == 0)">Discard</button>
        </div>
    </div>
    @if (HasArrangedLayout)
    {
        <section class="direct-expert-layout" @key="Section" @ref="ExpertLayoutElement" data-layout-section="@Section" data-layout-locked="@(LayoutLocked ? "true" : "false")" aria-label="@($"Arrange {SectionName} controls")">
            <span class="visually-hidden" id="expert-layout-help">Drag the box background or use Alt + arrow keys to reorder. Linked controls move together. Open Help in the header for instructions.</span>
            @if (LayoutFeedback is not null) { <p class="direct-layout-feedback" role="status">@LayoutFeedback</p> }
            <div class="direct-control-grid direct-expert-grid">
                @foreach (var group in VisibleExpertGroups)
                {
                    <section class="direct-expert-group @(group.Controls.Count > 1 ? "linked" : "")" @key="group.Id" data-expert-group="@group.Id" draggable="@(!LayoutLocked ? "true" : "false")" tabindex="0" aria-label="@group.Name" aria-describedby="expert-layout-help" aria-keyshortcuts="Alt+ArrowLeft Alt+ArrowRight Alt+ArrowUp Alt+ArrowDown">
                        <div class="direct-expert-members">@foreach (var control in group.Controls.Where(IsVisible)) { @ControlCard(control) }</div>
                    </section>
                }
            </div>
        </section>
    }
    else if (Section == "white2")
    {
        <div class="direct-white2">
            @foreach (var suffix in new[] { "Gain", "Offset" })
            { <section><h3>RGB @suffix.ToLowerInvariant()s</h3>@foreach (var control in VisibleControls.Where(control => control.Field.EndsWith(suffix, StringComparison.Ordinal))) { @ControlCard(control) }</section> }
        </div>
    }
    else
    {
        <div class="direct-control-grid">@foreach (var control in VisibleControls) { @ControlCard(control) }</div>
    }
    @if (HiddenControls.Any())
    { <p class="direct-hint">@HiddenControls.Count() controls hidden because their queries were rejected or their values were absent. <a href="diagnostics">See communication log</a>. Refresh reevaluates availability.</p> }
    @if (Grid is { } grid)
    {
        <section class="direct-indexed" aria-label="@(grid.Section == "white20" ? "All white balance intervals" : "All custom colors")">
            @if (!Snapshot.Menu.GridsRead.ContainsKey(Section))
            { <p class="direct-unavailable">@(GridModeEnabled ? "Use Reload all rows in the pinned toolbar to read their current values." : grid.Section == "white20" ? "Reload all rows reads the values while Off, restoring Off afterward. Turn on 20-point white balance above and Apply to enable these controls." : "Choose Custom in Color space above and Apply to enable these controls.")</p> }
            @if (grid.Section == "white20" && Snapshot.Menu.GridsRead.ContainsKey(Section) && !GridModeEnabled)
            { <p class="direct-hint">All 20-point values are loaded. The original Off mode was preserved; enable 20-point WB to edit them.</p> }
            <p class="direct-hint direct-grid-status" role="status" title="@GridStatus">@GridStatus</p>
            <div class="direct-indexed-rows">
                @foreach (var value in grid.Values)
                {
                    <section class="direct-indexed-row" @key="value">
                        <div class="direct-indexed-heading"><h3>@value</h3>
                            <div class="direct-indexed-actions">
                                <div class="direct-rgb-nudge" role="group" aria-label="@($"Adjust {value} RGB together")">
                                    <span>RGB together</span>
                                    @foreach (var delta in new[] { -1, 1 })
                                    {
                                        var reason = RowNudgeDisabledReason(grid, value, delta);
                                        <button type="button" class="toolbar-button" aria-label="@($"{(delta < 0 ? "Decrease" : "Increase")} {value} RGB together")" title="@(reason ?? "Adjust Red, Green, and Blue together by one, preserving their differences")" @onclick="() => NudgeRowAsync(grid, value, delta)" disabled="@(reason is not null)">@(delta < 0 ? "−" : "+")</button>
                                    }
                                </div>
                            @if (grid.Section == "white20" && !Snapshot.Menu.Preferences.ApplyImmediately)
                            { <button class="toolbar-button" aria-label="@($"Apply {value} white balance")" @onclick="() => ApplyRowAsync(grid, value)" disabled="@(!CanApplyRow(grid, value))">Apply @RowPendingCount(grid, value) pending</button> }
                            </div>
                        </div>
                        <div class="direct-indexed-channels">@foreach (var control in grid.Row(value).Where(IsVisible)) { @ControlCard(control) }</div>
                    </section>
                }
            </div>
        </section>
    }
</section>

@if (Snapshot.Menu.Update is { } update)
{
    <section class="panel direct-panel" aria-label="Last settings update">
        <div class="direct-toolbar"><h2>Last update · @update.Status</h2><span>@update.StartedAt.ToLocalTime().ToString("HH:mm:ss")</span></div><p>@update.Endpoint · @update.Input · @update.PictureMode</p><p role="status">@update.Message</p>
        @if (!update.QueryBeforeChange) { <p class="direct-fast-warning">Pre-change queries were Off. Saved originals are last known readings; outside changes may not have been detected before writing.</p> }
        <div class="direct-update-rows">@foreach (var step in update.Steps)
        { <div><strong>@IpMenuCatalog.Get(step.ControlId).Name</strong><span>@step.Original → @step.Target</span><span>@step.Status@if (step.Warning is { } warning) { <small class="direct-update-warning">@warning</small> }</span></div> }</div>
        @if (update.RgbGroups.Count > 0)
        {
            <details open="@update.NeedsReview">
                <summary>Saved RGB originals</summary>
                <p>@(update.QueryBeforeChange ? "Values queried before each row's changes" : "Last known values used without a pre-change query"), including untouched colors. These are recovery references, not current TV values; nothing is restored automatically.</p>
                @foreach (var group in update.RgbGroups)
                {
                    var savedGrid = IpMenuGrids.ForSection(group.Section)!;
                    <h3>@(group.Section == "white20" ? "20-point white balance" : "Custom color") · @group.Value</h3>
                    <p>@(group.Verified ? "Final row/context check passed." : group.ReviewClosed ? "Checked manually; not automatically verified." : group.WriteAttempted ? "Final row/context check incomplete — check all three colors." : "No RGB write attempted.")</p>
                    <div class="direct-update-rows">@foreach (var control in savedGrid.Row(group.Value))
                    { <div><strong>@control.Name</strong><span>Original @group.Originals[control.Field]</span></div> }</div>
                }
            </details>
        }
        @if (update.NeedsReview)
        {
            <p class="direct-error">A delivered command may have changed the TV. Refresh/read the actual values and check the display. Stop does not undo delivered commands.</p>
            <button class="toolbar-button" @onclick="CloseReviewAsync" disabled="@Snapshot.IsBusy">I checked the TV — close interrupted update</button>
        }
    </section>
}

@code {
    private IpRemoteSnapshot Snapshot = new();
    private string Section = "expert";
    private string SectionName => IpMenuCatalog.Sections.Single(section => section.Id == Section).Name;
    private readonly Dictionary<string, string> Edits = new(StringComparer.Ordinal);
    private readonly HashSet<string> AutoReads = new(StringComparer.Ordinal);
    private IpMenuSnapshot? QueueView;
    private IpMenuSnapshot DisplayMenu => QueueView ?? Snapshot.Menu;
    private string GridStatus => Snapshot.Menu.SelectorSession is { } session && session.Section == Section ? Snapshot.IsBusy ? Snapshot.Menu.Status : session.Message : "";
    private string? Error;
    private string? ResetSection, ResetFeedback;
    private string? ResetDisabledReason => !CanWork ? "Stop or finish the current TV operation, or connect to the display first."
        : Grid is null ? "Select 20pt WB or Color." : Controller.MenuGridResetDisabledReason(Section);
    private bool ActionRunning;
    private bool CanWork => Snapshot.Menu.Connected && !Snapshot.IsBusy && !ActionRunning && Snapshot.RgbProbe?.NeedsRecovery != true;
    private bool CanLoadGrid => CanWork && Snapshot.Menu.Update?.NeedsReview != true && Snapshot.Menu.WhiteBalanceRead?.NeedsRestore != true
        && Snapshot.PictureTest?.RequiresRecovery != true && Snapshot.CommandTrial?.RequiresReview != true;
    private bool CanApply => CanWork && Snapshot.Menu.Pending.Count > 0 && Snapshot.Menu.Update?.NeedsReview != true && Snapshot.Menu.WhiteBalanceRead?.NeedsRestore != true;
    private int RowPendingCount(IpMenuGrid grid, string value) => grid.Row(value).Count(Dirty);
    private bool CanApplyRow(IpMenuGrid grid, string value) => CanApply && RowPendingCount(grid, value) > 0
        && grid.Row(value).Where(Dirty).All(control => DisabledReason(control) is null);
    private IpMenuGrid? Grid => IpMenuGrids.ForSection(Section);
    private bool GridModeEnabled => Grid is { } grid && Snapshot.Menu.Readings.GetValueOrDefault(grid.ModeMethod)?.Values?[grid.ModeField]?.ToString() == grid.RequiredMode;
    private bool IsVisible(IpMenuControl control) => Dirty(control) || IpMenuAvailability.For(DisplayMenu, control).Visible;
    private IEnumerable<IpMenuControl> SectionControls => IpMenuCatalog.ForSection(Section)
        .Where(control => Grid is not { } grid || control.Field != grid.SelectorField && !grid.Fields.Contains(control.Field));
    private IEnumerable<IpMenuControl> HiddenControls => SectionControls.Concat(IpMenuCatalog.IndexedControls.Where(control => control.Section == Section)).Where(control => !IsVisible(control));
    private IEnumerable<IpMenuControl> VisibleControls => SectionControls.Where(IsVisible)
        .OrderBy(control => control.Method is "WB20PointModeControl" or "colorSpaceControl" ? 0 : 2);
    protected override async Task OnInitializedAsync() { Controller.Changed += Refresh; await GuardAsync(Controller.InitializeAsync); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (await AttachMenuToolbarAsync()) return;
        await AttachExpertLayoutAsync();
        var key = Snapshot.Menu.SessionId + ":" + Section;
        if (Snapshot.Menu.WhiteBalanceRead?.NeedsRestore == true) { AutoReads.Add(key); return; }
        if (Snapshot.Menu.ConnectionLoadAttempted) AutoReads.Add(key); // Do not retry incomplete/unsupported connection reads on tab visits.
        if (CanWork && (!Snapshot.Menu.SectionsRead.ContainsKey(Section) || Grid is not null && GridModeEnabled && !Snapshot.Menu.GridsRead.ContainsKey(Section)) && AutoReads.Add(key)) await GuardAsync(() => ReadSectionAsync(Section));
    }
    private void Refresh() => _ = InvokeAsync(() =>
    {
        var next = Controller.GetSnapshot();
        if (next.IsBusy || Snapshot.Menu.SessionId != next.Menu.SessionId || Snapshot.Menu.ValuesRevision != next.Menu.ValuesRevision
            || Snapshot.Menu.Preferences.ApplyImmediately != next.Menu.Preferences.ApplyImmediately)
        { ResetSection = null; ResetFeedback = null; }
        if (next.Menu.NudgeQueue is not null) QueueView ??= Snapshot.Menu.Connected ? Snapshot.Menu : next.Menu;
        else QueueView = null;
        if (Snapshot.Menu.SessionId != next.Menu.SessionId || Snapshot.Menu.ValuesRevision != next.Menu.ValuesRevision) Edits.Clear();
        Snapshot = next; StateHasChanged();
    });
    private static string SectionLabel(IpMenuSection section) => section.Id switch { "white2" => "2pt WB", "white20" => "20pt WB", _ => section.Name };
    private string Target(IpMenuControl control) => Edits.GetValueOrDefault(control.Id) ?? StoredTarget(control);
    private string StoredTarget(IpMenuControl control) => Snapshot.Menu.NudgeQueue?.Values.LastOrDefault(value => value.ControlId == control.Id)?.Target.ToString(CultureInfo.InvariantCulture)
        ?? Snapshot.Menu.Pending.GetValueOrDefault(control.Id)?.Target.ToString() ?? Snapshot.Menu.Value(control)?.ToString() ?? "";
    // A text draft such as "-" is valid while typing, but not a slider position.
    private string RangeTarget(IpMenuControl control) => int.TryParse(Target(control), NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var value)
        && value >= control.Parameter.Minimum && value <= control.Parameter.Maximum ? value.ToString(CultureInfo.InvariantCulture) : StoredTarget(control);
    private bool Dirty(IpMenuControl control) => Snapshot.Menu.Pending.ContainsKey(control.Id);
    private string? DisabledReason(IpMenuControl control) => ActionRunning ? "A TV request is running." : Controller.MenuControlDisabledReason(control);
    private string? NudgeDisabledReason(IpMenuControl control) => ActionRunning ? "A TV request is running." : Controller.MenuNudgeDisabledReason(control);
    private string? DisplayReason(IpMenuControl control) => SamsungIpRemoteService.MenuValueDisabledReason(DisplayMenu, control);
    private string ControlStatus(IpMenuControl control) => Snapshot.Menu.NudgeQueue?.Values.Count(value => value.ControlId == control.Id) is > 0 and var count
        ? $"{count} adjustment(s) queued / running" : Dirty(control) ? "Pending · not sent" : "";
    private RenderFragment ControlCard(IpMenuControl control) => @<article @key="control.Id" class="direct-control @(Dirty(control) ? "pending" : "") @(DisplayReason(control) is not null ? "unavailable" : "")" aria-disabled="@((control.Parameter.Kind == IpRemoteParameterKind.Integer ? NudgeDisabledReason(control) : DisabledReason(control)) is not null ? "true" : "false")">
        <div class="direct-control-heading"><h3>@(control.IsIndexed ? control.Field.Split('.').Last() : control.Name)</h3><span class="direct-read-value">TV: @(Snapshot.Menu.Value(control)?.ToString() ?? "Not reported")</span></div>
        @if (control.IsSwitch)
        {
            <label class="picture-switch-control">
                <span class="picture-switch-copy"><strong>@(Target(control).Length == 0 ? "Not reported" : Target(control).EndsWith("On", StringComparison.OrdinalIgnoreCase) ? "On" : "Off")</strong><small>Select to toggle</small></span>
                <input type="checkbox" role="switch" aria-label="@control.Name" checked="@Target(control).EndsWith("On", StringComparison.OrdinalIgnoreCase)" @onchange="args => SwitchAsync(control, args)" disabled="@(DisabledReason(control) is not null)" />
                <span class="picture-switch-track" aria-hidden="true"><i></i></span>
            </label>
        }
        else if (control.Parameter.Kind == IpRemoteParameterKind.Integer)
        {
            <div class="picture-compact-value"><strong>@(Target(control).Length > 0 ? Target(control) : "Not reported")</strong></div>
            <fieldset><div class="picture-compact-slider">
                <button aria-label="@($"Decrease {control.Name}")" @onclick="() => NudgeAsync(control, -1)" disabled="@(NudgeDisabledReason(control) is not null || Target(control) == "" || Target(control) == control.Parameter.Minimum.ToString(CultureInfo.InvariantCulture))">−</button>
                <div class="direct-bounded-slider">
                    <span class="direct-slider-bound" aria-label="@($"{control.Name} minimum")">@control.Parameter.Minimum</span>
                    <input type="range" aria-label="@($"{control.Name} slider")" min="@control.Parameter.Minimum" max="@control.Parameter.Maximum" step="1" value="@RangeTarget(control)" @oninput="args => Preview(control, args)" @onchange="args => CommitAsync(control, args.Value?.ToString() ?? string.Empty)" disabled="@(NudgeDisabledReason(control) is not null)" />
                    <span class="direct-slider-bound" aria-label="@($"{control.Name} maximum")">@control.Parameter.Maximum</span>
                </div>
                <button aria-label="@($"Increase {control.Name}")" @onclick="() => NudgeAsync(control, 1)" disabled="@(NudgeDisabledReason(control) is not null || Target(control) == "" || Target(control) == control.Parameter.Maximum.ToString(CultureInfo.InvariantCulture))">+</button>
                @* Native number inputs sanitize a partial minus to empty before Blazor sees it. Keep raw text until commit; the service validates integer bounds. *@
                <input class="picture-compact-number direct-number-value" aria-label="@($"{control.Name} value")" type="text" inputmode="@(control.Parameter.Minimum < 0 ? "text" : "numeric")" autocomplete="off" spellcheck="false" title="@($"Whole number from {control.Parameter.Minimum} to {control.Parameter.Maximum}")" value="@Target(control)" @oninput="args => Preview(control, args)" @onchange="args => CommitAsync(control, args.Value?.ToString() ?? string.Empty)" disabled="@(NudgeDisabledReason(control) is not null)" />
            </div></fieldset>
        }
        else
        {
            <select class="direct-choice" aria-label="@control.Name" value="@Target(control)" @onchange="args => CommitAsync(control, args.Value?.ToString() ?? string.Empty)" disabled="@(DisabledReason(control) is not null)">
                @if (!control.Parameter.Choices.Contains(Target(control), StringComparer.Ordinal)) { <option value="@Target(control)">@(Target(control).Length > 0 ? Target(control) + " (TV reported)" : "Not reported")</option> }
                @foreach (var choice in control.Parameter.Choices) { <option value="@choice">@choice</option> }
            </select>
        }
        <small class="direct-control-status direct-pending" role="status">@ControlStatus(control)</small>
        @if ((!control.IsIndexed || GridModeEnabled) && DisplayReason(control) is { } reason) { <p class="direct-unavailable">@reason</p> }
        @if (!control.IsIndexed)
        { <details class="direct-control-help"><summary>About this setting</summary><p>@(control.Command.ManagedPictureControl is not null ? "Applies your target directly, then queries the result. Query before changes controls whether a fresh baseline is read first." : control.Command.Notes.Replace("Experimental; display/input/mode support must be tested. ", "", StringComparison.Ordinal))</p><code>@control.Method</code><p>@control.RangeSource</p></details> }
    </article>;
    private void Preview(IpMenuControl control, ChangeEventArgs args) { ResetFeedback = null; ResetSection = null; Edits[control.Id] = args.Value?.ToString() ?? ""; }
    private Task CommitAsync(IpMenuControl control, string text)
    {
        ResetFeedback = null; ResetSection = null;
        if (control.Parameter.Kind == IpRemoteParameterKind.Integer && Snapshot.Menu.Preferences.ApplyImmediately)
            return QueueNumericAsync(control, () => Controller.QueueMenuValueAsync(control.Id, text));
        return GuardAsync(async () =>
        {
            Controller.StageMenuValue(control.Id, text);
            Edits.Remove(control.Id);
            if (Snapshot.Menu.Preferences.ApplyImmediately && Controller.GetSnapshot().Menu.Pending.Count > 0) { await Controller.ApplyMenuAsync(); await RefreshAfterModeAsync(control); }
        });
    }
    private Task SwitchAsync(IpMenuControl control, ChangeEventArgs args) => CommitAsync(control, control.Parameter.Choices.Single(choice => choice.EndsWith(args.Value is true ? "On" : "Off", StringComparison.OrdinalIgnoreCase)));
    private async Task NudgeAsync(IpMenuControl control, int amount)
    {
        ResetFeedback = null; ResetSection = null;
        if (!Snapshot.Menu.Preferences.ApplyImmediately)
        {
            if (int.TryParse(Target(control), out var value)) await CommitAsync(control, Math.Clamp(value + amount, control.Parameter.Minimum, control.Parameter.Maximum).ToString(CultureInfo.InvariantCulture));
            return;
        }
        await QueueNumericAsync(control, () => Controller.QueueMenuNudgeAsync(control.Id, amount));
    }
    private async Task QueueNumericAsync(IpMenuControl control, Func<Task> enqueue)
        => await QueueNumericAsync([control], enqueue);
    private string? RowNudgeDisabledReason(IpMenuGrid grid, string value, int delta) => ActionRunning ? "A TV request is running."
        : Controller.MenuRowNudgeDisabledReason(grid.Section, value, delta, Edits);
    private Task NudgeRowAsync(IpMenuGrid grid, string value, int delta) => QueueNumericAsync(grid.Row(value),
        () => Controller.NudgeMenuRowAsync(grid.Section, value, delta, Edits));
    private async Task QueueNumericAsync(IEnumerable<IpMenuControl> controls, Func<Task> enqueue)
    {
        // Do not set ActionRunning: later numeric edits must be able to enqueue
        // while this event awaits its confirmed result. The service owns the gate.
        Error = null; ResetFeedback = null; ResetSection = null;
        try
        {
            var operation = enqueue(); // Validation/enqueue is synchronous; preserve text if rejected.
            foreach (var control in controls) Edits.Remove(control.Id);
            Snapshot = Controller.GetSnapshot();
            await operation; // Never clear a newer drag/text preview when this older edit finishes.
        }
        catch (Exception error) when (error is ArgumentException or InvalidOperationException or IOException or UnauthorizedAccessException or JsonException or OperationCanceledException) { Error = error.Message; }
        finally { Snapshot = Controller.GetSnapshot(); await InvokeAsync(StateHasChanged); }
    }
    private Task ReadSectionAsync(string section)
    {
        AutoReads.Add(Snapshot.Menu.SessionId + ":" + section);
        return IpMenuGrids.ForSection(section) is null ? Controller.RefreshMenuSectionAsync(section) : Controller.RefreshMenuGridAsync(section);
    }
    private Task RefreshAsync() => GuardAsync(async () => { Edits.Clear(); if (Section == "white20") await Controller.RefreshInactiveWhiteBalanceAsync(); else await ReadSectionAsync(Section); });
    private Task ReloadRowsAsync() => Grid is null ? Task.CompletedTask : RefreshAsync();
    private void AskReset() { ResetSection = Section; ResetFeedback = null; }
    private void CancelReset() { ResetSection = null; }
    private Task ConfirmResetAsync()
    {
        if (ResetSection != Section || Grid is null) return Task.CompletedTask;
        var grid = Grid;
        var immediate = Snapshot.Menu.Preferences.ApplyImmediately;
        ResetSection = null;
        return GuardAsync(async () =>
        {
            var count = await Controller.ResetMenuGridAsync(grid.Section);
            foreach (var control in grid.Values.SelectMany(grid.Row)) Edits.Remove(control.Id);
            ResetFeedback = count == 0 ? $"All RGB values in this section are already {grid.NominalValue}. Nothing was sent."
                : immediate ? $"Reset {count} RGB values to {grid.NominalValue} and confirmed by readback."
                : $"Staged {count} RGB values at {grid.NominalValue}. Select Apply to send them, or Discard to cancel.";
        });
    }
    private Task RestoreWhiteBalanceAsync() => GuardAsync(Controller.RestoreWhiteBalanceReadAsync);
    private Task CloseWhiteBalanceReviewAsync() => GuardAsync(Controller.CloseWhiteBalanceReadReviewAsync);
    private Task ApplyAsync() => GuardAsync(async () => { await Controller.ApplyMenuAsync(); Edits.Clear(); if (!Controller.GetSnapshot().Menu.SectionsRead.ContainsKey(Section)) await ReadSectionAsync(Section); });
    private Task ApplyRowAsync(IpMenuGrid grid, string value) => GuardAsync(async () =>
    {
        await Controller.ApplyMenuRowAsync(grid.Section, value);
        foreach (var control in grid.Row(value)) Edits.Remove(control.Id);
    });
    private Task RefreshAfterModeAsync(IpMenuControl control) => !Controller.GetSnapshot().Menu.SectionsRead.ContainsKey(control.Section) ? ReadSectionAsync(control.Section) : Task.CompletedTask;
    private Task SetImmediateAsync(ChangeEventArgs args) { CancelReset(); return GuardAsync(() => Controller.SaveMenuPreferencesAsync(args.Value is true || args.Value?.ToString() == "immediate")); }
    private Task SetWaitAsync() { CancelReset(); return GuardAsync(() => Controller.SaveMenuPreferencesAsync(false)); }
    private Task SetQueryBeforeChangeAsync(ChangeEventArgs args) => GuardAsync(() => Controller.SaveMenuPreferencesAsync(Snapshot.Menu.Preferences.ApplyImmediately, args.Value is true));
    private void Discard() { try { Controller.DiscardMenuChanges(); Edits.Clear(); Error = null; ResetFeedback = null; ResetSection = null; } catch (InvalidOperationException error) { Error = error.Message; } }
    private Task CloseReviewAsync() => GuardAsync(Controller.CloseMenuUpdateReviewAsync);
    private async Task GuardAsync(Func<Task> action)
    {
        Error = null; ActionRunning = true;
        try { await action(); }
        catch (Exception error) when (error is ArgumentException or InvalidOperationException or IOException or UnauthorizedAccessException or JsonException or OperationCanceledException) { Error = error.Message; }
        finally { Snapshot = Controller.GetSnapshot(); ActionRunning = false; await InvokeAsync(StateHasChanged); }
    }
}
