@page "/menu"
@implements IDisposable
@inject SamsungControllerService Controller
@inject NavigationManager NavigationManager

<PageTitle>Verified Menus · SamsungController</PageTitle>

<section class="page-heading compact-heading menu-heading">
    <div>
        <span class="eyebrow">VERIFIED MENUS</span>
        <h1>Your proven menu map.</h1>
        <p>Click a verified destination to execute its proven route immediately. Only commands that passed visual verification on this TV are sent.</p>
    </div>
    <div class="menu-heading-aside">
        <div class="confidence-orb @ConfidenceClass">
            <strong>@Navigation.State.Confidence</strong>
            <span>prediction confidence</span>
        </div>
        <a class="secondary-action menu-authoring-link" href="menu/build">Build &amp; verify <span>→</span></a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="notice danger" role="alert"><strong>Navigator needs attention</strong><span>@ErrorMessage</span></div>
}

<section class="menu-current-state @ConfidenceClass" title="@CurrentStateTitle">
    <div>
        <span>CURRENT MENU</span>
        <strong>@CurrentMenuLabel</strong>
    </div>
    @if (LastCompletedPlan is { CommandCount: > 0 })
    {
        <button type="button"
                class="secondary-action danger-action traversal-failed-action"
                title="Capture the traversal keys for validation and return the TV to normal video"
                @onclick="ReportTraversalFailureAsync"
                disabled="@(!CanReportTraversalFailure)">
            @(ReportingTraversalFailure ? "Resetting…" : "Traversal failed")
        </button>
    }
</section>

<section class="navigator-layout">
    <div class="panel menu-tree-panel">
        <div class="panel-label"><span>VERIFIED MENU MAP · CLICK TO RUN</span><span>@VerifiedNodes.Count DESTINATIONS</span></div>

        @if (VerifiedNodes.Count == 0)
        {
            <div class="panel-empty verified-menu-empty">
                <strong>No verified destinations yet</strong>
                <span>Use Build &amp; Verify to record and complete three visual passes for a route.</span>
                <a href="menu/build">Open Build &amp; Verify →</a>
            </div>
        }
        else
        {
            <div class="menu-tree" role="tree" aria-label="Verified Samsung menu destinations">
                @foreach (var node in VerifiedNodes)
                {
                    <button class="menu-node @(SelectedTarget == node.Id ? "selected" : "") @(Navigation.State.NodeId == node.Id ? "current" : "")"
                            style="@($"padding-left: {14 + node.Depth * 18}px")"
                            role="treeitem"
                            aria-label="Run verified route to @node.Path"
                            @onclick="() => RunTargetAsync(node.Id)"
                            disabled="@(!CanAutomate)">
                        <span class="tree-branch" aria-hidden="true"></span>
                        <span>
                            <strong>@node.Label</strong>
                            <small>@(node.Description ?? node.Path)</small>
                        </span>
                        <b class="node-badge @(Navigation.State.NodeId == node.Id ? "current" : "verified")">
                            @(Navigation.State.NodeId == node.Id ? "Current" : "Run")
                        </b>
                    </button>
                }
            </div>
        }
    </div>

    <aside class="navigator-side-stack">
        <div class="panel anchor-panel">
            <div class="panel-label"><span>RESYNCHRONIZE</span><span>VERIFIED ANCHORS</span></div>
            <p>Return to a known state before navigating when the current menu is uncertain.</p>
            @if (VerifiedAnchors.Count == 0)
            {
                <div class="plan-empty">No verified anchors are available.</div>
            }
            @foreach (var anchor in VerifiedAnchors)
            {
                <button class="anchor-card" @onclick="() => RunAnchorAsync(anchor.Id)" disabled="@(!CanAutomate)">
                    <span><strong>@anchor.Label</strong><small>@anchor.CommandCount commands · @anchor.TargetPath</small></span>
                    <b>Run</b>
                </button>
            }
        </div>

        <div class="panel plan-panel">
            <div class="panel-label"><span>VERIFIED ROUTE</span><span>@(SelectedPlan is null ? "EMPTY" : "READY")</span></div>
            <span class="selected-label">TARGET</span>
            <strong class="selected-macro">@SelectedTargetPath</strong>
            <button class="secondary-action plan-action" @onclick="CreatePlan" disabled="@(Navigation.IsRunning || Navigation.State.NodeId is null || SelectedTarget is null)">Calculate route</button>

            @if (SelectedPlan is { } plan)
            {
                <div class="plan-summary verified">
                    <strong>@(plan.UsesCalculatedRoute ? "Calculated route from verified paths" : plan.UsesAnchor ? "Verified composite route" : "Verified route")</strong>
                    <span>@plan.CommandCount commands · @plan.EstimatedDelay.TotalSeconds.ToString("0.###", CultureInfo.InvariantCulture)s delay</span>
                </div>
                <div class="transition-list">
                    @if (plan.CalculatedLeg is { } calculatedLeg)
                    {
                        <div class="transition-card calculated-leg-card">
                            <header><span>@calculatedLeg.SourcePath → @calculatedLeg.TargetPath</span><b>Calculated leg</b></header>
                            <small>@calculatedLeg.Basis</small>
                            @foreach (var operation in calculatedLeg.Operations)
                            {
                                <code>@operation.Key × @operation.Repeat @operation.Action@(operation.DelayAfter is { } delay ? $" · {delay.TotalMilliseconds:0}ms wait" : "")</code>
                            }
                        </div>
                    }
                    @if (plan.AnchorLeg is { } anchorLeg)
                    {
                        <div class="transition-card anchor-leg-card">
                            <header><span>@anchorLeg.SourcePath → @anchorLeg.TargetPath</span><b>Known-state leg</b></header>
                            <small>@anchorLeg.Label</small>
                            @foreach (var operation in anchorLeg.Operations)
                            {
                                <code>@operation.Key × @operation.Repeat @operation.Action</code>
                            }
                        </div>
                    }
                    @foreach (var transition in plan.Transitions)
                    {
                        <div class="transition-card">
                            <header><span>@transition.FromNodeId → @transition.ToNodeId</span><b>Verified</b></header>
                            @foreach (var operation in transition.Operations)
                            {
                                <code>@operation.Key × @operation.Repeat @operation.Action</code>
                            }
                        </div>
                    }
                </div>
                @if (Navigation.IsRunning)
                {
                    <button class="secondary-action danger-action plan-action" @onclick="Controller.CancelNavigation">Cancel navigation</button>
                }
                else
                {
                    <button class="primary-action" @onclick="ExecutePlanAsync" disabled="@(!CanExecutePlan)">Execute verified route <span>▶</span></button>
                }
            }
            else
            {
                <div class="plan-empty">Click a verified destination to run it immediately. Use Calculate route afterward when you want to inspect its command sequence.</div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Navigation.Status) || Navigation.Progress is not null)
        {
            <div class="panel navigation-progress-panel">
                <div class="panel-label"><span>LIVE EXECUTION</span><span>@(Navigation.IsRunning ? "RUNNING" : "IDLE")</span></div>
                <strong>@Navigation.Status</strong>
                @if (Navigation.Progress is { } progress)
                {
                    <code>@progress.CommandNumber/@progress.CommandCount · @progress.Key · @progress.Action</code>
                    <small>@progress.SourcePath → @progress.TargetPath</small>
                }
            </div>
        }
    </aside>
</section>

@code {
    private ControllerSnapshot Snapshot { get; set; } = null!;
    private MenuNavigationSnapshot Navigation { get; set; } = null!;
    private string? SelectedTarget { get; set; }
    private string? LocalError { get; set; }
    private NavigationPlan? LastCompletedPlan { get; set; }
    private bool ReportingTraversalFailure { get; set; }

    private string? ErrorMessage => LocalError ?? Navigation.Error;
    private IReadOnlyList<MenuNodeSummary> VerifiedNodes => Navigation.Nodes
        .Where(node => node.HasVerifiedRoute)
        .ToArray();
    private IReadOnlyList<MenuAnchorSummary> VerifiedAnchors => Navigation.Anchors
        .Where(anchor => anchor.Verified)
        .ToArray();
    private NavigationPlan? SelectedPlan => Navigation.Plan?.TargetNodeId.Equals(
        SelectedTarget,
        StringComparison.OrdinalIgnoreCase) == true
            ? Navigation.Plan
            : null;
    private bool CanAutomate => Snapshot.ConnectionState == SamsungConnectionState.Connected &&
        !Snapshot.MacroRunning && !Navigation.IsRunning;
    private bool CanExecutePlan => CanAutomate && SelectedPlan?.IsExecutable == true;
    private bool CanReportTraversalFailure => CanAutomate
        && !ReportingTraversalFailure
        && LastCompletedPlan?.CommandCount > 0;
    private string SelectedTargetPath => Navigation.Nodes.FirstOrDefault(node => node.Id == SelectedTarget)?.Path ?? "—";
    private string CurrentMenuLabel => Navigation.Nodes.FirstOrDefault(node =>
        node.Id.Equals(Navigation.State.NodeId, StringComparison.OrdinalIgnoreCase))?.Label ?? "Unknown";
    private string CurrentStateTitle => Navigation.State.Path is null
        ? "Expected menu state is unknown. Run a verified anchor to synchronize it."
        : $"Expected menu path: {Navigation.State.Path}. {Navigation.State.Reason}";
    private string ConfidenceClass => Navigation.State.Confidence.ToString().ToLowerInvariant();

    protected override async Task OnInitializedAsync()
    {
        Snapshot = Controller.GetSnapshot();
        Navigation = Controller.GetMenuNavigationSnapshot();
        Controller.Changed += HandleControllerChanged;
        await Controller.InitializeAsync();
        Refresh();
        SelectDefaultTarget();
    }

    private async Task RunTargetAsync(string nodeId)
    {
        SelectedTarget = nodeId;
        LocalError = null;
        LastCompletedPlan = null;
        try
        {
            var plan = Controller.CreateNavigationPlan(nodeId);
            await Controller.ExecuteNavigationPlanAsync();
            LastCompletedPlan = plan;
        }
        catch (OperationCanceledException)
        {
            // Live state already reports cancellation and invalidates prediction.
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
    }

    private void SelectDefaultTarget()
    {
        if (SelectedTarget is not null
            && VerifiedNodes.Any(node => node.Id.Equals(SelectedTarget, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        SelectedTarget = VerifiedNodes.FirstOrDefault(node => node.Id == "settings-overlay")?.Id
            ?? VerifiedNodes.FirstOrDefault()?.Id;
    }

    private void CreatePlan()
    {
        if (SelectedTarget is null)
        {
            return;
        }

        LocalError = null;
        try
        {
            Controller.CreateNavigationPlan(SelectedTarget);
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
    }

    private async Task RunAnchorAsync(string anchorId)
    {
        LocalError = null;
        try
        {
            await Controller.RunMenuAnchorAsync(anchorId);
            LastCompletedPlan = null;
        }
        catch (OperationCanceledException)
        {
            // Live state already reports cancellation and invalidates prediction.
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
    }

    private async Task ExecutePlanAsync()
    {
        LocalError = null;
        var plan = SelectedPlan;
        LastCompletedPlan = null;
        try
        {
            await Controller.ExecuteNavigationPlanAsync();
            LastCompletedPlan = plan;
        }
        catch (OperationCanceledException)
        {
            // Live state already reports cancellation and invalidates prediction.
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
    }

    private async Task ReportTraversalFailureAsync()
    {
        if (LastCompletedPlan is not { } failedPlan)
        {
            return;
        }

        ReportingTraversalFailure = true;
        LocalError = null;
        try
        {
            await Controller.ReportMenuTraversalFailureAsync(failedPlan);
            LastCompletedPlan = null;
            NavigationManager.NavigateTo("menu/build#draft-validation");
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            ReportingTraversalFailure = false;
        }
    }

    private void HandleControllerChanged()
    {
        Refresh();
        SelectDefaultTarget();
        _ = InvokeAsync(StateHasChanged);
    }

    private void Refresh()
    {
        Snapshot = Controller.GetSnapshot();
        Navigation = Controller.GetMenuNavigationSnapshot();
    }

    public void Dispose()
    {
        Controller.Changed -= HandleControllerChanged;
    }
}
