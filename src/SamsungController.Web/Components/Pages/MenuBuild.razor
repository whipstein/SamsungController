@implements IDisposable
@inject SamsungControllerService Controller

<PageTitle>Build &amp; Verify Menus · SamsungController</PageTitle>

<section class="page-heading compact-heading menu-build-heading">
    <div>
        <span class="eyebrow">BUILD &amp; VERIFY</span>
        <h1>Define the menu. Anchor it. Verify the minimum.</h1>
        <p>Enter the complete topology once, define how its base menu opens and closes, then follow the automatically calculated verification list.</p>
    </div>
    <div class="page-heading-actions">
        <HelpBubble Title="Build a TV menu interface" ButtonText="Page help">
            <ol>
                <li><strong>Define menu:</strong> create the TV profile and enter the complete hierarchy in on-screen order. Use hidden rules for setting-dependent rows and named configurations for reordered or otherwise unmodeled layouts.</li>
                <li><strong>Define anchor:</strong> choose the base menu, normally Settings; save the base-menu and deeper-menu return rules; then record only the keys that open the base menu from normal video.</li>
                <li><strong>Verify coverage:</strong> complete the displayed return and representative branch line items. Three visually correct passes promote every route covered by a line item.</li>
            </ol>
            <p class="help-callout">Red tree nodes have no route. Yellow nodes have a recorded or topology-generated draft that still needs coverage validation. Normal-color nodes are verified.</p>
            <p>A route is valid only in the configuration where it was recorded. SamsungController cannot detect external setting changes, so choose the matching configuration explicitly.</p>
            <p>When you add or edit menu items later, the list is recalculated. Unchanged branches keep their verification; only affected coverage returns to the list.</p>
            <p>New profiles use YAML by default. Choose JSON in the profile form when another tool will generate or consume the menu file; both formats have identical fields and validation.</p>
            <p><strong>Menu structure files are distributable.</strong> Display-verification results and saved TV values stay in local application data and are never written into an exported structure.</p>
            <p>Do not approve a failed pass. Manually restore the TV if needed, correct the topology, add an explicit exception, or adjust the waits and replay it.</p>
        </HelpBubble>
        <a class="secondary-action menu-authoring-link" href="menu">Open Menu <span>→</span></a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="notice danger" role="alert"><strong>Menu definition needs attention</strong><span class="definition-error-detail">@ErrorMessage</span></div>
}
else if (!string.IsNullOrWhiteSpace(LocalStatus))
{
    <div class="notice" role="status"><strong>Menu structure</strong><span>@LocalStatus</span></div>
}

<section class="panel definition-workspace">
    <div class="panel-label"><span>MENU STRUCTURE</span><span>DISTRIBUTABLE AUTHORING SOURCE</span></div>
    <div class="definition-profile">
        <div><span>Definition</span><strong>@(Navigation.DefinitionName ?? "Not loaded")</strong></div>
        <div><span>Model</span><strong>@(Navigation.Model ?? "—")</strong></div>
        <div><span>Firmware</span><strong>@(Navigation.Context?.Firmware ?? "—")</strong></div>
        <div><span>File format</span><strong>@DefinitionFormatLabel</strong></div>
        <div title="@ActiveConfiguration?.Conditions">
            <span>Menu configuration</span>
            <strong>@(ActiveConfiguration?.Name ?? "Default menu configuration")</strong>
        </div>
    </div>
    <div class="definition-editor">
        <label>
            <span>Active menu structure YAML or JSON</span>
            <input @bind="DefinitionPath" disabled="@Navigation.IsRunning" />
        </label>
        <button class="secondary-action" @onclick="LoadDefinitionAsync" disabled="@(Navigation.IsRunning || IsLoading)">@(IsLoading ? "Validating…" : "Load & validate")</button>
    </div>
    <div class="definition-editor structure-export-editor">
        <label>
            <span>Repository/distribution copy</span>
            <input @bind="StructureExportPath" disabled="@(Navigation.IsRunning || IsExporting)" />
        </label>
        <button class="secondary-action" @onclick="ExportStructureAsync" disabled="@(Navigation.IsRunning || IsExporting || string.IsNullOrWhiteSpace(StructureExportPath))">@(IsExporting ? "Exporting…" : "Export & use structure")</button>
        <small>Exports topology, controls, routes, and conditions, then makes that copy the active authoring source. Display verification and saved TV states remain local.</small>
    </div>
</section>

<section class="panel schema-inspector-panel">
    <div class="panel-label"><span>SCHEMA INSPECTOR</span><span>NO TV COMMANDS ARE SENT</span></div>
    <div class="schema-inspector-heading">
        <div>
            <h2>Evaluate menu files</h2>
            <p>Check one YAML/JSON file or every definition in a folder using the same parser, route generator, and validator as menu discovery.</p>
        </div>
        <HelpBubble Title="Schema inspector" ButtonText="How it works">
            <p>Select a file to diagnose one definition, or a directory to scan every <code>.yaml</code>, <code>.yml</code>, and <code>.json</code> file below it.</p>
            <p><strong>Errors</strong> prevent a file from appearing as a usable menu. JSON diagnostics include source line and column when a location can be identified.</p>
            <p><strong>Warnings</strong> do not prevent loading. They call out generated routes that will be rebuilt and missing anchors or seed traversals.</p>
            <p><strong>File evidence</strong> counts only verification evidence inside this file. Local display-verification sidecars are intentionally outside the distributable schema and are not included.</p>
        </HelpBubble>
    </div>
    <div class="definition-editor schema-inspector-editor">
        <label>
            <span>Menu file or directory</span>
            <input @bind="SchemaInspectionPath" disabled="@IsInspecting" />
        </label>
        <button class="primary-action" @onclick="InspectSchemasAsync" disabled="@(IsInspecting || string.IsNullOrWhiteSpace(SchemaInspectionPath))">@(IsInspecting ? "Inspecting…" : "Inspect")</button>
    </div>
    <div class="schema-inspector-shortcuts">
        <button class="secondary-action" @onclick="InspectActiveSchemaAsync" disabled="@(IsInspecting || string.IsNullOrWhiteSpace(Navigation.DefinitionPath))">Inspect active file</button>
        <button class="secondary-action" @onclick="InspectRepositoryCatalogAsync" disabled="@IsInspecting">Inspect repository catalog</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(SchemaInspectionError))
    {
        <div class="notice danger schema-inspector-notice" role="alert"><strong>Inspector could not run</strong><span>@SchemaInspectionError</span></div>
    }
    else if (SchemaInspections is not null)
    {
        <div class="schema-inspector-summary" role="status">
            <strong>@SchemaInspections.Count(item => item.IsValid) valid</strong>
            <span>@SchemaInspections.Count(item => !item.IsValid) invalid · @SchemaInspections.Count total</span>
        </div>
        @if (SchemaInspections.Count == 0)
        {
            <div class="panel-empty compact-empty">
                <strong>No menu definitions found</strong>
                <span>The selected directory contains no YAML or JSON files.</span>
            </div>
        }
        else
        {
            <div class="schema-inspection-list">
                @foreach (var inspection in SchemaInspections)
                {
                    <article class="schema-inspection-card @(inspection.IsValid ? inspection.Warnings.Count > 0 ? "warning" : "valid" : "invalid")">
                        <header>
                            <div>
                                <span>@(inspection.IsValid ? "VALID SCHEMA" : "INVALID SCHEMA") · @MenuDefinitionFileFormats.Label(inspection.Format)</span>
                                <strong>@(inspection.Name ?? Path.GetFileName(inspection.Path))</strong>
                                <small>@inspection.Path</small>
                            </div>
                            @if (inspection.IsValid)
                            {
                                <button class="secondary-action" @onclick="() => ActivateInspectedDefinitionAsync(inspection.Path)" disabled="@(Navigation.IsRunning || IsLoading)">Load this definition</button>
                            }
                        </header>
                        @if (inspection.IsValid)
                        {
                            <div class="schema-inspection-facts">
                                <div><span>ID</span><strong>@inspection.Id</strong></div>
                                <div><span>Model / firmware</span><strong>@inspection.Model · @inspection.Context?.Firmware</strong></div>
                                <div><span>Nodes</span><strong>@inspection.NodeCount</strong></div>
                                <div><span>Anchors</span><strong>@inspection.AnchorCount</strong></div>
                                <div><span>Seed routes</span><strong>@inspection.ExplicitTransitionCount</strong></div>
                                <div><span>Calculated routes</span><strong>@inspection.GeneratedTransitionCount</strong></div>
                                <div><span>Configurations</span><strong>@inspection.ConfigurationCount</strong></div>
                                <div title="Local display-verification sidecars are not included."><span>File evidence</span><strong>@inspection.CurrentVerificationCheckCount / @inspection.VerificationCheckCount</strong></div>
                            </div>
                        }
                        @if (inspection.Diagnostics.Count > 0)
                        {
                            <div class="schema-diagnostic-block errors">
                                <strong>Errors</strong>
                                <ol>
                                    @foreach (var diagnostic in inspection.Diagnostics)
                                    {
                                        <li>@diagnostic</li>
                                    }
                                </ol>
                            </div>
                        }
                        @if (inspection.Warnings.Count > 0)
                        {
                            <div class="schema-diagnostic-block warnings">
                                <strong>Warnings</strong>
                                <ul>
                                    @foreach (var warning in inspection.Warnings)
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    }
</section>

<MenuAuthoringStudio />

@code {
    private MenuNavigationSnapshot Navigation { get; set; } = null!;
    private string DefinitionPath { get; set; } = string.Empty;
    private string? LastObservedDefinitionPath { get; set; }
    private string? LocalError { get; set; }
    private string? LocalStatus { get; set; }
    private bool IsLoading { get; set; }
    private bool IsExporting { get; set; }
    private string StructureExportPath { get; set; } = string.Empty;
    private string SchemaInspectionPath { get; set; } = string.Empty;
    private bool IsInspecting { get; set; }
    private string? SchemaInspectionError { get; set; }
    private IReadOnlyList<MenuDefinitionSchemaInspection>? SchemaInspections { get; set; }

    private string? ErrorMessage => LocalError ?? Navigation.Error;
    private string DefinitionFormatLabel => Path.GetExtension(Navigation.DefinitionPath)
        .ToLowerInvariant() switch
    {
        ".json" => "JSON",
        ".yaml" or ".yml" => "YAML",
        "" when string.IsNullOrWhiteSpace(Navigation.DefinitionPath) => "—",
        _ => "Auto-detected"
    };
    private MenuConfigurationSummary? ActiveConfiguration => Navigation.Configurations
        .FirstOrDefault(configuration => configuration.IsActive);

    protected override async Task OnInitializedAsync()
    {
        Navigation = Controller.GetMenuNavigationSnapshot();
        Controller.Changed += HandleControllerChanged;
        await Controller.InitializeAsync();
        Refresh();
    }

    private async Task LoadDefinitionAsync()
    {
        IsLoading = true;
        LocalError = null;
        LocalStatus = null;
        try
        {
            await Controller.SetMenuDefinitionAsync(DefinitionPath);
            Refresh();
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ExportStructureAsync()
    {
        IsExporting = true;
        LocalError = null;
        LocalStatus = null;
        try
        {
            var exportedPath = await Controller.ExportMenuStructureAsync(
                StructureExportPath);
            await Controller.SetMenuDefinitionAsync(exportedPath);
            StructureExportPath = exportedPath;
            Refresh();
            LocalStatus = $"Exported and activated the distributable menu structure at {exportedPath}. Local display verification and saved TV states were not included.";
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsExporting = false;
        }
    }

    private async Task InspectSchemasAsync()
    {
        IsInspecting = true;
        SchemaInspectionError = null;
        try
        {
            SchemaInspections = await Controller.InspectMenuDefinitionSchemasAsync(
                SchemaInspectionPath);
        }
        catch (Exception exception)
        {
            SchemaInspections = null;
            SchemaInspectionError = exception.Message;
        }
        finally
        {
            IsInspecting = false;
        }
    }

    private async Task InspectActiveSchemaAsync()
    {
        SchemaInspectionPath = Navigation.DefinitionPath;
        await InspectSchemasAsync();
    }

    private async Task InspectRepositoryCatalogAsync()
    {
        SchemaInspectionPath = Path.Combine(
            Directory.GetCurrentDirectory(),
            "menu-definitions");
        await InspectSchemasAsync();
    }

    private async Task ActivateInspectedDefinitionAsync(string path)
    {
        DefinitionPath = path;
        await LoadDefinitionAsync();
    }

    private void HandleControllerChanged()
    {
        Refresh();
        _ = InvokeAsync(StateHasChanged);
    }

    private void Refresh()
    {
        var navigation = Controller.GetMenuNavigationSnapshot();
        if (string.IsNullOrWhiteSpace(DefinitionPath)
            || DefinitionPath.Equals(LastObservedDefinitionPath, StringComparison.Ordinal))
        {
            DefinitionPath = navigation.DefinitionPath;
        }

        LastObservedDefinitionPath = navigation.DefinitionPath;
        Navigation = navigation;
        if (string.IsNullOrWhiteSpace(StructureExportPath)
            && !string.IsNullOrWhiteSpace(navigation.DefinitionPath))
        {
            StructureExportPath = Path.Combine(
                Directory.GetCurrentDirectory(),
                "menu-definitions",
                Path.GetFileName(navigation.DefinitionPath));
        }

        if (string.IsNullOrWhiteSpace(SchemaInspectionPath))
        {
            SchemaInspectionPath = Path.Combine(
                Directory.GetCurrentDirectory(),
                "menu-definitions");
        }
    }

    public void Dispose()
    {
        Controller.Changed -= HandleControllerChanged;
    }
}
