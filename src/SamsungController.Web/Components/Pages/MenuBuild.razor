@page "/menu/build"
@implements IDisposable
@inject SamsungControllerService Controller

<PageTitle>Build &amp; Verify Menus · SamsungController</PageTitle>

<section class="page-heading compact-heading menu-build-heading">
    <div>
        <span class="eyebrow">BUILD &amp; VERIFY</span>
        <h1>Define the menu. Anchor it. Verify the minimum.</h1>
        <p>Enter the complete topology once, define how its base menu opens and closes, then follow the automatically calculated verification list.</p>
    </div>
    <div class="page-heading-actions">
        <HelpBubble Title="Build a TV menu interface" ButtonText="Page help">
            <ol>
                <li><strong>Define menu:</strong> create the TV profile and enter the complete hierarchy in on-screen order. Use hidden rules for setting-dependent rows and named configurations for reordered or otherwise unmodeled layouts.</li>
                <li><strong>Define anchor:</strong> choose the base menu, normally Settings; save the base-menu and deeper-menu return rules; then record only the keys that open the base menu from normal video.</li>
                <li><strong>Verify coverage:</strong> complete the displayed return and representative branch line items. Three visually correct passes promote every route covered by a line item.</li>
            </ol>
            <p class="help-callout">Red tree nodes have no route. Yellow nodes have a recorded or topology-generated draft that still needs coverage validation. Normal-color nodes are verified.</p>
            <p>A route is valid only in the configuration where it was recorded. SamsungController cannot detect external setting changes, so choose the matching configuration explicitly.</p>
            <p>When you add or edit menu items later, the list is recalculated. Unchanged branches keep their verification; only affected coverage returns to the list.</p>
            <p>New profiles use YAML by default. Choose JSON in the profile form when another tool will generate or consume the menu file; both formats have identical fields and validation.</p>
            <p>Do not approve a failed pass. Manually restore the TV if needed, correct the topology, add an explicit exception, or adjust the waits and replay it.</p>
        </HelpBubble>
        <a class="secondary-action menu-authoring-link" href="menu">View verified menus <span>→</span></a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="notice danger" role="alert"><strong>Menu definition needs attention</strong><span>@ErrorMessage</span></div>
}

<section class="panel definition-workspace">
    <div class="panel-label"><span>MENU DEFINITION</span><span>AUTHORING SOURCE</span></div>
    <div class="definition-profile">
        <div><span>Definition</span><strong>@(Navigation.DefinitionName ?? "Not loaded")</strong></div>
        <div><span>Model</span><strong>@(Navigation.Model ?? "—")</strong></div>
        <div><span>Firmware</span><strong>@(Navigation.Context?.Firmware ?? "—")</strong></div>
        <div><span>Context</span><strong>@ContextLabel</strong></div>
        <div><span>File format</span><strong>@DefinitionFormatLabel</strong></div>
        <div title="@ActiveConfiguration?.Conditions">
            <span>Menu configuration</span>
            <strong>@(ActiveConfiguration?.Name ?? "Default menu configuration")</strong>
        </div>
    </div>
    <div class="definition-editor">
        <label>
            <span>Menu definition YAML or JSON</span>
            <input @bind="DefinitionPath" disabled="@Navigation.IsRunning" />
        </label>
        <button class="secondary-action" @onclick="LoadDefinitionAsync" disabled="@(Navigation.IsRunning || IsLoading)">@(IsLoading ? "Validating…" : "Load & validate")</button>
    </div>
</section>

<MenuAuthoringStudio />

@code {
    private MenuNavigationSnapshot Navigation { get; set; } = null!;
    private string DefinitionPath { get; set; } = string.Empty;
    private string? LastObservedDefinitionPath { get; set; }
    private string? LocalError { get; set; }
    private bool IsLoading { get; set; }

    private string? ErrorMessage => LocalError ?? Navigation.Error;
    private string ContextLabel => Navigation.Context is null
        ? "—"
        : $"{Navigation.Context.Signal} · {Navigation.Context.PictureMode} · {Navigation.Context.Input}";
    private string DefinitionFormatLabel => Path.GetExtension(Navigation.DefinitionPath)
        .ToLowerInvariant() switch
    {
        ".json" => "JSON",
        ".yaml" or ".yml" => "YAML",
        "" when string.IsNullOrWhiteSpace(Navigation.DefinitionPath) => "—",
        _ => "Auto-detected"
    };
    private MenuConfigurationSummary? ActiveConfiguration => Navigation.Configurations
        .FirstOrDefault(configuration => configuration.IsActive);

    protected override async Task OnInitializedAsync()
    {
        Navigation = Controller.GetMenuNavigationSnapshot();
        Controller.Changed += HandleControllerChanged;
        await Controller.InitializeAsync();
        Refresh();
    }

    private async Task LoadDefinitionAsync()
    {
        IsLoading = true;
        LocalError = null;
        try
        {
            await Controller.SetMenuDefinitionAsync(DefinitionPath);
            Refresh();
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void HandleControllerChanged()
    {
        Refresh();
        _ = InvokeAsync(StateHasChanged);
    }

    private void Refresh()
    {
        var navigation = Controller.GetMenuNavigationSnapshot();
        if (string.IsNullOrWhiteSpace(DefinitionPath)
            || DefinitionPath.Equals(LastObservedDefinitionPath, StringComparison.Ordinal))
        {
            DefinitionPath = navigation.DefinitionPath;
        }

        LastObservedDefinitionPath = navigation.DefinitionPath;
        Navigation = navigation;
    }

    public void Dispose()
    {
        Controller.Changed -= HandleControllerChanged;
    }
}
