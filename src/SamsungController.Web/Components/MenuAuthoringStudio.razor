    private void LoadCurrentTopologyOutline()
    {
        var builder = new StringBuilder();

        void AppendChildren(string parentId, int depth)
        {
            foreach (var node in Navigation.Nodes.Where(candidate => string.Equals(
                         candidate.ParentId,
                         parentId,
                         StringComparison.OrdinalIgnoreCase)))
            {
                builder.Append(' ', depth * 2)
                    .Append(node.Label)
                    .Append(' ')
                    .Append(FormatOutlineControlDetails(node))
                    .Append(" [")
                    .Append(node.Id)
                    .AppendLine("]");
                AppendChildren(node.Id, depth + 1);
            }
        }

        AppendChildren(TopologyParentId, 0);
        TopologyOutline = builder.ToString().TrimEnd();
        TopologyOutlineDirty = false;
        TopologyOutlineDefinitionPath = Navigation.DefinitionPath;
        TopologyPreview = null;
        TopologyOutlineError = null;
        LocalError = null;
    }

    private void PreviewTopologyOutline()
    {
        LocalError = null;
        TopologyOutlineError = null;
        try
        {
            TopologyPreview = Controller.PreviewMenuTopologyOutline(CreateTopologyOutlineRequest());
        }
        catch (Exception exception)
        {
            TopologyPreview = null;
            TopologyOutlineError = exception.Message;
        }
    }

    private async Task ApplyTopologyOutlineAsync(bool continueToRecording)
    {
        IsBusy = true;
        LocalError = null;
        TopologyOutlineError = null;
        try
        {
            await Controller.ApplyMenuTopologyOutlineAsync(CreateTopologyOutlineRequest());
            Refresh();
            LoadCurrentTopologyOutline();
            InitializeNodeDefaults(force: true);
            if (continueToRecording)
            {
                MenuTreeExpanded = false;
                PendingSetupScroll = MenuSetupStep.Record;
            }
            else
            {
                MenuTreeExpanded = true;
                BulkTopologyExpanded = true;
            }
        }
        catch (OperationCanceledException)
        {
            // Service state reports cancellation.
        }
        catch (Exception exception)
        {
            TopologyPreview = null;
            TopologyOutlineError = exception.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

