@implements IDisposable
@inject SamsungControllerService Controller

<section class="panel authoring-studio">
    <div class="panel-label">
        <span>MENU AUTHORING STUDIO</span>
        <span class="@(Authoring.IsRecording ? "recording-indicator active" : "recording-indicator")">
            @(Authoring.IsRecording ? "● RECORDING" : "UI → TV → YAML → 3× VERIFY")
        </span>
    </div>

    <div class="authoring-intro">
        <div>
            <strong>Build routes without editing files.</strong>
            <p>Record buttons while they control the TV, save the sequence as draft YAML, then replay it three times before it becomes verified.</p>
        </div>
        <button class="secondary-action" @onclick="ToggleDefinitionForm" disabled="@(Authoring.IsRecording || Navigation.IsRunning)">
            @(ShowDefinitionForm ? "Close setup" : "New TV interface")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="authoring-message error" role="alert">@ErrorMessage</div>
    }
    else if (!string.IsNullOrWhiteSpace(Authoring.Status))
    {
        <div class="authoring-message">@Authoring.Status</div>
    }

    @if (ShowDefinitionForm)
    {
        <div class="definition-setup-card">
            <div class="authoring-section-title"><span>01</span><strong>Create a menu definition</strong></div>
            <div class="authoring-form-grid">
                <label><span>Definition ID</span><input @bind="DefinitionId" placeholder="living-room-tv" /></label>
                <label><span>Name</span><input @bind="DefinitionName" placeholder="Living Room TV Menu" /></label>
                <label><span>TV model</span><input @bind="DefinitionModel" placeholder="Samsung S95F" /></label>
                <label><span>Firmware</span><input @bind="DefinitionFirmware" placeholder="1296" /></label>
                <label><span>Signal</span><input @bind="DefinitionSignal" placeholder="SDR" /></label>
                <label><span>Picture mode</span><input @bind="DefinitionPictureMode" placeholder="Filmmaker Mode" /></label>
                <label class="wide-field"><span>Input/source</span><input @bind="DefinitionInput" placeholder="Home Theater System" /></label>
            </div>
            <button class="primary-action authoring-save" @onclick="CreateDefinitionAsync" disabled="@IsBusy">
                Create and load definition <span>→</span>
            </button>
            <p class="field-note">The YAML file is created in SamsungController's per-user configuration directory and becomes the active definition.</p>
        </div>
    }

    @if (Navigation.DefinitionName is not null)
    {
        <div class="menu-tree-builder collapsible-authoring-section @(MenuTreeExpanded ? "" : "collapsed")">
            <button type="button" class="authoring-section-title authoring-section-toggle" @onclick="ToggleMenuTree" aria-expanded="@(MenuTreeExpanded ? "true" : "false")">
                <span>00</span><strong>Define the overall menu tree</strong>
                <b class="tree-node-count">@Navigation.Nodes.Count nodes</b>
                <i aria-hidden="true">@(MenuTreeExpanded ? "−" : "+")</i>
            </button>
            @if (MenuTreeExpanded)
            {
                <div class="authoring-section-body">
                    <div class="menu-tree-toolbar">
                        <p class="menu-tree-intro">Name and arrange the complete on-screen hierarchy first. Custom order is saved to YAML and can mirror the TV; alphabetical order is a temporary viewing aid.</p>
                        <label>
                            <span>TREE ORDER</span>
                            <select @bind="TreeOrdering">
                                <option value="@MenuTreeSortMode.Custom">Custom · TV order</option>
                                <option value="@MenuTreeSortMode.Alphabetical">Alphabetical</option>
                            </select>
                        </label>
                    </div>
                    <div class="menu-tree-layout">
                        <div class="menu-tree-list">
                            <button class="secondary-action menu-tree-new" @onclick="BeginNewMenuNode" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)">+ New node</button>
                            @foreach (var node in OrderedTreeNodes)
                            {
                                <div class="menu-tree-node @(EditingNodeId?.Equals(node.Id, StringComparison.OrdinalIgnoreCase) == true ? "active" : "")">
                                    <button type="button" class="menu-tree-node-select" @onclick="() => EditMenuNode(node)">
                                        <span style="--tree-depth: @node.Depth">@node.Label</span>
                                        <small>@node.Id</small>
                                    </button>
                                    @if (TreeOrdering == MenuTreeSortMode.Custom)
                                    {
                                        <div class="menu-tree-order-actions">
                                            <button type="button" title="Move up within this menu level" aria-label="Move @node.Label up" @onclick="() => MoveMenuNodeAsync(node.Id, -1)" disabled="@(!CanMoveMenuNode(node, -1))">↑</button>
                                            <button type="button" title="Move down within this menu level" aria-label="Move @node.Label down" @onclick="() => MoveMenuNodeAsync(node.Id, 1)" disabled="@(!CanMoveMenuNode(node, 1))">↓</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="menu-node-editor">
                            <header>
                                <span>@(EditingNodeId is null ? "NEW TREE NODE" : "EDIT TREE NODE")</span>
                                <strong>@(EditingNodeId is null ? "Add a named menu position" : NodeEditorLabel)</strong>
                            </header>
                            <div class="authoring-form-grid compact">
                                <label>
                                    <span>Display name</span>
                                    <input @bind="NodeEditorLabel" placeholder="Brightness" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)" />
                                </label>
                                <label>
                                    <span>Stable node ID</span>
                                    <input @bind="NodeEditorId" placeholder="Generated from name" disabled="@(EditingNodeId is not null || IsBusy || Authoring.IsRecording || Navigation.IsRunning)" />
                                </label>
                                <label class="wide-field">
                                    <span>Parent menu position</span>
                                    <select @bind="NodeEditorParentId" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)">
                                        <option value="">No parent (top-level)</option>
                                        @foreach (var node in AvailableParentNodes)
                                        {
                                            <option value="@node.Id">@node.Path</option>
                                        }
                                    </select>
                                </label>
                                <label class="wide-field">
                                    <span>Description (optional)</span>
                                    <input @bind="NodeEditorDescription" placeholder="What is visible or selected in this state" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)" />
                                </label>
                            </div>
                            @if (EditingNodeId is null && string.IsNullOrWhiteSpace(NodeEditorId) && !string.IsNullOrWhiteSpace(NodeEditorLabel))
                            {
                                <p class="field-note">Will be saved as <code>@CreateMenuNodeId(NodeEditorLabel)</code>.</p>
                            }
                            <div class="menu-node-editor-actions">
                                @if (EditingNodeId is not null)
                                {
                                    @if (ConfirmMenuNodeDelete)
                                    {
                                        <button class="secondary-action" @onclick="CancelMenuNodeDelete" disabled="@IsBusy">Cancel</button>
                                        <button class="secondary-action danger-action" @onclick="DeleteMenuNodeAsync" disabled="@IsBusy">Delete unrecorded branch</button>
                                    }
                                    else
                                    {
                                        <button class="secondary-action danger-action" @onclick="RequestMenuNodeDelete" disabled="@(!CanDeleteMenuNode)">Delete</button>
                                    }
                                }
                                <button class="primary-action" @onclick="SaveMenuNodeAsync" disabled="@(!CanSaveMenuNode)">@(EditingNodeId is null ? "Add to tree" : "Save node") <span>→</span></button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (VerifiedSettings.Count > 0)
    {
        <div class="verified-setting-manager collapsible-authoring-section @(ManageVerifiedSettingsExpanded ? "" : "collapsed")">
            <button type="button" class="authoring-section-title authoring-section-toggle" @onclick="ToggleManageVerifiedSettings" aria-expanded="@(ManageVerifiedSettingsExpanded ? "true" : "false")">
                <span>!</span><strong>Manage verified settings</strong><i aria-hidden="true">@(ManageVerifiedSettingsExpanded ? "−" : "+")</i>
            </button>
            @if (ManageVerifiedSettingsExpanded)
            {
                <div class="authoring-section-body">
                    <p>Remove an incorrect validated setting from the map. Removal also deletes its descendants and every route that enters or leaves them.</p>
                    <div class="verified-setting-list">
                        @foreach (var setting in VerifiedSettings)
                        {
                            var isProtected = IsKnownStateSetting(setting);
                            var isConfirming = PendingVerifiedSettingRemovalId?.Equals(
                                setting.Id,
                                StringComparison.OrdinalIgnoreCase) == true;
                            <div class="verified-setting-row @(isConfirming ? "confirming" : "")">
                                <span>
                                    <strong>@setting.Label</strong>
                                    <small>@setting.Path</small>
                                </span>
                                @if (isProtected)
                                {
                                    <b>Known state</b>
                                }
                                else if (isConfirming)
                                {
                                    <div class="verified-setting-confirm">
                                        <button class="secondary-action" @onclick="CancelVerifiedSettingRemoval" disabled="@IsBusy">Cancel</button>
                                        <button class="secondary-action danger-action" @onclick="() => RemoveVerifiedSettingAsync(setting)" disabled="@IsBusy">Confirm removal</button>
                                    </div>
                                }
                                else
                                {
                                    <button class="secondary-action danger-action" @onclick="() => RemoveVerifiedSettingAsync(setting)" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)">Remove</button>
                                }
                            </div>
                        }
                    </div>
                    <p class="field-note">Verified anchor targets are protected because automatic connection synchronization depends on them.</p>
                </div>
            }
        </div>
    }

    @if (Navigation.DefinitionName is not null)
    {
        <div class="authoring-workflow-grid">
            <div class="authoring-config">
                <div class="authoring-section-title"><span>01</span><strong>Describe the recording</strong></div>
                @if (ReturnToVideoAnchor is not null)
                {
                    <label class="return-recording-toggle">
                        <input type="checkbox" @bind="RedefineReturnToVideo" disabled="@Authoring.IsRecording" />
                        <span>
                            <strong>Redefine return to normal video</strong>
                            <small>Record a replacement for the current default without changing it until the replacement passes 3/3.</small>
                        </span>
                    </label>
                }
                <div class="authoring-form-grid compact">
                    @if (RedefineReturnToVideo && ReturnToVideoAnchor is { } returnAnchor)
                    {
                        <div class="auto-route-identity wide-field return-recording-intent">
                            <span>FIXED RECORDING INTENT</span>
                            <strong>@returnAnchor.Label</strong>
                            <small>Target: @returnAnchor.TargetPath · the replacement is saved as a separate draft.</small>
                        </div>
                        <label class="wide-field">
                            <span>Verification start state</span>
                            <select @bind="ReturnVerificationSourceNodeId" disabled="@Authoring.IsRecording">
                                @foreach (var node in ReturnVerificationSources)
                                {
                                    <option value="@node.Id">@node.Path</option>
                                }
                            </select>
                        </label>
                    }
                    else
                    {
                        <label>
                            <span>Record as</span>
                            <select @bind="RecordingKind" disabled="@Authoring.IsRecording">
                                <option value="@MenuAuthoringItemKind.Transition">Transition</option>
                                <option value="@MenuAuthoringItemKind.Anchor">Anchor</option>
                            </select>
                        </label>
                        @if (RecordingKind == MenuAuthoringItemKind.Anchor)
                        {
                            <label><span>Anchor ID</span><input @bind="RecordingId" disabled="@Authoring.IsRecording" /></label>
                            <label class="wide-field"><span>Label / intent</span><input @bind="RecordingLabel" disabled="@Authoring.IsRecording" /></label>
                        }
                        else
                        {
                            <label>
                                <span>Source control</span>
                                <select @bind="SourceNodeId" disabled="@Authoring.IsRecording">
                                    @foreach (var node in Navigation.Nodes)
                                    {
                                        <option value="@node.Id">@node.Path</option>
                                    }
                                </select>
                            </label>
                            <div class="auto-route-identity wide-field">
                                <span>AUTOMATIC TRAVERSAL</span>
                                <strong>Identified by source and target</strong>
                                <small>An existing draft for the same route is replaced automatically.</small>
                            </div>
                        }
                        <label class="wide-field">
                            <span>Target node</span>
                            <select @bind="ExistingTargetId" disabled="@Authoring.IsRecording">
                                @foreach (var node in Navigation.Nodes)
                                {
                                    <option value="@node.Id">@node.Path</option>
                                }
                            </select>
                        </label>
                    }
                </div>

                @if (!Authoring.IsRecording)
                {
                    <div class="authoring-start-actions">
                        @if (RecordingKind == MenuAuthoringItemKind.Transition)
                        {
                            <button class="secondary-action" @onclick="PrepareSourceAsync" disabled="@(!CanPrepareSource)">Prepare source</button>
                        }
                        <button class="primary-action" @onclick="StartRecording" disabled="@(!CanStartRecording)">
                            Start live recording <span>●</span>
                        </button>
                    </div>
                    @if (RedefineReturnToVideo)
                    {
                        <p class="field-note">During validation, Prepare source sends this replacement draft first, then follows a verified route to the selected start state. If that preparation is wrong, manually position the TV before Replay test.</p>
                    }
                    else
                    {
                        <p class="field-note">Add and name menu positions in the tree above, then choose them here. New recordings inherit the system-wide timing profile; traversals are matched to source and target automatically.</p>
                    }
                }
                else
                {
                    <div class="recording-actions">
                        <button class="primary-action" @onclick="StopAndSaveAsync" disabled="@(IsBusy || Authoring.RecordedCommandCount == 0)">Stop + save draft <span>■</span></button>
                        <button class="secondary-action" @onclick="Controller.UndoLastRecordedMenuCommand" disabled="@(Authoring.RecordedCommandCount == 0)">Undo last</button>
                        <button class="secondary-action danger-action" @onclick="Controller.ClearRecordedMenuCommands" disabled="@(Authoring.RecordedCommandCount == 0)">Clear</button>
                        <button class="secondary-action danger-action" @onclick="CancelRecording" disabled="@(IsBusy || IsSendingKey)">Cancel recording</button>
                    </div>
                }
            </div>

            <div class="authoring-controller">
                <div class="authoring-section-title"><span>02</span><strong>Control and capture</strong></div>
                <div class="authoring-remote" aria-label="Menu recording remote">
                    <div class="authoring-remote-row">
                        <button @onclick='() => SendRecordedKeyAsync("KEY_HOME")' disabled="@RecordButtonsDisabled">Home</button>
                        <button @onclick='() => SendRecordedKeyAsync("KEY_MENU")' disabled="@RecordButtonsDisabled">Menu</button>
                        <button @onclick='() => SendRecordedKeyAsync("KEY_EXIT")' disabled="@RecordButtonsDisabled">Exit</button>
                    </div>
                    <div class="authoring-dpad">
                        <button class="up" aria-label="Up" @onclick='() => SendRecordedKeyAsync("KEY_UP")' disabled="@RecordButtonsDisabled">↑</button>
                        <button class="left" aria-label="Left" @onclick='() => SendRecordedKeyAsync("KEY_LEFT")' disabled="@RecordButtonsDisabled">←</button>
                        <button class="enter" aria-label="Enter" @onclick='() => SendRecordedKeyAsync("KEY_ENTER")' disabled="@RecordButtonsDisabled">OK</button>
                        <button class="right" aria-label="Right" @onclick='() => SendRecordedKeyAsync("KEY_RIGHT")' disabled="@RecordButtonsDisabled">→</button>
                        <button class="down" aria-label="Down" @onclick='() => SendRecordedKeyAsync("KEY_DOWN")' disabled="@RecordButtonsDisabled">↓</button>
                    </div>
                    <button class="authoring-return" @onclick='() => SendRecordedKeyAsync("KEY_RETURN")' disabled="@RecordButtonsDisabled">↩ Return</button>
                </div>
                <div class="custom-record-key">
                    <input @bind="CustomKey" placeholder="KEY_SOURCE" disabled="@RecordButtonsDisabled" />
                    <select @bind="CustomAction" disabled="@RecordButtonsDisabled">
                        @foreach (var action in Enum.GetValues<RemoteKeyAction>())
                        {
                            <option value="@action">@action</option>
                        }
                    </select>
                    <button class="secondary-action" @onclick="SendCustomRecordedKeyAsync" disabled="@(RecordButtonsDisabled || string.IsNullOrWhiteSpace(CustomKey))">Send</button>
                </div>
            </div>

            <div class="authoring-capture">
                <div class="authoring-section-title"><span>03</span><strong>Captured sequence</strong></div>
                @if (Authoring.RecordedSteps.Count == 0)
                {
                    <div class="capture-empty">Start recording, then use the controls. Only successfully sent keys appear here.</div>
                }
                else
                {
                    <div class="recorded-step-list">
                        @foreach (var step in Authoring.RecordedSteps)
                        {
                            <div><code>@step.Key</code><span>×@step.Repeat · @step.Action · @step.DelayAfter.TotalMilliseconds.ToString("0", CultureInfo.InvariantCulture)ms</span></div>
                        }
                    </div>
                    <div class="recorded-total">@Authoring.RecordedCommandCount button presses captured</div>
                }
            </div>
        </div>

        @if (Authoring.ReturnStrategy is { } returnStrategy)
        {
            <div class="return-strategy-lab collapsible-authoring-section @(ReturnScriptsExpanded ? "" : "collapsed")">
                <button type="button" class="authoring-section-title authoring-section-toggle" @onclick="ToggleReturnScripts" aria-expanded="@(ReturnScriptsExpanded ? "true" : "false")">
                    <span>04</span><strong>Return to normal video scripts</strong>
                    <b class="timing-profile-state @(ReturnScriptsNeedValidation ? "unverified" : "verified")">
                        @(ReturnScriptsNeedValidation ? "NEEDS VALIDATION" : "VERIFIED")
                    </b>
                    <i aria-hidden="true">@(ReturnScriptsExpanded ? "−" : "+")</i>
                </button>
                @if (ReturnScriptsExpanded)
                {
                    <div class="authoring-section-body">
                        <p class="return-strategy-intro">An exact verified state override is tried first. Otherwise the verified menu-root or deeper-menu default is used, followed by the existing unknown-position anchor. Tests send only the script shown—prepare or place the TV at the named start first.</p>
                        <div class="return-script-grid">
                    <article class="return-script-card">
                        <header>
                            <div><span>AT MENU ROOT</span><strong>@returnStrategy.MenuRootPath</strong></div>
                            <b class="timing-profile-state @(returnStrategy.AtMenuRoot.Verified ? "verified" : "unverified")">@(returnStrategy.AtMenuRoot.Verified ? "VERIFIED" : "NEEDS VALIDATION")</b>
                        </header>
                        <label><span>KEY SCRIPT</span><input @bind="AtMenuRootScript" @bind:after="MarkReturnScriptsDirty" disabled="@(IsBusy || Navigation.IsRunning)" /></label>
                        <small>Place the TV at this menu first. Test sends only <code>@AtMenuRootScript</code>.</small>
                        <div class="return-script-actions">
                            @if (returnStrategy.ActiveValidationKind == MenuReturnScriptKind.AtMenuRoot)
                            {
                                <b>@returnStrategy.ValidationPasses/@returnStrategy.RequiredValidationPasses passed</b>
                            }
                            <button class="primary-action" @onclick="TestAtMenuRootReturnAsync" disabled="@(!CanTestAtMenuRootReturn)">Save + test <span>▶</span></button>
                        </div>
                    </article>

                    <article class="return-script-card">
                        <header>
                            <div><span>DEEPER MENU</span><strong>Any node below @returnStrategy.MenuRootPath</strong></div>
                            <b class="timing-profile-state @(returnStrategy.BelowMenuRoot.Verified ? "verified" : "unverified")">@(returnStrategy.BelowMenuRoot.Verified ? "VERIFIED" : "NEEDS VALIDATION")</b>
                        </header>
                        <label><span>KEY SCRIPT</span><input @bind="BelowMenuRootScript" @bind:after="MarkReturnScriptsDirty" disabled="@(IsBusy || Navigation.IsRunning)" /></label>
                        <small>Place the TV at the selected deeper menu first. Test sends only <code>@BelowMenuRootScript</code>.</small>
                        <label>
                            <span>EXPECTED START</span>
                            <select @bind="DeepReturnTestNodeId" disabled="@(IsBusy || Navigation.IsRunning)">
                                @foreach (var node in returnStrategy.DeepTestNodes)
                                {
                                    <option value="@node.Id">@node.Path</option>
                                }
                            </select>
                        </label>
                        <div class="return-script-actions">
                            @if (returnStrategy.ActiveValidationKind == MenuReturnScriptKind.BelowMenuRoot)
                            {
                                <b>@returnStrategy.ValidationPasses/@returnStrategy.RequiredValidationPasses passed</b>
                            }
                            <button class="primary-action" @onclick="TestBelowMenuRootReturnAsync" disabled="@(!CanTestBelowMenuRootReturn)">Save + test <span>▶</span></button>
                        </div>
                    </article>
                </div>
                <div class="return-override-lab">
                    <header>
                        <div>
                            <span>STATE-SPECIFIC OVERRIDES</span>
                            <strong>Use a different return script from one exact menu position</strong>
                        </div>
                        <b>@returnStrategy.NodeOverrides.Count defined</b>
                    </header>
                    <div class="return-override-editor">
                        <label>
                            <span>MENU STATE</span>
                            <select @bind="OverrideReturnNodeId" @bind:after="LoadSelectedReturnOverride" disabled="@(IsBusy || Navigation.IsRunning)">
                                @foreach (var node in ReturnOverrideNodes)
                                {
                                    var existingOverride = returnStrategy.NodeOverrides.FirstOrDefault(item => item.NodeId.Equals(node.Id, StringComparison.OrdinalIgnoreCase));
                                    <option value="@node.Id">@node.Path@(existingOverride is null ? "" : existingOverride.Verified ? " · verified override" : " · override needs validation")</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>KEY SCRIPT</span>
                            <input @bind="OverrideReturnScript" placeholder="KEY_MENU, KEY_RETURN" disabled="@(IsBusy || Navigation.IsRunning)" />
                        </label>
                        <div class="return-override-status">
                            @if (SelectedReturnOverride is { } selectedOverride)
                            {
                                <b class="timing-profile-state @(selectedOverride.Verified ? "verified" : "unverified")">@(selectedOverride.Verified ? "VERIFIED" : "NEEDS VALIDATION")</b>
                            }
                            else
                            {
                                <b class="timing-profile-state unverified">USES DEFAULT</b>
                            }
                            @if (returnStrategy.ActiveValidationKind == MenuReturnScriptKind.NodeOverride
                                && returnStrategy.ActiveValidationNodeId?.Equals(OverrideReturnNodeId, StringComparison.OrdinalIgnoreCase) == true)
                            {
                                <small>@returnStrategy.ValidationPasses/@returnStrategy.RequiredValidationPasses passed</small>
                            }
                        </div>
                    </div>
                    <div class="return-override-actions">
                        <button class="secondary-action" @onclick="PrepareReturnOverrideStartAsync" disabled="@(!CanPrepareReturnOverride)">Prepare start</button>
                        @if (SelectedReturnOverride is not null)
                        {
                            <button class="secondary-action danger-action" @onclick="DeleteReturnOverrideAsync" disabled="@(IsBusy || Navigation.IsRunning)">Remove override</button>
                        }
                        <button class="secondary-action" @onclick="SaveReturnOverrideAsync" disabled="@(!CanSaveReturnOverride)">Save override</button>
                        <button class="primary-action" @onclick="TestReturnOverrideAsync" disabled="@(!CanTestReturnOverride)">Save + test <span>▶</span></button>
                    </div>
                    <small class="return-override-note">Removing an override immediately restores the normal root/deeper/default fallback for that state.</small>
                </div>
                <div class="return-fallback-row">
                    <div><span>UNKNOWN POSITION FALLBACK</span><strong>@returnStrategy.AnchorLabel</strong></div>
                    <code>@returnStrategy.FallbackScript</code>
                    <small>This existing verified anchor remains the fallback when the predicted menu position is unavailable.</small>
                    <button class="secondary-action" @onclick="SaveReturnScriptsAsync" disabled="@(!CanSaveReturnScripts)">Save scripts</button>
                </div>

                @if (returnStrategy.AwaitingValidationConfirmation)
                {
                    <div class="validation-confirmation return-validation-confirmation">
                        <div><span>RETURN SCRIPT CONFIRMATION</span><strong>Did the TV return to @returnStrategy.ExpectedTargetPath?</strong></div>
                        <button class="secondary-action danger-action" @onclick="() => ConfirmReturnScriptAsync(false)" disabled="@IsBusy">No — reset passes</button>
                        <button class="primary-action" @onclick="() => ConfirmReturnScriptAsync(true)" disabled="@IsBusy">Yes — count pass <span>✓</span></button>
                    </div>
                }
                    </div>
                }
            </div>
        }

        <div class="timing-profile-lab collapsible-authoring-section @(SystemTimingExpanded ? "" : "collapsed")">
            <button type="button" class="authoring-section-title authoring-section-toggle timing-profile-title" @onclick="ToggleSystemTiming" aria-expanded="@(SystemTimingExpanded ? "true" : "false")">
                <span>05</span><strong>System-wide timing</strong>
                <b class="timing-profile-state @(SystemTimingIsVerified ? "verified" : "unverified")">
                    @(SystemTimingIsVerified ? "VERIFIED" : "NEEDS VALIDATION")
                </b>
                <i aria-hidden="true">@(SystemTimingExpanded ? "−" : "+")</i>
            </button>
            @if (SystemTimingExpanded)
            {
                <div class="authoring-section-body">
                    <div class="timing-profile-layout">
                <div>
                    <strong>One profile for every menu route.</strong>
                    <p>These waits apply throughout this TV interface. A button can override its system wait inside a draft's timing lab.</p>
                </div>
                <div class="timing-profile-fields">
                    <label>
                        <span>Default / D-pad</span>
                        <div class="number-with-unit"><input type="number" min="50" max="30000" step="50" @bind="DefaultDelayMilliseconds" @bind:after="MarkTimingProfileDirty" disabled="@(Authoring.IsRecording || Navigation.IsRunning)" /><b>ms</b></div>
                    </label>
                    <label>
                        <span>Screen change</span>
                        <div class="number-with-unit"><input type="number" min="50" max="30000" step="50" @bind="ScreenChangeDelayMilliseconds" @bind:after="MarkTimingProfileDirty" disabled="@(Authoring.IsRecording || Navigation.IsRunning)" /><b>ms</b></div>
                    </label>
                    <label>
                        <span>Return</span>
                        <div class="number-with-unit"><input type="number" min="50" max="30000" step="50" @bind="ReturnDelayMilliseconds" @bind:after="MarkTimingProfileDirty" disabled="@(Authoring.IsRecording || Navigation.IsRunning)" /><b>ms</b></div>
                    </label>
                </div>
                <div class="timing-profile-actions">
                    <button class="secondary-action" @onclick="SaveSystemTimingAsync" disabled="@(!CanSaveSystemTiming)">Save system profile</button>
                </div>
            </div>
            <div class="timing-profile-test">
                <label>
                    <span>VALIDATION TRAVERSAL</span>
                    <select @bind="SelectedTimingTestRouteId" disabled="@(IsBusy || Authoring.AwaitingTimingValidationConfirmation)">
                        <option value="">Select a traversal</option>
                        @foreach (var route in Authoring.TimingTestRoutes)
                        {
                            <option value="@route.Id">@route.SourcePath → @route.TargetPath · @route.CommandCount commands</option>
                        }
                    </select>
                </label>
                <div class="timing-profile-test-score">
                    <span>SYSTEM PROFILE</span>
                    <b>@Authoring.TimingValidationPasses/@Authoring.RequiredTimingValidationPasses passed</b>
                </div>
                <button class="primary-action" @onclick="TestSystemTimingAsync" disabled="@(!CanTestSystemTiming)">
                    Test system profile <span>▶</span>
                </button>
            </div>
            @if (Authoring.TimingTestRoutes.Count == 0)
            {
                <p class="field-note">Create a traversal before testing the system profile.</p>
            }
            else
            {
                <p class="field-note">Place the TV at the selected traversal's source first. The test saves these values and sends only that traversal, using system waits and no setup commands. Screen change covers Menu, OK, Home, Exit, and Source.</p>
            }

            @if (Authoring.AwaitingTimingValidationConfirmation)
            {
                <div class="validation-confirmation timing-validation-confirmation">
                    <div><span>SYSTEM TIMING CONFIRMATION</span><strong>Did the TV reach @Authoring.TimingValidationExpectedTargetPath?</strong></div>
                    <button class="secondary-action danger-action" @onclick="() => ConfirmSystemTimingAsync(false)" disabled="@IsBusy">No — reset passes</button>
                    <button class="primary-action" @onclick="() => ConfirmSystemTimingAsync(true)" disabled="@IsBusy">Yes — count pass <span>✓</span></button>
                </div>
            }
                </div>
            }
        </div>

        <div id="draft-validation" class="validation-studio collapsible-authoring-section @(DraftValidationExpanded ? "" : "collapsed")">
            <button type="button" class="authoring-section-title authoring-section-toggle" @onclick="ToggleDraftValidation" aria-expanded="@(DraftValidationExpanded ? "true" : "false")">
                <span>06</span><strong>Timing lab and visual validation</strong>
                @if (DraftValidationNeedsAttention)
                {
                    <b class="timing-profile-state unverified">@Authoring.DraftCandidates.Count NEED VALIDATION</b>
                }
                <i aria-hidden="true">@(DraftValidationExpanded ? "−" : "+")</i>
            </button>
            @if (DraftValidationExpanded)
            {
                <div class="authoring-section-body">
                    <p class="field-note">Prepare source uses the pending return-to-video replacement when one exists, then follows verified routes toward the source shown. If preparation is incomplete, position the TV manually. Replay test still sends only the draft being validated.</p>
            @if (Authoring.DraftCandidates.Count == 0)
            {
                <div class="capture-empty compact">No draft anchors or transitions are waiting for validation.</div>
            }
            else
            {
                <div class="validation-list">
                    @foreach (var candidate in Authoring.DraftCandidates)
                    {
                        var isActive = Authoring.ActiveValidationKind == candidate.Kind && Authoring.ActiveValidationId == candidate.Id;
                        <article class="validation-card @(isActive ? "active" : "")">
                            <div>
                                <span>@candidate.Kind</span>
                                <strong>@candidate.Label</strong>
                                <small>@(candidate.SourcePath is null ? candidate.TargetPath : $"{candidate.SourcePath} → {candidate.TargetPath}") · @candidate.CommandCount commands</small>
                            </div>
                            <div class="validation-card-actions">
                                @if (isActive)
                                {
                                    <b>@Authoring.ValidationPasses/@Authoring.RequiredValidationPasses passed</b>
                                }
                                @if (candidate.SourceNodeId is not null)
                                {
                                    <button class="secondary-action" @onclick="() => PrepareValidationSourceAsync(candidate)" disabled="@(!CanPrepareValidationSource(candidate))">@(IsReturnToVideoReplacement(candidate) ? "Prepare with draft" : "Prepare source")</button>
                                }
                                <button class="secondary-action" @onclick="() => PrepareRerecord(candidate)" disabled="@(Authoring.IsRecording || Navigation.IsRunning)">Re-record</button>
                                <button class="secondary-action" @onclick="() => ToggleTimingEditor(candidate)" disabled="@(Authoring.IsRecording || Navigation.IsRunning)">@(IsTimingEditorOpen(candidate) ? "Close timing" : "Timing lab")</button>
                                <button class="secondary-action" @onclick="() => RunValidationAsync(candidate)" disabled="@(!CanRunValidation || Authoring.AwaitingValidationConfirmation)">Replay test</button>
                                <button class="secondary-action danger-action" @onclick="() => DeleteDraftAsync(candidate)" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)">Delete</button>
                            </div>
                            @if (IsTimingEditorOpen(candidate))
                            {
                                <div class="timing-step-editor">
                                    <header>
                                        <div><strong>Press-by-press waits</strong><small>Waits occur after the named button. System values follow the profile above.</small></div>
                                        <div><span>ESTIMATED REPLAY</span><b>@TimingDurationMilliseconds.ToString("N0", CultureInfo.InvariantCulture) ms</b></div>
                                    </header>
                                    <div class="timing-step-list">
                                        @foreach (var step in TimingSteps)
                                        {
                                            <div class="timing-step-row">
                                                <b>@step.Position.ToString("00", CultureInfo.InvariantCulture)</b>
                                                <code>@step.Key</code>
                                                <small>@step.Action</small>
                                                <label class="timing-override-toggle"><input type="checkbox" @bind="step.UseCustomDelay" /><span>Custom</span></label>
                                                @if (step.UseCustomDelay)
                                                {
                                                    <div class="number-with-unit timing-step-input"><input type="number" min="50" max="30000" step="50" @bind="step.DelayAfterMilliseconds" /><b>ms</b></div>
                                                }
                                                else
                                                {
                                                    <div class="timing-system-wait"><span>System</span><b>@GetSystemDelayMilliseconds(step.Key) ms</b></div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="timing-editor-actions">
                                        <button class="secondary-action" @onclick="UseSystemTimingForAllSteps" disabled="@IsBusy">Use system for all</button>
                                        <button class="secondary-action" @onclick="() => SaveCandidateTimingAsync(candidate)" disabled="@(!CanSaveCandidateTiming)">Save to YAML</button>
                                        <button class="primary-action" @onclick="() => SaveAndReplayTimingAsync(candidate)" disabled="@(!CanSaveAndReplayTiming)">Save + replay <span>▶</span></button>
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            }

            @if (Authoring.AwaitingValidationConfirmation)
            {
                <div class="validation-confirmation">
                    <div><span>VISUAL CONFIRMATION REQUIRED</span><strong>Did the TV reach @Authoring.ExpectedTargetPath?</strong></div>
                    <button class="secondary-action danger-action" @onclick="() => ConfirmValidationAsync(false)" disabled="@IsBusy">No — adjust timing</button>
                    <button class="primary-action" @onclick="() => ConfirmValidationAsync(true)" disabled="@IsBusy">Yes — count pass <span>✓</span></button>
                </div>
            }
                </div>
            }
        </div>
    }
</section>

@code {
    private enum MenuTreeSortMode
    {
        Custom,
        Alphabetical
    }

    private ControllerSnapshot Snapshot { get; set; } = null!;
    private MenuNavigationSnapshot Navigation { get; set; } = null!;
    private MenuAuthoringSnapshot Authoring { get; set; } = null!;
    private MenuAuthoringItemKind RecordingKind { get; set; } = MenuAuthoringItemKind.Transition;
    private string RecordingId { get; set; } = "new-anchor";
    private string RecordingLabel { get; set; } = "Return to known state";
    private string SourceNodeId { get; set; } = string.Empty;
    private string ExistingTargetId { get; set; } = string.Empty;
    private bool RedefineReturnToVideo { get; set; }
    private string ReturnVerificationSourceNodeId { get; set; } = string.Empty;
    private string? EditingNodeId { get; set; }
    private string NodeEditorId { get; set; } = string.Empty;
    private string NodeEditorLabel { get; set; } = string.Empty;
    private string NodeEditorParentId { get; set; } = string.Empty;
    private string NodeEditorDescription { get; set; } = string.Empty;
    private bool ConfirmMenuNodeDelete { get; set; }
    private string CustomKey { get; set; } = "KEY_SOURCE";
    private RemoteKeyAction CustomAction { get; set; } = RemoteKeyAction.Click;
    private int DefaultDelayMilliseconds { get; set; } = 150;
    private int ScreenChangeDelayMilliseconds { get; set; } = 500;
    private int ReturnDelayMilliseconds { get; set; } = 300;
    private string SelectedTimingTestRouteId { get; set; } = string.Empty;
    private string AtMenuRootScript { get; set; } = "KEY_RETURN";
    private string BelowMenuRootScript { get; set; } = "KEY_MENU, KEY_RETURN";
    private string DeepReturnTestNodeId { get; set; } = string.Empty;
    private string OverrideReturnNodeId { get; set; } = string.Empty;
    private string OverrideReturnScript { get; set; } = string.Empty;
    private bool ReturnScriptsInitialized { get; set; }
    private bool ReturnScriptsDirty { get; set; }
    private bool TimingProfileInitialized { get; set; }
    private bool TimingProfileDirty { get; set; }
    private MenuTimingProfile? LastObservedTiming { get; set; }
    private MenuAuthoringItemKind? TimingEditorKind { get; set; }
    private string? TimingEditorId { get; set; }
    private List<TimingStepEdit> TimingSteps { get; } = [];
    private bool ShowDefinitionForm { get; set; }
    private bool IsBusy { get; set; }
    private bool IsSendingKey { get; set; }
    private string? LocalError { get; set; }
    private string? PendingVerifiedSettingRemovalId { get; set; }
    private bool ManageVerifiedSettingsExpanded { get; set; }
    private bool MenuTreeExpanded { get; set; } = true;
    private MenuTreeSortMode TreeOrdering { get; set; } = MenuTreeSortMode.Custom;
    private bool ReturnScriptsExpanded { get; set; }
    private bool SystemTimingExpanded { get; set; }
    private bool DraftValidationExpanded { get; set; }
    private bool AttentionStateInitialized { get; set; }
    private bool ReturnScriptsPreviouslyNeededValidation { get; set; }
    private bool SystemTimingPreviouslyNeededValidation { get; set; }
    private int PreviousDraftValidationCount { get; set; }

    private string DefinitionId { get; set; } = "samsung-menu";
    private string DefinitionName { get; set; } = "Samsung TV Menu";
    private string DefinitionModel { get; set; } = "Samsung TV";
    private string DefinitionFirmware { get; set; } = "unrecorded";
    private string DefinitionSignal { get; set; } = "any";
    private string DefinitionPictureMode { get; set; } = "any";
    private string DefinitionInput { get; set; } = "any";

    private string? ErrorMessage => LocalError ?? Authoring.Error;
    private IReadOnlyList<MenuNodeSummary> VerifiedSettings => Navigation.Nodes
        .Where(node => node.HasVerifiedRoute)
        .ToArray();
    private MenuAnchorSummary? ReturnToVideoAnchor => Navigation.Anchors
        .Where(anchor => !anchor.Id.Equals(
            SamsungControllerService.ReturnToVideoReplacementAnchorId,
            StringComparison.OrdinalIgnoreCase))
        .Where(anchor => anchor.Id.Equals("normal-video", StringComparison.OrdinalIgnoreCase)
            || anchor.TargetNodeId.Equals("normal-video", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(anchor => anchor.Id.Equals("normal-video", StringComparison.OrdinalIgnoreCase))
        .ThenByDescending(anchor => anchor.Verified)
        .FirstOrDefault();
    private IReadOnlyList<MenuNodeSummary> ReturnVerificationSources => ReturnToVideoAnchor is not { } anchor
        ? []
        : Navigation.Nodes
            .Where(node => !node.Id.Equals(anchor.TargetNodeId, StringComparison.OrdinalIgnoreCase))
            .ToArray();
    private bool IsConnected => Snapshot.ConnectionState == SamsungConnectionState.Connected;
    private bool CanStartRecording => IsConnected && !IsBusy && !Snapshot.MacroRunning && !Navigation.IsRunning &&
        (RedefineReturnToVideo
            ? ReturnToVideoAnchor is not null
              && !string.IsNullOrWhiteSpace(ReturnVerificationSourceNodeId)
            : !string.IsNullOrWhiteSpace(ExistingTargetId)
              && (RecordingKind == MenuAuthoringItemKind.Transition
                  ? !string.IsNullOrWhiteSpace(SourceNodeId)
                  : !string.IsNullOrWhiteSpace(RecordingId) && !string.IsNullOrWhiteSpace(RecordingLabel)));
    private IReadOnlyList<MenuNodeSummary> AvailableParentNodes
    {
        get
        {
            var edited = EditingNodeId is null
                ? null
                : Navigation.Nodes.FirstOrDefault(node =>
                    node.Id.Equals(EditingNodeId, StringComparison.OrdinalIgnoreCase));
            return Navigation.Nodes
                .Where(node => edited is null
                    || (!node.Id.Equals(edited.Id, StringComparison.OrdinalIgnoreCase)
                        && !node.Path.StartsWith(edited.Path + " / ", StringComparison.OrdinalIgnoreCase)))
                .OrderBy(node => node.Path, StringComparer.OrdinalIgnoreCase)
                .ToArray();
        }
    }
    private IReadOnlyList<MenuNodeSummary> OrderedTreeNodes =>
        FlattenTreeNodes(
            Navigation.Nodes,
            TreeOrdering == MenuTreeSortMode.Alphabetical);
    private bool CanSaveMenuNode => !IsBusy && !Authoring.IsRecording && !Navigation.IsRunning
        && !Snapshot.MacroRunning && !string.IsNullOrWhiteSpace(NodeEditorLabel)
        && (EditingNodeId is not null
            || !string.IsNullOrWhiteSpace(NodeEditorId)
            || !string.IsNullOrWhiteSpace(CreateMenuNodeId(NodeEditorLabel)));
    private bool CanDeleteMenuNode => EditingNodeId is not null && !IsBusy && !Authoring.IsRecording
        && !Navigation.IsRunning && !Snapshot.MacroRunning
        && Navigation.Nodes.FirstOrDefault(node => node.Id.Equals(EditingNodeId, StringComparison.OrdinalIgnoreCase))?.ParentId is not null;
    private bool RecordButtonsDisabled => !Authoring.IsRecording || !IsConnected || IsSendingKey || Navigation.IsRunning;
    private bool CanPrepareSource => RecordingKind == MenuAuthoringItemKind.Transition && IsConnected && !IsBusy &&
        !Authoring.IsRecording && !Navigation.IsRunning && !Snapshot.MacroRunning && !string.IsNullOrWhiteSpace(SourceNodeId);
    private bool CanRunValidation => IsConnected && !IsBusy && !Authoring.IsRecording && !Navigation.IsRunning
        && !Snapshot.MacroRunning && !Authoring.AwaitingTimingValidationConfirmation
        && Authoring.ReturnStrategy?.AwaitingValidationConfirmation != true;
    private bool TimingProfileValid => IsValidWait(DefaultDelayMilliseconds)
        && IsValidWait(ScreenChangeDelayMilliseconds)
        && IsValidWait(ReturnDelayMilliseconds);
    private bool TimingOverridesValid => TimingSteps.All(step =>
        !step.UseCustomDelay || IsValidWait(step.DelayAfterMilliseconds));
    private bool CanSaveSystemTiming => TimingProfileValid && !IsBusy && !Authoring.IsRecording
        && !Navigation.IsRunning && !Snapshot.MacroRunning && !Authoring.AwaitingValidationConfirmation
        && !Authoring.AwaitingTimingValidationConfirmation
        && Authoring.ReturnStrategy?.AwaitingValidationConfirmation != true;
    private bool CanTestSystemTiming => CanRunValidation && TimingProfileValid
        && !Authoring.AwaitingValidationConfirmation
        && Authoring.TimingTestRoutes.Any(route =>
            route.Id.Equals(SelectedTimingTestRouteId, StringComparison.OrdinalIgnoreCase));
    private bool SystemTimingIsVerified => !TimingProfileDirty
        && Authoring.Timing.Verified
        && Authoring.Timing.HasSameDelays(CreateTimingProfile());
    private bool ReturnScriptsNeedValidation => Authoring.ReturnStrategy is { } returnStrategy
        && (ReturnScriptsDirty
            || !returnStrategy.AtMenuRoot.Verified
            || !returnStrategy.BelowMenuRoot.Verified
            || returnStrategy.NodeOverrides.Any(item => !item.Verified));
    private bool DraftValidationNeedsAttention => Authoring.DraftCandidates.Count > 0;
    private bool CanSaveCandidateTiming => CanSaveSystemTiming && TimingEditorKind is not null
        && TimingEditorId is not null && TimingSteps.Count > 0 && TimingOverridesValid;
    private bool CanSaveAndReplayTiming => CanSaveCandidateTiming && CanRunValidation;
    private bool ReturnScriptsValid => TryParseKeyScript(AtMenuRootScript, out _)
        && TryParseKeyScript(BelowMenuRootScript, out _);
    private bool CanSaveReturnScripts => Authoring.ReturnStrategy is not null && ReturnScriptsValid
        && !IsBusy && !Authoring.IsRecording && !Navigation.IsRunning && !Snapshot.MacroRunning
        && !Authoring.AwaitingValidationConfirmation && !Authoring.AwaitingTimingValidationConfirmation
        && Authoring.ReturnStrategy.AwaitingValidationConfirmation == false;
    private bool CanTestAtMenuRootReturn => CanSaveReturnScripts && IsConnected;
    private bool CanTestBelowMenuRootReturn => CanSaveReturnScripts && IsConnected
        && Authoring.ReturnStrategy!.DeepTestNodes.Any(node =>
            node.Id.Equals(DeepReturnTestNodeId, StringComparison.OrdinalIgnoreCase));
    private IReadOnlyList<MenuNodeSummary> ReturnOverrideNodes => Authoring.ReturnStrategy is not { } strategy
        ? []
        : Navigation.Nodes
            .Where(node => !node.Id.Equals(strategy.TargetNodeId, StringComparison.OrdinalIgnoreCase))
            .OrderBy(node => node.Path, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    private MenuReturnOverrideSummary? SelectedReturnOverride => Authoring.ReturnStrategy?.NodeOverrides
        .FirstOrDefault(item => item.NodeId.Equals(OverrideReturnNodeId, StringComparison.OrdinalIgnoreCase));
    private bool ReturnOverrideScriptValid => TryParseKeyScript(OverrideReturnScript, out _);
    private bool CanSaveReturnOverride => Authoring.ReturnStrategy is not null
        && !string.IsNullOrWhiteSpace(OverrideReturnNodeId) && ReturnOverrideScriptValid
        && !IsBusy && !Authoring.IsRecording && !Navigation.IsRunning && !Snapshot.MacroRunning
        && !Authoring.AwaitingValidationConfirmation && !Authoring.AwaitingTimingValidationConfirmation
        && Authoring.ReturnStrategy.AwaitingValidationConfirmation == false;
    private bool CanTestReturnOverride => CanSaveReturnOverride && IsConnected;
    private bool CanPrepareReturnOverride => IsConnected && !IsBusy && !Authoring.IsRecording
        && !Navigation.IsRunning && !Snapshot.MacroRunning && !string.IsNullOrWhiteSpace(OverrideReturnNodeId);
    private long TimingDurationMilliseconds => TimingSteps.Sum(step =>
        (long)(step.UseCustomDelay
            ? step.DelayAfterMilliseconds
            : GetSystemDelayMilliseconds(step.Key)));

    protected override async Task OnInitializedAsync()
    {
        Refresh();
        Controller.Changed += HandleControllerChanged;
        await Controller.InitializeAsync();
        Refresh();
        InitializeNodeDefaults();
    }

    private void ToggleDefinitionForm()
    {
        ShowDefinitionForm = !ShowDefinitionForm;
        LocalError = null;
    }

    private void ToggleManageVerifiedSettings() =>
        ManageVerifiedSettingsExpanded = !ManageVerifiedSettingsExpanded;

    private void ToggleMenuTree() => MenuTreeExpanded = !MenuTreeExpanded;

    private void ToggleReturnScripts() => ReturnScriptsExpanded = !ReturnScriptsExpanded;

    private void ToggleSystemTiming() => SystemTimingExpanded = !SystemTimingExpanded;

    private void ToggleDraftValidation() => DraftValidationExpanded = !DraftValidationExpanded;

    private async Task CreateDefinitionAsync()
    {
        await RunBusyAsync(async () =>
        {
            await Controller.CreateMenuDefinitionAsync(new MenuDefinitionCreationRequest(
                DefinitionId,
                DefinitionName,
                DefinitionModel,
                DefinitionFirmware,
                DefinitionSignal,
                DefinitionPictureMode,
                DefinitionInput));
            ShowDefinitionForm = false;
            Refresh();
            InitializeNodeDefaults(force: true);
        });
    }

    private void BeginNewMenuNode()
    {
        EditingNodeId = null;
        NodeEditorId = string.Empty;
        NodeEditorLabel = string.Empty;
        NodeEditorDescription = string.Empty;
        NodeEditorParentId = Navigation.Nodes.FirstOrDefault(node =>
                node.Id.Equals("tv-interface", StringComparison.OrdinalIgnoreCase))?.Id
            ?? Navigation.Nodes.FirstOrDefault()?.Id
            ?? string.Empty;
        ConfirmMenuNodeDelete = false;
        LocalError = null;
    }

    private void EditMenuNode(MenuNodeSummary node)
    {
        EditingNodeId = node.Id;
        NodeEditorId = node.Id;
        NodeEditorLabel = node.Label;
        NodeEditorParentId = node.ParentId ?? string.Empty;
        NodeEditorDescription = node.Description ?? string.Empty;
        ConfirmMenuNodeDelete = false;
        LocalError = null;
    }

    private bool CanMoveMenuNode(MenuNodeSummary node, int direction)
    {
        if (TreeOrdering != MenuTreeSortMode.Custom
            || IsBusy
            || Authoring.IsRecording
            || Navigation.IsRunning
            || Snapshot.MacroRunning)
        {
            return false;
        }

        var siblings = Navigation.Nodes
            .Where(candidate => string.Equals(
                candidate.ParentId,
                node.ParentId,
                StringComparison.OrdinalIgnoreCase))
            .ToArray();
        var index = Array.FindIndex(siblings, candidate =>
            candidate.Id.Equals(node.Id, StringComparison.OrdinalIgnoreCase));
        var destination = index + direction;
        return index >= 0 && destination >= 0 && destination < siblings.Length;
    }

    private Task MoveMenuNodeAsync(string nodeId, int direction) => RunBusyAsync(async () =>
    {
        await Controller.MoveMenuNodeAsync(nodeId, direction);
        Refresh();
    });

    private Task SaveMenuNodeAsync() => RunBusyAsync(async () =>
    {
        var nodeId = EditingNodeId
            ?? (string.IsNullOrWhiteSpace(NodeEditorId)
                ? CreateMenuNodeId(NodeEditorLabel)
                : NodeEditorId.Trim());
        var request = new MenuNodeEditRequest(
            nodeId,
            NodeEditorLabel,
            NodeEditorParentId,
            NodeEditorDescription);
        if (EditingNodeId is null)
        {
            await Controller.CreateMenuNodeAsync(request);
        }
        else
        {
            await Controller.UpdateMenuNodeAsync(EditingNodeId, request);
        }

        Refresh();
        var saved = Navigation.Nodes.First(node =>
            node.Id.Equals(nodeId, StringComparison.OrdinalIgnoreCase));
        EditMenuNode(saved);
        InitializeNodeDefaults(force: true);
    });

    private void RequestMenuNodeDelete()
    {
        ConfirmMenuNodeDelete = true;
        LocalError = null;
    }

    private void CancelMenuNodeDelete()
    {
        ConfirmMenuNodeDelete = false;
        LocalError = null;
    }

    private Task DeleteMenuNodeAsync() => RunBusyAsync(async () =>
    {
        var nodeId = EditingNodeId
            ?? throw new InvalidOperationException("Choose a menu-tree node to delete.");
        await Controller.DeleteMenuNodeAsync(nodeId);
        Refresh();
        BeginNewMenuNode();
        InitializeNodeDefaults(force: true);
    });

    private void StartRecording()
    {
        LocalError = null;
        try
        {
            if (RedefineReturnToVideo)
            {
                var anchor = ReturnToVideoAnchor
                    ?? throw new InvalidOperationException(
                        "No existing return-to-video command is available to replace.");
                Controller.StartMenuRecording(new MenuRecordingRequest(
                    MenuAuthoringItemKind.Anchor,
                    SamsungControllerService.ReturnToVideoReplacementAnchorId,
                    $"{anchor.Label} (replacement)",
                    ReturnVerificationSourceNodeId,
                    anchor.TargetNodeId,
                    null,
                    null));
            }
            else
            {
                Controller.StartMenuRecording(new MenuRecordingRequest(
                    RecordingKind,
                    RecordingKind == MenuAuthoringItemKind.Anchor ? RecordingId : string.Empty,
                    RecordingKind == MenuAuthoringItemKind.Anchor ? RecordingLabel : GetTargetLabel(ExistingTargetId),
                    RecordingKind == MenuAuthoringItemKind.Transition ? SourceNodeId : null,
                    ExistingTargetId,
                    null,
                    null));
            }
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
    }

    private Task PrepareSourceAsync() =>
        RunBusyAsync(() => Controller.PrepareMenuRecordingSourceAsync(SourceNodeId));

    private Task StopAndSaveAsync() => RunBusyAsync(() => Controller.StopAndSaveMenuRecordingAsync());

    private void CancelRecording()
    {
        LocalError = null;
        try
        {
            Controller.CancelMenuRecording();
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
    }

    private Task SendCustomRecordedKeyAsync() => SendRecordedKeyAsync(CustomKey, CustomAction);

    private async Task SendRecordedKeyAsync(string key, RemoteKeyAction action = RemoteKeyAction.Click)
    {
        IsSendingKey = true;
        LocalError = null;
        try
        {
            await Controller.SendKeyAsync(key, action);
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsSendingKey = false;
        }
    }

    private Task RunValidationAsync(MenuAuthoringCandidateSummary candidate) =>
        RunBusyAsync(() => Controller.RunMenuAuthoringValidationAsync(candidate.Kind, candidate.Id));

    private bool CanPrepareValidationSource(MenuAuthoringCandidateSummary candidate) =>
        candidate.SourceNodeId is not null
        && IsConnected
        && !IsBusy
        && !Authoring.IsRecording
        && !Navigation.IsRunning
        && !Snapshot.MacroRunning;

    private Task PrepareValidationSourceAsync(MenuAuthoringCandidateSummary candidate) =>
        RunBusyAsync(() => Controller.PrepareMenuRecordingSourceAsync(candidate.SourceNodeId!));

    private Task SaveSystemTimingAsync() => RunBusyAsync(async () =>
    {
        await Controller.UpdateMenuTimingProfileAsync(CreateTimingProfile());
        TimingProfileDirty = false;
        Refresh();
    });

    private Task TestSystemTimingAsync() => RunBusyAsync(async () =>
    {
        await Controller.RunMenuTimingProfileTestAsync(
            SelectedTimingTestRouteId,
            CreateTimingProfile());
        TimingProfileDirty = false;
        Refresh();
    });

    private void MarkTimingProfileDirty()
    {
        TimingProfileDirty = true;
        UpdateAttentionSections();
    }

    private void ToggleTimingEditor(MenuAuthoringCandidateSummary candidate)
    {
        LocalError = null;
        if (IsTimingEditorOpen(candidate))
        {
            CloseTimingEditor();
            return;
        }

        TimingEditorKind = candidate.Kind;
        TimingEditorId = candidate.Id;
        LoadTimingSteps(candidate);
    }

    private bool IsTimingEditorOpen(MenuAuthoringCandidateSummary candidate) =>
        TimingEditorKind == candidate.Kind
        && string.Equals(TimingEditorId, candidate.Id, StringComparison.OrdinalIgnoreCase);

    private void UseSystemTimingForAllSteps()
    {
        foreach (var step in TimingSteps)
        {
            step.UseCustomDelay = false;
        }
    }

    private Task SaveCandidateTimingAsync(MenuAuthoringCandidateSummary candidate) =>
        SaveCandidateTimingCoreAsync(candidate, replay: false);

    private Task SaveAndReplayTimingAsync(MenuAuthoringCandidateSummary candidate) =>
        SaveCandidateTimingCoreAsync(candidate, replay: true);

    private Task SaveCandidateTimingCoreAsync(
        MenuAuthoringCandidateSummary candidate,
        bool replay) =>
        RunBusyAsync(async () =>
        {
            await Controller.UpdateMenuAuthoringTimingAsync(
                candidate.Kind,
                candidate.Id,
                CreateTimingProfile(),
                TimingSteps.Select(step => new MenuAuthoringReplayStepUpdate(
                        step.Position,
                        step.UseCustomDelay,
                        step.DelayAfterMilliseconds))
                    .ToArray());
            TimingProfileDirty = false;
            Refresh();
            var refreshed = Authoring.DraftCandidates.First(item =>
                item.Kind == candidate.Kind
                && item.Id.Equals(candidate.Id, StringComparison.OrdinalIgnoreCase));
            LoadTimingSteps(refreshed);
            if (replay)
            {
                await Controller.RunMenuAuthoringValidationAsync(candidate.Kind, candidate.Id);
            }
        });

    private void PrepareRerecord(MenuAuthoringCandidateSummary candidate)
    {
        LocalError = null;
        RedefineReturnToVideo = IsReturnToVideoReplacement(candidate);
        RecordingKind = candidate.Kind;
        if (candidate.Kind == MenuAuthoringItemKind.Anchor)
        {
            RecordingId = candidate.Id;
            RecordingLabel = candidate.Label;
        }

        SourceNodeId = candidate.SourceNodeId ?? SourceNodeId;
        if (RedefineReturnToVideo)
        {
            ReturnVerificationSourceNodeId = candidate.SourceNodeId
                ?? ReturnVerificationSourceNodeId;
        }

        ExistingTargetId = candidate.TargetNodeId;
    }

    private static bool IsReturnToVideoReplacement(MenuAuthoringCandidateSummary candidate) =>
        candidate.Kind == MenuAuthoringItemKind.Anchor
        && candidate.Id.Equals(
            SamsungControllerService.ReturnToVideoReplacementAnchorId,
            StringComparison.OrdinalIgnoreCase);

    private Task DeleteDraftAsync(MenuAuthoringCandidateSummary candidate) =>
        RunBusyAsync(() => Controller.DeleteMenuAuthoringDraftAsync(candidate.Kind, candidate.Id));

    private bool IsKnownStateSetting(MenuNodeSummary setting) => Navigation.Anchors.Any(anchor =>
        anchor.Verified
        && (anchor.TargetPath.Equals(setting.Path, StringComparison.OrdinalIgnoreCase)
            || anchor.TargetPath.StartsWith(
                setting.Path + " / ",
                StringComparison.OrdinalIgnoreCase)));

    private async Task RemoveVerifiedSettingAsync(MenuNodeSummary setting)
    {
        if (!string.Equals(
                PendingVerifiedSettingRemovalId,
                setting.Id,
                StringComparison.OrdinalIgnoreCase))
        {
            PendingVerifiedSettingRemovalId = setting.Id;
            LocalError = null;
            return;
        }

        await RunBusyAsync(async () =>
        {
            await Controller.DeleteVerifiedMenuSettingAsync(setting.Id);
            PendingVerifiedSettingRemovalId = null;
            Refresh();
            InitializeNodeDefaults(force: true);
        });
    }

    private void CancelVerifiedSettingRemoval()
    {
        PendingVerifiedSettingRemovalId = null;
        LocalError = null;
    }

    private Task ConfirmValidationAsync(bool passed) =>
        RunBusyAsync(() => Controller.ConfirmMenuAuthoringValidationAsync(passed));

    private Task ConfirmSystemTimingAsync(bool passed) =>
        RunBusyAsync(() => Controller.ConfirmMenuTimingProfileTestAsync(passed));

    private void MarkReturnScriptsDirty()
    {
        ReturnScriptsDirty = true;
        UpdateAttentionSections();
    }

    private Task SaveReturnScriptsAsync() => RunBusyAsync(async () =>
    {
        await SaveReturnScriptsCoreAsync();
        Refresh();
    });

    private Task TestAtMenuRootReturnAsync() =>
        SaveAndTestReturnScriptAsync(MenuReturnScriptKind.AtMenuRoot);

    private Task TestBelowMenuRootReturnAsync() =>
        SaveAndTestReturnScriptAsync(MenuReturnScriptKind.BelowMenuRoot);

    private Task PrepareReturnOverrideStartAsync() =>
        RunBusyAsync(() => Controller.PrepareMenuRecordingSourceAsync(OverrideReturnNodeId));

    private Task SaveReturnOverrideAsync() => RunBusyAsync(async () =>
    {
        await SaveReturnOverrideCoreAsync();
        Refresh();
        LoadSelectedReturnOverride();
    });

    private Task TestReturnOverrideAsync() => RunBusyAsync(async () =>
    {
        await SaveReturnOverrideCoreAsync();
        await Controller.RunMenuReturnStrategyTestAsync(
            MenuReturnScriptKind.NodeOverride,
            OverrideReturnNodeId);
        Refresh();
    });

    private Task DeleteReturnOverrideAsync() => RunBusyAsync(async () =>
    {
        await Controller.DeleteMenuReturnOverrideAsync(OverrideReturnNodeId);
        Refresh();
        LoadSelectedReturnOverride();
    });

    private async Task SaveReturnOverrideCoreAsync()
    {
        if (!TryParseKeyScript(OverrideReturnScript, out var keys))
        {
            throw new InvalidOperationException(
                "The state-specific return script must contain one or more comma-separated KEY_ commands.");
        }

        await Controller.UpdateMenuReturnOverrideAsync(OverrideReturnNodeId, keys);
    }

    private void LoadSelectedReturnOverride()
    {
        if (Authoring.ReturnStrategy is not { } strategy
            || string.IsNullOrWhiteSpace(OverrideReturnNodeId))
        {
            OverrideReturnScript = string.Empty;
            return;
        }

        var existing = strategy.NodeOverrides.FirstOrDefault(item =>
            item.NodeId.Equals(OverrideReturnNodeId, StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            OverrideReturnScript = existing.Script;
            return;
        }

        var selectedNode = Navigation.Nodes.FirstOrDefault(node =>
            node.Id.Equals(OverrideReturnNodeId, StringComparison.OrdinalIgnoreCase));
        var rootNode = Navigation.Nodes.FirstOrDefault(node =>
            node.Id.Equals(strategy.MenuRootNodeId, StringComparison.OrdinalIgnoreCase));
        OverrideReturnScript = selectedNode?.Id.Equals(
                                   strategy.MenuRootNodeId,
                                   StringComparison.OrdinalIgnoreCase) == true
            ? strategy.AtMenuRoot.Script
            : selectedNode is not null && rootNode is not null
              && selectedNode.Path.StartsWith(rootNode.Path + " / ", StringComparison.OrdinalIgnoreCase)
                ? strategy.BelowMenuRoot.Script
                : strategy.FallbackScript;
    }

    private Task SaveAndTestReturnScriptAsync(MenuReturnScriptKind kind) => RunBusyAsync(async () =>
    {
        await SaveReturnScriptsCoreAsync();
        await Controller.RunMenuReturnStrategyTestAsync(
            kind,
            kind == MenuReturnScriptKind.BelowMenuRoot ? DeepReturnTestNodeId : null);
        Refresh();
    });

    private async Task SaveReturnScriptsCoreAsync()
    {
        if (!TryParseKeyScript(AtMenuRootScript, out var atMenuRootKeys)
            || !TryParseKeyScript(BelowMenuRootScript, out var belowMenuRootKeys))
        {
            throw new InvalidOperationException(
                "Each return script must contain one or more comma-separated KEY_ commands.");
        }

        await Controller.UpdateMenuReturnStrategyAsync(atMenuRootKeys, belowMenuRootKeys);
        ReturnScriptsDirty = false;
    }

    private Task ConfirmReturnScriptAsync(bool passed) =>
        RunBusyAsync(() => Controller.ConfirmMenuReturnStrategyTestAsync(passed));

    private async Task RunBusyAsync(Func<Task> action)
    {
        IsBusy = true;
        LocalError = null;
        try
        {
            await action();
        }
        catch (OperationCanceledException)
        {
            // Service state reports cancellation.
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void HandleControllerChanged()
    {
        Refresh();
        _ = InvokeAsync(StateHasChanged);
    }

    private void Refresh()
    {
        Snapshot = Controller.GetSnapshot();
        Navigation = Controller.GetMenuNavigationSnapshot();
        var authoring = Controller.GetMenuAuthoringSnapshot();
        if (!TimingProfileInitialized
            || (!TimingProfileDirty && authoring.Timing != LastObservedTiming))
        {
            DefaultDelayMilliseconds = authoring.Timing.DefaultDelayMilliseconds;
            ScreenChangeDelayMilliseconds = authoring.Timing.ScreenChangeDelayMilliseconds;
            ReturnDelayMilliseconds = authoring.Timing.ReturnDelayMilliseconds;
            TimingProfileInitialized = true;
        }

        LastObservedTiming = authoring.Timing;
        Authoring = authoring;
        if (ReturnToVideoAnchor is null)
        {
            RedefineReturnToVideo = false;
            ReturnVerificationSourceNodeId = string.Empty;
        }

        if (Authoring.ReturnStrategy is { } returnStrategy)
        {
            if (!ReturnScriptsInitialized || !ReturnScriptsDirty)
            {
                AtMenuRootScript = returnStrategy.AtMenuRoot.Script;
                BelowMenuRootScript = returnStrategy.BelowMenuRoot.Script;
                ReturnScriptsInitialized = true;
            }

            if (string.IsNullOrWhiteSpace(DeepReturnTestNodeId)
                || returnStrategy.DeepTestNodes.All(node =>
                    !node.Id.Equals(DeepReturnTestNodeId, StringComparison.OrdinalIgnoreCase)))
            {
                DeepReturnTestNodeId = returnStrategy.DeepTestNodes.FirstOrDefault()?.Id
                    ?? string.Empty;
            }

            if (string.IsNullOrWhiteSpace(OverrideReturnNodeId)
                || ReturnOverrideNodes.All(node =>
                    !node.Id.Equals(OverrideReturnNodeId, StringComparison.OrdinalIgnoreCase)))
            {
                OverrideReturnNodeId = ReturnOverrideNodes.FirstOrDefault()?.Id
                    ?? string.Empty;
                LoadSelectedReturnOverride();
            }
        }
        if (string.IsNullOrWhiteSpace(SelectedTimingTestRouteId)
            || Authoring.TimingTestRoutes.All(route =>
                !route.Id.Equals(SelectedTimingTestRouteId, StringComparison.OrdinalIgnoreCase)))
        {
            SelectedTimingTestRouteId = Authoring.ActiveTimingTestRouteId
                ?? Authoring.TimingTestRoutes.FirstOrDefault()?.Id
                ?? string.Empty;
        }

        if (TimingEditorId is not null
            && Authoring.DraftCandidates.All(candidate =>
                candidate.Kind != TimingEditorKind
                || !candidate.Id.Equals(TimingEditorId, StringComparison.OrdinalIgnoreCase)))
        {
            CloseTimingEditor();
        }

        if (PendingVerifiedSettingRemovalId is not null
            && Navigation.Nodes.All(node =>
                !node.Id.Equals(PendingVerifiedSettingRemovalId, StringComparison.OrdinalIgnoreCase)))
        {
            PendingVerifiedSettingRemovalId = null;
        }

        UpdateAttentionSections();
    }

    private void UpdateAttentionSections()
    {
        var returnScriptsNeedValidation = ReturnScriptsNeedValidation;
        var systemTimingNeedsValidation = !SystemTimingIsVerified;
        var draftValidationCount = Authoring.DraftCandidates.Count;

        if (!AttentionStateInitialized)
        {
            if (Navigation.DefinitionName is null)
            {
                return;
            }

            ReturnScriptsExpanded = returnScriptsNeedValidation;
            SystemTimingExpanded = systemTimingNeedsValidation;
            DraftValidationExpanded = draftValidationCount > 0;
        }
        else
        {
            if (!ReturnScriptsPreviouslyNeededValidation && returnScriptsNeedValidation)
            {
                ReturnScriptsExpanded = true;
            }

            if (!SystemTimingPreviouslyNeededValidation && systemTimingNeedsValidation)
            {
                SystemTimingExpanded = true;
            }

            if (draftValidationCount > PreviousDraftValidationCount)
            {
                DraftValidationExpanded = true;
            }
        }

        ReturnScriptsPreviouslyNeededValidation = returnScriptsNeedValidation;
        SystemTimingPreviouslyNeededValidation = systemTimingNeedsValidation;
        PreviousDraftValidationCount = draftValidationCount;
        AttentionStateInitialized = true;
    }

    private MenuTimingProfile CreateTimingProfile() => new(
        DefaultDelayMilliseconds,
        ScreenChangeDelayMilliseconds,
        ReturnDelayMilliseconds);

    private int GetSystemDelayMilliseconds(string key) => checked((int)
        CreateTimingProfile().GetDelay(key).TotalMilliseconds);

    private static bool IsValidWait(int milliseconds) =>
        milliseconds is >= 50 and <= 30_000;

    private static bool TryParseKeyScript(string script, out string[] keys)
    {
        keys = script.Split(
            [',', '\n', '\r', '\t', ' '],
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return keys.Length is >= 1 and <= MenuDefinitionValidator.MaximumRepeat
               && keys.All(key => key.StartsWith("KEY_", StringComparison.OrdinalIgnoreCase));
    }

    private void LoadTimingSteps(MenuAuthoringCandidateSummary candidate)
    {
        TimingSteps.Clear();
        TimingSteps.AddRange(candidate.ReplaySteps.Select(step => new TimingStepEdit(step)));
    }

    private void CloseTimingEditor()
    {
        TimingEditorKind = null;
        TimingEditorId = null;
        TimingSteps.Clear();
    }

    private void InitializeNodeDefaults(bool force = false)
    {
        if (Navigation.Nodes.Count == 0)
        {
            return;
        }

        if (force || string.IsNullOrWhiteSpace(SourceNodeId) || Navigation.Nodes.All(node => node.Id != SourceNodeId))
        {
            SourceNodeId = Navigation.Nodes.FirstOrDefault(node => node.Id == "normal-video")?.Id
                ?? Navigation.Nodes[0].Id;
        }

        if (force || string.IsNullOrWhiteSpace(ExistingTargetId) || Navigation.Nodes.All(node => node.Id != ExistingTargetId))
        {
            ExistingTargetId = Navigation.Nodes.FirstOrDefault(node => node.Id != SourceNodeId)?.Id
                ?? Navigation.Nodes[0].Id;
        }

        if (ReturnToVideoAnchor is { } returnAnchor
            && (force
                || string.IsNullOrWhiteSpace(ReturnVerificationSourceNodeId)
                || ReturnVerificationSources.All(node => !node.Id.Equals(
                    ReturnVerificationSourceNodeId,
                    StringComparison.OrdinalIgnoreCase))))
        {
            ReturnVerificationSourceNodeId = Navigation.State.NodeId is { } currentNodeId
                && !currentNodeId.Equals(returnAnchor.TargetNodeId, StringComparison.OrdinalIgnoreCase)
                && ReturnVerificationSources.Any(node => node.Id.Equals(
                    currentNodeId,
                    StringComparison.OrdinalIgnoreCase))
                    ? currentNodeId
                    : ReturnVerificationSources.FirstOrDefault(node =>
                            node.Id.Contains("setting", StringComparison.OrdinalIgnoreCase)
                            || node.Label.Contains("setting", StringComparison.OrdinalIgnoreCase))?.Id
                      ?? ReturnVerificationSources.FirstOrDefault(node => node.HasVerifiedRoute)?.Id
                      ?? ReturnVerificationSources.FirstOrDefault()?.Id
                      ?? string.Empty;
        }

        if (force && EditingNodeId is null && string.IsNullOrWhiteSpace(NodeEditorParentId))
        {
            NodeEditorParentId = Navigation.Nodes.FirstOrDefault(node =>
                    node.Id.Equals("tv-interface", StringComparison.OrdinalIgnoreCase))?.Id
                ?? Navigation.Nodes[0].Id;
        }
    }

    private string GetTargetLabel(string targetId) => Navigation.Nodes.FirstOrDefault(node =>
            node.Id.Equals(targetId, StringComparison.OrdinalIgnoreCase))?.Label
        ?? targetId;

    private static string CreateMenuNodeId(string label)
    {
        var normalized = new string(label.Trim().ToLowerInvariant()
            .Select(character => char.IsLetterOrDigit(character) || character == '_'
                ? character
                : '-')
            .ToArray());
        while (normalized.Contains("--", StringComparison.Ordinal))
        {
            normalized = normalized.Replace("--", "-", StringComparison.Ordinal);
        }

        normalized = normalized.Trim('-');
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return "menu-node";
        }

        return char.IsLetter(normalized[0]) || normalized[0] == '_'
            ? normalized
            : $"node-{normalized}";
    }

    private static IReadOnlyList<MenuNodeSummary> FlattenTreeNodes(
        IReadOnlyList<MenuNodeSummary> nodes,
        bool alphabetical)
    {
        var result = new List<MenuNodeSummary>(nodes.Count);
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        IEnumerable<MenuNodeSummary> Order(IEnumerable<MenuNodeSummary> candidates) =>
            alphabetical
                ? candidates
                    .OrderBy(candidate => candidate.Label, StringComparer.OrdinalIgnoreCase)
                    .ThenBy(candidate => candidate.Id, StringComparer.OrdinalIgnoreCase)
                : candidates;

        void AppendBranch(MenuNodeSummary node)
        {
            if (!visited.Add(node.Id))
            {
                return;
            }

            result.Add(node);
            foreach (var child in Order(nodes.Where(candidate => string.Equals(
                         candidate.ParentId,
                         node.Id,
                         StringComparison.OrdinalIgnoreCase))))
            {
                AppendBranch(child);
            }
        }

        foreach (var root in Order(nodes.Where(node => string.IsNullOrWhiteSpace(node.ParentId))))
        {
            AppendBranch(root);
        }

        foreach (var node in Order(nodes))
        {
            AppendBranch(node);
        }

        return result;
    }

    public void Dispose()
    {
        Controller.Changed -= HandleControllerChanged;
    }

    private sealed class TimingStepEdit(MenuAuthoringReplayStepSummary step)
    {
        public int Position { get; } = step.Position;

        public string Key { get; } = step.Key;

        public RemoteKeyAction Action { get; } = step.Action;

        public bool UseCustomDelay { get; set; } = step.HasCustomDelay;

        public int DelayAfterMilliseconds { get; set; } = step.EffectiveDelayMilliseconds;
    }
