        NodeEditorId = string.Empty;
        NodeEditorLabel = string.Empty;
        NodeEditorDescription = string.Empty;
        NodeEditorParentId = retainedParentId;
        NodeEditorControlType = MenuControlType.Submenu;
        NodeEditorDefaultValue = string.Empty;
        NodeEditorMinimumValue = null;
        NodeEditorMaximumValue = null;
        NodeEditorSelectionOptions.Clear();
        NodeEditorDisabledConditions.Clear();
        ConfirmMenuNodeDelete = false;
        LocalError = null;
    }

    private void CancelMenuNodeAdd()
    {
        var restored = MenuNodeBeforeAddId is null
            ? null
            : Navigation.Nodes.FirstOrDefault(node => node.Id.Equals(
                MenuNodeBeforeAddId,
                StringComparison.OrdinalIgnoreCase));
        restored ??= Navigation.Nodes.FirstOrDefault();
        if (restored is not null)
        {
            EditMenuNode(restored);
        }
        else
        {
            IsAddingMenuNode = false;
            MenuNodeBeforeAddId = null;
            EditingNodeId = null;
            NodeEditorId = string.Empty;
            NodeEditorLabel = string.Empty;
            NodeEditorParentId = string.Empty;
            NodeEditorDescription = string.Empty;
            NodeEditorControlType = MenuControlType.Submenu;
            NodeEditorDefaultValue = string.Empty;
            NodeEditorMinimumValue = null;
            NodeEditorMaximumValue = null;
            NodeEditorSelectionOptions.Clear();
            NodeEditorDisabledConditions.Clear();
            LocalError = null;
        }
    }

    private void EditMenuNode(MenuNodeSummary node)
    {
        IsAddingMenuNode = false;
        MenuNodeBeforeAddId = null;
        EditingNodeId = node.Id;
        NodeEditorId = node.Id;
        NodeEditorLabel = node.Label;
        NodeEditorParentId = node.ParentId ?? string.Empty;
        NodeEditorDescription = node.Description ?? string.Empty;
        NodeEditorControlType = node.ControlType;
        NodeEditorDefaultValue = node.DefaultValue ?? string.Empty;
        NodeEditorMinimumValue = node.MinimumValue;
        NodeEditorMaximumValue = node.MaximumValue;
        NodeEditorSelectionOptions.Clear();
        NodeEditorSelectionOptions.AddRange(node.SelectionOptions.Select(option =>
            new SelectionOptionEdit(option)));
        NodeEditorDisabledConditions.Clear();
        NodeEditorDisabledConditions.AddRange(node.DisabledWhen.Select(condition =>
            new NodeDisabledConditionEdit(condition)));
        ConfirmMenuNodeDelete = false;
        LocalError = null;
    }

    private void HandleNodeControlTypeChanged()
    {
        if (NodeEditorControlType != MenuControlType.Slider)
        {
            NodeEditorMinimumValue = null;
            NodeEditorMaximumValue = null;
        }

        if (NodeEditorControlType == MenuControlType.Submenu)
        {
            NodeEditorDefaultValue = string.Empty;
            NodeEditorSelectionOptions.Clear();
        }
        else if (NodeEditorControlType is MenuControlType.Selection or MenuControlType.Confirmation)
        {
            NodeEditorDefaultValue = string.Empty;
            NodeEditorSelectionOptions.Clear();
            NodeEditorSelectionOptions.Add(new SelectionOptionEdit(string.Empty));
            if (NodeEditorControlType == MenuControlType.Confirmation)
            {
                NodeEditorSelectionOptions.Add(new SelectionOptionEdit(string.Empty));
            }
        }
        else
        {
            NodeEditorSelectionOptions.Clear();
            if (NodeEditorControlType == MenuControlType.Switch
                && !NodeEditorDefaultValue.Equals("on", StringComparison.OrdinalIgnoreCase)
                && !NodeEditorDefaultValue.Equals("off", StringComparison.OrdinalIgnoreCase))
            {
                NodeEditorDefaultValue = "off";
            }
        }

        LocalError = null;
    }

    private void AddNodeDisabledCondition()
    {
        var settingId = AvailableDisabledConditionSettings
            .FirstOrDefault(node => NodeEditorDisabledConditions.All(condition =>
                !condition.SettingNodeId.Equals(node.Id, StringComparison.OrdinalIgnoreCase)))?.Id
            ?? AvailableDisabledConditionSettings.FirstOrDefault()?.Id
            ?? string.Empty;
        NodeEditorDisabledConditions.Add(new NodeDisabledConditionEdit(settingId, string.Empty));
        LocalError = null;
    }

    private IReadOnlyList<string> GetDisabledConditionChoices(string settingNodeId)
    {
        var setting = Navigation.Nodes.FirstOrDefault(node => node.Id.Equals(
            settingNodeId,
            StringComparison.OrdinalIgnoreCase));
        return setting?.ControlType switch
        {
            MenuControlType.Selection => setting.SelectionOptions,
            MenuControlType.Switch => ["off", "on"],
            _ => []
        };
    }

    private void RemoveNodeDisabledCondition(int index)
    {
        if (index >= 0 && index < NodeEditorDisabledConditions.Count)
        {
            NodeEditorDisabledConditions.RemoveAt(index);
        }

        LocalError = null;
    }

    private void AddSelectionOption()
    {
        if (CanAddSelectionOption)
        {
            NodeEditorSelectionOptions.Add(new SelectionOptionEdit(string.Empty));
        }

        LocalError = null;
    }

    private void RemoveSelectionOption(int index)
    {
        if (index >= 0 && index < NodeEditorSelectionOptions.Count)
        {
            var removed = NodeEditorSelectionOptions[index].Value;
            NodeEditorSelectionOptions.RemoveAt(index);
            if (removed.Equals(NodeEditorDefaultValue, StringComparison.OrdinalIgnoreCase))
            {
                NodeEditorDefaultValue = string.Empty;
            }
        }

        LocalError = null;
    }

    private bool CanMoveSelectionOption(int index, int direction) =>
        CanEditMenuTree
        && NodeEditorControlType is MenuControlType.Selection or MenuControlType.Confirmation
        && index >= 0
        && index < NodeEditorSelectionOptions.Count
        && index + direction >= 0
        && index + direction < NodeEditorSelectionOptions.Count;

    private void MoveSelectionOption(int index, int direction)
    {
        if (!CanMoveSelectionOption(index, direction))
        {
            return;
        }

        var destination = index + direction;
        (NodeEditorSelectionOptions[index], NodeEditorSelectionOptions[destination]) =
            (NodeEditorSelectionOptions[destination], NodeEditorSelectionOptions[index]);
        LocalError = null;
    }

    private IReadOnlyList<MenuNodeDisabledCondition> CreateNodeDisabledConditions() =>
        NodeEditorDisabledConditions
            .Select(condition => new MenuNodeDisabledCondition(
                condition.SettingNodeId,
                condition.EqualsValue))
            .ToArray();

    private IReadOnlyList<string> CreateSelectionOptions() => NodeEditorSelectionOptions
        .Select(option => option.Value.Trim())
        .ToArray();

    private bool CanMoveMenuNode(MenuNodeSummary node, int direction)
    {
        if (TreeOrdering != MenuTreeSortMode.Custom
            || IsBusy
            || Authoring.IsRecording
            || Navigation.IsRunning
            || Snapshot.MacroRunning)
        {
            return false;
        }

        var siblings = Navigation.Nodes
            .Where(candidate => string.Equals(
                candidate.ParentId,
                node.ParentId,
                StringComparison.OrdinalIgnoreCase))
            .ToArray();
        var index = Array.FindIndex(siblings, candidate =>
            candidate.Id.Equals(node.Id, StringComparison.OrdinalIgnoreCase));
        var destination = index + direction;
        return index >= 0 && destination >= 0 && destination < siblings.Length;
    }

