            {
                return "Choose a source control.";
            }

            if (RecordingKind == MenuAuthoringItemKind.Transition
                && RecordReturnToVideo
                && ReturnToVideoAnchor is null)
            {
                return "Create a return-to-video anchor before recording a route-specific return sequence.";
