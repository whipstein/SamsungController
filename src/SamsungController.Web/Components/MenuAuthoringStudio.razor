    private string? RecordingUnavailableReason
    {
        get
        {
            if (IsBusy)
            {
                return "Wait for the current action to finish.";
            }

            if (Snapshot.MacroRunning)
            {
                return "Wait for the active macro to finish.";
            }

            if (Navigation.IsRunning)
            {
                return "Wait for the active menu traversal to finish.";
            }

            if (string.IsNullOrWhiteSpace(ExistingTargetId))
            {
                return SelectableRecordingTargets.Count == 0
                    ? "No red, unrecorded target is available in this menu configuration."
                    : "Choose a target node.";
            }

            if (SelectableRecordingTargets.All(node => !node.Id.Equals(
