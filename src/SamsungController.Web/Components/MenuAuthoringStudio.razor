    private Task DeleteMenuNodeAsync() => RunBusyAsync(async () =>
    {
        var nodeId = EditingNodeId
            ?? throw new InvalidOperationException("Choose a menu-tree node to delete.");
        var deleted = Navigation.Nodes.First(node => node.Id.Equals(
            nodeId,
            StringComparison.OrdinalIgnoreCase));
        await Controller.DeleteMenuNodeAsync(nodeId);
        Refresh();
        var next = deleted.ParentId is null
            ? null
            : Navigation.Nodes.FirstOrDefault(node => node.Id.Equals(
                deleted.ParentId,
                StringComparison.OrdinalIgnoreCase));
        next ??= Navigation.Nodes.FirstOrDefault();
        if (next is not null)
        {
            EditMenuNode(next);
        }

        InitializeNodeDefaults(force: true);
    });

    private Task StartRecordingAsync() => RunBusyAsync(async () =>
    {
        if (!IsConnected)
        {
            var snapshot = Controller.GetSnapshot();
            var host = snapshot.Host
                ?? throw new InvalidOperationException(
                    "Save the TV IP address on the Connection page before recording.");
            await Controller.ConnectAsync(new TvConnectionRequest(
                snapshot.DisplayName,
                host,
                snapshot.Secure,
                snapshot.Port,
                snapshot.AllowUntrustedCertificate,
                snapshot.KeepAliveIntervalSeconds,
                snapshot.KeepAliveTimeoutSeconds,
                snapshot.PostConnectWarmupMilliseconds,
                snapshot.ReconnectAfterIdleSeconds));
        }

        Controller.StartMenuRecording(new MenuRecordingRequest(
            RecordingKind,
            RecordingKind == MenuAuthoringItemKind.Anchor ? RecordingId : string.Empty,
            RecordingKind == MenuAuthoringItemKind.Anchor ? RecordingLabel : GetTargetLabel(ExistingTargetId),
            RecordingKind == MenuAuthoringItemKind.Transition ? SourceNodeId : null,
            ExistingTargetId,
            null,
            null,
            RecordReturnToVideo: RecordingKind == MenuAuthoringItemKind.Transition
                                 && RecordReturnToVideo));
    });

