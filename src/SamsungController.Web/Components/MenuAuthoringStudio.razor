    private void Refresh()
    {
        Snapshot = Controller.GetSnapshot();
        Navigation = Controller.GetMenuNavigationSnapshot();
        var authoring = Controller.GetMenuAuthoringSnapshot();
        if (!TimingProfileInitialized
            || (!TimingProfileDirty && authoring.Timing != LastObservedTiming))
        {
            DefaultDelayMilliseconds = authoring.Timing.DefaultDelayMilliseconds;
            ScreenChangeDelayMilliseconds = authoring.Timing.ScreenChangeDelayMilliseconds;
            ReturnDelayMilliseconds = authoring.Timing.ReturnDelayMilliseconds;
            TimingProfileInitialized = true;
        }

        LastObservedTiming = authoring.Timing;
        Authoring = authoring;
        if (PreparedRerecordTargetId is not null
            && Authoring.DraftCandidates.All(candidate => !candidate.TargetNodeId.Equals(
                PreparedRerecordTargetId,
                StringComparison.OrdinalIgnoreCase)))
        {
            PreparedRerecordTargetId = null;
        }

        if (ReturnToVideoAnchor is null)
        {
            RecordReturnToVideo = false;
        }

        if (Authoring.ReturnStrategy is { } returnStrategy)
        {
            if (!ReturnScriptsInitialized || !ReturnScriptsDirty)
            {
                AtMenuRootScript = returnStrategy.AtMenuRoot.Script;
                BelowMenuRootScript = returnStrategy.BelowMenuRoot.Script;
                ReturnScriptsInitialized = true;
            }

            if (string.IsNullOrWhiteSpace(DeepReturnTestNodeId)
                || returnStrategy.DeepTestNodes.All(node =>
                    !node.Id.Equals(DeepReturnTestNodeId, StringComparison.OrdinalIgnoreCase)))
            {
                DeepReturnTestNodeId = returnStrategy.DeepTestNodes.FirstOrDefault()?.Id
                    ?? string.Empty;
            }

            if (string.IsNullOrWhiteSpace(OverrideReturnNodeId)
                || ReturnOverrideNodes.All(node =>
                    !node.Id.Equals(OverrideReturnNodeId, StringComparison.OrdinalIgnoreCase)))
            {
                OverrideReturnNodeId = ReturnOverrideNodes.FirstOrDefault()?.Id
                    ?? string.Empty;
                LoadSelectedReturnOverride();
            }
        }
        if (string.IsNullOrWhiteSpace(SelectedTimingTestRouteId)
            || Authoring.TimingTestRoutes.All(route =>
                !route.Id.Equals(SelectedTimingTestRouteId, StringComparison.OrdinalIgnoreCase)))
        {
            SelectedTimingTestRouteId = Authoring.ActiveTimingTestRouteId
                ?? Authoring.TimingTestRoutes.FirstOrDefault()?.Id
                ?? string.Empty;
        }

        if (TimingEditorId is not null
            && Authoring.DraftCandidates.All(candidate =>
                candidate.Kind != TimingEditorKind
                || !candidate.Id.Equals(TimingEditorId, StringComparison.OrdinalIgnoreCase)))
        {
            CloseTimingEditor();
        }

        if (PendingVerifiedSettingRemovalId is not null
            && Navigation.Nodes.All(node =>
                !node.Id.Equals(PendingVerifiedSettingRemovalId, StringComparison.OrdinalIgnoreCase)))
        {
            PendingVerifiedSettingRemovalId = null;
        }

        UpdateAttentionSections();
    }

    private void UpdateAttentionSections()
    {
        var returnScriptsNeedValidation = ReturnScriptsNeedValidation;
        var systemTimingNeedsValidation = !SystemTimingIsVerified;
        var draftValidationCount = Authoring.DraftCandidates.Count;

        if (!AttentionStateInitialized)
        {
            if (Navigation.DefinitionName is null)
            {
                return;
            }

            ReturnScriptsExpanded = returnScriptsNeedValidation;
            SystemTimingExpanded = systemTimingNeedsValidation;
            DraftValidationExpanded = draftValidationCount > 0;
        }
        else
        {
            if (!ReturnScriptsPreviouslyNeededValidation && returnScriptsNeedValidation)
            {
                ReturnScriptsExpanded = true;
            }

            if (!SystemTimingPreviouslyNeededValidation && systemTimingNeedsValidation)
            {
                SystemTimingExpanded = true;
            }

            if (draftValidationCount > PreviousDraftValidationCount)
            {
                DraftValidationExpanded = true;
            }
        }

        ReturnScriptsPreviouslyNeededValidation = returnScriptsNeedValidation;
        SystemTimingPreviouslyNeededValidation = systemTimingNeedsValidation;
        PreviousDraftValidationCount = draftValidationCount;
        AttentionStateInitialized = true;
    }

