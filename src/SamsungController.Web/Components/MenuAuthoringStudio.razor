    private async Task RunBusyAsync(Func<Task> action)
    {
        IsBusy = true;
        LocalError = null;
        try
        {
            await action();
        }
        catch (OperationCanceledException)
        {
            // Service state reports cancellation.
        }
        catch (Exception exception)
        {
            LocalError = exception.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

