    private Task UpdateMenuNodeAsync()
    {
        var nodeId = EditingNodeId
            ?? throw new InvalidOperationException("Choose a menu-tree node to update.");
        return RunBusyAsync(async () =>
        {
            var request = new MenuNodeEditRequest(
                nodeId,
                NodeEditorLabel,
                NodeEditorParentId,
                NodeEditorDescription,
                NodeEditorControlType,
                NodeEditorDefaultValue,
                CreateNodeDisabledConditions(),
                CreateSelectionOptions(),
                NodeEditorMinimumValue,
                NodeEditorMaximumValue);
            await Controller.UpdateMenuNodeAsync(nodeId, request);

            Refresh();
            var saved = Navigation.Nodes.First(node =>
                node.Id.Equals(nodeId, StringComparison.OrdinalIgnoreCase));
            EditMenuNode(saved);
            InitializeNodeDefaults(force: true);
        });
    }

