    private void InitializeNodeDefaults(bool force = false)
    {
        if (Navigation.Nodes.Count == 0)
        {
            return;
        }

        if (!string.Equals(
                TopologyOutlineDefinitionPath,
                Navigation.DefinitionPath,
                StringComparison.Ordinal))
        {
            TopologyOutlineDirty = false;
            TopologyOutline = string.Empty;
        }

        if (string.IsNullOrWhiteSpace(TopologyParentId)
            || Navigation.Nodes.All(node => !node.Id.Equals(
                TopologyParentId,
                StringComparison.OrdinalIgnoreCase)))
        {
            TopologyParentId = Navigation.Nodes.FirstOrDefault(node => node.Id.Equals(
                    "tv-interface",
                    StringComparison.OrdinalIgnoreCase))?.Id
                ?? Navigation.Nodes[0].Id;
            TopologyPreview = null;
        }

        if (!TopologyOutlineDirty)
        {
            LoadCurrentTopologyOutline();
        }

        if (force || string.IsNullOrWhiteSpace(SourceNodeId) || Navigation.Nodes.All(node => node.Id != SourceNodeId))
        {
            SourceNodeId = Navigation.Nodes.FirstOrDefault(node => node.Id == "normal-video")?.Id
                ?? Navigation.Nodes[0].Id;
        }

        if (force
            || string.IsNullOrWhiteSpace(ExistingTargetId)
            || SelectableRecordingTargets.All(node => !node.Id.Equals(
                ExistingTargetId,
                StringComparison.OrdinalIgnoreCase)))
        {
            ExistingTargetId = UnrecordedRecordingTargets.FirstOrDefault(node =>
                    !node.Id.Equals(SourceNodeId, StringComparison.OrdinalIgnoreCase))?.Id
                ?? UnrecordedRecordingTargets.FirstOrDefault()?.Id
                ?? string.Empty;
        }

        if (EditingNodeId is null && string.IsNullOrWhiteSpace(NodeEditorParentId))
        {
            NodeEditorParentId = Navigation.Nodes.FirstOrDefault(node =>
                    node.Id.Equals("tv-interface", StringComparison.OrdinalIgnoreCase))?.Id
                ?? Navigation.Nodes[0].Id;
        }

        if (!IsAddingMenuNode
            && (EditingNodeId is null || Navigation.Nodes.All(node => !node.Id.Equals(
                EditingNodeId,
                StringComparison.OrdinalIgnoreCase))))
        {
            var initial = Navigation.Nodes.FirstOrDefault(node => node.Id.Equals(
                    "normal-video",
                    StringComparison.OrdinalIgnoreCase))
                ?? Navigation.Nodes[0];
            EditMenuNode(initial);
        }
    }

