    private void UseGeneratedDefinitionIdentity()
    {
        DefinitionNameWasEdited = false;
        DefinitionIdWasEdited = false;
        UpdateGeneratedDefinitionIdentity();
    }

    private void UpdateGeneratedDefinitionIdentity()
    {
        PendingDefinitionReplacement = null;
        LocalError = null;
        if (!CanGenerateDefinitionIdentity)
        {
            if (!DefinitionNameWasEdited)
            {
                DefinitionName = string.Empty;
            }

            if (!DefinitionIdWasEdited)
            {
                DefinitionId = string.Empty;
            }

            return;
        }

        var model = DefinitionModel.Trim();
        var firmware = DefinitionFirmware.Trim();
        if (!DefinitionNameWasEdited)
        {
            DefinitionName = $"{model} · firmware {firmware}";
        }

        if (!DefinitionIdWasEdited)
        {
            var fileIdParts = new List<string> { model, firmware };
            AddSpecificContextPart(fileIdParts, DefinitionSignal);
            AddSpecificContextPart(fileIdParts, DefinitionPictureMode);
            AddSpecificContextPart(fileIdParts, DefinitionInput);
            DefinitionId = CreateMenuNodeId(string.Join('-', fileIdParts));
        }
    }

    private static void AddSpecificContextPart(ICollection<string> parts, string value)
    {
        if (IsSpecificContextValue(value))
        {
            parts.Add(value.Trim());
        }
    }

    private static bool IsSpecificContextValue(string value) =>
        !string.IsNullOrWhiteSpace(value)
        && !value.Trim().Equals("any", StringComparison.OrdinalIgnoreCase)
        && !value.Trim().Equals("unknown", StringComparison.OrdinalIgnoreCase)
        && !value.Trim().Equals("unrecorded", StringComparison.OrdinalIgnoreCase);

