    private static string FormatControlType(MenuControlType controlType) => controlType switch
    {
        MenuControlType.Submenu => "Sub-menu",
        MenuControlType.Slider => "Slider",
        MenuControlType.Selection => "Selection",
        MenuControlType.Switch => "Switch",
        MenuControlType.Confirmation => "Confirmation",
        _ => controlType.ToString()
    };

    private static string FormatOutlineControlDetails(MenuNodeSummary node)
    {
        var details = new List<string>
        {
            node.ControlType.ToString().ToLowerInvariant()
        };
        if (!string.IsNullOrWhiteSpace(node.DefaultValue))
        {
            details.Add($"default={node.DefaultValue}");
        }

        if (node.MinimumValue is { } minimum)
        {
            details.Add($"min={minimum.ToString("G29", CultureInfo.InvariantCulture)}");
        }

        if (node.MaximumValue is { } maximum)
        {
            details.Add($"max={maximum.ToString("G29", CultureInfo.InvariantCulture)}");
        }

        if (node.SelectionOptions.Count > 0)
        {
            details.Add("options=" + string.Join('|', node.SelectionOptions));
        }

        if (node.DisabledWhen.Count > 0)
        {
            details.Add("disabledWhen=" + string.Join('|', node.DisabledWhen.Select(condition =>
                $"{condition.SettingNodeId}={condition.EqualsValue}")));
        }

        return "{" + string.Join("; ", details) + "}";
    }

    private string FormatDisabledConditions(MenuNodeSummary node)
    {
        var rules = node.DisabledWhen.Select(condition =>
        {
            var setting = Navigation.Nodes.FirstOrDefault(candidate => candidate.Id.Equals(
                condition.SettingNodeId,
                StringComparison.OrdinalIgnoreCase));
            return $"{setting?.Label ?? condition.SettingNodeId} = {condition.EqualsValue}";
        });
        return (node.IsDisabledByDefault ? "Disabled by default · " : "Disabled when ")
               + string.Join(" or ", rules);
    }

    private static string GetControlInteractionGuidance(MenuNodeSummary node)
    {
        var defaultSuffix = string.IsNullOrWhiteSpace(node.DefaultValue)
            ? string.Empty
            : $" Declared default: {node.DefaultValue}.";
        return node.ControlType switch
        {
            MenuControlType.Submenu => "Press OK to open this sub-menu.",
            MenuControlType.Slider => "Use Left/Right to change the slider from "
                                      + node.MinimumValue?.ToString("G29", CultureInfo.InvariantCulture)
                                      + " to "
                                      + node.MaximumValue?.ToString("G29", CultureInfo.InvariantCulture)
                                      + "."
                                      + defaultSuffix,
            MenuControlType.Selection => "Press OK to open its choices, then select a value. Available: "
                                         + string.Join(", ", node.SelectionOptions)
                                         + "."
                                         + defaultSuffix,
            MenuControlType.Switch => "Press OK to toggle the switch." + defaultSuffix,
            MenuControlType.Confirmation => "Press OK to open the confirmation dialog. Choices: "
                                            + string.Join(", ", node.SelectionOptions)
                                            + ". Initially highlighted: "
                                            + node.DefaultValue
                                            + ".",
            _ => "Follow the recorded interaction."
        };
    }

    private static string CreateMenuNodeId(string label)
    {
        var normalized = new string(label.Trim().ToLowerInvariant()
            .Select(character => char.IsLetterOrDigit(character) || character == '_'
                ? character
                : '-')
            .ToArray());
        while (normalized.Contains("--", StringComparison.Ordinal))
        {
            normalized = normalized.Replace("--", "-", StringComparison.Ordinal);
        }

        normalized = normalized.Trim('-');
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return "menu-node";
        }

        return char.IsLetter(normalized[0]) || normalized[0] == '_'
            ? normalized
            : $"node-{normalized}";
    }

    private static string GetIndentGuideStyle(int indentLevel) =>
        $"left: calc(54px + {(indentLevel * 2) - 1}ch);";

    private static IReadOnlyList<MenuNodeSummary> FlattenTreeNodes(
        IReadOnlyList<MenuNodeSummary> nodes,
        bool alphabetical)
    {
        var result = new List<MenuNodeSummary>(nodes.Count);
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        IEnumerable<MenuNodeSummary> Order(IEnumerable<MenuNodeSummary> candidates) =>
            alphabetical
                ? candidates
                    .OrderBy(candidate => candidate.Label, StringComparer.OrdinalIgnoreCase)
                    .ThenBy(candidate => candidate.Id, StringComparer.OrdinalIgnoreCase)
                : candidates;

        void AppendBranch(MenuNodeSummary node)
        {
            if (!visited.Add(node.Id))
            {
                return;
            }

            result.Add(node);
            foreach (var child in Order(nodes.Where(candidate => string.Equals(
                         candidate.ParentId,
                         node.Id,
                         StringComparison.OrdinalIgnoreCase))))
            {
                AppendBranch(child);
            }
        }

        foreach (var root in Order(nodes.Where(node => string.IsNullOrWhiteSpace(node.ParentId))))
        {
            AppendBranch(root);
        }

        foreach (var node in Order(nodes))
        {
            AppendBranch(node);
        }

        return result;
    }

