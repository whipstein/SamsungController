    private async Task GoToSetupStepAsync(MenuSetupStep step)
    {
        LocalError = null;
        switch (step)
        {
            case MenuSetupStep.Profile:
                ShowDefinitionForm = true;
                break;
            case MenuSetupStep.Configuration:
                MenuTreeExpanded = true;
                BulkTopologyExpanded = true;
                if (!ActiveMenuConfigurationIsDescribed
                    && ActiveMenuConfiguration is not null
                    && !ShowMenuConfigurationEditor)
                {
                    BeginEditMenuConfiguration();
                }

                break;
            case MenuSetupStep.Outline:
                MenuTreeExpanded = true;
                BulkTopologyExpanded = true;
                break;
            case MenuSetupStep.Record:
                MenuTreeExpanded = false;
                break;
            case MenuSetupStep.Verify:
                MenuTreeExpanded = false;
                DraftValidationExpanded = true;
                break;
        }

        PendingSetupScroll = step;
        await InvokeAsync(StateHasChanged);
    }

    private ElementReference GetSetupStepElement(MenuSetupStep step) => step switch
    {
        MenuSetupStep.Profile => DefinitionSetupElement,
        MenuSetupStep.Configuration => ConfigurationStepElement,
        MenuSetupStep.Outline => TopologyStepElement,
        MenuSetupStep.Record => RecordingStepElement,
        MenuSetupStep.Verify => ValidationStepElement,
        _ => RecordingStepElement
    };

    private string GetSetupStepClass(MenuSetupStep step)
    {
        var classes = new List<string> { "menu-setup-guide-step" };
        if (IsSetupStepComplete(step))
        {
            classes.Add("complete");
        }

        if (step == RecommendedSetupStep)
        {
            classes.Add("current");
        }

        return string.Join(' ', classes);
    }

    private bool IsSetupStepComplete(MenuSetupStep step) => step switch
    {
        MenuSetupStep.Profile => Navigation.DefinitionName is not null,
        MenuSetupStep.Configuration => ActiveMenuConfigurationIsDescribed,
        MenuSetupStep.Outline => Navigation.Nodes.Count > 2,
        MenuSetupStep.Record => Navigation.Nodes.Any(node => node.HasDraftRoute || node.HasVerifiedRoute),
        MenuSetupStep.Verify => Navigation.Nodes.Any(node => node.HasVerifiedRoute)
            && Authoring.DraftCandidates.Count == 0,
        _ => false
    };

    private string GetSetupStepStatus(MenuSetupStep step) => step switch
    {
        MenuSetupStep.Profile when Navigation.DefinitionName is not null => Navigation.DefinitionName,
        MenuSetupStep.Profile => "Required",
        MenuSetupStep.Configuration when ActiveMenuConfigurationIsDescribed => ActiveMenuConfiguration!.Name,
        MenuSetupStep.Configuration => "Describe layout",
        MenuSetupStep.Outline when Navigation.Nodes.Count > 2 => $"{Navigation.Nodes.Count - 2} menu items",
        MenuSetupStep.Outline => "Add hierarchy",
        MenuSetupStep.Record when UnrecordedRecordingTargets.Count > 0 => $"{UnrecordedRecordingTargets.Count} remaining",
        MenuSetupStep.Record => "Routes recorded",
        MenuSetupStep.Verify when Authoring.DraftCandidates.Count > 0 => $"{Authoring.DraftCandidates.Count} waiting",
        MenuSetupStep.Verify when IsSetupStepComplete(MenuSetupStep.Verify) => "Complete",
        _ => "No draft yet"
    };

