        .OrderByDescending(anchor => anchor.Id.Equals("normal-video", StringComparison.OrdinalIgnoreCase))
        .ThenByDescending(anchor => anchor.Verified)
        .FirstOrDefault();
    private bool IsConnected => Snapshot.ConnectionState == SamsungConnectionState.Connected;
    private IReadOnlyList<MenuNodeSummary> UnrecordedRecordingTargets => Navigation.Nodes
        .Where(IsUnrecordedRecordingTarget)
        .ToArray();
    private IReadOnlyList<MenuNodeSummary> SelectableRecordingTargets => Navigation.Nodes
        .Where(node => IsUnrecordedRecordingTarget(node)
            || node.Id.Equals(PreparedRerecordTargetId, StringComparison.OrdinalIgnoreCase))
        .ToArray();
    private MenuNodeSummary? SelectedRecordingTarget => Navigation.Nodes.FirstOrDefault(node =>
        node.Id.Equals(ExistingTargetId, StringComparison.OrdinalIgnoreCase));
    private IReadOnlyList<MenuNodeSummary> AvailableDisabledConditionSettings => Navigation.Nodes
        .Where(node => node.ControlType is not MenuControlType.Submenu
