@implements IDisposable
@inject SamsungControllerService Controller
@inject IJSRuntime JavaScript
@using System.Text

<section class="panel authoring-studio">
    <div class="panel-label">
        <span>MENU AUTHORING STUDIO</span>
        <span class="@(Authoring.IsRecording ? "recording-indicator active" : "recording-indicator")">
            @(Authoring.IsRecording ? "● RECORDING" : "UI → TV → YAML → 3× VERIFY")
        </span>
    </div>

    <div class="authoring-intro">
        <div>
            <strong>Follow one guided path from TV profile to verified menu.</strong>
            <p>The highlighted step is the next recommended action. Successful saves automatically open and move to the next part of setup.</p>
        </div>
        <div class="authoring-intro-actions">
            <HelpBubble Title="Menu-authoring workflow" ButtonText="Workflow help">
                <ol>
                    <li><strong>TV profile:</strong> enter the model number and firmware. The definition name and file ID are generated for you.</li>
                    <li><strong>Configuration:</strong> the initial Default layout is ready automatically. Add and describe alternatives only when TV settings change which rows are visible or their order.</li>
                    <li><strong>Menu outline:</strong> paste the visible hierarchy using indentation. Preview it, then save while continuing to edit or advance to recording. Use fine adjustments only when needed.</li>
                    <li><strong>Record:</strong> select a source and target, then use the embedded remote. Successful buttons control the TV and enter the draft.</li>
                    <li><strong>Timing:</strong> recording starts with an assumed-valid 800 ms screen-change wait. Test and tune common waits after a route exists, then override only steps that need special pacing.</li>
                    <li><strong>Verify:</strong> prepare the source, replay the draft, and confirm three separate visual passes.</li>
                </ol>
                <p class="help-callout safe">The source/target pair identifies a transition automatically. Recording the same pair replaces its existing draft instead of creating a duplicate ID.</p>
                <p>Use <strong>Also record return to normal video</strong> when that target needs a specific return sequence. Forward and return keys then share one verification count.</p>
            </HelpBubble>
            <button class="secondary-action" @onclick="ToggleDefinitionForm" disabled="@(Authoring.IsRecording || Navigation.IsRunning)">
                @(ShowDefinitionForm ? "Close TV profile" : "Create TV profile")
            </button>
        </div>
    </div>

    <nav class="menu-setup-guide" aria-label="Menu setup progress">
        <button type="button" class="@GetSetupStepClass(MenuSetupStep.Profile)" @onclick="() => GoToSetupStepAsync(MenuSetupStep.Profile)">
            <span>1</span><strong>TV profile</strong><small>@GetSetupStepStatus(MenuSetupStep.Profile)</small>
        </button>
        <button type="button" class="@GetSetupStepClass(MenuSetupStep.Configuration)" @onclick="() => GoToSetupStepAsync(MenuSetupStep.Configuration)" disabled="@(Navigation.DefinitionName is null)">
            <span>2</span><strong>Configuration</strong><small>@GetSetupStepStatus(MenuSetupStep.Configuration)</small>
        </button>
        <button type="button" class="@GetSetupStepClass(MenuSetupStep.Outline)" @onclick="() => GoToSetupStepAsync(MenuSetupStep.Outline)" disabled="@(Navigation.DefinitionName is null)">
            <span>3</span><strong>Menu outline</strong><small>@GetSetupStepStatus(MenuSetupStep.Outline)</small>
        </button>
        <button type="button" class="@GetSetupStepClass(MenuSetupStep.Record)" @onclick="() => GoToSetupStepAsync(MenuSetupStep.Record)" disabled="@(Navigation.DefinitionName is null || Navigation.Nodes.Count <= 2)">
            <span>4</span><strong>Record route</strong><small>@GetSetupStepStatus(MenuSetupStep.Record)</small>
        </button>
        <button type="button" class="@GetSetupStepClass(MenuSetupStep.Verify)" @onclick="() => GoToSetupStepAsync(MenuSetupStep.Verify)" disabled="@(Authoring.DraftCandidates.Count == 0)">
            <span>5</span><strong>Verify</strong><small>@GetSetupStepStatus(MenuSetupStep.Verify)</small>
        </button>
    </nav>
    <div class="menu-setup-next">
        <span>NEXT</span>
        <strong>@RecommendedSetupMessage</strong>
        <button type="button" class="secondary-action" @onclick="() => GoToSetupStepAsync(RecommendedSetupStep)">Go to next step <span>→</span></button>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="authoring-message error" role="alert">@ErrorMessage</div>
    }
    else if (!string.IsNullOrWhiteSpace(Authoring.Status))
    {
        <div class="authoring-message">@Authoring.Status</div>
    }

    @if (ShowDefinitionForm)
    {
        <div class="definition-setup-card setup-step-anchor" @ref="DefinitionSetupElement">
            <div class="authoring-section-title"><span>01</span><strong>Identify this TV software</strong></div>
            <div class="authoring-form-grid">
                <label><span>TV model number</span><input value="@DefinitionModel" @oninput="HandleDefinitionModelChanged" placeholder="e.g. QN90D" /></label>
                <label><span>Firmware version</span><input value="@DefinitionFirmware" @oninput="HandleDefinitionFirmwareChanged" placeholder="e.g. 1296" /></label>
                <label><span>Name · generated by default</span><input value="@DefinitionName" @oninput="HandleDefinitionNameChanged" placeholder="QN90D · firmware 1296" /></label>
                <label><span>File ID · generated by default</span><input value="@DefinitionId" @oninput="HandleDefinitionIdChanged" placeholder="qn90d-1296" /></label>
                <label><span>Signal</span><input value="@DefinitionSignal" @oninput="HandleDefinitionSignalChanged" placeholder="SDR" /></label>
                <label><span>Picture mode</span><input value="@DefinitionPictureMode" @oninput="HandleDefinitionPictureModeChanged" placeholder="e.g. Movie" /></label>
                <label class="wide-field"><span>Input/source</span><input value="@DefinitionInput" @oninput="HandleDefinitionInputChanged" placeholder="e.g. HDMI 1" /></label>
            </div>
            <div class="definition-identity-actions">
                <button class="secondary-action" @onclick="UseGeneratedDefinitionIdentity" disabled="@(!CanGenerateDefinitionIdentity)">Regenerate name + file ID</button>
                <button class="primary-action authoring-save" @onclick="CreateDefinitionAsync" disabled="@(!CanCreateDefinition)">
                    Create profile and continue <span>→</span>
                </button>
            </div>
            @if (PendingDefinitionReplacement is { } replacement)
            {
                <div class="definition-replacement-confirmation" role="alert">
                    <div>
                        <span>FILE ALREADY EXISTS</span>
                        <strong>@Path.GetFileName(replacement.Path)</strong>
                        <p>Replacing it will overwrite that file's menu tree, recorded routes, and verification state with a new empty TV profile.</p>
                    </div>
                    <div>
                        <button type="button" class="secondary-action" @onclick="CancelDefinitionReplacement" disabled="@IsBusy">Cancel</button>
                        <button type="button" class="secondary-action danger-action" @onclick="ConfirmDefinitionReplacementAsync" disabled="@IsBusy">Replace existing file</button>
                    </div>
                </div>
            }
            <p class="field-note">The YAML file is created in SamsungController's per-user configuration directory and becomes the active definition.</p>
        </div>
    }

    @if (Navigation.DefinitionName is not null)
    {
        <div class="menu-tree-builder collapsible-authoring-section @(MenuTreeExpanded ? "" : "collapsed")">
            <button type="button" class="authoring-section-title authoring-section-toggle" @onclick="ToggleMenuTree" aria-expanded="@(MenuTreeExpanded ? "true" : "false")">
                <span>02</span><strong>Configure and define the menu</strong>
                <b class="tree-node-count">@Navigation.Nodes.Count nodes</b>
                <i aria-hidden="true">@(MenuTreeExpanded ? "−" : "+")</i>
            </button>
            @if (MenuTreeExpanded)
            {
                <div class="authoring-section-body">
                    <div class="bulk-topology-editor @(BulkTopologyExpanded ? "" : "collapsed")">
                        <button type="button" class="bulk-topology-toggle" @onclick="ToggleBulkTopology" aria-expanded="@(BulkTopologyExpanded ? "true" : "false")">
                            <span>
                                <b>GUIDED MENU SETUP</b>
                                <strong>Build many menu items from one outline</strong>
                            </span>
                            <i aria-hidden="true">@(BulkTopologyExpanded ? "−" : "+")</i>
                        </button>
                        @if (BulkTopologyExpanded)
                        {
                            <div class="bulk-topology-body">
                                    <div class="menu-configuration-workspace setup-step-anchor" @ref="ConfigurationStepElement">
                                    <div class="menu-configuration-heading">
                                        <span>
                                            <b>ACTIVE MENU CONFIGURATION</b>
                                            <strong>@(ActiveMenuConfiguration?.Name ?? "Default menu configuration")</strong>
                                            <small>@(ActiveMenuConfiguration?.Conditions ?? "Add a configuration before recording routes whose key counts depend on visible menu items.")</small>
                                        </span>
                                        <div>
                                            @if (ActiveMenuConfiguration is not null)
                                            {
                                                <button class="secondary-action" @onclick="BeginEditMenuConfiguration" disabled="@(!CanEditMenuTree)">Edit</button>
                                            }
                                            <button class="secondary-action" @onclick="BeginAddMenuConfiguration" disabled="@(!CanEditMenuTree)">+ Add configuration</button>
                                        </div>
                                    </div>
                                    @if (Navigation.Configurations.Count > 0)
                                    {
                                        <label class="menu-configuration-selector">
                                            <span>CONFIGURATION USED FOR RECORDING, VERIFICATION, AND NAVIGATION</span>
                                            <select value="@Navigation.ActiveConfigurationId" @onchange="ChangeMenuConfigurationAsync" disabled="@(!CanEditMenuTree)">
                                                @foreach (var configuration in Navigation.Configurations)
                                                {
                                                    <option value="@configuration.Id">@configuration.Name</option>
                                                }
                                            </select>
                                        </label>
                                    }
                                    @if (ShowMenuConfigurationEditor)
                                    {
                                        <div class="menu-configuration-editor">
                                            <div class="authoring-form-grid compact">
                                                <label>
                                                    <span>Name</span>
                                                    <input value="@MenuConfigurationName" @oninput="HandleMenuConfigurationNameChanged" placeholder="Game Mode on" disabled="@IsBusy" />
                                                </label>
                                                <label>
                                                    <span>Stable ID</span>
                                                    <input @bind="MenuConfigurationId" placeholder="Generated from name" disabled="@(!IsAddingMenuConfiguration || IsBusy)" />
                                                </label>
                                                <label class="wide-field">
                                                    <span>Selections that produce this menu layout</span>
                                                    <input @bind="MenuConfigurationConditions" placeholder="Game Mode = On; Input Signal Plus = On" disabled="@IsBusy" />
                                                </label>
                                            </div>
                                            <div class="menu-node-editor-actions">
                                                <button class="secondary-action" @onclick="CancelMenuConfigurationEdit" disabled="@IsBusy">Cancel</button>
                                                <button class="primary-action" @onclick="SaveMenuConfigurationAsync" disabled="@(!CanSaveMenuConfiguration)">
                                                    @(IsAddingMenuConfiguration ? "Create & select" : "Update") <span>→</span>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="menu-outline-step setup-step-anchor" @ref="TopologyStepElement">
                                <p>Paste the visible hierarchy using two spaces per level. Add control details as <code>{slider; default=50; min=0; max=100}</code>, <code>{selection; default=Warm2; options=Standard|Warm1|Warm2}</code>, <code>{switch; default=off}</code>, or <code>{confirmation; default=Cancel; options=Reset|Cancel}</code>. A disabled rule uses a setting's stable ID: <code>{slider; default=50; min=0; max=100; disabledWhen=adaptive-picture=on}</code>. Add <code>[stable-id]</code> last only when identity must be explicit.</p>
                                <div class="bulk-topology-controls">
                                    <label>
                                        <span>PLACE OUTLINE UNDER</span>
                                        <select value="@TopologyParentId" @onchange="HandleTopologyParentChanged" disabled="@(!CanEditMenuTree)">
                                            @foreach (var node in Navigation.Nodes.OrderBy(node => node.Path, StringComparer.OrdinalIgnoreCase))
                                            {
                                                <option value="@node.Id">@node.Path</option>
                                            }
                                        </select>
                                    </label>
                                    <button class="secondary-action" @onclick="LoadCurrentTopologyOutline" disabled="@(!CanEditMenuTree)">Reload branch from YAML</button>
                                </div>
                                <label class="bulk-topology-outline">
                                    <span>MENU OUTLINE</span>
                                    <div class="bulk-topology-code-editor">
                                        <div class="bulk-topology-line-numbers" @ref="TopologyLineNumbersElement" aria-hidden="true">
                                            @for (var lineNumber = 1; lineNumber <= TopologyOutlineLineCount; lineNumber++)
                                            {
                                                <span>@lineNumber</span>
                                            }
                                        </div>
                                        <div class="bulk-topology-indent-guide-viewport" aria-hidden="true">
                                            <div class="bulk-topology-indent-guide-content" @ref="TopologyIndentGuidesElement">
                                                @foreach (var guideDepth in TopologyOutlineGuideDepths)
                                                {
                                                    <span>
                                                        @for (var indentLevel = 1; indentLevel <= guideDepth; indentLevel++)
                                                        {
                                                            <i style="@GetIndentGuideStyle(indentLevel)"></i>
                                                        }
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <textarea value="@TopologyOutline"
                                                  @oninput="HandleTopologyOutlineChanged"
                                                  @ref="TopologyOutlineElement"
                                                  aria-describedby="menu-outline-guidance menu-outline-error"
                                                  rows="20"
                                                  wrap="off"
                                                  spellcheck="false"
                                                  placeholder="Settings {submenu}&#10;  Picture {submenu}&#10;    Expert Settings {submenu}&#10;      Brightness {slider; default=50; min=0; max=100}&#10;      Color Tone {selection; default=Warm2; options=Standard|Warm1|Warm2}&#10;      Adaptive Picture {switch; default=off}&#10;      Reset Picture {confirmation; default=Cancel; options=Reset|Cancel}"
                                                  disabled="@(!CanEditMenuTree)"></textarea>
                                    </div>
                                </label>
                                <small id="menu-outline-guidance" class="bulk-topology-indent-note">Enter starts the next line with the same indentation as the current line. Tree guides appear only within populated indentation branches and stop when the outline returns to a shallower level.</small>
                                @if (!string.IsNullOrWhiteSpace(TopologyOutlineError))
                                {
                                    <div id="menu-outline-error" class="bulk-topology-error" role="alert">
                                        <strong>Outline could not be validated</strong>
                                        <span>@TopologyOutlineError</span>
                                    </div>
                                }
                                <label class="bulk-topology-keep">
                                    <input type="checkbox" checked="@KeepUnlistedTopologyNodes" @onchange="HandleKeepUnlistedChanged" disabled="@(!CanEditMenuTree)" />
                                    <span>
                                        <strong>This is a partial outline · keep omitted menu items</strong>
                                        <small>Leave this off for normal editing so deleting a line removes that item from YAML. Enable it only when the text intentionally describes part of the selected branch. Items used by recordings remain protected.</small>
                                    </span>
                                </label>
                                <div class="bulk-topology-actions">
                                    <button class="secondary-action" @onclick="PreviewTopologyOutline" disabled="@(!CanPreviewTopology)">Preview changes</button>
                                    <button class="secondary-action" @onclick="() => ApplyTopologyOutlineAsync(false)" disabled="@(!CanApplyTopology)">Save &amp; keep editing</button>
                                    <button class="primary-action" @onclick="() => ApplyTopologyOutlineAsync(true)" disabled="@(!CanApplyTopology)">Save &amp; continue <span>→</span></button>
                                </div>
                                <small class="bulk-topology-save-note">Saving is two-step: preview the current text, then save and remain here or continue to recording. Editing the text requires a new preview. Deleted lines appear as removals in the preview.</small>
                                @if (TopologyPreview is not null)
                                {
                                    <div class="bulk-topology-preview @(TopologyPreview.HasChanges ? "" : "no-changes")">
                                        <div>
                                            <span><b>@TopologyPreview.OutlineNodeCount</b> in outline</span>
                                            <span><b>@TopologyPreview.AddedNodeCount</b> add</span>
                                            <span><b>@TopologyPreview.UpdatedNodeCount</b> update</span>
                                            <span><b>@TopologyPreview.RemovedNodeCount</b> remove</span>
                                            <span><b>@TopologyPreview.FinalNodeCount</b> total</span>
                                        </div>
                                        @if (TopologyPreview.Changes.Count == 0)
                                        {
                                            <p>The active topology already matches this outline.</p>
                                        }
                                        else
                                        {
                                            <ul>
                                                @foreach (var change in TopologyPreview.Changes.Take(8))
                                                {
                                                    <li>@change</li>
                                                }
                                            </ul>
                                            @if (TopologyPreview.Changes.Count > 8)
                                            {
                                                <p>Plus @(TopologyPreview.Changes.Count - 8) more change(s).</p>
                                            }
                                        }
                                    </div>
                                }
                                <p class="bulk-topology-footnote"><strong>Topology is not verification.</strong> Record only the destinations you want to execute. Unrecorded items remain in this model file but stay off the verified Menu page.</p>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="fine-adjustments @(FineAdjustmentsExpanded ? "" : "collapsed")">
                        <button type="button" class="fine-adjustments-toggle" @onclick="ToggleFineAdjustments" aria-expanded="@FineAdjustmentsExpanded">
                            <span><b>OPTIONAL</b><strong>Fine adjustments for individual menu items</strong><small>Rename, move, add, or remove one item after applying the outline.</small></span>
                            <i aria-hidden="true">@(FineAdjustmentsExpanded ? "−" : "+")</i>
                        </button>
                    @if (FineAdjustmentsExpanded)
                    {
                    <div class="menu-tree-toolbar">
                        <p class="menu-tree-intro">Review the complete on-screen hierarchy here, or make a precise one-item edit. Custom order is saved to YAML and can mirror the TV; alphabetical order is a temporary viewing aid. Red has no recorded command; yellow is recorded and needs verification.</p>
                        <label>
                            <span>TREE ORDER</span>
                            <select @bind="TreeOrdering">
                                <option value="@MenuTreeSortMode.Custom">Custom · TV order</option>
                                <option value="@MenuTreeSortMode.Alphabetical">Alphabetical</option>
                            </select>
                        </label>
                    </div>
                    <div class="menu-tree-layout">
                        <div class="menu-tree-list"
                             role="tree"
                             aria-label="Defined menu positions"
                             tabindex="0"
                             @ref="MenuTreeElement">
                            @foreach (var node in OrderedTreeNodes)
                            {
                                <div class="menu-tree-node @GetMenuTreeNodeStateClass(node) @(EditingNodeId?.Equals(node.Id, StringComparison.OrdinalIgnoreCase) == true ? "active" : "")">
                                    <button type="button"
                                            class="menu-tree-node-select"
                                            role="treeitem"
                                            aria-level="@(node.Depth + 1)"
                                            aria-selected="@(EditingNodeId?.Equals(node.Id, StringComparison.OrdinalIgnoreCase) == true ? "true" : "false")"
                                            data-node-id="@node.Id"
                                            data-parent-id="@(node.ParentId ?? string.Empty)"
                                            title="@GetMenuTreeNodeStateTitle(node)"
                                            @onclick="() => EditMenuNode(node)">
                                        <span style="--tree-depth: @node.Depth">@node.Label</span>
                                        <small><b>@FormatControlType(node.ControlType)</b>@(node.DefaultValue is null ? string.Empty : $" · {node.DefaultValue}")</small>
                                    </button>
                                    @if (TreeOrdering == MenuTreeSortMode.Custom)
                                    {
                                        <div class="menu-tree-order-actions">
                                            <button type="button" title="Move up within this menu level" aria-label="Move @node.Label up" @onclick="() => MoveMenuNodeAsync(node.Id, -1)" disabled="@(!CanMoveMenuNode(node, -1))">↑</button>
                                            <button type="button" title="Move down within this menu level" aria-label="Move @node.Label down" @onclick="() => MoveMenuNodeAsync(node.Id, 1)" disabled="@(!CanMoveMenuNode(node, 1))">↓</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="menu-node-editor">
                            <div class="menu-node-editor-start">
                                <button class="secondary-action"
                                        @onclick="BeginNewMenuNode"
                                        disabled="@(!CanBeginMenuNodeAdd)">
                                    + Add node
                                </button>
                            </div>
                            <header>
                                <span>@(IsAddingMenuNode ? "NEW TREE NODE" : "EDIT TREE NODE")</span>
                                <strong>@(IsAddingMenuNode ? "Add a named menu position" : NodeEditorLabel)</strong>
                            </header>
                            <div class="authoring-form-grid compact">
                                <label>
                                    <span>Display name</span>
                                    <input @bind="NodeEditorLabel" placeholder="Brightness" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)" />
                                </label>
                                <label>
                                    <span>Stable node ID</span>
                                    <input @bind="NodeEditorId" placeholder="Generated from name" disabled="@(!IsAddingMenuNode || IsBusy || Authoring.IsRecording || Navigation.IsRunning)" />
                                </label>
                                <label class="wide-field">
                                    <span>Parent menu position</span>
                                    <select @bind="NodeEditorParentId" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)">
                                        <option value="">No parent (top-level)</option>
                                        @foreach (var node in AvailableParentNodes)
                                        {
                                            <option value="@node.Id">@node.Path</option>
                                        }
                                    </select>
                                </label>
                                <label class="wide-field">
                                    <span>Description (optional)</span>
                                    <input @bind="NodeEditorDescription" placeholder="What is visible or selected in this state" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)" />
                                </label>
                                <label>
                                    <span>Control type</span>
                                    <select @bind="NodeEditorControlType" @bind:after="HandleNodeControlTypeChanged" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)">
                                        <option value="@MenuControlType.Submenu">Sub-menu</option>
                                        <option value="@MenuControlType.Slider">Slider</option>
                                        <option value="@MenuControlType.Selection">Selection</option>
                                        <option value="@MenuControlType.Switch">Switch</option>
                                        <option value="@MenuControlType.Confirmation">Confirmation dialog</option>
                                    </select>
                                </label>
                                @if (NodeEditorControlType is MenuControlType.Selection or MenuControlType.Confirmation)
                                {
                                    <label>
                                        <span>@(NodeEditorControlType == MenuControlType.Confirmation ? "Initially highlighted choice" : "Default selection")</span>
                                        <select @bind="NodeEditorDefaultValue" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)">
                                            <option value="">Choose an available choice</option>
                                            @foreach (var option in SelectionOptionChoices)
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                    </label>
                                }
                                else if (NodeEditorControlType == MenuControlType.Switch)
                                {
                                    <label>
                                        <span>Default setting</span>
                                        <select @bind="NodeEditorDefaultValue" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)">
                                            <option value="off">Off</option>
                                            <option value="on">On</option>
                                        </select>
                                    </label>
                                }
                                else if (NodeEditorControlType == MenuControlType.Slider)
                                {
                                    <label>
                                        <span>Default setting</span>
                                        <input type="number" step="any" @bind="NodeEditorDefaultValue" placeholder="Value shown initially" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)" />
                                    </label>
                                    <label>
                                        <span>Minimum value</span>
                                        <input type="number" step="any" @bind="NodeEditorMinimumValue" placeholder="0" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)" />
                                    </label>
                                    <label>
                                        <span>Maximum value</span>
                                        <input type="number" step="any" @bind="NodeEditorMaximumValue" placeholder="100" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)" />
                                    </label>
                                }
                            </div>
                            @if (NodeEditorControlType is MenuControlType.Selection or MenuControlType.Confirmation)
                            {
                                <div class="selection-option-editor">
                                    <header>
                                        <span>
                                            <b>@(NodeEditorControlType == MenuControlType.Confirmation ? "CONFIRMATION CHOICES" : "AVAILABLE SELECTIONS")</b>
                                            <small>@(NodeEditorControlType == MenuControlType.Confirmation ? "List the dialog buttons in TV order. The initially highlighted choice must be one of them." : "Keep these in the same order shown on the TV. The default must be one of them.")</small>
                                        </span>
                                        <button type="button" class="secondary-action" @onclick="AddSelectionOption" disabled="@(!CanAddSelectionOption)">+ Add option</button>
                                    </header>
                                    @for (var index = 0; index < NodeEditorSelectionOptions.Count; index++)
                                    {
                                        var optionIndex = index;
                                        var option = NodeEditorSelectionOptions[optionIndex];
                                        <div class="selection-option-row">
                                            <span>@(optionIndex + 1)</span>
                                            <input @bind="option.Value" placeholder="Selection name" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)" />
                                            <button type="button" title="Move option up" aria-label="Move option up" @onclick="() => MoveSelectionOption(optionIndex, -1)" disabled="@(!CanMoveSelectionOption(optionIndex, -1))">↑</button>
                                            <button type="button" title="Move option down" aria-label="Move option down" @onclick="() => MoveSelectionOption(optionIndex, 1)" disabled="@(!CanMoveSelectionOption(optionIndex, 1))">↓</button>
                                            <button type="button" class="recorded-step-delete" title="Remove option" aria-label="Remove selection option" @onclick="() => RemoveSelectionOption(optionIndex)" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)">×</button>
                                        </div>
                                    }
                                </div>
                            }
                            <div class="node-disabled-rule-editor">
                                <header>
                                    <span><b>DISABLED / GRAYED-OUT RULES</b><small>The item remains in menu order. It is disabled when any listed setting equals the specified value.</small></span>
                                    <button class="secondary-action" @onclick="AddNodeDisabledCondition" disabled="@(!CanAddNodeDisabledCondition)">+ Add rule</button>
                                </header>
                                @if (NodeEditorDisabledConditions.Count == 0)
                                {
                                    <p>Always enabled under the declared defaults.</p>
                                }
                                else
                                {
                                    @for (var index = 0; index < NodeEditorDisabledConditions.Count; index++)
                                    {
                                        var conditionIndex = index;
                                        var condition = NodeEditorDisabledConditions[conditionIndex];
                                        var conditionValues = GetDisabledConditionChoices(condition.SettingNodeId);
                                        <div class="node-disabled-rule-row">
                                            <span>Disabled when</span>
                                            <select @bind="condition.SettingNodeId" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)">
                                                <option value="">Choose setting</option>
                                                @foreach (var setting in AvailableDisabledConditionSettings)
                                                {
                                                    <option value="@setting.Id">@setting.Path · @FormatControlType(setting.ControlType)</option>
                                                }
                                            </select>
                                            <span>equals</span>
                                            @if (conditionValues.Count > 0)
                                            {
                                                <select @bind="condition.EqualsValue" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)">
                                                    <option value="">Choose value</option>
                                                    @foreach (var value in conditionValues)
                                                    {
                                                        <option value="@value">@value</option>
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <input @bind="condition.EqualsValue" placeholder="Value" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)" />
                                            }
                                            <button type="button" class="recorded-step-delete" aria-label="Remove disabled rule" @onclick="() => RemoveNodeDisabledCondition(conditionIndex)" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)">×</button>
                                        </div>
                                    }
                                }
                            </div>
                            @if (IsAddingMenuNode && string.IsNullOrWhiteSpace(NodeEditorId) && !string.IsNullOrWhiteSpace(NodeEditorLabel))
                            {
                                <p class="field-note">Will be saved as <code>@CreateMenuNodeId(NodeEditorLabel)</code>.</p>
                            }
                            <div class="menu-node-editor-actions">
                                @if (!IsAddingMenuNode && EditingNodeId is not null)
                                {
                                    @if (ConfirmMenuNodeDelete)
                                    {
                                        <button class="secondary-action" @onclick="CancelMenuNodeDelete" disabled="@IsBusy">Cancel</button>
                                        <button class="secondary-action danger-action" @onclick="DeleteMenuNodeAsync" disabled="@IsBusy">Delete unrecorded branch</button>
                                    }
                                    else
                                    {
                                        <button class="secondary-action danger-action" @onclick="RequestMenuNodeDelete" disabled="@(!CanDeleteMenuNode)">Delete</button>
                                    }
                                }
                                @if (IsAddingMenuNode)
                                {
                                    <button class="secondary-action" @onclick="CancelMenuNodeAdd" disabled="@IsBusy">Cancel</button>
                                }
                                <button class="primary-action"
                                        @onclick="SaveOrUpdateMenuNodeAsync"
                                        disabled="@(!CanSaveOrUpdateMenuNode)">
                                    @(IsAddingMenuNode ? "Save" : "Update") <span>→</span>
                                </button>
                            </div>
                        </div>
                    </div>
                    }
                    </div>
                </div>
            }
        </div>
    }

    @if (VerifiedSettings.Count > 0)
    {
        <div class="verified-setting-manager collapsible-authoring-section @(ManageVerifiedSettingsExpanded ? "" : "collapsed")">
            <button type="button" class="authoring-section-title authoring-section-toggle" @onclick="ToggleManageVerifiedSettings" aria-expanded="@(ManageVerifiedSettingsExpanded ? "true" : "false")">
                <span>!</span><strong>Manage verified settings</strong><i aria-hidden="true">@(ManageVerifiedSettingsExpanded ? "−" : "+")</i>
            </button>
            @if (ManageVerifiedSettingsExpanded)
            {
                <div class="authoring-section-body">
                    <p>Remove an incorrect validated setting from the map. Removal also deletes its descendants and every route that enters or leaves them.</p>
                    <div class="verified-setting-list">
                        @foreach (var setting in VerifiedSettings)
                        {
                            var isProtected = IsKnownStateSetting(setting);
                            var isConfirming = PendingVerifiedSettingRemovalId?.Equals(
                                setting.Id,
                                StringComparison.OrdinalIgnoreCase) == true;
                            <div class="verified-setting-row @(isConfirming ? "confirming" : "")">
                                <span>
                                    <strong>@setting.Label</strong>
                                    <small>@setting.Path</small>
                                </span>
                                @if (isProtected)
                                {
                                    <b>Known state</b>
                                }
                                else if (isConfirming)
                                {
                                    <div class="verified-setting-confirm">
                                        <button class="secondary-action" @onclick="CancelVerifiedSettingRemoval" disabled="@IsBusy">Cancel</button>
                                        <button class="secondary-action danger-action" @onclick="() => RemoveVerifiedSettingAsync(setting)" disabled="@IsBusy">Confirm removal</button>
                                    </div>
                                }
                                else
                                {
                                    <button class="secondary-action danger-action" @onclick="() => RemoveVerifiedSettingAsync(setting)" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)">Remove</button>
                                }
                            </div>
                        }
                    </div>
                    <p class="field-note">Verified anchor targets are protected because automatic connection synchronization depends on them.</p>
                </div>
            }
        </div>
    }

    @if (Navigation.DefinitionName is not null)
    {
        <div class="authoring-workflow-grid setup-step-anchor" @ref="RecordingStepElement">
            <div class="authoring-config">
                <div class="authoring-section-title"><span>01</span><strong>Describe the recording</strong></div>
                <div class="recording-configuration-badge">
                    <span>ROUTE VALID ONLY FOR</span>
                    <strong>@(ActiveMenuConfiguration?.Name ?? "Default menu configuration")</strong>
                    <small>@(ActiveMenuConfiguration?.Conditions ?? "Add a named configuration when visible rows can change.")</small>
                </div>
                <div class="authoring-form-grid compact">
                    <label>
                        <span>Record as</span>
                        <select @bind="RecordingKind" disabled="@Authoring.IsRecording">
                            <option value="@MenuAuthoringItemKind.Transition">Transition</option>
                            <option value="@MenuAuthoringItemKind.Anchor">Anchor</option>
                        </select>
                    </label>
                    @if (RecordingKind == MenuAuthoringItemKind.Anchor)
                    {
                        <label><span>Anchor ID</span><input @bind="RecordingId" disabled="@Authoring.IsRecording" /></label>
                        <label class="wide-field"><span>Label / intent</span><input @bind="RecordingLabel" disabled="@Authoring.IsRecording" /></label>
                    }
                    else
                    {
                        <label>
                            <span>Source control</span>
                            <select @bind="SourceNodeId" disabled="@Authoring.IsRecording">
                                @foreach (var node in Navigation.Nodes)
                                {
                                    <option value="@node.Id">@node.Path</option>
                                }
                            </select>
                        </label>
                        <div class="auto-route-identity wide-field">
                            <span>AUTOMATIC TRAVERSAL</span>
                            <strong>Identified by source and target</strong>
                            <small>An existing draft for the same route is replaced automatically.</small>
                        </div>
                    }
                    <label class="wide-field">
                        <span>Target node</span>
                        <select @bind="ExistingTargetId" disabled="@(Authoring.IsRecording || SelectableRecordingTargets.Count == 0)">
                            @if (SelectableRecordingTargets.Count == 0)
                            {
                                <option value="">No unrecorded targets</option>
                            }
                            @foreach (var node in SelectableRecordingTargets)
                            {
                                var isPreparedRerecordTarget = !IsUnrecordedRecordingTarget(node);
                                <option value="@node.Id" disabled="@isPreparedRerecordTarget">
                                    @node.Path@(isPreparedRerecordTarget ? " · selected for re-recording" : string.Empty)
                                </option>
                            }
                        </select>
                        <small class="field-note">Only red, unrecorded menu positions are available. Use Re-record on an existing draft to edit it explicitly.</small>
                    </label>
                    @if (SelectedRecordingTarget is { } recordingTarget)
                    {
                        <div class="recording-target-behavior wide-field @(recordingTarget.IsDisabledByDefault ? "disabled-default" : "")">
                            <span>@FormatControlType(recordingTarget.ControlType)</span>
                            <strong>@GetControlInteractionGuidance(recordingTarget)</strong>
                            @if (recordingTarget.DisabledWhen.Count > 0)
                            {
                                <small>@FormatDisabledConditions(recordingTarget)</small>
                            }
                        </div>
                    }
                </div>
                @if (RecordingKind == MenuAuthoringItemKind.Transition && ReturnToVideoAnchor is not null)
                {
                    <label class="return-recording-toggle integrated-return-toggle">
                        <input type="checkbox" @bind="RecordReturnToVideo" disabled="@Authoring.IsRecording" />
                        <span>
                            <strong>Also record return to normal video</strong>
                            <small>After recording the forward traversal, capture the return keys as phase two of this same command and verify both with one 3-pass count.</small>
                        </span>
                    </label>
                }

                @if (!Authoring.IsRecording)
                {
                    <div class="authoring-start-actions">
                        @if (RecordingKind == MenuAuthoringItemKind.Transition)
                        {
                            <button class="secondary-action" @onclick="PrepareSourceAsync" disabled="@(!CanPrepareSource)">Prepare source</button>
                        }
                        <button class="primary-action" @onclick="StartRecordingAsync" disabled="@(!CanStartRecording)">
                            @(IsConnected ? "Start live recording" : "Connect + start live recording") <span>●</span>
                        </button>
                    </div>
                    @if (!CanStartRecording && RecordingUnavailableReason is { } recordingUnavailableReason)
                    {
                        <p class="field-note" role="status"><strong>Recording unavailable:</strong> @recordingUnavailableReason</p>
                    }
                    @if (RecordingKind == MenuAuthoringItemKind.Transition && RecordReturnToVideo)
                    {
                        <p class="field-note">Recording has two phases: navigate to the target, then record how that target returns to normal video. Validation keeps them together as one draft.</p>
                    }
                    else
                    {
                        <p class="field-note">Add and name menu positions in the tree above, then choose them here. New recordings inherit the system-wide timing profile; traversals are matched to source and target automatically.</p>
                    }
                }
                else
                {
                    @if (Authoring.RecordsReturnToVideo)
                    {
                        <p class="recording-phase-note"><strong>Phase @(Authoring.IsRecordingReturnToVideo ? "2/2" : "1/2")</strong> · @(Authoring.IsRecordingReturnToVideo ? "Record the keys that return this target to normal video." : "Record the forward traversal to the selected target.")</p>
                    }
                    <div class="recording-actions">
                        @if (Authoring.RecordsReturnToVideo && !Authoring.IsRecordingReturnToVideo)
                        {
                            <button class="primary-action" @onclick="BeginReturnRecording" disabled="@(IsBusy || Authoring.ForwardRecordedCommandCount == 0)">Continue · record return <span>→</span></button>
                        }
                        else
                        {
                            <button class="primary-action" @onclick="StopAndSaveAsync" disabled="@(IsBusy || Authoring.RecordedCommandCount == 0)">Stop + save draft <span>■</span></button>
                        }
                        <button class="secondary-action" @onclick="Controller.UndoLastRecordedMenuCommand" disabled="@(Authoring.RecordedCommandCount == 0)">Undo last</button>
                        <button class="secondary-action danger-action" @onclick="Controller.ClearRecordedMenuCommands" disabled="@(Authoring.RecordedCommandCount == 0)">Clear</button>
                        <button class="secondary-action danger-action" @onclick="CancelRecording" disabled="@(IsBusy || IsSendingKey)">Cancel recording</button>
                    </div>
                }
            </div>

            <div class="authoring-controller">
                <div class="authoring-section-title"><span>02</span><strong>Control and capture</strong></div>
                <div class="authoring-remote" aria-label="Menu recording remote">
                    <div class="authoring-remote-row">
                        <button @onclick='() => SendRecordedKeyAsync("KEY_HOME")' disabled="@RecordButtonsDisabled">Home</button>
                        <button @onclick='() => SendRecordedKeyAsync("KEY_MENU")' disabled="@RecordButtonsDisabled">Menu</button>
                        <button @onclick='() => SendRecordedKeyAsync("KEY_EXIT")' disabled="@RecordButtonsDisabled">Exit</button>
                    </div>
                    <div class="authoring-dpad">
                        <button class="up" aria-label="Up" @onclick='() => SendRecordedKeyAsync("KEY_UP")' disabled="@RecordButtonsDisabled">↑</button>
                        <button class="left" aria-label="Left" @onclick='() => SendRecordedKeyAsync("KEY_LEFT")' disabled="@RecordButtonsDisabled">←</button>
                        <button class="enter" aria-label="Enter" @onclick='() => SendRecordedKeyAsync("KEY_ENTER")' disabled="@RecordButtonsDisabled">OK</button>
                        <button class="right" aria-label="Right" @onclick='() => SendRecordedKeyAsync("KEY_RIGHT")' disabled="@RecordButtonsDisabled">→</button>
                        <button class="down" aria-label="Down" @onclick='() => SendRecordedKeyAsync("KEY_DOWN")' disabled="@RecordButtonsDisabled">↓</button>
                    </div>
                    <button class="authoring-return" @onclick='() => SendRecordedKeyAsync("KEY_RETURN")' disabled="@RecordButtonsDisabled">↩ Return</button>
                </div>
                <div class="custom-record-key">
                    <input @bind="CustomKey" placeholder="KEY_SOURCE" disabled="@RecordButtonsDisabled" />
                    <select @bind="CustomAction" disabled="@RecordButtonsDisabled">
                        @foreach (var action in Enum.GetValues<RemoteKeyAction>())
                        {
                            <option value="@action">@action</option>
                        }
                    </select>
                    <button class="secondary-action" @onclick="SendCustomRecordedKeyAsync" disabled="@(RecordButtonsDisabled || string.IsNullOrWhiteSpace(CustomKey))">Send</button>
                </div>
            </div>

            <div class="authoring-capture">
                <div class="authoring-section-title"><span>03</span><strong>@(Authoring.IsRecordingReturnToVideo ? "Captured return sequence" : "Captured traversal sequence")</strong></div>
                @if (Authoring.RecordedSteps.Count == 0)
                {
                    <div class="capture-empty">Start recording, then use the controls. Only successfully sent keys appear here.</div>
                }
                else
                {
                    <div class="recorded-step-list">
                        @for (var index = 0; index < Authoring.RecordedSteps.Count; index++)
                        {
                            var stepIndex = index;
                            var step = Authoring.RecordedSteps[stepIndex];
                            <div class="recorded-step-row">
                                <code>@step.Key</code>
                                <div class="recorded-step-details">
                                    <span>×@step.Repeat · @step.Action · @step.DelayAfter.TotalMilliseconds.ToString("0", CultureInfo.InvariantCulture)ms</span>
                                    <button type="button"
                                            class="recorded-step-delete"
                                            title="Delete this captured command"
                                            aria-label="Delete @step.Key command"
                                            @onclick="() => Controller.RemoveRecordedMenuCommand(stepIndex)"
                                            disabled="@(!Authoring.IsRecording || IsBusy || IsSendingKey)">×</button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="recorded-total">@Authoring.RecordedCommandCount button presses captured</div>
                }
            </div>
        </div>

        @if (Authoring.ReturnStrategy is { } returnStrategy)
        {
            <div class="return-strategy-lab collapsible-authoring-section @(ReturnScriptsExpanded ? "" : "collapsed")">
                <button type="button" class="authoring-section-title authoring-section-toggle" @onclick="ToggleReturnScripts" aria-expanded="@(ReturnScriptsExpanded ? "true" : "false")">
                    <span>04</span><strong>Return to normal video scripts</strong>
                    <b class="timing-profile-state @(ReturnScriptsNeedValidation ? "unverified" : "verified")">
                        @(ReturnScriptsNeedValidation ? "NEEDS VALIDATION" : "VERIFIED")
                    </b>
                    <i aria-hidden="true">@(ReturnScriptsExpanded ? "−" : "+")</i>
                </button>
                @if (ReturnScriptsExpanded)
                {
                    <div class="authoring-section-body">
                        <p class="return-strategy-intro">An exact verified state override is tried first. Otherwise the verified menu-root or deeper-menu default is used, followed by the existing unknown-position anchor. Tests send only the script shown—prepare or place the TV at the named start first.</p>
                        <div class="return-script-grid">
                    <article class="return-script-card">
                        <header>
                            <div><span>AT MENU ROOT</span><strong>@returnStrategy.MenuRootPath</strong></div>
                            <b class="timing-profile-state @(returnStrategy.AtMenuRoot.Verified ? "verified" : "unverified")">@(returnStrategy.AtMenuRoot.Verified ? "VERIFIED" : "NEEDS VALIDATION")</b>
                        </header>
                        <label><span>KEY SCRIPT</span><input @bind="AtMenuRootScript" @bind:after="MarkReturnScriptsDirty" disabled="@(IsBusy || Navigation.IsRunning)" /></label>
                        <small>Place the TV at this menu first. Test sends only <code>@AtMenuRootScript</code>.</small>
                        <div class="return-script-actions">
                            @if (returnStrategy.ActiveValidationKind == MenuReturnScriptKind.AtMenuRoot)
                            {
                                <b>@returnStrategy.ValidationPasses/@returnStrategy.RequiredValidationPasses passed</b>
                            }
                            <button class="primary-action" @onclick="TestAtMenuRootReturnAsync" disabled="@(!CanTestAtMenuRootReturn)">Save + test <span>▶</span></button>
                        </div>
                    </article>

                    <article class="return-script-card">
                        <header>
                            <div><span>DEEPER MENU</span><strong>Any node below @returnStrategy.MenuRootPath</strong></div>
                            <b class="timing-profile-state @(returnStrategy.BelowMenuRoot.Verified ? "verified" : "unverified")">@(returnStrategy.BelowMenuRoot.Verified ? "VERIFIED" : "NEEDS VALIDATION")</b>
                        </header>
                        <label><span>KEY SCRIPT</span><input @bind="BelowMenuRootScript" @bind:after="MarkReturnScriptsDirty" disabled="@(IsBusy || Navigation.IsRunning)" /></label>
                        <small>Place the TV at the selected deeper menu first. Test sends only <code>@BelowMenuRootScript</code>.</small>
                        <label>
                            <span>EXPECTED START</span>
                            <select @bind="DeepReturnTestNodeId" disabled="@(IsBusy || Navigation.IsRunning)">
                                @foreach (var node in returnStrategy.DeepTestNodes)
                                {
                                    <option value="@node.Id">@node.Path</option>
                                }
                            </select>
                        </label>
                        <div class="return-script-actions">
                            @if (returnStrategy.ActiveValidationKind == MenuReturnScriptKind.BelowMenuRoot)
                            {
                                <b>@returnStrategy.ValidationPasses/@returnStrategy.RequiredValidationPasses passed</b>
                            }
                            <button class="primary-action" @onclick="TestBelowMenuRootReturnAsync" disabled="@(!CanTestBelowMenuRootReturn)">Save + test <span>▶</span></button>
                        </div>
                    </article>
                </div>
                <div class="return-override-lab">
                    <header>
                        <div>
                            <span>STATE-SPECIFIC OVERRIDES</span>
                            <strong>Use a different return script from one exact menu position</strong>
                        </div>
                        <b>@returnStrategy.NodeOverrides.Count defined</b>
                    </header>
                    <div class="return-override-editor">
                        <label>
                            <span>MENU STATE</span>
                            <select @bind="OverrideReturnNodeId" @bind:after="LoadSelectedReturnOverride" disabled="@(IsBusy || Navigation.IsRunning)">
                                @foreach (var node in ReturnOverrideNodes)
                                {
                                    var existingOverride = returnStrategy.NodeOverrides.FirstOrDefault(item => item.NodeId.Equals(node.Id, StringComparison.OrdinalIgnoreCase));
                                    <option value="@node.Id">@node.Path@(existingOverride is null ? "" : existingOverride.Verified ? " · verified override" : " · override needs validation")</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>KEY SCRIPT</span>
                            <input @bind="OverrideReturnScript" placeholder="KEY_MENU, KEY_RETURN" disabled="@(IsBusy || Navigation.IsRunning)" />
                        </label>
                        <div class="return-override-status">
                            @if (SelectedReturnOverride is { } selectedOverride)
                            {
                                <b class="timing-profile-state @(selectedOverride.Verified ? "verified" : "unverified")">@(selectedOverride.Verified ? "VERIFIED" : "NEEDS VALIDATION")</b>
                            }
                            else
                            {
                                <b class="timing-profile-state unverified">USES DEFAULT</b>
                            }
                            @if (returnStrategy.ActiveValidationKind == MenuReturnScriptKind.NodeOverride
                                && returnStrategy.ActiveValidationNodeId?.Equals(OverrideReturnNodeId, StringComparison.OrdinalIgnoreCase) == true)
                            {
                                <small>@returnStrategy.ValidationPasses/@returnStrategy.RequiredValidationPasses passed</small>
                            }
                        </div>
                    </div>
                    <div class="return-override-actions">
                        <button class="secondary-action" @onclick="PrepareReturnOverrideStartAsync" disabled="@(!CanPrepareReturnOverride)">Prepare start</button>
                        @if (SelectedReturnOverride is not null)
                        {
                            <button class="secondary-action danger-action" @onclick="DeleteReturnOverrideAsync" disabled="@(IsBusy || Navigation.IsRunning)">Remove override</button>
                        }
                        <button class="secondary-action" @onclick="SaveReturnOverrideAsync" disabled="@(!CanSaveReturnOverride)">Save override</button>
                        <button class="primary-action" @onclick="TestReturnOverrideAsync" disabled="@(!CanTestReturnOverride)">Save + test <span>▶</span></button>
                    </div>
                    <small class="return-override-note">Removing an override immediately restores the normal root/deeper/default fallback for that state.</small>
                </div>
                <div class="return-fallback-row">
                    <div><span>UNKNOWN POSITION FALLBACK</span><strong>@returnStrategy.AnchorLabel</strong></div>
                    <code>@returnStrategy.FallbackScript</code>
                    <small>This existing verified anchor remains the fallback when the predicted menu position is unavailable.</small>
                    <button class="secondary-action" @onclick="SaveReturnScriptsAsync" disabled="@(!CanSaveReturnScripts)">Save scripts</button>
                </div>

                @if (returnStrategy.AwaitingValidationConfirmation)
                {
                    <div class="validation-confirmation return-validation-confirmation">
                        <div><span>RETURN SCRIPT CONFIRMATION</span><strong>Did the TV return to @returnStrategy.ExpectedTargetPath?</strong></div>
                        <button class="secondary-action danger-action" @onclick="() => ConfirmReturnScriptAsync(false)" disabled="@IsBusy">No — reset passes</button>
                        <button class="primary-action" @onclick="() => ConfirmReturnScriptAsync(true)" disabled="@IsBusy">Yes — count pass <span>✓</span></button>
                    </div>
                }
                    </div>
                }
            </div>
        }

        <div class="timing-profile-lab collapsible-authoring-section @(SystemTimingExpanded ? "" : "collapsed")">
            <button type="button" class="authoring-section-title authoring-section-toggle timing-profile-title" @onclick="ToggleSystemTiming" aria-expanded="@(SystemTimingExpanded ? "true" : "false")">
                <span>05</span><strong>System-wide timing</strong>
                <b class="timing-profile-state @(SystemTimingIsVerified ? "verified" : "unverified")">
                    @(SystemTimingIsVerified ? "VERIFIED" : "NEEDS VALIDATION")
                </b>
                <i aria-hidden="true">@(SystemTimingExpanded ? "−" : "+")</i>
            </button>
            @if (SystemTimingExpanded)
            {
                <div class="authoring-section-body">
                    <div class="timing-profile-layout">
                <div>
                    <strong>One profile for every menu route.</strong>
                    <p>These waits apply throughout this TV interface. A button can override its system wait inside a draft's timing lab.</p>
                </div>
                <div class="timing-profile-fields">
                    <label>
                        <span>Default / D-pad</span>
                        <div class="number-with-unit"><input type="number" min="50" max="30000" step="50" @bind="DefaultDelayMilliseconds" @bind:after="MarkTimingProfileDirty" disabled="@(Authoring.IsRecording || Navigation.IsRunning)" /><b>ms</b></div>
                    </label>
                    <label>
                        <span>Screen change</span>
                        <div class="number-with-unit"><input type="number" min="50" max="30000" step="50" @bind="ScreenChangeDelayMilliseconds" @bind:after="MarkTimingProfileDirty" disabled="@(Authoring.IsRecording || Navigation.IsRunning)" /><b>ms</b></div>
                    </label>
                    <label>
                        <span>Return</span>
                        <div class="number-with-unit"><input type="number" min="50" max="30000" step="50" @bind="ReturnDelayMilliseconds" @bind:after="MarkTimingProfileDirty" disabled="@(Authoring.IsRecording || Navigation.IsRunning)" /><b>ms</b></div>
                    </label>
                </div>
                <div class="timing-profile-actions">
                    <button class="secondary-action" @onclick="SaveSystemTimingAsync" disabled="@(!CanSaveSystemTiming)">Save system profile</button>
                </div>
            </div>
            <div class="timing-profile-test">
                <label>
                    <span>VALIDATION TRAVERSAL</span>
                    <select @bind="SelectedTimingTestRouteId" disabled="@(IsBusy || Authoring.AwaitingTimingValidationConfirmation)">
                        <option value="">Select a traversal</option>
                        @foreach (var route in Authoring.TimingTestRoutes)
                        {
                            <option value="@route.Id">@route.SourcePath → @route.TargetPath · @route.CommandCount commands</option>
                        }
                    </select>
                </label>
                <div class="timing-profile-test-score">
                    <span>SYSTEM PROFILE</span>
                    <b>@Authoring.TimingValidationPasses/@Authoring.RequiredTimingValidationPasses passed</b>
                </div>
                <button class="primary-action" @onclick="TestSystemTimingAsync" disabled="@(!CanTestSystemTiming)">
                    Test system profile <span>▶</span>
                </button>
            </div>
            @if (Authoring.TimingTestRoutes.Count == 0)
            {
                <p class="field-note">The default profile is ready for recording. After creating a traversal, you can use it here to test and tune the system waits if needed.</p>
            }
            else
            {
                <p class="field-note">Place the TV at the selected traversal's source first. The test saves these values and sends only that traversal, using system waits and no setup commands. Screen change covers Menu, OK, Home, Exit, and Source.</p>
            }

            @if (Authoring.AwaitingTimingValidationConfirmation)
            {
                <div class="validation-confirmation timing-validation-confirmation">
                    <div><span>SYSTEM TIMING CONFIRMATION</span><strong>Did the TV reach @Authoring.TimingValidationExpectedTargetPath?</strong></div>
                    <button class="secondary-action danger-action" @onclick="() => ConfirmSystemTimingAsync(false)" disabled="@IsBusy">No — reset passes</button>
                    <button class="primary-action" @onclick="() => ConfirmSystemTimingAsync(true)" disabled="@IsBusy">Yes — count pass <span>✓</span></button>
                </div>
            }
                </div>
            }
        </div>

        <div id="draft-validation" class="validation-studio collapsible-authoring-section setup-step-anchor @(DraftValidationExpanded ? "" : "collapsed")" @ref="ValidationStepElement">
            <button type="button" class="authoring-section-title authoring-section-toggle" @onclick="ToggleDraftValidation" aria-expanded="@(DraftValidationExpanded ? "true" : "false")">
                <span>06</span><strong>Timing lab and visual validation</strong>
                @if (DraftValidationNeedsAttention)
                {
                    <b class="timing-profile-state unverified">@Authoring.DraftCandidates.Count NEED VALIDATION</b>
                }
                <i aria-hidden="true">@(DraftValidationExpanded ? "−" : "+")</i>
            </button>
            @if (DraftValidationExpanded)
            {
                <div class="authoring-section-body">
                    <p class="field-note">For a traversal with recorded return keys, Prepare source sends that return sequence and then follows verified routes toward the forward source. Replay test sends the forward traversal, then that same command row changes to Count pass. Each card remembers its own 3-pass count when you switch between commands. The third accepted pass verifies the command and returns to normal video automatically.</p>
            @if (Authoring.DraftCandidates.Count == 0)
            {
                <div class="capture-empty compact">No draft anchors or transitions are waiting for validation.</div>
            }
            else
            {
                <div class="validation-list">
                    @foreach (var candidate in Authoring.DraftCandidates)
                    {
                        var isActive = Authoring.ActiveValidationKind == candidate.Kind && Authoring.ActiveValidationId == candidate.Id;
                        <article class="validation-card @(isActive ? "active" : "")">
                            <div>
                                <span>@candidate.Kind</span>
                                <strong>@candidate.Label</strong>
                                <small>@(candidate.SourcePath is null ? candidate.TargetPath : $"{candidate.SourcePath} → {candidate.TargetPath}") · @candidate.CommandCount forward@(candidate.ReturnCommandCount > 0 ? $" + {candidate.ReturnCommandCount} return" : string.Empty) commands</small>
                            </div>
                            <div class="validation-card-actions">
                                <b>@candidate.ValidationPasses/@Authoring.RequiredValidationPasses passed</b>
                                @if (candidate.SourceNodeId is not null)
                                {
                                    <button class="secondary-action" @onclick="() => PrepareValidationSourceAsync(candidate)" disabled="@(!CanPrepareValidationSource(candidate))">@(candidate.ReturnCommandCount > 0 ? "Prepare with recorded return" : "Prepare source")</button>
                                }
                                <button class="secondary-action" @onclick="() => PrepareRerecord(candidate)" disabled="@(Authoring.IsRecording || Navigation.IsRunning)">Re-record</button>
                                <button class="secondary-action" @onclick="() => ToggleTimingEditor(candidate)" disabled="@(Authoring.IsRecording || Navigation.IsRunning)">@(IsTimingEditorOpen(candidate) ? "Close timing" : "Timing lab")</button>
                                @if (isActive && Authoring.AwaitingValidationConfirmation)
                                {
                                    <span class="validation-inline-prompt" role="status">Did the TV reach @candidate.TargetPath?</span>
                                    <button class="secondary-action danger-action" @onclick="() => ConfirmValidationAsync(false)" disabled="@IsBusy">No — adjust timing</button>
                                    <button class="primary-action" @onclick="() => ConfirmValidationAsync(true)" disabled="@IsBusy">
                                        @(candidate.ValidationPasses + 1 >= Authoring.RequiredValidationPasses
                                            ? "Count final pass + return"
                                            : "Count pass") <span>✓</span>
                                    </button>
                                }
                                else
                                {
                                    <button class="secondary-action" @onclick="() => RunValidationAsync(candidate)" disabled="@(!CanRunValidation || Authoring.AwaitingValidationConfirmation)">Replay test</button>
                                }
                                <button class="secondary-action danger-action" @onclick="() => DeleteDraftAsync(candidate)" disabled="@(IsBusy || Authoring.IsRecording || Navigation.IsRunning)">Delete</button>
                            </div>
                            @if (IsTimingEditorOpen(candidate))
                            {
                                <div class="timing-step-editor">
                                    <header>
                                        <div><strong>Press-by-press waits</strong><small>Waits occur after the named button. System values follow the profile above.</small></div>
                                        <div><span>ESTIMATED REPLAY</span><b>@TimingDurationMilliseconds.ToString("N0", CultureInfo.InvariantCulture) ms</b></div>
                                    </header>
                                    <div class="timing-step-list">
                                        @foreach (var step in TimingSteps)
                                        {
                                            <div class="timing-step-row">
                                                <b>@step.Position.ToString("00", CultureInfo.InvariantCulture)</b>
                                                <code>@step.Key</code>
                                                <small>@step.Action</small>
                                                <label class="timing-override-toggle"><input type="checkbox" @bind="step.UseCustomDelay" /><span>Custom</span></label>
                                                @if (step.UseCustomDelay)
                                                {
                                                    <div class="number-with-unit timing-step-input"><input type="number" min="50" max="30000" step="50" @bind="step.DelayAfterMilliseconds" /><b>ms</b></div>
                                                }
                                                else
                                                {
                                                    <div class="timing-system-wait"><span>System</span><b>@GetSystemDelayMilliseconds(step.Key) ms</b></div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="timing-editor-actions">
                                        <button class="secondary-action" @onclick="UseSystemTimingForAllSteps" disabled="@IsBusy">Use system for all</button>
                                        <button class="secondary-action" @onclick="() => SaveCandidateTimingAsync(candidate)" disabled="@(!CanSaveCandidateTiming)">Save to YAML</button>
                                        <button class="primary-action" @onclick="() => SaveAndReplayTimingAsync(candidate)" disabled="@(!CanSaveAndReplayTiming)">Save + replay <span>▶</span></button>
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            }

                </div>
            }
        </div>
    }
</section>

