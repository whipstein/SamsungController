    private bool CanTestAtMenuRootReturn => CanSaveReturnScripts && IsConnected;
    private bool CanTestBelowMenuRootReturn => CanSaveReturnScripts && IsConnected
        && Authoring.ReturnStrategy!.DeepTestNodes.Any(node =>
            node.Id.Equals(DeepReturnTestNodeId, StringComparison.OrdinalIgnoreCase));
    private IReadOnlyList<MenuNodeSummary> ReturnOverrideNodes => Authoring.ReturnStrategy is not { } strategy
        ? []
        : Navigation.Nodes
            .Where(node => !node.Id.Equals(strategy.TargetNodeId, StringComparison.OrdinalIgnoreCase))
            .OrderBy(node => node.Path, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    private MenuReturnOverrideSummary? SelectedReturnOverride => Authoring.ReturnStrategy?.NodeOverrides
        .FirstOrDefault(item => item.NodeId.Equals(OverrideReturnNodeId, StringComparison.OrdinalIgnoreCase));
    private bool ReturnOverrideScriptValid => TryParseKeyScript(OverrideReturnScript, out _);
    private bool CanSaveReturnOverride => Authoring.ReturnStrategy is not null
        && !string.IsNullOrWhiteSpace(OverrideReturnNodeId) && ReturnOverrideScriptValid
        && !IsBusy && !Authoring.IsRecording && !Navigation.IsRunning && !Snapshot.MacroRunning
        && !Authoring.AwaitingValidationConfirmation && !Authoring.AwaitingTimingValidationConfirmation
        && Authoring.ReturnStrategy.AwaitingValidationConfirmation == false;
    private bool CanTestReturnOverride => CanSaveReturnOverride && IsConnected;
    private bool CanPrepareReturnOverride => IsConnected && !IsBusy && !Authoring.IsRecording
        && !Navigation.IsRunning && !Snapshot.MacroRunning && !string.IsNullOrWhiteSpace(OverrideReturnNodeId);
    private long TimingDurationMilliseconds => TimingSteps.Sum(step =>
        (long)(step.UseCustomDelay
            ? step.DelayAfterMilliseconds
            : GetSystemDelayMilliseconds(step.Key)));

    protected override async Task OnInitializedAsync()
    {
        Refresh();
        Controller.Changed += HandleControllerChanged;
        await Controller.InitializeAsync();
        Refresh();
        InitializeNodeDefaults();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (PendingSetupScroll is { } step)
            {
                PendingSetupScroll = null;
                await JavaScript.InvokeVoidAsync(
                    "samsungController.scrollToElement",
                    GetSetupStepElement(step));
            }

            if (MenuTreeExpanded && FineAdjustmentsExpanded && Navigation.DefinitionName is not null)
            {
                await JavaScript.InvokeVoidAsync(
                    "samsungController.bindMenuTree",
                    MenuTreeElement);
            }

            if (MenuTreeExpanded && BulkTopologyExpanded && Navigation.DefinitionName is not null)
            {
                await JavaScript.InvokeVoidAsync(
                    "samsungController.bindAutoIndent",
                    TopologyOutlineElement);
                await JavaScript.InvokeVoidAsync(
                    "samsungController.bindOutlineEditorGuides",
                    TopologyOutlineElement,
                    TopologyLineNumbersElement,
                    TopologyIndentGuidesElement);
            }
        }
        catch (JSDisconnectedException)
        {
            // The browser can disconnect while dotnet watch replaces the circuit.
        }
    }

