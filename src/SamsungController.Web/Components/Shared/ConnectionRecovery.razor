@implements IDisposable
@inject SamsungIpRemoteService Controller

@if (Snapshot.ActiveProfile is not null && Snapshot.HasToken)
{
    <div class="notice">
        <div class="direct-actions"><button class="toolbar-button" title="Reset the local connection using the saved token; clears cached readings and unsent drafts" @onclick="ResetAsync" disabled="@Snapshot.IsBusy">Reset connection (keep pairing)</button></div>
        @if (Result is not null) { <p role="status">@Result</p> }
        @if (Error is not null) { <p class="direct-unavailable" role="alert">@Error</p> }
    </div>
}

@code {
    private IpRemoteSnapshot Snapshot = new();
    private string? Error, Result;
    protected override async Task OnInitializedAsync()
    {
        Controller.Changed += Refresh;
        try { await Controller.InitializeAsync(); }
        catch (Exception error) when (error is ArgumentException or InvalidOperationException or IOException or UnauthorizedAccessException or JsonException) { Error = error.Message; }
        Snapshot = Controller.GetSnapshot();
    }
    private void Refresh() => _ = InvokeAsync(() => { Snapshot = Controller.GetSnapshot(); StateHasChanged(); });
    private async Task ResetAsync()
    {
        Error = Result = null;
        try { await Controller.ResetMenuConnectionAsync(); Result = Controller.GetSnapshot().Menu.Status; }
        catch (Exception error) when (error is ArgumentException or InvalidOperationException or IOException or UnauthorizedAccessException or JsonException or OperationCanceledException)
        { Error = error.Message; }
        finally { Snapshot = Controller.GetSnapshot(); }
    }
    public void Dispose() => Controller.Changed -= Refresh;
}
