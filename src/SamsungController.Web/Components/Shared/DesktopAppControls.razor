@implements IDisposable
@inject IServiceProvider Services
@inject SamsungIpRemoteService Controller

@if (Runtime is { Enabled: true })
{
    <div class="desktop-app-controls">
        <button type="button" class="toolbar-button" title="Stop the background server and close this app tab if your browser permits. Closing the browser alone leaves the server running." @onclick="QuitAsync" disabled="@(Quitting || Controller.GetSnapshot().IsBusy)">Quit app</button>
        @if (Message is not null) { <span class="desktop-app-controls-message" role="status">@Message</span> }
    </div>
}

@code {
    private DesktopRuntime? Runtime;
    private string? Message;
    private bool Quitting;
    protected override void OnInitialized() { Runtime = Services.GetService<DesktopRuntime>(); Controller.Changed += Changed; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Runtime is not { Enabled: true } || Services.GetService<IJSRuntime>() is not { } js) return;
        try { await js.InvokeVoidAsync("samsungDesktop.watch", Runtime.Instance); }
        catch (Exception error) when (error is JSException or InvalidOperationException or TaskCanceledException) { /* Quitting must still work if scripting is unavailable. */ }
    }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    private async Task QuitAsync()
    {
        if (Runtime is null) return;
        Quitting = true;
        Message = "Stopping the app. Reopen SamsungController to start it again; your saved data is kept.";
        try { await Runtime.QuitAsync(Controller); }
        catch (InvalidOperationException error) { Quitting = false; Message = error.Message; }
    }
    public void Dispose() => Controller.Changed -= Changed;
}
